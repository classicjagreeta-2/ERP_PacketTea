@model PacketTea.Models.PT.T_MRETU_DATA
@using Newtonsoft.Json
@{
    ViewBag.Title = "Market Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var types = (Dictionary<string, string>)ViewBag.Types;
    bool isEdit = ViewBag.IsEdit ?? false;
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    bool isView = ViewBag.IsView ?? false;
    var head = Model.T_MRETU_HED;
    string newType = (string)ViewBag.NewType;
    bool irnLocked = !string.IsNullOrEmpty(head.IRN);
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (see CLAUDE.md's "lookup pickers" rule) -- the same
         jquery.inputpicker include AWR Entry / Packing use, replacing this screen's earlier
         bespoke centered-modal Party / Transporter / Item picker. (The Bill No help stays a modal:
         it is a composite bill-selection dialog, deliberately not converted.) -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        /* The plugin wraps a picked cell's input in a div with inline "overflow:auto; height:100%"; inside a
           table cell that can sprout scrollbars, so keep the wrapper exactly the size of its input. */
        #gridTable .inputpicker-div { overflow: hidden !important; height: auto !important; }
        #gridTable .inputpicker-overflow-hidden { overflow: hidden; }
        #gridTable td.col-item { min-width: 130px; }
        input[readonly] { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 80px; }
        #gridTable td input.f-rate, #gridTable td input.f-amount, #gridTable td input.f-mretu,
        #gridTable td input.f-grosswt, #gridTable td input.f-netwt, #gridTable td input.f-sht,
        #gridTable td input.f-bkg, #gridTable td input.f-lkg, #gridTable td input.f-crqty,
        #gridTable td input.f-discpct, #gridTable td input.f-discount,
        #gridTable td input.f-cgstrate, #gridTable td input.f-cgstamt,
        #gridTable td input.f-sgstrate, #gridTable td input.f-sgstamt,
        #gridTable td input.f-igstrate, #gridTable td input.f-igstamt,
        #gridTable td input.f-cessrate, #gridTable td input.f-cessamt,
        input[type="number"] { text-align: right; }
        #gridTable td input.f-amount, #gridTable td input.f-cgstamt, #gridTable td input.f-sgstamt,
        #gridTable td input.f-igstamt, #gridTable td input.f-cessamt { background-color: #f3f4f7; }
        .grid-pick-btn { width: 20px; height: 21px; padding: 0; margin-left: 2px; vertical-align: middle; border: 1px solid #ccc; background: #f4f6fa; cursor: pointer; font-size: 11px; line-height: 1; }
        .popup-box.picker-box { width: 420px; display: none; }
        .popup-box.picker-box.wide { width: 780px; max-width: 92vw; }
        .popup-box .picker-body { max-height: 40vh; overflow-y: auto; margin-top: 8px; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .action-btns li a.is-disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
        .irn-banner { background:#fff3cd; border:1px solid #ffe69c; color:#664d03; padding:8px 14px; margin-bottom:10px; border-radius:4px; font-size:13px; }
        .optflag-row label { font-weight: normal; margin-right: 14px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />
    <input type="hidden" id="ID" value="@head.ID" />

    <div class="general-container">
        <div class="purchase-details">

            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "MarketReturn")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "MarketReturn")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Market Return</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : @(head.DOCNO ?? "")</div>
                    </div>
                </div>
            </div>

            @if (irnLocked)
            {
                <div class="irn-banner"><i class="fa fa-lock"></i> e-Invoice (IRN: @head.IRN) already generated against this document -- Edit/Delete is not allowed.</div>
            }

            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit / Type</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                <input type="text" id="UNIT_disp" value="@head.UNIT" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Type <span>(*)</span></label>
                                <select id="TYPE" disabled>
                                    @foreach (var t in types)
                                    {
                                        <option value="@t.Key" selected="@(t.Key == newType)">@t.Value (@t.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">

                <!-- Header -->
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" value="@head.DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Date <span>(*)</span></label>
                                <input type="date" id="DATE_ORA" value="@(head.DATE_ORA?.ToString("yyyy-MM-dd"))"
                                       min="@ViewBag.MinDocDate" />
                            </div>
                            <div class="form-col-20">
                                <label>Party <span>(*)</span></label>
                                <input type="text" id="PCD" data-picker="party" value="@head.PCD" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Party Name</label>
                                <input type="text" id="PCD_disp" value="@head.PartyName" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Bill No <span>(*)</span></label>
                                <div style="display:flex;gap:4px;">
                                    <input type="text" id="BLNO" value="@head.BLNO" style="flex:1;" />
                                    <button type="button" id="btnBillHelp" title="Select a bill of this party" style="width:auto;padding:0 10px;"><i class="fa fa-search"></i></button>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Bill Date <span>(*)</span></label>
                                <input type="date" id="BLDT" value="@(head.BLDT?.ToString("yyyy-MM-dd"))" readonly />
                            </div>
                            <div class="form-col-40">
                                <label>Bill of</label>
                                <div style="padding-top:6px;" class="optflag-row">
                                    <label><input type="checkbox" id="chkLastYr" style="width:auto;" /> Last Year</label>
                                    <label><input type="checkbox" id="chkLLYr" style="width:auto;" /> Before Last Year</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Transporter <span>(*)</span></label>
                                <input type="text" id="TPT" data-picker="transporter" value="@head.TPT" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Transporter Name</label>
                                <input type="text" id="TPT_disp" value="@head.TransporterName" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Vehicle No <span>(*)</span></label>
                                <input type="text" id="VEH" value="@head.VEH" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>LR No</label>
                                <input type="text" id="LR_NO" value="@head.LR_NO" />
                            </div>
                            <div class="form-col-20">
                                <label>Invoice No</label>
                                <input type="text" id="INVNO" value="@head.INVNO" />
                            </div>
                            <div class="form-col-20">
                                <label>Veh Type</label>
                                <input type="text" id="VTYPE" value="@head.VTYPE" />
                            </div>
                            <div class="form-col-20">
                                <label>Trip No.</label>
                                <input type="text" id="TRIP_NO" value="@head.TRIP_NO" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Trip Unit</label>
                                <input type="text" id="TRIP_UNIT" value="@head.TRIP_UNIT" readonly />
                            </div>
                        </div>

                        <div class="form-row optflag-row">
                            <div class="form-col-40">
                                <label>Amount basis (GST/Amount calculation)</label>
                                <div style="padding-top:6px;">
                                    <label><input type="radio" name="OptFlag" value="QTY" checked style="width:auto;" /> Quantity</label>
                                    <label><input type="radio" name="OptFlag" value="WT" style="width:auto;" /> Net Weight</label>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Item Detail -->
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Item Detail</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnAddRow"><i class="fa fa-plus"></i> Add Row</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;text-align:right;">Sl</th>
                                        <th>Item <span style="color:red;">(*)</span></th>
                                        <th>MRP <span style="color:red;">(*)</span></th>
                                        <th style="width:110px;">Mfg Date <span style="color:red;">(*)</span></th>
                                        <th>Batch No <span style="color:red;">(*)</span></th>
                                        <th style="text-align:right;">Return Qty</th>
                                        <th style="text-align:right;">Gross Wt</th>
                                        <th style="text-align:right;">Net Wt</th>
                                        <th style="text-align:right;">Shortage</th>
                                        <th style="text-align:right;">Breakage</th>
                                        <th style="text-align:right;">Leakage</th>
                                        <th>PL-Crate Code</th>
                                        <th style="text-align:right;">Crate Qty</th>
                                        <th style="text-align:right;">Rate</th>
                                        <th style="text-align:right;">Disc %</th>
                                        <th style="text-align:right;">Discount</th>
                                        <th style="text-align:right;">Amount</th>
                                        <th>GST Code</th>
                                        <th style="text-align:right;">CGST%</th>
                                        <th style="text-align:right;">CGST Amt</th>
                                        <th style="text-align:right;">SGST%</th>
                                        <th style="text-align:right;">SGST Amt</th>
                                        <th style="text-align:right;">IGST%</th>
                                        <th style="text-align:right;">IGST Amt</th>
                                        <th style="text-align:right;">Cess%</th>
                                        <th style="text-align:right;">Cess Amt</th>
                                        <th style="text-align:right;">Available Qty</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="6" style="text-align:right;">Total</td>
                                        <td id="ftMretu" style="text-align:right;"></td>
                                        <td id="ftGross" style="text-align:right;"></td><td id="ftWeight" style="text-align:right;"></td>
                                        <td></td><td></td><td></td><td></td>
                                        <td></td><td></td><td></td><td></td>
                                        <td id="ftAmt" style="text-align:right;"></td>
                                        <td colspan="9"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Backdrop shared by every popup below -->
    <div class="popup-overlay" id="pickerOverlay"></div>

    <!-- Generic single-select picker (Party/Transporter/Item) -->
    <div class="popup-box picker-box" id="genericPicker">
        <div class="popup-header">
            <h2 id="pickerTitle">Select</h2>
            <button type="button" class="close-btn" onclick="closePicker()">X</button>
        </div>
        <input type="text" id="pickerSearch" class="picker-search" placeholder="Type to search..." />
        <div class="picker-body" id="pickerBody"></div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
    function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) {
        $('#appAlertTitle').text('Notice');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').hide();
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onOk) onOk(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function showConfirm(message, onYes) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', closeAppAlert);
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onYes) onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function handleLookupFail(jqXHR) {
        if (jqXHR.status === 440) {
            showAlert((jqXHR.responseJSON && jqXHR.responseJSON.message) || 'Your session has expired. Please log in again.',
                function () { window.location.reload(); });
        } else {
            showAlert((jqXHR.responseJSON && jqXHR.responseJSON.message) || 'Could not load data. Please try again.');
        }
    }

    $('#pickerOverlay, #genericPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    // View mode (list page "View" button) / e-Invoice lock: the whole form is read-only.
    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    var IRN_LOCKED = @Html.Raw(irnLocked ? "true" : "false");
    var DOCNO = @Html.Raw(JsonConvert.SerializeObject(head.DOCNO ?? ""));
    var UNIT = @Html.Raw(JsonConvert.SerializeObject(head.UNIT ?? ""));
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function round2(v) { return Math.round(num(v) * 100) / 100; }
    // Qty / weights are 3 decimals (Amount / Rate / % / tax stay 2 decimals).
    function round3(v) { return Math.round(num(v) * 1000) / 1000; }

    var rows =@Html.Raw(JsonConvert.SerializeObject(Model.T_MRETU_DET));
    var rowSeq = 0;

    // A saved document's lines carry the FLAG the VB6 form wrote ('1' = Quantity,
    // '2' = Net Wt) -- restore the option from it before any recalculation.
    if (rows.length && String(rows[0].FLAG || '1') === '2') { $('input[name=OptFlag][value=WT]').prop('checked', true); }
    function basisOf(r) { return $('input[name=OptFlag]:checked').val() === 'WT' ? num(r.WEIGHT) : num(r.Mretu); }
    rows.forEach(function (r) {
        r._cid = ++rowSeq; r._availQty = null; r._availWeight = null;
        r._discPct = num(r.DISC);
        var b = basisOf(r);
        r._discPerUnit = b ? num(r.DISCOUNT) / b : null;
    });

    // Cache of the currently-loaded bill's lines (from GetOriginalBill), keyed by
    // item+mrp+mfgdt+batchno -- used to (re)cap the Return Qty/Net Wt ceiling on
    // every grid row as its identifying fields change.
    var billLinesCache = [];
    var billHeaderCache = null;
    var billRt = '';

    function lineKey(itcd, mrp, mfgdt, batchno) {
        function n(s) { return String(s || '').trim().toUpperCase(); }
        return n(itcd) + '|' + n(mrp) + '|' + (mfgdt ? String(mfgdt).substring(0, 10) : '') + '|' + n(batchno);
    }

    // VB6 ChkLastYr / chkLLYr -- which fiscal year's schema the bill is read from.
    function yearBack() { return $('#chkLastYr').is(':checked') ? 1 : ($('#chkLLYr').is(':checked') ? 2 : 0); }
    function setYearBack(yb) { $('#chkLastYr').prop('checked', yb === 1); $('#chkLLYr').prop('checked', yb === 2); }
    $('#chkLastYr').on('change', function () { if (this.checked) $('#chkLLYr').prop('checked', false); });
    $('#chkLLYr').on('change', function () { if (this.checked) $('#chkLastYr').prop('checked', false); });

    // yb = -1 lets the server find the bill in the current, last or before-last
    // year (used when reopening a saved document).
    function loadBillLines(blno, yb, cb) {
        if (!blno) { billLinesCache = []; billHeaderCache = null; if (cb) cb(false); return; }
        $.getJSON('@Url.Action("GetOriginalBill", "MarketReturn")',
            { blno: blno, unit: UNIT, rt: billRt, yearBack: yb, excludeDocno: DOCNO, excludeUnit: UNIT }, function (data) {
            billHeaderCache = data.header || null;
            billLinesCache = data.lines || [];
            if (billHeaderCache) { billRt = billHeaderCache.rt || ''; setYearBack(billHeaderCache.yearBack || 0); }
            if (cb) cb(true);
        }).fail(function (jqXHR) {
            billLinesCache = []; billHeaderCache = null;
            if (jqXHR.status === 404 || /not found/i.test((jqXHR.responseJSON && jqXHR.responseJSON.message) || '')) {
                showAlert('Bill No "' + blno + '" was not found.');
            } else { handleLookupFail(jqXHR); }
            if (cb) cb(false);
        });
    }

    // VB6 poplines: the bill overwrites the header (party, vehicle, transporter,
    // veh type, trip no/unit, LR no), sets Quantity/Net Wt from the bill's FLAG,
    // and replaces the grid with every bill line -- qty, weights, rate, discount
    // and GST code/rates as billed. Each line defaults to what is still returnable
    // (billed minus what other Market Returns already took back).
    function popLines() {
        var h = billHeaderCache;
        if (!h) return;
        // The return belongs to the bill's Sales unit (BTEA/BGCH/...), not the
        // PacketTea login unit (e.g. JSTI) the screen may have been opened with.
        if (h.unit && !IS_EDIT) { UNIT = h.unit; $('#UNIT_disp').val(h.unit); }
        $('#BLDT').val(h.bldt ? h.bldt.substring(0, 10) : '');
        setPickerValue('#PCD', h.pcd || ''); $('#PCD_disp').val(h.partyName || '');
        $('#VEH').val(h.veh || '');
        setPickerValue('#TPT', h.tpt || ''); $('#TPT_disp').val(h.tptName || '');
        $('#VTYPE').val(h.vtype || '').attr('title', h.vtypeName || '');
        $('#TRIP_NO').val(h.tripNo == null ? '' : h.tripNo);
        $('#TRIP_UNIT').val(h.tripUnit || '');
        $('#LR_NO').val(h.lrNo || '');
        $('input[name=OptFlag][value=' + (h.optFlag === 'WT' ? 'WT' : 'QTY') + ']').prop('checked', true);

        rows = billLinesCache.map(function (l) {
            var q = num(l.qty), avail = Math.max(0, num(l.availableQty));
            var share = q > 0 ? Math.min(1, avail / q) : 0;
            var r = {
                _cid: ++rowSeq, ITCD: l.itcd, ItemName: l.itemName, MRP: l.mrp, MFGDT: l.mfgdt, BATCHNO: l.batchno,
                Mretu: round3(avail),
                WEIGHT: round3(Math.min(num(l.weight), num(l.availableWeight))),
                GROSS_WEIGHT: round3(num(l.grossWeight) * share),
                SHT: 0, BKG: 0, LKG: 0, PLCRCD: l.plcrcd || '', PLCRQTY: 0,
                RATE: num(l.rate), DISC: num(l.disc), _discPct: num(l.disc), DISCOUNT: num(l.discount),
                CSTCD: l.cstcd || '', FLAG: l.flag || '1',
                GST_CODE: l.gstCode || '', CGST_RATE: num(l.cgstRate), SGST_RATE: num(l.sgstRate),
                IGST_RATE: num(l.igstRate), GCESS_RATE: num(l.gcessRate),
                _availQty: round3(l.availableQty), _availWeight: round3(l.availableWeight)
            };
            // Bill discount is carried per unit of the amount basis, so a partial
            // return gets its proportional share of it.
            var billBasis = h.optFlag === 'WT' ? num(l.weight) : q;
            r._discPerUnit = billBasis ? num(l.discount) / billBasis : null;
            recalcRow(r);
            return r;
        });
        renderGrid();
    }

    // Bill help (VB6 TEXT3_buttonclick) -- a party must be chosen first.
    $('#btnBillHelp').on('click', function () {
        if (!$('#PCD').val()) { showAlert('Select Party first', function () { $('#PCD').focus(); }); return; }
        openBillPicker(function (row) {
            $('#BLNO').val(row.BLNO);
            billRt = row.RT || '';
            loadBillLines(row.BLNO, yearBack(), function (ok) { if (ok) popLines(); });
        });
    });

    // Typing a Bill No (VB6 Text3_Validate) loads it the same way.
    $('#BLNO').on('change', function () {
        var blno = $.trim($(this).val());
        billRt = '';
        if (!blno) { billLinesCache = []; billHeaderCache = null; return; }
        loadBillLines(blno, yearBack(), function (ok) { if (ok) popLines(); });
    });

    // Re-derive a row's ceiling (available qty/weight) from the cached bill lines
    // whenever its identifying fields (item/mrp/mfgdt/batch) change.
    function capRow(r) {
        // A bill line without a Mfg Date matches its item+MRP+batch on any date
        // (the user has to type one for the return line).
        var key = lineKey(r.ITCD, r.MRP, r.MFGDT, r.BATCHNO);
        var undated = lineKey(r.ITCD, r.MRP, null, r.BATCHNO);
        var m = billLinesCache.find(function (b) {
            return b.mfgdt ? lineKey(b.itcd, b.mrp, b.mfgdt, b.batchno) === key
                           : lineKey(b.itcd, b.mrp, null, b.batchno) === undated;
        });
        if (m) {
            r._availQty = round3(m.availableQty);
            r._availWeight = round3(m.availableWeight);
        } else {
            r._availQty = null;
            r._availWeight = null;
        }
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        var totMretu = 0, totWeight = 0, totGross = 0, totAmt = 0;
        rows.forEach(function (r, idx) {
            r.SRLNO = idx + 1;
            totMretu += num(r.Mretu);
            totWeight += num(r.WEIGHT);
            totGross += num(r.GROSS_WEIGHT);
            totAmt += num(r.AMT);
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" /></td>');
            tr.append('<td style="text-align:right;">' + r.SRLNO + '</td>');
            tr.append('<td class="col-item"><input type="text" class="f-item" data-picker-row="item" value="' + (r.ITCD || '') + '" placeholder="Code" title="' + (r.ItemName || '') + '" /></td>');
            tr.append('<td><input type="text" class="f-mrp" value="' + (r.MRP || '') + '" /></td>');
            tr.append('<td><input type="date" class="f-mfgdt" value="' + (r.MFGDT ? r.MFGDT.substring(0, 10) : '') + '" /></td>');
            tr.append('<td><input type="text" class="f-batchno" value="' + (r.BATCHNO || '') + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-mretu" value="' + round3(r.Mretu).toFixed(3) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-grosswt" value="' + round3(r.GROSS_WEIGHT).toFixed(3) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-netwt" value="' + round3(r.WEIGHT).toFixed(3) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-sht" value="' + round3(r.SHT).toFixed(3) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-bkg" value="' + round3(r.BKG).toFixed(3) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" class="f-lkg" value="' + round3(r.LKG).toFixed(3) + '" /></td>');
            tr.append('<td><input type="text" class="f-plcrcd" value="' + (r.PLCRCD || '') + '" /></td>');
            tr.append('<td><input type="number" step="1" class="f-crqty" value="' + (r.PLCRQTY || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-rate" value="' + round2(r.RATE).toFixed(2) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-discpct" value="' + round2(r._discPct).toFixed(2) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-discount" value="' + round2(r.DISCOUNT).toFixed(2) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-amount" value="' + round2(r.AMT).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-gstcode" value="' + (r.GST_CODE || '') + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-cgstrate" value="' + round2(r.CGST_RATE).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-cgstamt" value="' + round2(r.CGST_AMT).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-sgstrate" value="' + round2(r.SGST_RATE).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-sgstamt" value="' + round2(r.SGST_AMT).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-igstrate" value="' + round2(r.IGST_RATE).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-igstamt" value="' + round2(r.IGST_AMT).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-cessrate" value="' + round2(r.GCESS_RATE).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-cessamt" value="' + round2(r.GCESS_AMT).toFixed(2) + '" readonly /></td>');
            tr.append('<td class="f-avail" style="text-align:right;color:#666;">' + (r._availQty != null ? round3(r._availQty).toFixed(3) : '') + '</td>');
            $tb.append(tr);
        });
        $('#ftMretu').text(round3(totMretu).toFixed(3));
        $('#ftGross').text(round3(totGross).toFixed(3));
        $('#ftWeight').text(round3(totWeight).toFixed(3));
        $('#ftAmt').text(round2(totAmt).toFixed(2));
        // A read-only screen (View / IRN-locked) keeps freshly rendered rows disabled too -- the
        // bill-lines cache reload re-renders the grid after the page-level lock below has run.
        if (IS_VIEW || IRN_LOCKED) $('#gridBody :input').prop('disabled', true);
    }

    // VB6 poplines' arithmetic: Amount = rate x qty (or x net wt), discount kept
    // separate, GST on (Amount - Discount) at the bill line's own rates (the bill
    // already carries the CGST+SGST vs IGST split). The server recomputes the same
    // on Save from the bill itself.
    function recalcRow(r) {
        var basis = basisOf(r);
        r.AMT = round2(basis * num(r.RATE));
        if (r._discPerUnit != null) r.DISCOUNT = round2(basis * r._discPerUnit);
        else if (r._discPct) r.DISCOUNT = round2(r.AMT * num(r._discPct) / 100);
        var taxable = r.AMT - num(r.DISCOUNT);
        r.CGST_AMT = round2(taxable * num(r.CGST_RATE) / 100);
        r.SGST_AMT = round2(taxable * num(r.SGST_RATE) / 100);
        r.IGST_AMT = round2(taxable * num(r.IGST_RATE) / 100);
        r.GCESS_AMT = round2(taxable * num(r.GCESS_RATE) / 100);
    }

    $('#gridBody').on('input change', 'input', function () {
        var $tr = $(this).closest('tr');
        var r = findRow($tr.data('cid'));
        if (!r) return;

        r.ITCD = $tr.find('.f-item').val();
        r.MRP = $tr.find('.f-mrp').val();
        r.MFGDT = $tr.find('.f-mfgdt').val() || null;
        r.BATCHNO = ($tr.find('.f-batchno').val() || '').toUpperCase();
        r.Mretu = round3($tr.find('.f-mretu').val());
        r.GROSS_WEIGHT = round3($tr.find('.f-grosswt').val());
        r.WEIGHT = round3($tr.find('.f-netwt').val());
        r.SHT = round3($tr.find('.f-sht').val());
        r.BKG = round3($tr.find('.f-bkg').val());
        r.LKG = round3($tr.find('.f-lkg').val());
        r.PLCRCD = $tr.find('.f-plcrcd').val();
        r.PLCRQTY = num($tr.find('.f-crqty').val());
        r.RATE = round2($tr.find('.f-rate').val());
        r._discPct = round2($tr.find('.f-discpct').val());
        r.DISC = r._discPct;
        if ($(this).hasClass('f-discpct')) r._discPerUnit = null; // user-set % replaces the bill's discount
        r.GST_CODE = ($tr.find('.f-gstcode').val() || '').toUpperCase();

        if ($(this).hasClass('f-item') || $(this).hasClass('f-mrp') || $(this).hasClass('f-mfgdt') || $(this).hasClass('f-batchno')) {
            capRow(r);
            $tr.find('.f-avail').text(r._availQty != null ? round3(r._availQty).toFixed(3) : '');
        }
        // Enforce the ceiling client-side too: a picked/typed row's Return Qty can be
        // edited DOWN freely but never back up past the bill line's remaining balance.
        if ($(this).hasClass('f-mretu') && r._availQty != null && num(r.Mretu) > r._availQty) {
            r.Mretu = r._availQty;
            $tr.find('.f-mretu').val(round3(r.Mretu).toFixed(3));
            showAlert('Return Qty for ' + (r.ITCD || 'this item') + ' cannot exceed the available billed quantity (' + round3(r._availQty).toFixed(3) + ').');
        }
        if ($(this).hasClass('f-netwt') && r._availWeight != null && num(r.WEIGHT) > r._availWeight) {
            r.WEIGHT = r._availWeight;
            $tr.find('.f-netwt').val(round3(r.WEIGHT).toFixed(3));
            showAlert('Net Weight for ' + (r.ITCD || 'this item') + ' cannot exceed the available billed weight (' + round3(r._availWeight).toFixed(3) + ').');
        }

        recalcRow(r);
        $tr.find('.f-amount').val(round2(r.AMT).toFixed(2));
        $tr.find('.f-discount').val(round2(r.DISCOUNT).toFixed(2));
        $tr.find('.f-cgstamt').val(round2(r.CGST_AMT).toFixed(2));
        $tr.find('.f-sgstamt').val(round2(r.SGST_AMT).toFixed(2));
        $tr.find('.f-igstamt').val(round2(r.IGST_AMT).toFixed(2));
        $tr.find('.f-cessamt').val(round2(r.GCESS_AMT).toFixed(2));

        $('#ftMretu').text(round3(rows.reduce(function (s, x) { return s + num(x.Mretu); }, 0)).toFixed(3));
        $('#ftGross').text(round3(rows.reduce(function (s, x) { return s + num(x.GROSS_WEIGHT); }, 0)).toFixed(3));
        $('#ftWeight').text(round3(rows.reduce(function (s, x) { return s + num(x.WEIGHT); }, 0)).toFixed(3));
        $('#ftAmt').text(round2(rows.reduce(function (s, x) { return s + num(x.AMT); }, 0)).toFixed(2));
    });

    // Re-format an editable numeric cell once the user leaves it (not while typing),
    // so what is shown is exactly what was calculated and will be posted.
    var FIELD_DP = { 'f-mretu': 3, 'f-grosswt': 3, 'f-netwt': 3, 'f-sht': 3, 'f-bkg': 3, 'f-lkg': 3,
                     'f-rate': 2, 'f-discpct': 2, 'f-discount': 2 };
    $('#gridBody').on('blur', 'input[type=number]', function () {
        var $i = $(this);
        for (var cls in FIELD_DP) {
            if ($i.hasClass(cls) && $i.val() !== '') { $i.val(num($i.val()).toFixed(FIELD_DP[cls])); return; }
        }
    });

    $('input[name=OptFlag]').on('change', function () {
        // Keep each line's discount amount; only the per-unit basis changes.
        rows.forEach(function (r) {
            if (r._discPerUnit != null) { var b = basisOf(r); r._discPerUnit = b ? num(r.DISCOUNT) / b : null; }
            recalcRow(r);
        });
        renderGrid();
    });

    $('#btnAddRow').on('click', function () {
        rows.push({ _cid: ++rowSeq, SRLNO: rows.length + 1, Mretu: 0, SHT: 0, BKG: 0, LKG: 0, RATE: 0, AMT: 0, _availQty: null, _availWeight: null });
        renderGrid();
    });

    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });

    $('#btnRemoveRows').on('click', function () {
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        renderGrid();
    });

    // =========================================================
    // Party / Transporter / row-level Item lookups -- jquery.inputpicker (Root UI convention: an
    // anchored, paginated picker under the field itself -- see CLAUDE.md's "lookup pickers" rule).
    // Replaces this screen's earlier bespoke centered-modal picker. The endpoints match the typed
    // text against every column shown (Code and Name). Row-level Item anchors to that row's own
    // text input. (The Bill No help below stays a modal: a composite bill-selection dialog.)
    // =========================================================
    var pickerConfig = {
        party: { url: '@Url.Action("GetParty", "MarketReturn")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'PCD' },
        transporter: { url: '@Url.Action("GetTransporter", "MarketReturn")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'TPT' },
        item: { url: '@Url.Action("GetItemMaster", "MarketReturn")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }] }
    };

    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });
    // Row Item lookup: the row's own box is the dropdown. inputpicker clones the input it is attached
    // to (classes included, "f-item") and shows the clone; the clone must NOT match here, or clicking
    // it would attach a second picker inside the first.
    $('#gridBody').on('click focus', '.f-item:not(.inputpicker-input)', function () {
        var $tr = $(this).closest('tr'), r = findRow($tr.data('cid'));
        if (!r) return;
        openPicker('item', $(this), function (row) {
            r.ITCD = row.CODE; r.ItemName = row.NAME || '';
            $tr.find('.f-item').val(row.CODE).attr('title', row.NAME || '');
            capRow(r);
            $tr.find('.f-avail').text(r._availQty != null ? round3(r._availQty).toFixed(3) : '');
        });
    });

    // Programmatic value for a field that may already be wrapped by inputpicker (Party / Transporter
    // filled from the picked bill): set the original and the visible shadow input directly. Never
    // trigger "change" for this -- the plugin would look the code up in its last-loaded rows and
    // swap in the first row when it isn't there.
    function setPickerValue(sel, code) {
        var $o = $(sel);
        $o.val(code);
        if ($o.hasClass('inputpicker-original'))
            $o.next('.inputpicker-overflow-hidden').find('input.inputpicker-input').val(code);
    }

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the
    // plugin writes the picked value into the original input and fires "change" on it; it does
    // not hand the row to a select handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    // Open the dropdown AND refresh its rows. The plugin loads url-backed data asynchronously and
    // only re-renders the list on a keystroke, so showing it right after init (before the first
    // response lands) displayed "No results" -- the keyup makes it fetch and render the rows.
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function openPicker(key, $input, onSelect) {
        var cfg = pickerConfig[key];
        $('.inputpicker-wrapped-list').remove();

        // This plugin never sets $.data('inputpicker'); the class it puts on the original input
        // is the "already initialised" test (otherwise every click re-wraps the field and drops
        // whatever the user has typed).
        // Showing is deferred a tick: called from a click, the click's own bubbling up to the
        // plugin's document-level "outside click" handler would otherwise hide it straight away.
        if ($input.hasClass('inputpicker-original')) {
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker({
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2      // seconds (the plugin multiplies by 1000): one request per pause in typing, not per keystroke
        });
        setTimeout(function () { showPickerList($input); }, 0);

        function deliver(row) {
            if (!row) return;
            if (onSelect) {
                onSelect(row);
            } else if (cfg.target) {
                $('#' + cfg.target).val(row[cfg.fields[0].name]);
                $('#' + cfg.target + '_disp').val(row[cfg.fields[1].name] || '');
            }
        }
        // Both hooks call the same idempotent handler, so whichever this plugin build fires works.
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
    }

    // =========================================================
    // Bill No help -- composite bill-selection modal (deliberately NOT an inputpicker).
    // =========================================================
    var billConfig = {
        url: '@Url.Action("GetBillList", "MarketReturn")', title: 'Bill No',
        cols: [['BLNO', 'Bill No'], ['BLDT', 'Bill Date'], ['VAT_NO', 'VAT No'], ['UNIT', 'Unit'], ['PCD', 'Party'], ['ACNAME', 'Name']],
        params: function () { return { pcd: $('#PCD').val(), unit: UNIT, yearBack: yearBack() }; }
    };
    function cellText(key, v) {
        if (v == null) return '';
        if (key === 'BLDT' && typeof v === 'string' && v.length >= 10) { var p = v.substring(0, 10).split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
        return v;
    }
    var activePicker = null;
    var pickerXhr = null;
    var pickerReqSeq = 0;

    function openBillPicker(onSelect) {
        activePicker = { onSelect: onSelect };
        $('#pickerTitle').text('Select ' + billConfig.title);
        $('#genericPicker').addClass('wide');
        $('#pickerSearch').val('');
        $('#pickerBody').empty().removeData('rows');
        $('#pickerOverlay, #genericPicker').fadeIn(120);
        loadPickerData('');
        $('#pickerSearch').off('input').on('input', function () { loadPickerData($(this).val()); });
    }
    function closePicker() { $('#pickerOverlay, .popup-box').fadeOut(120); }

    function loadPickerData(term) {
        var cfg = billConfig;
        var myReq = ++pickerReqSeq;
        if (pickerXhr) { pickerXhr.abort(); }
        pickerXhr = $.getJSON(cfg.url, $.extend({ search: term }, cfg.params ? cfg.params() : {}), function (data) {
            if (myReq !== pickerReqSeq) return;
            data = data || [];
            var html = '<table><thead><tr>' + cfg.cols.map(function (c) { return '<th>' + c[1] + '</th>'; }).join('') + '</tr></thead><tbody>';
            data.forEach(function (row, i) {
                html += '<tr data-i="' + i + '">' + cfg.cols.map(function (c) {
                    var v = row[c[0]] !== undefined ? row[c[0]] : row[c[0].toLowerCase()];
                    return '<td>' + cellText(c[0], v) + '</td>';
                }).join('') + '</tr>';
            });
            html += '</tbody></table>';
            if (!data.length) {
                html += '<p style="margin:10px 4px;color:#666;">No bills found for party ' + ($('#PCD').val() || '') +
                    (yearBack() === 1 ? ' in last year' : yearBack() === 2 ? ' in the year before last' : ' in this year') +
                    '. Try Last Year / Before Last Year, or check the Party.</p>';
            }
            $('#pickerBody').html(html);
            $('#pickerBody').data('rows', data);
        }).fail(function (jqXHR) { if (myReq === pickerReqSeq) handleLookupFail(jqXHR); });
    }

    $('#pickerBody').on('click', 'tr[data-i]', function () {
        var data = $('#pickerBody').data('rows');
        var row = data[$(this).data('i')];
        if (activePicker && activePicker.onSelect) activePicker.onSelect(row);
        closePicker();
    });

    // =========================================================
    // Save (mirrors the VB Command1_Click validation order, per
    // Documentation.md section 2 / the approved plan's validation chain)
    // =========================================================
    $('#btnSave').on('click', function () {
        if (!$('#DATE_ORA').val()) { showAlert('Date required'); return; }
        if (!$('#BLNO').val()) { showAlert('Bill No is required.'); return; }
        if (!$('#BLDT').val()) { showAlert('Bill Date is required. Select the Bill No from its help to fetch it.'); return; }
        if (!$('#PCD').val()) { showAlert('Party Code is required.'); return; }
        if (!$('#TPT').val()) { showAlert('Transporter Code is required.'); return; }
        if (!$('#VEH').val()) { showAlert('Vehicle Number is required.'); return; }

        // As in VB6 Command1_Click, bill lines left at zero Return/Shortage/
        // Breakage/Leakage are simply not saved.
        var valid = rows.filter(function (r) { return r.ITCD && (num(r.Mretu) + num(r.SHT) + num(r.BKG) + num(r.LKG)) !== 0; });
        if (!valid.length) { showAlert('At least one item line with a non-zero quantity is required.'); return; }
        for (var i = 0; i < valid.length; i++) {
            var r = valid[i];
            if (!r.MRP) { showAlert('MRP is required for item ' + r.ITCD + '.'); return; }
            if (!r.MFGDT) { showAlert('Manufacturing Date is required for item ' + r.ITCD + '.'); return; }
            if (!r.BATCHNO) { showAlert('Batch No is required for item ' + r.ITCD + '.'); return; }
            if (r._availQty != null && num(r.Mretu) > r._availQty + 0.001) {
                showAlert('Return Qty for ' + r.ITCD + ' exceeds the quantity available on Bill No ' + $('#BLNO').val() + '.'); return;
            }
        }

        showConfirm('Are you sure?', function () {
            var model = {
                T_MRETU_HED: {
                    ID: $('#ID').val() ? parseInt($('#ID').val(), 10) : 0,
                    UNIT: UNIT,
                    DOCNO: $('#DOCNO').val(),
                    DATE_ORA: $('#DATE_ORA').val(),
                    BLNO: $('#BLNO').val(),
                    BLDT: $('#BLDT').val(),
                    PCD: $('#PCD').val(),
                    TPT: $('#TPT').val(),
                    VEH: $('#VEH').val(),
                    VTYPE: $('#VTYPE').val(),
                    LR_NO: $('#LR_NO').val(),
                    INVNO: $('#INVNO').val(),
                    TRIP_NO: $('#TRIP_NO').val() ? num($('#TRIP_NO').val()) : null,
                    TRIP_UNIT: $('#TRIP_UNIT').val()
                },
                T_MRETU_DET: valid,
                OptFlag: $('input[name=OptFlag]:checked').val(),
                BillYearBack: yearBack(),
                // New vs edit -- the server applies the AEDV Add / Edit right and back-date window to it.
                IsNew: !IS_EDIT
            };

            $.ajax({
                url: '@Url.Action("Save", "MarketReturn")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(model),
                success: function (resp) {
                    if (resp.success) {
                        showAlert(resp.message || 'Saved.', function () {
                            window.location.href = '@Url.Action("Index", "MarketReturn")' + '?unit=' + encodeURIComponent(UNIT);
                        });
                    } else {
                        showAlert(resp.message || 'Save failed.');
                    }
                },
                error: function () { showAlert('Save failed - server error.'); }
            });
        });
    });

    // Pre-load the bill lines cache on open (edit/view) so availability ceilings
    // show immediately; the saved rows themselves are kept, not re-populated.
    // yearBack -1: the server finds which year's schema holds the bill and the
    // Last Year / Before Last Year boxes are ticked to match.
    if ($('#BLNO').val()) {
        loadBillLines($('#BLNO').val(), -1, function () {
            rows.forEach(function (r) { capRow(r); });
            renderGrid();
        });
    } else {
        renderGrid();
    }

    // =========================================================
    // View mode / IRN lock
    // =========================================================
    if (IS_VIEW || IRN_LOCKED) {
        $('.accordion-container :input, #btnBillHelp, #btnAddRow, #btnRemoveRows')
            .prop('disabled', true);
        $('#btnSave').addClass('is-disabled').prop('disabled', true);
    }
</script>
</body>
</html>
