@using PacketTea.Utility
@model List<Finance.Controllers.TEA.MretuDocRow>

@{
    ViewBag.Title = "Market Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var types = (Dictionary<string, string>)ViewBag.Types;
    var unitList = (List<PacketTea.Models.PT.UnitOption>)ViewBag.UnitList ?? new List<PacketTea.Models.PT.UnitOption>();
}

@{
    Func<string, string, MvcHtmlString> SortTh = (key, label) =>
    {
        var cur = (string)(ViewBag.SortBy ?? "");
        var dir = (string)(ViewBag.SortDir ?? "");
        var active = string.Equals(cur, key, StringComparison.OrdinalIgnoreCase);
        var next = (active && dir == "asc") ? "desc" : "asc";
        var thClass = active ? "sortable is-sorted" : "sortable";
        var up = (active && dir == "asc") ? "feather icon-arrow-up on" : "feather icon-arrow-up";
        var down = (active && dir != "asc") ? "feather icon-arrow-down on" : "feather icon-arrow-down";
        return MvcHtmlString.Create(
            "<th class=\"" + thClass + "\" data-sort=\"" + key + "\" data-dir=\"" + next +
            "\" title=\"Sort by " + label + "\"><span class=\"th-label\">" + label +
            "</span><span class=\"sort-arrows\"><i class=\"" + up + "\"></i><i class=\"" +
            down + "\"></i></span></th>");
    };
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <style>
        .table.table-sm td, .table.table-sm th { padding: 0.6rem; }
        tbody div { overflow: unset !important; height: auto !important; max-height: none !important; }
        .btn-link { font-weight: 500; color: black; border-radius: 0; }
        table.main-table th, table.main-table td {
            padding: 6px; font-size: 12px; line-height: 1.3;
            height: 30px; box-sizing: border-box; vertical-align: middle;
        }
        table.main-table td .row-check { margin: 0; vertical-align: middle; }
        .table-responsive thead th.sortable { cursor: pointer; user-select: none; }
        .table-responsive thead th.sortable:hover { background-color: #4b5b7a; }
        .table-responsive thead th.is-sorted { background-color: #4b5b7a; }
        th.sortable .sort-arrows { margin-left: 6px; white-space: nowrap; }
        th.sortable .sort-arrows i { font-size: 12px; color: rgba(255,255,255,.45); vertical-align: middle; }
        th.sortable .sort-arrows i.on { color: #fff; }
        tr.new-entry-row td { background-color: #eef3ff; vertical-align: middle; }
        tr.new-entry-row select { border: 1px solid #ccc; border-radius: 4px; padding: 4px 6px; width: 100%; }
        tr.new-entry-row .go-new { font-size: 15px; cursor: not-allowed; color: #aab2c0; }
        tr.new-entry-row .go-new.is-ready { cursor: pointer; color: #404e68; }
        table.detail-sub-table { width: 100%; border-collapse: collapse; }
        table.detail-sub-table th, table.detail-sub-table td { border: 1px solid #ddd; padding: 6px; white-space: nowrap; }
        table.detail-sub-table thead th { background-color: #404e68; color: #fff; font-weight: bold; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="action-btns">
            <ul>
                <li><a href="@Url.Action("Index", "Menu")"><i class="fa fa-arrow-left"></i> Back</a></li>
                <li><a href="javascript:void(0)" id="btnNew"><i class="fa fa-plus"></i> New</a></li>
                <li><a href="javascript:void(0)" id="editBtn"><i class="fa fa-pencil"></i> Edit</a></li>
                <li><a href="javascript:void(0)" id="viewBtn"><i class="fa fa-eye"></i> View</a></li>
                <li><a href="javascript:void(0)" id="deleteBtn"><i class="fa fa-trash-o"></i> Delete</a></li>
                <li style="margin-left:auto">
                    <label class="btn btn-inverse pull-right" style="margin: 10px;">LIST</label>
                </li>
            </ul>
        </div>

        <div class="title-heading">Market Return</div>

        <div style="display: flex; justify-content: flex-end; width: 100%; margin-bottom: 15px;">
            <div style="position: relative; width: 250px;">
                <input type="text" id="searchInput" value="@ViewBag.CurrentFilter" placeholder="Search Doc No / Bill No"
                       style="width: 100%; padding: 6px 40px 6px 10px; border: 1px solid #ccc; border-radius: 4px;" />
                <i class="fa fa-search" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #333;"></i>
            </div>
        </div>

        <div class="table-responsive">
            <table class="border main-table" id="mretuTable">
                <thead>
                    <tr>
                        <th style="width:26px;"></th>
                        <th style="width:26px;"></th>
                        @SortTh("DOCNO", "Doc No")
                        @SortTh("DOCDT", "Date")
                        <th>Bill No</th>
                        <th>Bill Date</th>
                        @SortTh("PARTY", "Party")
                        <th>Vehicle No</th>
                        <th>Unit</th>
                        <th style="text-align:right;">Total Qty</th>
                        <th style="text-align:right;">Total Amount</th>
                        <th>e-Invoice</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        var rowIndex = 0;
                        foreach (var row in Model)
                        {
                            rowIndex++;
                            var detailId = "rowDetail" + rowIndex;
                            <tr>
                                <td><input type="checkbox" class="row-check" value="@row.docno" data-unit="@row.unit" /></td>
                                <td style="text-align:center;">
                                    <i class="fa fa-plus row-expand-btn" data-target="@detailId" title="Show item lines" style="cursor:pointer;"></i>
                                </td>
                                <td><a href="@Url.Action("InsertOrUpdate", "MarketReturn", new { docno = row.docno, unit = row.unit })">@row.docno</a></td>
                                <td>@(row.docdt?.ToString("dd/MM/yyyy"))</td>
                                <td>@row.blno</td>
                                <td>@(row.bldt?.ToString("dd/MM/yyyy"))</td>
                                <td>@row.partyName</td>
                                <td>@row.veh</td>
                                <td>@row.unit</td>
                                <td class="text-right">@(row.totQty?.ToString("N2"))</td>
                                <td class="text-right">@(row.totAmt?.ToString("N2"))</td>
                                <td>@(string.IsNullOrEmpty(row.irn) ? "" : "Generated")</td>
                            </tr>
                            <tr class="row-detail" id="@detailId" style="display:none;" data-docno="@row.docno" data-unit="@row.unit">
                                <td colspan="11" style="background:#f8f9fc;padding:10px 12px;">
                                    <div style="overflow-x:auto;">
                                        <table class="detail-sub-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:34px;">Sl</th>
                                                    <th>Item</th>
                                                    <th>MRP</th>
                                                    <th>Mfg Date</th>
                                                    <th>Batch No</th>
                                                    <th style="text-align:right;">Return Qty</th>
                                                    <th style="text-align:right;">Shortage</th>
                                                    <th style="text-align:right;">Breakage</th>
                                                    <th style="text-align:right;">Leakage</th>
                                                    <th style="text-align:right;">Rate</th>
                                                    <th style="text-align:right;">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody class="detail-items-body">
                                                <tr><td colspan="11" style="text-align:center;color:#666;">Loading...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="11" style="text-align:center;">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            int pageSize = (int)ViewBag.PageSize;
            int rowCount = (int)ViewBag.RowCount;
            int currentPage = (int)ViewBag.Page;
            int pageCount = pageSize > 0 ? (int)Math.Ceiling(rowCount / (double)pageSize) : 1;
        }
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px 0;flex-wrap:wrap;gap:8px;">
            <div class="dataTables_info" style="padding:0;">Showing @(Model?.Count ?? 0) of @rowCount</div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button type="button" id="btnPrevPage" class="btn-white" style="width:auto;padding:5px 14px;" @(currentPage <= 1 ? "disabled" : "")>&laquo; Prev</button>
                <span style="color:#666;font-size:12.5px;">Page @currentPage of @Math.Max(pageCount, 1)</span>
                <button type="button" id="btnNextPage" class="btn-white" style="width:auto;padding:5px 14px;" @(currentPage >= pageCount ? "disabled" : "")>Next &raquo;</button>
            </div>
        </div>
    </div>

    <script>
        // TEMPORARY diagnostic -- shows which Oracle schema (x-database header, see
        // Services.SalesGetAsync/SalesPostAsync) this session's TB Sales API calls
        // actually connect as (CLASSIC_CONTROL.SCHEMA_SALES for the selected company/
        // location, e.g. "FIN_JSTIL2027"), NOT the unit's normal getDbName schema.
        // Same pattern as MasterBlendEntry/Index.cshtml's own diagnostic. Safe to
        // remove once you've confirmed the schema name in the browser console.
        console.log('[MarketReturn diag] x-database (Sales schema) for this session: ' +
            @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(SessionHelper.GetUser()?.Salesdb ?? "(null/empty -- Salesdb is not set for this session)")));
        $(function () {
            var searchTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () { reload(1); }, 400);
            });

            var SORT_BY = '@(ViewBag.SortBy ?? "")', SORT_DIR = '@(ViewBag.SortDir ?? "")';
            function reload(page, sortBy, sortDir) {
                var by = (sortBy === undefined) ? SORT_BY : sortBy;
                var dir = (sortDir === undefined) ? SORT_DIR : sortDir;
                window.location.href = '@Url.Action("Index", "MarketReturn")'
                    + '?searchString=' + encodeURIComponent($('#searchInput').val())
                    + '&page=' + (page || 1)
                    + '&sortBy=' + encodeURIComponent(by || '')
                    + '&sortDir=' + encodeURIComponent(dir || '');
            }

            $('#mretuTable').on('click', 'thead th.sortable', function () {
                reload(1, $(this).data('sort'), $(this).data('dir'));
            });

            $('#btnPrevPage').on('click', function () { if (!$(this).is(':disabled')) reload(@currentPage - 1); });
            $('#btnNextPage').on('click', function () { if (!$(this).is(':disabled')) reload(@currentPage + 1); });

            // "+" toggle -- item lines sub-grid, re-fetched every open (same pattern as
            // Master Blend Entry's Index.cshtml).
            function openDetail($btn) {
                var $detail = $('#' + $btn.data('target'));
                $detail.show();
                $btn.removeClass('fa-plus').addClass('fa-minus');
                var $body = $detail.find('.detail-items-body');
                $.get('@Url.Action("GetRowDetail", "MarketReturn")', {
                    docno: $detail.data('docno'),
                    unit: $detail.data('unit')
                }).done(function (r) {
                    if (!r || !r.success) {
                        $body.html('<tr><td colspan="11" style="text-align:center;color:#666;">Unable to load item lines.</td></tr>');
                        return;
                    }
                    var items = r.details || [];
                    if (items.length === 0) {
                        $body.html('<tr><td colspan="11" style="text-align:center;color:#666;">No item lines</td></tr>');
                        return;
                    }
                    $body.empty();
                    items.forEach(function (d, i) {
                        var mfgDate = d.mfgdt ? new Date(d.mfgdt).toLocaleDateString('en-GB') : '';
                        $('<tr>').append(
                            '<td>' + (d.srlno != null ? d.srlno : (i + 1)) + '</td>',
                            '<td>' + (d.itemName || d.itcd || '') + '</td>',
                            '<td>' + (d.mrp || '') + '</td>',
                            '<td>' + mfgDate + '</td>',
                            '<td>' + (d.batchno || '') + '</td>',
                            '<td style="text-align:right;">' + Number(d.mretu || 0).toFixed(2) + '</td>',
                            '<td style="text-align:right;">' + Number(d.sht || 0).toFixed(2) + '</td>',
                            '<td style="text-align:right;">' + Number(d.bkg || 0).toFixed(2) + '</td>',
                            '<td style="text-align:right;">' + Number(d.lkg || 0).toFixed(2) + '</td>',
                            '<td style="text-align:right;">' + Number(d.rate || 0).toFixed(2) + '</td>',
                            '<td style="text-align:right;">' + Number(d.amt || 0).toFixed(2) + '</td>'
                        ).appendTo($body);
                    });
                }).fail(function () {
                    $body.html('<tr><td colspan="11" style="text-align:center;color:#666;">Unable to load item lines.</td></tr>');
                });
            }
            function closeDetail($btn) {
                $('#' + $btn.data('target')).hide();
                $btn.removeClass('fa-minus').addClass('fa-plus');
            }
            $('#mretuTable').on('click', '.row-expand-btn', function () {
                var $btn = $(this);
                if ($('#' + $btn.data('target')).is(':visible')) closeDetail($btn); else openDetail($btn);
            });

            // "New" inline row -- pick Unit + Type here first (Type is a fixed single
            // option, Market Return has no real "type" axis, shown purely for UI
            // consistency with Master Blend Entry's Unit+Type "New" row).
            var UNIT_LIST = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitList));
            var TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(types));

            function buildNewRow() {
                var unitOpts = '<option value="">Select Unit</option>' +
                    UNIT_LIST.map(function (u) { return '<option value="' + u.CODE + '">' + u.CODE + ' - ' + (u.NAME || '') + '</option>'; }).join('');
                var typeOpts = Object.keys(TYPES).map(function (k) { return '<option value="' + k + '">' + TYPES[k] + ' (' + k + ')</option>'; }).join('');
                return '<tr id="newUnitRow" class="new-entry-row">' +
                    '<td colspan="2" style="text-align:center;"><i class="fa fa-pencil go-new" title="Open Market Return"></i></td>' +
                    '<td colspan="2"><select id="newRowUnit">' + unitOpts + '</select></td>' +
                    '<td colspan="2"><select id="newRowType">' + typeOpts + '</select></td>' +
                    '<td colspan="5"></td>' +
                    '</tr>';
            }

            function refreshGoNewState() {
                var ready = !!$('#newRowUnit').val() && !!$('#newRowType').val();
                $('.go-new').toggleClass('is-ready', ready);
            }

            $('#btnNew').on('click', function () {
                if ($('#newUnitRow').length) return;
                $('#mretuTable tbody').prepend(buildNewRow());
                refreshGoNewState();
            });

            $('#mretuTable').on('change', '#newRowUnit, #newRowType', refreshGoNewState);

            $('#mretuTable').on('click', '.go-new', function () {
                var unit = $('#newRowUnit').val(), type = $('#newRowType').val();
                if (!unit) { alert('Please select Unit first'); return; }
                if (!type) { alert('Please select Type first'); return; }
                window.location.href = '@Url.Action("InsertOrUpdate", "MarketReturn")'
                    + '?unit=' + encodeURIComponent(unit)
                    + '&type=' + encodeURIComponent(type);
            });

            function getSingleChecked(action) {
                var $c = $('.row-check:checked');
                if ($c.length === 0) { alert('Please select a record to ' + action + '.'); return null; }
                if ($c.length > 1) { alert('Please select only one record to ' + action + '.'); return null; }
                return $c;
            }

            $('#editBtn').on('click', function () {
                var $c = getSingleChecked('edit');
                if (!$c) return;
                window.location.href = '@Url.Action("InsertOrUpdate", "MarketReturn")'
                    + '?docno=' + encodeURIComponent($c.val()) + '&unit=' + encodeURIComponent($c.data('unit'));
            });

            $('#viewBtn').on('click', function () {
                var $c = getSingleChecked('view');
                if (!$c) return;
                window.location.href = '@Url.Action("InsertOrUpdate", "MarketReturn")'
                    + '?docno=' + encodeURIComponent($c.val()) + '&unit=' + encodeURIComponent($c.data('unit')) + '&view=true';
            });

            $('#deleteBtn').on('click', function () {
                var $c = getSingleChecked('delete');
                if (!$c) return;
                if (!confirm('Are you sure you want to delete Doc No ' + $c.val() + ' ?')) return;

                $('<form>', { method: 'POST', action: '@Url.Action("Delete", "MarketReturn")' })
                    .append($('<input>', { type: 'hidden', name: 'docno', value: $c.val() }))
                    .append($('<input>', { type: 'hidden', name: 'unit', value: $c.data('unit') }))
                    .appendTo('body').submit();
            });
        });
    </script>
</body>
</html>
