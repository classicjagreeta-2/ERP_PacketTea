@* Table rows for the Market Return list. Rendered by Index.cshtml for the first chunk and
   returned on its own (Request.IsAjaxRequest) for every further chunk the list's infinite
   scroll asks for -- see Scripts/list-infinite-scroll.js and MarketReturnController.Index.
   ViewBag.RowOffset keeps the "+" expand ids unique across chunks.
   Each row carries its own Unit as a data attribute / link param -- a Doc No repeats across
   units, so Edit / View / Delete / "+" all identify the document by Doc No + Unit. *@
@model List<Finance.Controllers.TEA.MretuDocRow>
@{
    var rowIndex = (int?)ViewBag.RowOffset ?? 0;
    // Doc No is a link into Edit mode only for users holding the Edit right (AEDV) -- UX only:
    // MarketReturnController.InsertOrUpdate re-checks the right and the back-date window server-side.
    var canEdit = (ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? false;
}
@if (Model != null)
{
    foreach (var row in Model)
    {
        rowIndex++;
        var detailId = "rowDetail" + rowIndex;
        <tr class="data-row">
            <td><input type="checkbox" class="row-check" value="@row.docno" data-unit="@row.unit" /></td>
            <td style="text-align:center;">
                <i class="fa fa-plus row-expand-btn" data-target="@detailId" title="Show item lines" style="cursor:pointer;"></i>
            </td>
            <td>@row.unit</td>
            <td>
                @if (canEdit)
                {
                    <a href="@Url.Action("InsertOrUpdate", "MarketReturn", new { docno = row.docno, unit = row.unit })">@row.docno</a>
                }
                else
                {
                    @row.docno
                }
            </td>
            <td>@(row.docdt?.ToString("dd/MM/yyyy"))</td>
            <td>@row.blno</td>
            <td>@(row.bldt?.ToString("dd/MM/yyyy"))</td>
            <td>@row.partyName</td>
            <td>@row.veh</td>
            <td style="text-align:right;">@(row.totQty?.ToString("N3"))</td>
            <td style="text-align:right;">@(row.totAmt?.ToString("N2"))</td>
            <td>@(string.IsNullOrEmpty(row.irn) ? "" : "Generated")</td>
        </tr>
        <tr class="row-detail" id="@detailId" style="display:none;" data-docno="@row.docno" data-unit="@row.unit">
            <td colspan="12" style="background:#f8f9fc;padding:10px 12px;">
                <div style="overflow-x:auto;">
                    <table class="detail-sub-table">
                        <thead>
                            <tr>
                                <th style="width:34px;">Sl</th>
                                <th>Item</th>
                                <th>MRP</th>
                                <th>Mfg Date</th>
                                <th>Batch No</th>
                                <th style="text-align:right;">Return Qty</th>
                                <th style="text-align:right;">Shortage</th>
                                <th style="text-align:right;">Breakage</th>
                                <th style="text-align:right;">Leakage</th>
                                <th style="text-align:right;">Rate</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="detail-items-body">
                            <tr><td colspan="12" style="text-align:center;color:#666;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
    }
}
