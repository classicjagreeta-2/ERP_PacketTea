@* Table rows for the Packing Entry list. Rendered by Index.cshtml for the first chunk and
   returned on its own (Request.IsAjaxRequest) for every further chunk the list's infinite
   scroll asks for -- see Scripts/list-infinite-scroll.js and PackingController.Index.
   ViewBag.RowOffset keeps the "+" expand ids unique across chunks. *@
@model List<PacketTea.Models.PT.BLEND_PACKING_DATA>
@{
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    var currentBlendType = (string)ViewBag.BlendType;
    Func<string, string> btLabel = code => (code != null && blendTypes != null && blendTypes.ContainsKey(code)) ? blendTypes[code] : code;
    var rowIndex = (int?)ViewBag.RowOffset ?? 0;
    // Blend No is a link into Edit mode only for users holding the Edit right (AEDV) -- UX only:
    // PackingController.InsertOrUpdate re-checks the right and the back-date window server-side.
    var canEdit = (ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? false;
}
@if (Model != null)
{
    foreach (var row in Model)
    {
        rowIndex++;
        var detailId = "rowDetail" + rowIndex;
        // Each row's own type, not the toolbar filter's -- the list can show
        // every type when no filter has been applied yet (blendType is null).
        var rowBlendType = string.IsNullOrEmpty(row.BLEND_TYPE) ? currentBlendType : row.BLEND_TYPE;
        <tr class="data-row">
            <td>
                <input type="checkbox" class="row-check"
                       value="@row.DOCNO"
                       data-docdt="@(row.DOCDT?.ToString("yyyy-MM-dd"))"
                       data-blendtype="@rowBlendType"
                       data-unit="@row.UNIT" />
            </td>
            <td style="text-align:center;">
                <button type="button" class="row-expand-btn" data-target="@detailId" title="Show more details">+</button>
            </td>
            <td>@row.UNIT</td>
            <td>@btLabel(rowBlendType)</td>
            <td>@row.DOCNO</td>
            <td>@(row.DOCDT?.ToString("dd/MM/yyyy"))</td>
            <td>
                @if (canEdit)
                {
                    <a href="@Url.Action("InsertOrUpdate", "Packing", new { docno = row.DOCNO, docdt = row.DOCDT?.ToString("yyyy-MM-dd"), blendType = rowBlendType, unit = row.UNIT })">@row.BlendDocNo</a>
                }
                else
                {
                    @row.BlendDocNo
                }
            </td>
            <td>@PacketTea.DateText.Display(row.BlendDocDate)</td>
            <td>@row.SaleCentreName</td>
            <td class="text-right">@row.TotalQty</td>
            <td class="text-right">@row.ShortExcess</td>
            <td>@row.PartyName</td>
        </tr>
        <tr class="row-detail" id="@detailId" style="display:none;"
            data-docno="@row.DOCNO" data-docdt="@(row.DOCDT?.ToString("yyyy-MM-dd"))" data-blendtype="@rowBlendType" data-unit="@row.UNIT">
            <td colspan="12" style="background:#f8f9fc;padding:10px 12px;">
                <!-- Just the packing lines sub-grid -- same "+" expand as Final/Master
                     Blend Entry (straight to the detail table, no summary line above it). -->
                <div style="overflow-x:auto;">
                    <table class="detail-sub-table">
                        <thead>
                            <tr>
                                <th style="width:34px;">Sl</th>
                                <th>Mark/Garden</th>
                                <th>Grade</th>
                                <th>Inv No</th>
                                <th>Pack Date</th>
                                <th style="text-align:right;">Bag</th>
                                <th style="text-align:right;">Chest F</th>
                                <th style="text-align:right;">Chest T</th>
                                <th style="text-align:right;">Gross Wt</th>
                                <th style="text-align:right;">Net Wt</th>
                                <th style="text-align:right;">Qty</th>
                                <th>Size</th>
                                <th style="text-align:right;">Rate</th>
                                <th style="text-align:right;">Amount</th>
                                <th>Allocation</th>
                            </tr>
                        </thead>
                        <tbody class="detail-items-body">
                            <tr><td colspan="15" style="text-align:center;color:var(--mbe-muted);">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
    }
}
