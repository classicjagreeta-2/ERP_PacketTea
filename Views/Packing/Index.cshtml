@using PacketTea.Utility
@model List<PacketTea.Models.PT.BLEND_PACKING_DATA>

@{
    ViewBag.Title = "Packing Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    var currentBlendType = (string)ViewBag.BlendType;
    var unitList = (List<PacketTea.Models.PT.UnitOption>)ViewBag.UnitList ?? new List<PacketTea.Models.PT.UnitOption>();
    // AEDV rights + edit back-date limit (Eday), same as Master Blend's list. The
    // controller re-checks all of these.
    var perm = ViewBag.Permission as PacketTea.Helpers.AEDV;
    bool canAdd = perm?.Can('A') ?? false, canEdit = perm?.Can('E') ?? false, canDelete = perm?.Can('D') ?? false;
    var editMinDate = perm?.MinDocDate(false) ?? DateTime.Today;
}

@{
    // Sortable column header. Sorting is server-side (see the API GetByPage's sortBy/sortDir),
    // so a header sorts the WHOLE filtered result set, not just the rows on the current page.
    // Clicking the active column flips direction; any other column starts ascending.
    // Written as a plain Func returning MvcHtmlString rather than a Razor helper block: every label
    // passed in below is a literal, so nothing here needs HTML-encoding.
    Func<string, string, MvcHtmlString> SortTh = (key, label) =>
    {
        var cur = (string)(ViewBag.SortBy ?? "");
        var dir = (string)(ViewBag.SortDir ?? "");
        var active = string.Equals(cur, key, StringComparison.OrdinalIgnoreCase);
        var next = (active && dir == "asc") ? "desc" : "asc";
        var thClass = active ? "sortable is-sorted" : "sortable";
        var up = (active && dir == "asc") ? "feather icon-arrow-up on" : "feather icon-arrow-up";
        var down = (active && dir != "asc") ? "feather icon-arrow-down on" : "feather icon-arrow-down";
        return MvcHtmlString.Create(
            "<th class=\"" + thClass + "\" data-sort=\"" + key + "\" data-dir=\"" + next +
            "\" title=\"Sort by " + label + "\"><span class=\"th-label\">" + label +
            "</span><span class=\"sort-arrows\"><i class=\"" + up + "\"></i><i class=\"" +
            down + "\"></i></span></th>");
    };
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <style>
        /* Matches ERP_Inventory's Purchase Order list. The shared purchase-order.css this
           page already links styles .general-container, .action-btns (white bar with a 1px
           #ddd border and dividers between items), table.border.main-table and
           .table-responsive thead th (#404e68, sticky). This view used to override all of
           that with its own theme -- navy #2c3958 headers, a borderless toolbar, zebra rows,
           a rounded white card, wider cell padding -- which is exactly why it did not look
           like Purchase Order. Those overrides are gone; only Purchase Order's own two extra
           rules, the sort-arrow styling, and the PacketTea-only sub-grid / New-row styles
           remain below. */
        .table.table-sm td, .table.table-sm th { padding: 0.6rem; }
        tbody div { overflow: unset !important; height: auto !important; max-height: none !important; }
        .btn-link { font-weight: 500; color: black; border-radius: 0; }

        /* Row metrics pinned to Purchase Order's, so all three list screens are identical
           and cannot drift on cascade order. That screen resolves to 12px/1.3 text in a
           6px-padded cell (shared purchase-order.css: "table tr th, table tr td
           {padding:6px}" over "html,body {font-size:12px; line-height:1.3}") -- about a
           30px row. Nothing in a cell may exceed that: the expand control is a bare
           <i class="fa fa-plus"> exactly like _POList.cshtml's .toggle-details, NOT a
           <button>, and the row checkbox is the plain .row-check rather than the 18px
           .checkbox-round -- both of those were making these rows noticeably taller. */
        table.main-table th, table.main-table td {
            padding: 6px; font-size: 12px; line-height: 1.3;
            height: 30px; box-sizing: border-box; vertical-align: middle;
        }
        table.main-table td .row-expand-btn { font-size: 12px; line-height: 1.3; }
        table.main-table td .row-check { margin: 0; vertical-align: middle; }

        /* Sortable headers. Purchase Order renders the same paired up/down arrows but as a
           dead <a href="#">; here they drive a real server-side sort, so the pair is tinted
           to show which column is active and which way it is going. */
        .table-responsive thead th.sortable { cursor: pointer; user-select: none; }
        .table-responsive thead th.sortable:hover { background-color: #4b5b7a; }
        .table-responsive thead th.is-sorted { background-color: #4b5b7a; }
        th.sortable .sort-arrows { margin-left: 6px; white-space: nowrap; }
        th.sortable .sort-arrows i { font-size: 12px; color: rgba(255,255,255,.45); vertical-align: middle; }
        th.sortable .sort-arrows i.on { color: #fff; }

        /* PacketTea-only: item-line sub-grid shown inside the "+" expand row, themed to
           match the main grid's header rather than introducing a second palette. */
        table.detail-sub-table { width: 100%; border-collapse: collapse; }
        table.detail-sub-table th, table.detail-sub-table td { border: 1px solid #ddd; padding: 6px; white-space: nowrap; }
        table.detail-sub-table thead th { background-color: #404e68; color: #fff; font-weight: bold; }

        /* PacketTea-only: the "New" inline row -- pick Unit + Packet Type here first, then
           the pencil (enabled only once both are chosen) opens the entry screen with both
           locked in. Same pattern as ERP_Inventory's Purchase_Requisition list. */
        tr.new-entry-row td { background-color: #eef3ff; vertical-align: middle; }
        tr.new-entry-row select { border: 1px solid #ccc; border-radius: 4px; padding: 4px 6px; width: 100%; }
        tr.new-entry-row .go-new { font-size: 15px; cursor: not-allowed; color: #aab2c0; }
        tr.new-entry-row .go-new.is-ready { cursor: pointer; color: #404e68; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="action-btns">
            <ul>
                <li><a href="@Url.Action("Index", "Menu")"><i class="fa fa-arrow-left"></i> Back</a></li>
                <!-- The Packet Type filter dropdown that used to sit here is gone, same as
                     on the Master/Final Blend lists: Packet Type is picked in the "New"
                     inline row instead, so the list itself shows every type the user has
                     rights to (PackingController.GetAllowedBlendTypesAsync) rather than one
                     type at a time. -->
                <li><a href="javascript:void(0)" id="btnNew" style="@(canAdd ? "" : "opacity:0.5;")"><i class="fa fa-plus"></i> New</a></li>
                <li><a href="javascript:void(0)" id="editBtn" style="@(canEdit ? "" : "opacity:0.5;")"><i class="fa fa-pencil"></i> Edit</a></li>
                <li><a href="javascript:void(0)" id="deleteBtn" style="@(canDelete ? "" : "opacity:0.5;")"><i class="fa fa-trash-o"></i> Delete</a></li>
                <li><a href="javascript:void(0)" id="viewBtn"><i class="fa fa-eye"></i> View</a></li>
                <li><a href="javascript:void(0)" id="linesBtn"><i class="fa fa-list"></i> Lines</a></li>
                <li style="margin-left:auto">
                    <label class="btn btn-inverse pull-right" style="margin: 10px;">LIST</label>
                </li>
            </ul>
        </div>

        <div class="title-heading">Packing Entry</div>

        <div style="display: flex; justify-content: flex-end; width: 100%; margin-bottom: 15px;">
            <div style="position: relative; width: 250px;">
                <input type="text" id="searchInput" value="@ViewBag.CurrentFilter" placeholder="Search Doc No / Blend No"
                       style="width: 100%; padding: 6px 40px 6px 10px; border: 1px solid #ccc; border-radius: 4px;" />
                <i class="fa fa-search" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #333;"></i>
            </div>
        </div>

        <div class="table-responsive">
            <table class="border main-table" id="packingTable">
                <thead>
                    <tr>
                        <th style="width:26px;"></th>
                        <th style="width:26px;"></th>
                        @SortTh("UNIT", "Unit")
                        @SortTh("BLEND_TYPE", "Packing Type")
                        @SortTh("DOCNO", "Doc No")
                        @SortTh("DOCDT", "Date")
                        @SortTh("BLEND_NO", "Blend No")
                        @SortTh("BLEND_DATE", "Date")
                        @SortTh("SALE_CENTRE", "Location")
                        @SortTh("TOTAL_QTY", "Packing Qty.")
                        @SortTh("SHORT_EXCESS", "Short/Excess")
                        @SortTh("PARTY", "Party")
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        var rowIndex = 0;
                        foreach (var row in Model)
                        {
                            rowIndex++;
                            var detailId = "rowDetail" + rowIndex;
                            var rowBlendType = string.IsNullOrEmpty(row.BLEND_TYPE) ? currentBlendType : row.BLEND_TYPE;
                            <tr>
                                <td>
                                    <!-- The row's own Packet Type, not the page filter's: the list
                                         now shows every type the user has rights to at once, so
                                         Edit/Delete have to carry each row's actual type. -->
                                    <input type="checkbox" class="row-check"
                                           value="@row.DOCNO"
                                           data-docdt="@(row.DOCDT?.ToString("yyyy-MM-dd"))"
                                           data-blendtype="@rowBlendType" />
                                </td>
                                <td style="text-align:center;">
                                    <i class="fa fa-plus row-expand-btn" data-target="@detailId" title="Show item lines" style="cursor:pointer;"></i>
                                </td>
                                <td>@row.UNIT</td>
                                <td>@(rowBlendType != null && blendTypes != null && blendTypes.ContainsKey(rowBlendType) ? blendTypes[rowBlendType] : rowBlendType)</td>
                                <td>
                                    <a href="@Url.Action("InsertOrUpdate", "Packing", new { docno = row.DOCNO, docdt = row.DOCDT?.ToString("yyyy-MM-dd"), blendType = rowBlendType })">@row.DOCNO</a>
                                </td>
                                <td>@(row.DOCDT?.ToString("dd/MM/yyyy"))</td>
                                @* "Blend No" is the Final Blend's business number (BLEND_NO,
                                   e.g. "R023"), which is what the VB form displays -- its
                                   internal doc number (BLEND_DOCNO, e.g. "000048") is only
                                   the key. Falls back to the doc number if the referenced
                                   blend can no longer be resolved. *@
                                <td>@(string.IsNullOrEmpty(row.MasterBlendNo) ? row.BlendDocNo : row.MasterBlendNo)</td>
                                @* DateTime.TryParse, not .Parse -- a handful of legacy rows carry a
                                   BlendDocDate string the current culture can't parse (e.g. an Oracle
                                   default-format date), which crashed the whole list with a raw
                                   FormatException instead of just leaving that one cell blank. *@
                                <td>@(DateTime.TryParse(row.BlendDocDate, out var blendDocDate) ? blendDocDate.ToString("dd/MM/yyyy") : "")</td>
                                <td>@row.SaleCentreName</td>
                                <td class="text-right">@row.TotalQty</td>
                                <td class="text-right">@row.ShortExcess</td>
                                <td>@row.PartyName</td>
                            </tr>
                            <tr class="row-detail" id="@detailId" style="display:none;"
                                data-docno="@row.DOCNO" data-docdt="@(row.DOCDT?.ToString("yyyy-MM-dd"))" data-blendtype="@rowBlendType">
                                <td colspan="12" style="background:#f8f9fc;padding:10px 12px;">
                                    <div style="overflow-x:auto;">
                                        <table class="detail-sub-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:34px;">Sl</th>
                                                    <th>Mark</th>
                                                    <th>Grade</th>
                                                    <th>Category</th>
                                                    <th>Inv No</th>
                                                    <th>Pack Date</th>
                                                    <th>Season</th>
                                                    <th style="text-align:right;">Bag</th>
                                                    <th style="text-align:right;">Chest From</th>
                                                    <th style="text-align:right;">Chest To</th>
                                                    <th style="text-align:right;">Gross Wt</th>
                                                    <th style="text-align:right;">Tare</th>
                                                    <th style="text-align:right;">Qty</th>
                                                    <th>Batch No</th>
                                                    <th>Size</th>
                                                    <th style="text-align:right;">Rate</th>
                                                    <th style="text-align:right;">Amount</th>
                                                    <th>Allocation</th>
                                                    <th>Item</th>
                                                    <th>MRP</th>
                                                </tr>
                                            </thead>
                                            <tbody class="detail-items-body">
                                                <tr><td colspan="20" style="text-align:center;color:#666;">Loading...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="12" style="text-align:center;">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            int pageSize = (int)ViewBag.PageSize;
            int rowCount = (int)ViewBag.RowCount;
            int currentPage = (int)ViewBag.Page;
            int pageCount = pageSize > 0 ? (int)Math.Ceiling(rowCount / (double)pageSize) : 1;
        }
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 20px 0;flex-wrap:wrap;gap:8px;">
            <div class="dataTables_info" style="padding:0;">Showing @(Model?.Count ?? 0) of @rowCount</div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button type="button" id="btnPrevPage" class="btn-white" style="width:auto;padding:5px 14px;" @(currentPage <= 1 ? "disabled" : "")>&laquo; Prev</button>
                <span style="color:#666;font-size:12.5px;">Page @currentPage of @Math.Max(pageCount, 1)</span>
                <button type="button" id="btnNextPage" class="btn-white" style="width:auto;padding:5px 14px;" @(currentPage >= pageCount ? "disabled" : "")>Next &raquo;</button>
            </div>
        </div>
    </div>

    @Html.Partial("_BlendAlert")
    <script>
        $(function () {
            var searchTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(reload, 400);
            });

            // No blendType in the query string any more -- the list is no longer filtered
            // to one Packet Type (see the markup comment where the dropdown used to be).
            // Sort state rides along with every navigation (search, paging) so changing the
            // search text or turning the page keeps the column you sorted by.
            var SORT_BY = '@(ViewBag.SortBy ?? "")', SORT_DIR = '@(ViewBag.SortDir ?? "")';
            function reload(page, sortBy, sortDir) {
                var by = (sortBy === undefined) ? SORT_BY : sortBy;
                var dir = (sortDir === undefined) ? SORT_DIR : sortDir;
                window.location.href = '@Url.Action("Index", "Packing")'
                    + '?searchString=' + encodeURIComponent($('#searchInput').val())
                    + '&page=' + (page || 1)
                    + '&sortBy=' + encodeURIComponent(by || '')
                    + '&sortDir=' + encodeURIComponent(dir || '');
            }

            // Re-sorting always returns to page 1 -- staying on page 4 of the old order
            // shows an arbitrary slice of the new one.
            $('#packingTable').on('click', 'thead th.sortable', function () {
                reload(1, $(this).data('sort'), $(this).data('dir'));
            });

            $('#btnPrevPage').on('click', function () { if (!$(this).is(':disabled')) reload(@currentPage - 1); });
            $('#btnNextPage').on('click', function () { if (!$(this).is(':disabled')) reload(@currentPage + 1); });

            // =========================================================
            // "New" inline row -- same flow as the Master/Final Blend lists: New
            // prepends a row with a Unit picker and a (rights-filtered) Packet Type
            // picker rather than navigating straight into a blank entry screen. The
            // pencil lights up only once both are chosen, then opens Packing Entry in
            // the same tab with both passed through and locked there.
            // =========================================================
            var UNIT_LIST = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitList));
            var PACKET_TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(blendTypes));

            function buildNewRow() {
                var unitOpts = '<option value="">Select Unit</option>' +
                    UNIT_LIST.map(function (u) { return '<option value="' + u.CODE + '">' + u.CODE + ' - ' + (u.NAME || '') + '</option>'; }).join('');
                var typeOpts = '<option value="">Select Packet Type</option>' +
                    Object.keys(PACKET_TYPES).map(function (k) { return '<option value="' + k + '">' + PACKET_TYPES[k] + ' (' + k + ')</option>'; }).join('');
                return '<tr id="newUnitRow" class="new-entry-row">' +
                    '<td colspan="2" style="text-align:center;"><i class="fa fa-pencil go-new" title="Open Packing Entry"></i></td>' +
                    '<td colspan="2"><select id="newRowUnit">' + unitOpts + '</select></td>' +
                    '<td colspan="2"><select id="newRowPacketType">' + typeOpts + '</select></td>' +
                    '<td colspan="6"></td>' +
                    '</tr>';
            }

            function refreshGoNewState() {
                var ready = !!$('#newRowUnit').val() && !!$('#newRowPacketType').val();
                $('.go-new').toggleClass('is-ready', ready);
            }

            // AEDV rights + edit back-date limit -- see the perm block at the top of this view.
            var CAN_ADD = @(canAdd ? "true" : "false"), CAN_EDIT = @(canEdit ? "true" : "false"), CAN_DELETE = @(canDelete ? "true" : "false");
            var EDIT_MIN_DATE = '@editMinDate.ToString("yyyy-MM-dd")', EDIT_MIN_DMY = '@editMinDate.ToString("dd/MM/yyyy")';
            function editRefusal(docdt) {
                if (!CAN_EDIT) return 'You do not have permission to edit this entry.';
                if (docdt && docdt < EDIT_MIN_DATE)
                    return 'Edit is not allowed. Only entries dated on or after ' + EDIT_MIN_DMY + ' can be edited.';
                return null;
            }

            $('#btnNew').on('click', function () {
                if (!CAN_ADD) { showWarningDialog('You do not have permission to add a new entry.', 'Add Not Allowed !'); return; }
                if ($('#newUnitRow').length) return;
                $('#packingTable tbody').prepend(buildNewRow());
                refreshGoNewState();
            });

            $('#packingTable').on('change', '#newRowUnit, #newRowPacketType', refreshGoNewState);

            $('#packingTable').on('click', '.go-new', function () {
                var unit = $('#newRowUnit').val(), packetType = $('#newRowPacketType').val();
                if (!unit) { showWarning('Please select Unit first'); return; }
                if (!packetType) { showWarning('Please select Packet Type first'); return; }
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?unit=' + encodeURIComponent(unit)
                    + '&blendType=' + encodeURIComponent(packetType);
            });

            function fmtNum(v) { return v == null ? '' : v; }
            function fmtDmy(v) { return v ? new Date(v).toLocaleDateString('en-GB') : ''; }
            function esc(v) {
                return (v == null ? '' : String(v)).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            function openDetail($btn) {
                var $detail = $('#' + $btn.data('target'));
                $detail.show();
                $btn.removeClass('fa-plus').addClass('fa-minus');
                if ($detail.data('loaded')) return;
                $detail.data('loaded', true);
                var $body = $detail.find('.detail-items-body');
                $.get('@Url.Action("GetRowDetail", "Packing")', {
                    docno: $detail.data('docno'),
                    docdt: $detail.data('docdt'),
                    blendType: $detail.data('blendtype')
                }).done(function (r) {
                    if (!r || !r.success) {
                        $detail.data('loaded', false);
                        $body.html('<tr><td colspan="20" style="text-align:center;color:#666;">' + esc((r && r.message) || 'Unable to load item lines.') + '</td></tr>');
                        return;
                    }
                    var items = r.details || [];
                    if (!items.length) {
                        $body.html('<tr><td colspan="20" style="text-align:center;color:#666;">No item lines</td></tr>');
                        return;
                    }
                    $body.empty();
                    items.forEach(function (d, i) {
                        $('<tr>').append(
                            '<td>' + esc(d.SL_NO || (i + 1)) + '</td>',
                            '<td>' + esc(d.MarkName || d.MARK) + '</td>',
                            '<td>' + esc(d.GradeName || d.GRADE) + '</td>',
                            '<td>' + esc(d.CategoryName || d.CAT) + '</td>',
                            '<td>' + esc(d.INVNO) + '</td>',
                            '<td>' + fmtDmy(d.PACK_DATE) + '</td>',
                            '<td>' + esc(d.SEASON) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.BAG_CHEST) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.CHESTSLF) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.CHESTSLT) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.GROSS) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.TARE) + '</td>',
                            '<td style="text-align:right;">' + fmtNum(d.QTY) + '</td>',
                            '<td>' + esc(d.BATCHNO) + '</td>',
                            '<td>' + esc(d.SzDesc || d.SZ_CODE) + '</td>',
                            '<td style="text-align:right;">' + (d.RATE != null ? Number(d.RATE).toFixed(2) : '') + '</td>',
                            '<td style="text-align:right;">' + (d.AMOUNT != null ? Number(d.AMOUNT).toFixed(2) : '') + '</td>',
                            '<td>' + esc(d.AllocationName || d.ALLOCATION) + '</td>',
                            '<td>' + esc(d.ITCD) + '</td>',
                            '<td>' + esc(d.MRP) + '</td>'
                        ).appendTo($body);
                    });
                }).fail(function () {
                    $detail.data('loaded', false);
                    $body.html('<tr><td colspan="20" style="text-align:center;color:#666;">Unable to load item lines.</td></tr>');
                });
            }

            function closeDetail($btn) {
                $('#' + $btn.data('target')).hide();
                $btn.removeClass('fa-minus').addClass('fa-plus');
            }

            $('#packingTable').on('click', '.row-expand-btn', function () {
                var $btn = $(this);
                if ($('#' + $btn.data('target')).is(':visible')) closeDetail($btn); else openDetail($btn);
            });

            // "Lines": expand the ticked rows' item lines, or every row when none is ticked;
            // a second click collapses them again.
            $('#linesBtn').on('click', function () {
                var $checked = $('.row-check:checked');
                var $btns = $checked.length
                    ? $checked.closest('tr').find('.row-expand-btn')
                    : $('#packingTable .row-expand-btn');
                var anyClosed = $btns.filter('.fa-plus').length > 0;
                $btns.each(function () { anyClosed ? openDetail($(this)) : closeDetail($(this)); });
            });

            function getSingleChecked(action) {
                var $c = $('.row-check:checked');
                if ($c.length === 0) { showWarning('Please select a record to ' + action + '.'); return null; }
                if ($c.length > 1) { showWarning('Please select only one record to ' + action + '.'); return null; }
                return $c;
            }

            $('#editBtn').on('click', function () {
                var $c = getSingleChecked('edit');
                if (!$c) return;
                var refusal = editRefusal($c.data('docdt'));
                if (refusal) { showWarningDialog(refusal, 'Edit Not Allowed !'); return; }
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?docno=' + encodeURIComponent($c.val())
                    + '&docdt=' + encodeURIComponent($c.data('docdt'))
                    + '&blendType=' + encodeURIComponent($c.data('blendtype'));
            });

            $('#viewBtn').on('click', function () {
                var $c = getSingleChecked('view');
                if (!$c) return;
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?docno=' + encodeURIComponent($c.val())
                    + '&docdt=' + encodeURIComponent($c.data('docdt'))
                    + '&blendType=' + encodeURIComponent($c.data('blendtype'))
                    + '&view=true';
            });

            $('#deleteBtn').on('click', function () {
                if (!CAN_DELETE) { showWarningDialog('You do not have permission to delete this entry.', 'Delete Not Allowed !'); return; }
                var $c = getSingleChecked('delete');
                if (!$c) return;
                bxConfirm('Are you sure you want to delete Packing Doc No ' + $c.val() + ' ?', function () {
                    $('<form>', { method: 'POST', action: '@Url.Action("Delete", "Packing")' })
                        .append($('<input>', { type: 'hidden', name: 'docno', value: $c.val() }))
                        .append($('<input>', { type: 'hidden', name: 'docdt', value: $c.data('docdt') }))
                        .append($('<input>', { type: 'hidden', name: 'blendType', value: $c.data('blendtype') }))
                        .appendTo('body').submit();
                }, { okText: 'Delete', cancelText: 'Cancel' });
            });
        });
    </script>
</body>
</html>
