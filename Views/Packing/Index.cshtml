@using PacketTea.Utility
@model List<PacketTea.Models.PT.BLEND_PACKING_DATA>

@{
    ViewBag.Title = "Packing Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    var currentBlendType = (string)ViewBag.BlendType;
    var unitList = (List<PacketTea.Models.PT.UnitOption>)ViewBag.UnitList ?? new List<PacketTea.Models.PT.UnitOption>();

    Func<string, string> btLabel = code => (code != null && blendTypes != null && blendTypes.ContainsKey(code)) ? blendTypes[code] : code;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <style>
        /* Same look as Master/Final Blend Entry's list -- see MasterBlendEntry's
           Index.cshtml for the rationale behind these overrides. */
        :root {
            --mbe-navy: #2c3958; --mbe-accent: #3a7bd5; --mbe-border: #dde2ea;
            --mbe-bg: #f4f6fa; --mbe-text: #2b2f38; --mbe-muted: #6b7280;
        }
        body { background: var(--mbe-bg); }
        .general-container { background: #fff; border-radius: 8px; box-shadow: 0 1px 3px rgba(20,30,60,.08); padding-bottom: 18px; overflow: hidden; }

        .action-btns, .action-btns ul { background: #fff; border: none; border-bottom: 1px solid var(--mbe-border); }
        .action-btns ul { display: flex; align-items: center; margin: 0; padding: 6px 14px; list-style: none; }
        .action-btns ul li { margin-right: 6px; border-right: none; }
        .action-btns ul li a, .action-btns ul li button {
            display: inline-flex; align-items: center; gap: 6px;
            color: var(--mbe-text); background: transparent; border: none; cursor: pointer;
            padding: 8px 12px; border-radius: 6px; font-size: 13px; font-weight: 500;
            text-decoration: none; transition: background .15s ease;
        }
        .action-btns ul li a:hover, .action-btns ul li button:hover:not(:disabled) { background: var(--mbe-bg); color: var(--mbe-text); }
        .action-btns ul li button:disabled { opacity: .4; cursor: not-allowed; }
        .list-badge { display: inline-block; background: var(--mbe-navy); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .05em; padding: 5px 10px; border-radius: 4px; }

        .title-heading { padding: 18px 20px 14px; font-size: 20px; font-weight: 700; color: var(--mbe-text); }

        #searchInput { border: 1px solid var(--mbe-border); border-radius: 6px; }

        .table-responsive { padding: 0 20px; overflow-x: auto; }
        /* Chunked list (same behaviour as ERP_Inventory's Purchase Order list): fixed-height
           scroll box with a sticky header; the next chunk of rows loads when the box is
           scrolled to the bottom -- see Scripts/list-infinite-scroll.js. */
        #tableScroll { max-height: calc(100vh - 380px); min-height: 240px; overflow: auto; }
        #tableScroll table.main-table thead th { position: sticky; top: 0; z-index: 3; }
        /* Match Purchase Order's own list font exactly -- see Master Blend Entry's Index
           for the full rationale. */
        table.main-table { width: 100%; border-collapse: collapse; font-size: 12px; font-family: Arial, Helvetica, sans-serif; }
        table.main-table th, table.main-table td { border: 1px solid var(--mbe-border); padding: 8px 10px; }
        table.main-table thead th { background: var(--mbe-navy); color: #fff; font-weight: 600; text-align: left; white-space: nowrap; }
        table.main-table tbody tr:nth-child(even) { background: #f8f9fc; }
        table.main-table tbody tr:hover { background: #eef3ff; }
        .dataTables_info { padding: 10px 20px 0; color: var(--mbe-muted); font-size: 12.5px; }

        table.detail-sub-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        table.detail-sub-table th, table.detail-sub-table td { border: 1px solid var(--mbe-border); padding: 6px 8px; }
        table.detail-sub-table thead th { background: var(--mbe-navy); color: #fff; font-weight: 600; text-align: left; white-space: nowrap; }
        table.detail-sub-table tbody tr:nth-child(even) { background: #fff; }

        /* "New" inline row -- same pattern as Master/Final Blend Entry's list: pick Unit +
           Packing Type here first, then the pencil icon (enabled only once both are
           picked) opens the root Packing Entry window with both locked in. */
        tr.new-entry-row td { background: #eef3ff; vertical-align: middle; }
        tr.new-entry-row select, tr.new-entry-row input.new-row-pick { border: 1px solid var(--mbe-border); border-radius: 6px; padding: 6px 8px; font-size: 13px; width: 100%; box-sizing: border-box; }
        /* jquery.inputpicker wraps each input in a div with inline overflow:auto; inside the
           narrow cell the input + arrow overflow it and native scrollbars (the stray arrows)
           blow the row up. Clip it instead. */
        tr.new-entry-row .inputpicker-overflow-hidden, tr.new-entry-row .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        /* Unit / Packet Type fields must not collapse to the squeezed cell width: fixed floor for the
           field and for its dropdown panel (the panel hangs off <body>, so target it by id). */
        tr.new-entry-row input.new-row-pick { min-width: 240px; }
        #inputpicker-wrapped-list { min-width: 300px; }
        tr.new-entry-row .go-new { font-size: 15px; cursor: not-allowed; color: #aab2c0; }
        tr.new-entry-row .go-new.is-ready { cursor: pointer; color: var(--mbe-accent); }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="action-btns">
            <ul>
                <li><a href="@Url.Action("Index", "Menu")"><i class="fa fa-arrow-left"></i> Back</a></li>
                <li>
                    <a href="javascript:void(0)" id="btnNew"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Add ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-plus"></i> New
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="editBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-pencil"></i> Edit
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="deleteBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Delete ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-trash-o"></i> Delete
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="viewBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.View ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-eye"></i> View
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="linesBtn" title="Show the ticked row's lines">
                        <i class="fa fa-list"></i> Lines
                    </a>
                </li>
                <li style="margin-left:auto">
                    <span class="list-badge">LIST</span>
                </li>
            </ul>
        </div>

        <div class="title-heading">Packing Entry</div>

        <div style="display:flex;justify-content:flex-end;padding:0 20px;margin-bottom:15px;">
            <div style="position:relative;width:280px;">
                <input type="text" id="searchInput" value="@ViewBag.CurrentFilter" placeholder="Search Doc No / Blend No"
                       style="width:100%;padding:8px 14px;box-sizing:border-box;" />
            </div>
        </div>

        <div class="table-responsive" id="tableScroll">
            <table class="border main-table" id="packingTable">
                <thead>
                    <tr>
                        <th style="width:26px;"></th>
                        <th style="width:26px;"></th>
                        <th>Unit</th>
                        <th>Packing Type</th>
                        <th>Doc No</th>
                        <th>Date</th>
                        <th>Blend No</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Packing Qty.</th>
                        <th>Short/Excess</th>
                        <th>Party</th>
                    </tr>
                </thead>
                <tbody id="listBody">
                    @Html.Partial("_ListRows", Model)
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr><td colspan="12" style="text-align:center;">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            int pageSize = (int)ViewBag.PageSize;
            int rowCount = (int)ViewBag.RowCount;
        }
        <div id="listLoading" style="display:none;text-align:center;padding:8px 0 0;color:var(--mbe-muted);font-size:12.5px;">Loading...</div>
        <div class="dataTables_info">Showing <span id="shownCount">@(Model?.Count ?? 0)</span> of @rowCount</div>
    </div>

    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <script src="~/Scripts/list-new-row-pickers.js"></script>
    <script src="~/Scripts/list-infinite-scroll.js"></script>
    <script>
        $(function () {
            var searchTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(reload, 400);
            });

            // The Packet Type / Unit dropdowns that used to sit in the toolbar are gone -- Unit
            // and Packing Type are now only picked in the "New" inline row, so the list shows
            // every type for the units the user is linked to (see PackingController.Index).
            // Changing the search text reloads the list from the first chunk.
            function reload() {
                window.location.href = '@Url.Action("Index", "Packing")'
                    + '?searchString=' + encodeURIComponent($('#searchInput').val());
            }

            // Chunked loading: the first chunk is rendered with the page, further chunks are
            // appended as the list is scrolled to the bottom (Scripts/list-infinite-scroll.js).
            initInfiniteList({
                scroll: '#tableScroll', body: '#listBody', loading: '#listLoading', count: '#shownCount',
                url: '@Url.Action("Index", "Packing")',
                search: $('#searchInput').val(), pageSize: @pageSize, total: @rowCount, startPage: 1
            });

            // "+" toggle -- reveals the packing lines for that row. Every open re-fetches them
            // via GetRowDetail instead of trusting what was rendered at page load.
            $('#packingTable').on('click', '.row-expand-btn', function () {
                var $btn = $(this);
                var $detail = $('#' + $btn.data('target'));
                var opening = !$detail.is(':visible');
                $detail.toggle(opening);
                $btn.text(opening ? '-' : '+');

                if (opening) {
                    var $body = $detail.find('.detail-items-body');
                    var msg = function (t) { return '<tr><td colspan="15" style="text-align:center;color:var(--mbe-muted);">' + t + '</td></tr>'; };
                    $.get('@Url.Action("GetRowDetail", "Packing")', {
                        docno: $detail.data('docno'),
                        docdt: $detail.data('docdt'),
                        blendType: $detail.data('blendtype'),
                        unit: $detail.data('unit')
                    }).done(function (r) {
                        if (!r || !r.success) { $body.html(msg('Unable to load packing lines.')); return; }
                        var items = r.details || [];
                        if (items.length === 0) { $body.html(msg('No packing lines')); return; }
                        $body.empty();
                        var n2 = function (v) { return Number(v || 0).toFixed(2); };
                        items.forEach(function (d, i) {
                            var packDate = d.PACK_DATE ? new Date(d.PACK_DATE).toLocaleDateString('en-GB') : '';
                            $('<tr>').append(
                                '<td>' + (d.SL_NO || (i + 1)) + '</td>',
                                '<td>' + (d.MarkName || d.MARK || '') + '</td>',
                                '<td>' + (d.GradeName || d.GRADE || '') + '</td>',
                                '<td>' + (d.INVNO || '') + '</td>',
                                '<td>' + packDate + '</td>',
                                '<td style="text-align:right;">' + (d.BAG_CHEST || 0) + '</td>',
                                '<td style="text-align:right;">' + (d.CHESTSLF || 0) + '</td>',
                                '<td style="text-align:right;">' + (d.CHESTSLT || 0) + '</td>',
                                '<td style="text-align:right;">' + n2(d.GROSS) + '</td>',
                                '<td style="text-align:right;">' + n2(d.NET != null ? d.NET : (d.GROSS || 0) - (d.TARE || 0)) + '</td>',
                                '<td style="text-align:right;">' + (d.QTY || 0) + '</td>',
                                '<td>' + (d.SzDesc || d.SZ_CODE || '') + '</td>',
                                '<td style="text-align:right;">' + n2(d.RATE) + '</td>',
                                '<td style="text-align:right;">' + n2(d.AMOUNT) + '</td>',
                                '<td>' + (d.AllocationName || d.ALLOCATION || '') + '</td>'
                            ).appendTo($body);
                        });
                    }).fail(function () { $body.html(msg('Unable to load packing lines.')); });
                }
            });

            // "New" inline row -- see the CSS comment above; same pattern as Master/Final
            // Blend Entry's list page (navigates in the same tab).
            var UNIT_LIST = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitList));
            var PACKET_TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(blendTypes));

            function buildNewRow() {
                // Unit + Packing Type are inputpicker dropdowns (searchable by Code and Name) --
                // initialised right after the row is inserted, see initNewRowPickers().
                return '<tr id="newUnitRow" class="new-entry-row">' +
                    '<td colspan="2" style="text-align:center;"><i class="fa fa-pencil go-new" title="Open Packing Entry"></i></td>' +
                    // Unit picker spans 3 columns (Unit / Blend Type / Doc No) so the "CODE - Name" text isn't clipped;
                    // the table's own columns are untouched.
                    '<td colspan="3"><input type="text" id="newRowUnit" class="new-row-pick" placeholder="Select Unit" autocomplete="off" /></td>' +
                    '<td colspan="2"><input type="text" id="newRowPacketType" class="new-row-pick" placeholder="Select Packing Type" autocomplete="off" /></td>' +
                    '<td colspan="5"></td>' +
                    '</tr>';
            }

            function refreshGoNewState() {
                var ready = !!$('#newRowUnit').val() && !!$('#newRowPacketType').val();
                $('.go-new').toggleClass('is-ready', ready);
            }

            $('#btnNew').on('click', function () {
                if ($('#newUnitRow').length) return;
                $('#listBody').prepend(buildNewRow());
                initNewRowPickers({ units: UNIT_LIST, types: PACKET_TYPES });   // also pre-selects a single Unit
                refreshGoNewState();
            });

            $('#packingTable').on('change', '#newRowUnit, #newRowPacketType', refreshGoNewState);

            $('#packingTable').on('click', '.go-new', function () {
                var unit = $('#newRowUnit').val(), packetType = $('#newRowPacketType').val();
                if (!unit) { alert('Please select Unit first'); return; }
                if (!packetType) { alert('Please select Packing Type first'); return; }
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?unit=' + encodeURIComponent(unit)
                    + '&blendType=' + encodeURIComponent(packetType);
            });

            // Row selection is checkboxes (so more than one can be ticked at once) -- Edit/Delete
            // only make sense against exactly one row, so guard the same way Master/Final do.
            function getSingleChecked(action) {
                var $c = $('.row-check:checked');
                if ($c.length === 0) { alert('Please select a record to ' + action + '.'); return null; }
                if ($c.length > 1) { alert('Please select only one record to ' + action + '.'); return null; }
                return $c;
            }

            // Toolbar buttons act on the ticked row.
            // The row's Unit travels with Edit/Delete: a Doc No repeats across units, so the
            // document is identified by Doc No + Date + Type + Unit.
            function goEdit(docno, docdt, blendType, unit) {
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?docno=' + encodeURIComponent(docno)
                    + '&docdt=' + encodeURIComponent(docdt)
                    + '&blendType=' + encodeURIComponent(blendType)
                    + '&unit=' + encodeURIComponent(unit || '');
            }

            function goView(docno, docdt, blendType, unit) {
                window.location.href = '@Url.Action("InsertOrUpdate", "Packing")'
                    + '?docno=' + encodeURIComponent(docno)
                    + '&docdt=' + encodeURIComponent(docdt)
                    + '&blendType=' + encodeURIComponent(blendType)
                    + '&unit=' + encodeURIComponent(unit || '')
                    + '&view=true';
            }

            function doDelete(docno, docdt, blendType, unit) {
                if (!confirm('Are you sure you want to delete Packing Doc No ' + docno + ' ?')) return;

                $('<form>', { method: 'POST', action: '@Url.Action("Delete", "Packing")' })
                    .append($('<input>', { type: 'hidden', name: 'docno', value: docno }))
                    .append($('<input>', { type: 'hidden', name: 'docdt', value: docdt }))
                    .append($('<input>', { type: 'hidden', name: 'blendType', value: blendType }))
                    .append($('<input>', { type: 'hidden', name: 'unit', value: unit || '' }))
                    .appendTo('body').submit();
            }

            $('#editBtn').on('click', function () {
                var $c = getSingleChecked('edit');
                if ($c) goEdit($c.val(), $c.data('docdt'), $c.data('blendtype'), $c.data('unit'));
            });

            $('#deleteBtn').on('click', function () {
                var $c = getSingleChecked('delete');
                if ($c) doDelete($c.val(), $c.data('docdt'), $c.data('blendtype'), $c.data('unit'));
            });

            $('#viewBtn').on('click', function () {
                var $c = getSingleChecked('view');
                if ($c) goView($c.val(), $c.data('docdt'), $c.data('blendtype'), $c.data('unit'));
            });

            // Lines: open the ticked row's "+" expand panel (packing lines) and scroll it into view.
            $('#linesBtn').on('click', function () {
                var $c = getSingleChecked('view its lines');
                if (!$c) return;
                var $btn = $c.closest('tr').find('.row-expand-btn');
                if ($btn.text().trim() === '+') $btn.trigger('click');
                var $detail = $('#' + $btn.data('target'));
                if ($detail.length && $detail[0].scrollIntoView) $detail[0].scrollIntoView({ block: 'nearest' });
            });
        });
    </script>
</body>
</html>
