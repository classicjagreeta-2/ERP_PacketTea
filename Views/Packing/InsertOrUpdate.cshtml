@model PacketTea.Models.PT.BLEND_PACKING_DATA
@using Newtonsoft.Json
@{
    ViewBag.Title = "Packing Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    bool isEdit = ViewBag.IsEdit ?? false;
    // True only when this window was opened from the list page's "New" inline row --
    // Unit + Packet Type were already chosen there (same as Master/Final Blend Entry).
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    bool isView = ViewBag.IsView ?? false;
    var head = Model;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <style>
        /* Same additions as Master/Final Blend Entry's InsertOrUpdate views. */
        input[readonly] { background-color: #f3f4f7; color: #555; }
        /* purchase-order.css hard-codes .accordion-container to a fixed 350px scroll
           area -- let the standalone Unit/Blend Type strip above Header size to its
           own single-row content instead (same as the other two entry screens). */
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        /* Every numeric field right-aligned, grid and header alike -- same as
           Master/Final Blend Entry. Rate/Amount additionally render to 2 decimals
           (see fmt2 in the script below). */
        input[type="number"] { text-align: right; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 80px; }
        /* Code columns sit next to their description, so keep the code inputs narrow
           enough that the pair still fits on one line. */
        #gridTable td input.code-input { width: 72px; min-width: 0; }
        /* Description columns were truncating (e.g. "BIRLA KAD...") -- give them
           room for the full mark/grade/category name. */
        #gridTable td input.f-markname { min-width: 140px; }
        #gridTable td input.f-gradename { min-width: 200px; }
        #gridTable td input.f-catname { min-width: 120px; }
        /* Grade codes run to 8+ chars (e.g. O0000575) and Inv No to 10 -- the shared
           72px code width clipped them. */
        #gridTable td input.f-grade.code-input { width: 95px; }
        #gridTable td input.f-invno { min-width: 110px; }
        /* Size Code/Size/Rate/Amount stay in the DOM (Rate/Amount still come from the
           blend lookup and are saved) but are not shown on this screen. */
        #gridTable .col-hide { display: none; }
        /* Item dropdown (select2). The theme's style.css forces every
           .select2-container to width:100% !important and paints the selection teal;
           the dropdown half is appended to <body>, so that rule stretched it across the
           whole page and shoved the layout sideways. Pin both halves to sane widths
           and make the closed box look like the other grid inputs. */
        #gridTable .select2-container { width: 340px !important; }
        /* Width comes from select2's own inline style (= the closed box's width), so
           the list lines up with the box and never runs off the right edge; long item
           names wrap instead of widening it. */
        body > .select2-container.select2-container--open { width: auto !important; }
        body > .select2-container--open .select2-results__option { font-size: 12px; padding: 5px 8px; white-space: normal; line-height: 1.35; }
        #gridTable .select2-container--default .select2-selection--single { height: 30px; border: 1px solid #ccc; border-radius: 2px; background: #fff; }
        #gridTable .select2-container--default .select2-selection--single .select2-selection__rendered { background: transparent; color: #222; padding: 0 40px 0 6px; line-height: 28px; font-size: 13px; }
        #gridTable .select2-container--default .select2-selection--single .select2-selection__arrow { height: 28px; top: 0; }
        #gridTable .select2-container--default .select2-selection--single .select2-selection__arrow b { border-color: #666 transparent transparent transparent; }
        #gridTable .select2-container--default .select2-selection--single .select2-selection__clear { color: #999; margin-right: 4px; }
        .grid-pick-btn { width: 20px; height: 21px; padding: 0; margin-left: 2px; vertical-align: middle; border: 1px solid #ccc; background: #f4f6fa; cursor: pointer; font-size: 11px; line-height: 1; }
        .popup-box.picker-box { width: 420px; display: none; }
        .popup-box.picker-box.wide { width: 760px; max-width: 92vw; }
        .popup-box .picker-body { max-height: 40vh; overflow-y: auto; margin-top: 8px; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .popup-box .picker-search { margin-bottom: 8px; }
        #balanceHint { font-size: 12px; color: var(--mbe-muted, #6b7280); padding-top: 6px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />
    <input type="hidden" id="BlendDocNo" value="@head.BlendDocNo" />
    <input type="hidden" id="BlendDocDt" value="@(head.BlendDocDt?.ToString("yyyy-MM-dd"))" />

    <div class="general-container">
        <div class="purchase-details">

            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "Packing")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "Packing")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Packing Entry</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : @(head.DOCNO ?? "")</div>
                    </div>
                </div>
            </div>

            <!-- Unit / Blend Type -- its own section above Header, matching the root UI of
                 Master and Final Blend Entry (the list page's "New" row still calls this
                 value "Packet Type" in its own picker label; it is one and the same field,
                 so it is not shown twice here). Unit is otherwise never user-facing (UNIT is
                 derived server-side -- see UnitForBlendType's comment), it's shown purely for
                 confirmation. Both lock read-only once Unit + Packet Type were chosen on the
                 list page (lockedFromList), same as Blend Type already does in Edit mode. -->
            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit / Blend Type</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                <input type="text" id="UNIT_disp" value="@head.UNIT" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Blend Type <span>(*)</span></label>
                                <select id="BLEND_TYPE" @((isEdit || lockedFromList) ? "disabled" : "")>
                                    @foreach (var bt in blendTypes)
                                    {
                                        <option value="@bt.Key" selected="@(bt.Key == head.BLEND_TYPE)">@bt.Value (@bt.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" value="@head.DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Doc Date <span>(*)</span></label>
                                @* New entry: FY narrowed by the back-date policy (Aday) and today -- see SetNewDocDateBounds. *@
                                <input type="date" id="DOCDT" value="@(head.DOCDT?.ToString("yyyy-MM-dd"))"
                                       min="@(ViewBag.DocDtMin ?? ViewBag.FyStart)" max="@(ViewBag.DocDtMax ?? ViewBag.FyEnd)" @(isEdit ? "disabled" : "") />
                            </div>
                            <div class="form-col-20">
                                <label>Blend No <span>(*)</span></label>
                                <input type="text" id="MasterBlendNo" value="@head.MasterBlendNo" placeholder="Click to pick" readonly style="cursor:pointer;" />
                                <div id="balanceHint"></div>
                            </div>
                            <div class="form-col-20">
                                <label>Blend Date</label>
                                <input type="text" id="MasterBlendDate" value="@(DateTime.TryParse(head.BlendDocDate, out var masterBlendDate) ? masterBlendDate.ToString("dd/MM/yyyy") : "")" readonly />
                            </div>
                        </div>

                        <!-- Code/description pairs, same as Master and Final Blend Entry's
                             headers. Party is carried over from the picked Final Blend (VB:
                             txtParty + lblParty); a Party lookup is available but display-only;
                             Location's description used to be a hidden input, which left a
                             picked code on screen with nothing saying what it was. -->
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Party</label>
                                @* Defaults from the picked Final Blend; the lookup lets the user
                                   pick another party for reference only. T_BLEND_PACKING has no
                                   party column, so the pick is NOT saved -- on reopen the Final
                                   Blend's party shows again. *@
                                <input type="text" id="PCODE" data-picker="party" value="@head.PCODE" placeholder="Click to pick" readonly style="cursor:pointer;" />
                            </div>
                            <div class="form-col-20">
                                <label>Party Name</label>
                                <input type="text" id="PartyName" value="@head.PartyName" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Location <span>(*)</span></label>
                                <input type="text" id="SaleCentre" data-picker="salescentre" value="@head.SaleCentre" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Location Name</label>
                                <input type="text" id="SaleCentre_disp" value="@head.SaleCentreName" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Short/Excess</label>
                                <input type="number" step="0.01" id="ShortExcess" value="@head.ShortExcess" />
                            </div>
                            <div class="form-col-20">
                                <label>Total Qty</label>
                                <input type="number" id="TotalQty" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-100">
                                <label>Shipping Mark</label>
                                <textarea id="ShipMark" rows="3" style="height:60px;resize:vertical;">@head.ShipMark</textarea>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-100">
                                <label>Remarks</label>
                                <textarea id="Remarks" style="height:50px;">@head.Remarks</textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header"><span class="txt">Lines</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnAddRow"><i class="fa fa-plus"></i> Add Row</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <!-- Column set follows the VB6 grid (trn_blend_Packing.frx),
                                         which pairs every coded column with its description:
                                         Mark Code/Mark, Grade Code/Grade, Cat/Category,
                                         Size Code/Size, Alloc Code/Allocation. The description
                                         halves are filled by the lookups (which now return code
                                         AND description) and are read-only. -->
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:50px;min-width:50px;text-align:center;">Sl</th>
                                        <th style="width:130px;min-width:130px;text-align:center;">Blend</th>
                                        <th>Mark Code <span style="color:red;">(*)</span></th>
                                        <th>Mark</th>
                                        <th>Grade Code <span style="color:red;">(*)</span></th>
                                        <th>Grade</th>
                                        <th style="width:60px;">Cat</th>
                                        <th>Category</th>
                                        <th>Inv No <span style="color:red;">(*)</span></th>
                                        <th style="width:110px;">Pack Date</th>
                                        <th>Season</th>
                                        <th style="width:65px;">Bag</th>
                                        <th style="width:60px;">Chest F</th>
                                        <th style="width:60px;">Chest T</th>
                                        <th style="width:80px;text-align:right;">Gross Wt</th>
                                        <th style="width:80px;text-align:right;">Net Wt</th>
                                        <th style="width:75px;text-align:right;">Tare</th>
                                        <th style="width:85px;text-align:right;">Qty</th>
                                        <th>Batch No</th>
                                        <th style="width:110px;">Mfg Date</th>
                                        <th class="col-hide">Size Code</th>
                                        <th class="col-hide">Size</th>
                                        <th class="col-hide" style="width:75px;text-align:right;">Rate</th>
                                        <th class="col-hide" style="width:90px;text-align:right;">Amount</th>
                                        <th>Alloc Code</th>
                                        <th>Allocation</th>
                                        <th>Item</th>
                                        <th style="width:60px;text-align:right;">MRP</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <!-- 29 columns: 12 + Bag + 5 + Qty + 2 + (Size Code, Size, Rate,
                                         Amount -- hidden) + 4. -->
                                    <tr class="total">
                                        <td colspan="12" style="text-align:right;">Total</td>
                                        <td id="ftBag" style="text-align:right;"></td>
                                        <td colspan="5"></td>
                                        <td id="ftQty" style="text-align:right;"></td>
                                        <td colspan="2"></td>
                                        <td colspan="3" class="col-hide"></td>
                                        <td id="ftAmt" class="col-hide" style="text-align:right;"></td>
                                        <td colspan="4"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="popup-overlay" id="pickerOverlay"></div>

    <div class="popup-box picker-box" id="genericPicker">
        <div class="popup-header">
            <h2 id="pickerTitle">Select</h2>
            <button type="button" class="close-btn" onclick="closePicker()">X</button>
        </div>
        <input type="text" id="pickerSearch" class="picker-search" placeholder="Type to search..." />
        <div class="picker-body" id="pickerBody"></div>
    </div>

    <!-- Final Blend picker -- used both by the header "Blend No" field and by
         each row's own "Blend" pick button (see BlendPackingController's class
         comment on why every row gets a WORKING picker here). -->
    <div class="popup-box picker-box wide" id="blendPicker">
        <div class="popup-header">
            <h2>Select Final Blend</h2>
            <button type="button" class="close-btn" onclick="closeBlendPicker()">X</button>
        </div>
        <input type="text" id="blendPickerSearch" class="picker-search" placeholder="Search Blend No / Doc No..." />
        <div class="picker-body" id="blendPickerBody"></div>
    </div>

@Html.Partial("_BlendAlert")

<script>
    // =========================================================
    // In-page alert/confirm -- drawn by Shared/_BlendAlert.cshtml.
    // kind: 'warning' (default -- every validation), 'success', or 'error' (real failure only).
    // =========================================================
    function showAlert(message, onOk, kind) {
        bxAlert(message, { kind: kind || 'warning', onOk: onOk });
    }
    function showConfirm(message, onYes) {
        bxConfirm(message, onYes);
    }

    $('#pickerOverlay, #genericPicker, #blendPicker').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    // Back-date policy (AEDV Aday): earliest Doc Date a new entry may carry. Blank in Edit.
    var BACK_DATE_MIN = '@ViewBag.BackDateMin';
    var rows = @Html.Raw(JsonConvert.SerializeObject(Model.Details));
    var rowSeq = 0;
    rows.forEach(function (r) { r._cid = ++rowSeq; });

    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
    }
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function round2(v) { return Math.round(num(v) * 100) / 100; }
    // Money columns (Rate/Amount) always render with exactly 2 decimals -- a raw
    // 132.5 or 132 from the API would otherwise sit next to a 132.50 typed by hand.
    // Right alignment comes from the input[type=number] rule in this view's <style>;
    // the totals row sets it per-cell.
    function fmt2(v) { return num(v).toFixed(2); }
    // Grid cells are built by string concatenation, so anything free-text (a mark
    // description with an apostrophe or a quote, say) has to be escaped or it breaks
    // out of the value="..." attribute it lands in.
    function esc(v) {
        return (v == null ? '' : String(v))
            .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
            .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    // Every picker search box used to fire one AJAX call per keystroke with nothing
    // shown in between -- typing a 4-letter code queued 4 round trips and the list
    // looked frozen/blank until the last one won the abort race. Debounce so only
    // the pause-after-typing triggers a call, and show a "Searching..." row
    // immediately so the picker never looks stuck.
    function debounce(fn, wait) {
        var t;
        return function () {
            var args = arguments, ctx = this;
            clearTimeout(t);
            t = setTimeout(function () { fn.apply(ctx, args); }, wait);
        };
    }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r, idx) {
            r.SL_NO = String(idx + 1);
            var net = round2((r.GROSS || 0) - (r.TARE || 0));
            totBag += num(r.BAG_CHEST);
            totQty += num(r.QTY);
            totAmt += num(r.AMOUNT);
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" /></td>');
            tr.append('<td style="text-align:center;">' + r.SL_NO + '</td>');
            tr.append('<td style="white-space:nowrap;"><input type="text" class="f-blendno" value="' + esc(blendNoFor(r)) + '" readonly style="width:90px;" />' +
                '<button type="button" class="grid-pick-btn f-blend-btn" title="Pick a Final Blend for this row">&hellip;</button></td>');
            tr.append('<td><input type="text" class="f-mark code-input" value="' + esc(r.MARK) + '" placeholder="Code" />' +
                '<button type="button" class="grid-pick-btn f-mark-btn" title="Search mark">&hellip;</button></td>');
            tr.append('<td><input type="text" class="f-markname" value="' + esc(r.MarkName) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-grade code-input" value="' + esc(r.GRADE) + '" placeholder="Code" />' +
                '<button type="button" class="grid-pick-btn f-grade-btn" title="Search grade">&hellip;</button></td>');
            tr.append('<td><input type="text" class="f-gradename" value="' + esc(r.GradeName) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-cat code-input" value="' + esc(r.CAT) + '" placeholder="Code" />' +
                '<button type="button" class="grid-pick-btn f-cat-btn" title="Search category">&hellip;</button></td>');
            tr.append('<td><input type="text" class="f-catname" value="' + esc(r.CategoryName) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-invno" value="' + esc(r.INVNO) + '" maxlength="10" /></td>');
            tr.append('<td><input type="date" class="f-packdate" value="' + (r.PACK_DATE ? r.PACK_DATE.substring(0, 10) : '') + '" /></td>');
            tr.append('<td><input type="text" class="f-season" value="' + esc(r.SEASON) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-bag" value="' + (r.BAG_CHEST || 0) + '" /></td>');
            tr.append('<td><input type="number" class="f-chestf" value="' + (r.CHESTSLF || 0) + '" /></td>');
            tr.append('<td><input type="number" class="f-chestt" value="' + (r.CHESTSLT || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-gross" value="' + (r.GROSS || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-net" value="' + net + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-tare" value="' + (r.TARE || 0) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-qty" value="' + fmt2(r.QTY) + '" /></td>');
            tr.append('<td><input type="text" class="f-batchno" value="' + esc(r.BATCHNO) + '" /></td>');
            tr.append('<td><input type="date" class="f-mfgfrom" value="' + (r.MFG_FROM ? r.MFG_FROM.substring(0, 10) : '') + '" /></td>');
            tr.append('<td class="col-hide"><input type="text" class="f-szcode code-input" value="' + esc(r.SZ_CODE) + '" placeholder="Code" />' +
                '<button type="button" class="grid-pick-btn f-sz-btn" title="Search chest size">&hellip;</button></td>');
            tr.append('<td class="col-hide"><input type="text" class="f-szdesc" value="' + esc(r.SzDesc) + '" readonly /></td>');
            tr.append('<td class="col-hide"><input type="number" step="0.01" class="f-rate" value="' + fmt2(r.RATE) + '" /></td>');
            tr.append('<td class="col-hide"><input type="number" step="0.01" class="f-amount" value="' + fmt2(r.AMOUNT) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-alloc code-input" value="' + esc(r.ALLOCATION) + '" placeholder="Code" />' +
                '<button type="button" class="grid-pick-btn f-alloc-btn" title="Search allocation">&hellip;</button></td>');
            tr.append('<td><input type="text" class="f-allocname" value="' + esc(r.AllocationName) + '" readonly /></td>');
            tr.append('<td><select class="f-itcd">' + itemOptionsHtml(r.ITCD) + '</select></td>');
            // Numeric input (like Rate/Amount) rather than free text, so letters can't
            // be typed in at all -- and right-aligned via the input[type=number] rule
            // above. Column was widened to VARCHAR2(10) (see T_BLEND_PACKING_ddl.sql)
            // specifically so a 2-decimal MRP fits; fmt2 renders it the same way
            // Rate/Amount always have.
            tr.append('<td><input type="number" step="0.01" class="f-mrp" value="' + fmt2(r.MRP) + '" /></td>');
            $tb.append(tr);
        });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(fmt2(totAmt));
        $('#TotalQty').val(round2(totQty + num($('#ShortExcess').val())));
        $tb.find('select.f-itcd').select2({ width: '340px', placeholder: 'Select item', allowClear: true });
    }

    // Item dropdown -- the item master (ITMAS) comes from the Sales schema, loaded
    // once and shared by every row. A saved ITCD that is no longer in the list still
    // gets an option of its own, so reopening a document never blanks it out.
    var items = [];
    var itemsHtml = '';
    function itemOptionsHtml(itcd) {
        var html = '<option value=""></option>' + itemsHtml;
        if (itcd && !items.some(function (i) { return i.CODE === itcd; })) {
            html += '<option value="' + esc(itcd) + '">' + esc(itcd) + '</option>';
        }
        return itcd ? html.replace('value="' + esc(itcd) + '"', 'value="' + esc(itcd) + '" selected') : html;
    }
    function loadItems() {
        return $.getJSON('@Url.Action("GetItems", "Packing")').then(function (data) {
            items = $.isArray(data) ? data : [];
            itemsHtml = items.map(function (i) {
                return '<option value="' + esc(i.CODE) + '">' + esc(i.CODE) + ' - ' + esc(i.NAME) + '</option>';
            }).join('');
        }, function () { items = []; itemsHtml = ''; });
    }
    $('#gridBody').on('change', 'select.f-itcd', function () {
        var r = findRow($(this).closest('tr').data('cid'));
        if (r) r.ITCD = $(this).val() || null;
    });

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    // Text shown in a row's Blend cell. A freshly picked row carries the Blend No
    // from GetFinalBlendRowValues; a saved row only has BLEND_DOCNO, so fall back
    // to the header's Blend No when it is the same Final Blend, else the Doc No.
    function blendNoFor(r) {
        if (r.BlendNo) return r.BlendNo;
        if (!r.BLEND_DOCNO) return '';
        if (r.BLEND_DOCNO === $('#BlendDocNo').val() && $('#MasterBlendNo').val()) return $('#MasterBlendNo').val();
        return r.BLEND_DOCNO;
    }

    $('#gridBody').on('input change', 'input', function () {
        var $tr = $(this).closest('tr');
        var r = findRow($tr.data('cid'));
        if (!r) return;
        r.MARK = $tr.find('.f-mark').val();
        r.GRADE = $tr.find('.f-grade').val();
        r.CAT = $tr.find('.f-cat').val();
        r.INVNO = $tr.find('.f-invno').val();
        r.PACK_DATE = $tr.find('.f-packdate').val() || null;
        r.SEASON = $tr.find('.f-season').val();
        r.CHESTSLF = num($tr.find('.f-chestf').val());
        r.CHESTSLT = num($tr.find('.f-chestt').val());
        r.BATCHNO = $tr.find('.f-batchno').val();
        r.MFG_FROM = $tr.find('.f-mfgfrom').val() || null;
        r.SZ_CODE = $tr.find('.f-szcode').val();
        r.ALLOCATION = $tr.find('.f-alloc').val();
        // MRP is a string server-side (T_BLEND_PACKING.MRP is VARCHAR2, not a number
        // column) -- keep it a formatted string here too. Sending a bare JS number
        // would serialize as a JSON number, which the API's strict JSON binder can't
        // convert into that string property and the whole save would fail.
        r.MRP = fmt2($tr.find('.f-mrp').val());

        var netWt = num($tr.find('.f-net').val());
        r.BAG_CHEST = num($tr.find('.f-bag').val());
        r.GROSS = num($tr.find('.f-gross').val());

        // Bag/NetWt drive Qty; Gross/NetWt drive Tare -- same recompute chain
        // as VB's DATAGRID1_BeforeColUpdate (Case BAGS/NETWT/grosswt), just
        // collapsed into one handler. A direct edit to Qty itself overrides
        // the computed value (matches Master/Final Blend Entry's f-qty/f-bag
        // precedence).
        if ($(this).hasClass('f-qty')) {
            r.QTY = num($tr.find('.f-qty').val());
        } else if ($(this).hasClass('f-bag') || $(this).hasClass('f-net')) {
            r.QTY = round2(r.BAG_CHEST * netWt);
            $tr.find('.f-qty').val(r.QTY);
        } else {
            r.QTY = num($tr.find('.f-qty').val());
        }
        r.TARE = round2(r.GROSS - netWt);
        $tr.find('.f-tare').val(r.TARE);

        if (($(this).hasClass('f-chestf') || $(this).hasClass('f-bag')) && r.CHESTSLF) {
            r.CHESTSLT = r.CHESTSLF + r.BAG_CHEST - 1;
            $tr.find('.f-chestt').val(r.CHESTSLT);
        }

        r.AMOUNT = round2(r.QTY * num($tr.find('.f-rate').val()));
        r.RATE = num($tr.find('.f-rate').val());
        $tr.find('.f-amount').val(fmt2(r.AMOUNT));

        renderTotalsOnly();
    });

    // Rate/Qty/MRP: snap the displayed value to 2 decimal places once the user leaves
    // the field (same as Master/Final Blend Entry) -- the live input/change handler
    // above already keeps r.RATE/r.QTY/r.MRP/r.AMOUNT numerically correct on every
    // keystroke; this only tidies up what's shown.
    $('#gridBody').on('blur', '.f-rate, .f-qty, .f-mrp', function () {
        $(this).val(round2($(this).val()).toFixed(2));
    });

    function renderTotalsOnly() {
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r) { totBag += num(r.BAG_CHEST); totQty += num(r.QTY); totAmt += num(r.AMOUNT); });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(fmt2(totAmt));
        $('#TotalQty').val(round2(totQty + num($('#ShortExcess').val())));
    }
    $('#ShortExcess').on('input change', renderTotalsOnly);

    $('#btnAddRow').on('click', function () {
        rows.push({ _cid: ++rowSeq, BAG_CHEST: 0, QTY: 0, GROSS: 0, TARE: 0, RATE: 0, AMOUNT: 0 });
        renderGrid();
    });
    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });
    $('#btnRemoveRows').on('click', function () {
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        renderGrid();
    });

    // =========================================================
    // Row-level lookups (Mark/Grade/Chest Size/Allocation) -- generic picker,
    // same pattern as Master/Final Blend Entry's header pickers.
    // =========================================================
    var pickerConfig = {
        mark: { url: '@Url.Action("GetMark", "Packing")', cols: [['MCD', 'Code'], ['MDESC', 'Garden/Mark']] },
        grade: { url: '@Url.Action("GetBlendGrade", "Packing")', cols: [['CODE', 'Code'], ['NAME', 'Name']] },
        category: { url: '@Url.Action("GetCategory", "Packing")', cols: [['CAT', 'Code'], ['DESCN', 'Description']] },
        chestsize: { url: '@Url.Action("GetChestSize", "Packing")', cols: [['SZ_CODE', 'Code'], ['SZ_DESC', 'Description']] },
        allocation: { url: '@Url.Action("GetAllocation", "Packing")', cols: [['CODE', 'Code'], ['DESCN', 'Description']] },
        salescentre: { url: '@Url.Action("GetSalesCentre", "Packing")', cols: [['CODE', 'Code'], ['NAME', 'Name']], target: 'SaleCentre' },
        party: { url: '@Url.Action("GetParty", "Packing")', cols: [['CODE', 'Code'], ['NAME', 'Name']], target: 'PCODE', dispTarget: 'PartyName' },
    };
    var activePicker = null;
    var pickerXhr = null, pickerReqSeq = 0;

    // Every row picker writes BOTH halves of its pair -- the code into the editable
    // input and the description into the read-only one beside it -- and keeps the
    // same two values on the row object so they survive a re-render.
    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });
    $('#gridBody').on('click', '.f-mark-btn', function () {
        rowPicker(this, 'mark', function (r, row, $tr) {
            r.MARK = row.MCD; r.MarkName = row.MDESC || '';
            $tr.find('.f-mark').val(r.MARK); $tr.find('.f-markname').val(r.MarkName);
        });
    });
    $('#gridBody').on('click', '.f-grade-btn', function () {
        rowPicker(this, 'grade', function (r, row, $tr) {
            r.GRADE = row.CODE; r.GradeName = row.NAME || '';
            $tr.find('.f-grade').val(r.GRADE); $tr.find('.f-gradename').val(r.GradeName);
        });
    });
    $('#gridBody').on('click', '.f-cat-btn', function () {
        rowPicker(this, 'category', function (r, row, $tr) {
            r.CAT = row.CAT; r.CategoryName = row.DESCN || '';
            $tr.find('.f-cat').val(r.CAT); $tr.find('.f-catname').val(r.CategoryName);
        });
    });
    $('#gridBody').on('click', '.f-sz-btn', function () {
        rowPicker(this, 'chestsize', function (r, row, $tr) {
            r.SZ_CODE = row.SZ_CODE; r.SzDesc = row.SZ_DESC || '';
            $tr.find('.f-szcode').val(r.SZ_CODE); $tr.find('.f-szdesc').val(r.SzDesc);
        });
    });
    $('#gridBody').on('click', '.f-alloc-btn', function () {
        rowPicker(this, 'allocation', function (r, row, $tr) {
            r.ALLOCATION = row.CODE; r.AllocationName = row.DESCN || '';
            $tr.find('.f-alloc').val(r.ALLOCATION); $tr.find('.f-allocname').val(r.AllocationName);
        });
    });

    function rowPicker(btn, key, apply) {
        var $tr = $(btn).closest('tr'), r = findRow($tr.data('cid'));
        if (!r) return;
        openPicker(key, null, function (row) { apply(r, row, $tr); });
    }

    function openPicker(key, $input, onSelect) {
        activePicker = { key: key, input: $input, onSelect: onSelect };
        $('#pickerTitle').text('Select ' + key);
        $('#pickerSearch').val('');
        $('#pickerBody').empty().removeData('rows');
        $('#pickerOverlay, #genericPicker').fadeIn(120);
        loadPickerData('');
        $('#pickerSearch').off('input').on('input', debouncedLoadPickerData);
    }
    function closePicker() { $('#pickerOverlay, .popup-box').fadeOut(120); }

    var debouncedLoadPickerData = debounce(function () { loadPickerData($(this).val()); }, 300);

    function loadPickerData(term) {
        var cfg = pickerConfig[activePicker.key];
        var myReq = ++pickerReqSeq;
        if (pickerXhr) { pickerXhr.abort(); }
        $('#pickerBody').html('<div style="padding:10px;color:#888;">Searching...</div>');
        pickerXhr = $.getJSON(cfg.url, { search: term }, function (data) {
            if (myReq !== pickerReqSeq) return;
            data = data || [];
            var html = '<table><thead><tr>' + cfg.cols.map(function (c) { return '<th>' + c[1] + '</th>'; }).join('') + '</tr></thead><tbody>';
            data.forEach(function (row, i) {
                html += '<tr data-i="' + i + '">' + cfg.cols.map(function (c) { return '<td>' + (row[c[0]] == null ? '' : row[c[0]]) + '</td>'; }).join('') + '</tr>';
            });
            html += '</tbody></table>';
            $('#pickerBody').html(html);
            $('#pickerBody').data('rows', data);
        });
    }

    $('#pickerBody').on('click', 'tr[data-i]', function () {
        var data = $('#pickerBody').data('rows');
        var row = data[$(this).data('i')];
        var cfg = pickerConfig[activePicker.key];
        if (activePicker.onSelect) {
            activePicker.onSelect(row);
        } else if (cfg.target) {
            $('#' + cfg.target).val(row[cfg.cols[0][0]]);
            $('#' + (cfg.dispTarget || cfg.target + '_disp')).val(row[cfg.cols[1][0]] || '');
        }
        closePicker();
        renderTotalsOnly();
    });

    // =========================================================
    // Final Blend picker (header "Blend No" AND each row's own "Blend"
    // button -- see the view-top comment and BlendPackingController's class
    // comment on why every row gets a working picker here).
    // =========================================================
    var blendPickerTarget = 'header'; // 'header' or a row _cid
    function openBlendPicker(target) {
        blendPickerTarget = target;
        $('#pickerOverlay, #blendPicker').fadeIn(120);
        $('#blendPickerSearch').val('');
        loadBlendList('');
        $('#blendPickerSearch').off('input').on('input', debouncedLoadBlendList);
    }
    function closeBlendPicker() { $('#pickerOverlay, .popup-box').fadeOut(120); }

    var debouncedLoadBlendList = debounce(function () { loadBlendList($(this).val()); }, 300);

    $('#MasterBlendNo').on('click focus', function () { openBlendPicker('header'); });
    $('#gridBody').on('click', '.f-blend-btn', function () { openBlendPicker($(this).closest('tr').data('cid')); });

    var blendListXhr = null;
    function loadBlendList(term) {
        if (blendListXhr) { blendListXhr.abort(); }
        $('#blendPickerBody').html('<div style="padding:10px;color:#888;">Searching...</div>');
        blendListXhr = $.getJSON('@Url.Action("GetFinalBlendList", "Packing")', { blendType: $('#BLEND_TYPE').val(), search: term }, function (data) {
            data = data || [];
            var html = '<table><thead><tr><th>Blend No</th><th>Doc No</th><th>Blend Qty</th><th>Packed Qty</th><th>Remaining</th><th>Rate</th></tr></thead><tbody>';
            data.forEach(function (b, i) {
                html += '<tr data-i="' + i + '"><td>' + esc(b.BLEND_NO) + '</td><td>' + esc(b.DOCNO) + '</td>' +
                    '<td style="text-align:right;">' + fmt2(b.BLEND_QTY) + '</td>' +
                    '<td style="text-align:right;">' + fmt2(b.PACKED_QTY) + '</td>' +
                    '<td style="text-align:right;">' + fmt2(b.REMAINING_QTY) + '</td>' +
                    '<td style="text-align:right;">' + fmt2(b.RATE) + '</td></tr>';
            });
            html += '</tbody></table>';
            $('#blendPickerBody').html(html);
            $('#blendPickerBody').data('rows', data);
        });
    }

    $('#blendPickerBody').on('click', 'tr[data-i]', function () {
        var data = $('#blendPickerBody').data('rows') || [];
        var b = data[$(this).data('i')];
        var target = blendPickerTarget;
        closeBlendPicker();

        if (target === 'header') {
            // VB TxtBlendNo_Validate: the picked blend fills Blend Date, Party
            // (code + name), Shipping Mark and the "Balance Qty To Be Packed" label.
            $('#BlendDocNo').val(b.DOCNO);
            $('#BlendDocDt').val((b.DOCDT || '').substring(0, 10));
            $('#MasterBlendNo').val(b.BLEND_NO || '');
            $('#MasterBlendDate').val(fmtDate(b.BLEND_DATE));
            $('#PCODE').val(b.PCODE || '');
            $('#PartyName').val(b.PartyName || '');
            $('#ShipMark').val(b.SHIP_MARK || '');
            $('#balanceHint').text('Balance Qty To Be Packed: ' + fmt2(b.REMAINING_QTY));
            // Auto-populate ONE summary row, same as VB's TxtBlendNo_Validate --
            // only when adding fresh with an empty grid, so re-picking the
            // header blend on an in-progress document never clobbers rows.
            if (!IS_EDIT && rows.length === 0) {
                applyBlendToRow(b.DOCNO, b.DOCDT, null);
            }
        } else {
            applyBlendToRow(b.DOCNO, b.DOCDT, target);
        }
    });

    // Fills one grid row from a picked Final Blend -- a direct port of VB's
    // TxtBlendNo_Validate "If bfmode = 'A'" block (Mark/Grade/Category/Inv No/
    // Bags/Net/Gross/Qty/Rate/Amount/Allocation). The server does the arithmetic,
    // since it is the side that knows how much of the blend is already packed;
    // see BlendPackingController.GetFinalBlendRowValues for the line-by-line map.
    function applyBlendToRow(blendDocNo, blendDocDt, cid) {
        $.get('@Url.Action("GetFinalBlendRowValues", "Packing")', {
            docno: blendDocNo, docdt: (blendDocDt || '').substring(0, 10), blendType: $('#BLEND_TYPE').val(),
            excludeDocNo: $('#DOCNO').val(), excludeDocDt: $('#DOCDT').val()
        }, function (v) {
            if (!v || !v.blendDocNo) { showAlert('Unable to read that Final Blend.'); return; }
            var r = cid ? findRow(cid) : null;
            if (!r) {
                r = { _cid: ++rowSeq };
                rows.push(r);
            }
            r.BLEND_DOCNO = v.blendDocNo;
            r.BLEND_DOCDT = v.blendDocDt;
            r.BlendNo = v.blendNo || '';
            r.MARK = v.mark; r.MarkName = v.markName || '';
            r.GRADE = v.grade; r.GradeName = v.gradeName || '';
            r.CAT = v.cat; r.CategoryName = v.categoryName || '';
            r.INVNO = v.invno;
            r.BAG_CHEST = num(v.bagChest);
            // Gross is the blend's own per-chest gross; the grid's Net Wt column is
            // derived (Gross - Tare), so seed Tare from the pair the blend carries.
            r.GROSS = num(v.grossWt);
            r.TARE = round2(num(v.grossWt) - num(v.netWt));
            r.QTY = num(v.qty);
            r.RATE = num(v.rate);
            r.AMOUNT = num(v.amount);
            r.ALLOCATION = v.allocCode; r.AllocationName = v.allocName || '';
            renderGrid();
            if (v.remainingQty != null) {
                $('#balanceHint').text('Balance Qty To Be Packed: ' + fmt2(v.remainingQty));
            }
        });
    }

    // =========================================================
    // Save (mirrors VB Command1_Click validation order)
    // =========================================================
    $('#btnSave').on('click', function () {
        if (!$('#DOCDT').val()) { showAlert('Doc Date cannot be blank'); return; }
        if (!IS_EDIT) {
            var docDtVal = $('#DOCDT').val(), now = new Date();
            var todayStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
            if (docDtVal > todayStr) { showAlert('Doc Date cannot be a future date'); return; }
            if (BACK_DATE_MIN && docDtVal < BACK_DATE_MIN) { showAlert('Back date entry is not allowed. Doc Date cannot be earlier than ' + BACK_DATE_MIN.split('-').reverse().join('/') + '.'); return; }
        }
        if (!$('#BlendDocNo').val()) { showAlert('Blend No cannot be blank'); return; }
        if (!$('#SaleCentre').val()) { showAlert('Location cannot be blank'); return; }

        var valid = rows.filter(function (r) { return r.MARK; });
        if (!valid.length) { showAlert('Without Grade Detail, Record Can Not be Saved.'); return; }
        if (valid.some(function (r) { return !r.INVNO; })) { showAlert('Invoice No. cannot be blank'); return; }

        var seen = {};
        for (var i = 0; i < valid.length; i++) {
            var k = valid[i].GRADE + '|' + valid[i].INVNO + '|' + valid[i].MARK;
            if (seen[k]) { showAlert('Duplicate Entry'); return; }
            seen[k] = true;
        }

        showConfirm('Are you sure?', function () {
            var model = {
                DOCNO: $('#DOCNO').val(),
                DOCDT: $('#DOCDT').val(),
                BLEND_TYPE: $('#BLEND_TYPE').val(),
                // The Unit actually chosen on the list page's "New" row (or loaded with
                // the record). Left blank the server falls back to its Blend-Type -> Unit
                // guess, which is only ever a stopgap -- see UnitForBlendType's comment.
                UNIT: $('#UNIT_disp').val(),
                BlendDocNo: $('#BlendDocNo').val(),
                BlendDocDt: $('#BlendDocDt').val(),
                SaleCentre: $('#SaleCentre').val(),
                Remarks: $('#Remarks').val(),
                ShortExcess: num($('#ShortExcess').val()),
                Details: valid
            };

            $.ajax({
                url: '@Url.Action("Save", "Packing")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(model),
                success: function (resp) {
                    if (resp.success) {
                        showAlert(resp.message || 'Saved.', function () {
                            window.location.href = '@Url.Action("Index", "Packing")' + '?blendType=' + encodeURIComponent($('#BLEND_TYPE').val());
                        }, 'success');
                    } else {
                        showAlert(resp.message || 'Save failed.', null, resp.warning === false ? 'error' : 'warning');
                    }
                },
                error: function () { showAlert('Save failed - server error.', null, 'error'); }
            });
        });
    });

    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    renderGrid();
    // Re-render once the item list is in, so each row's Item dropdown is filled.
    loadItems().always(function () {
        renderGrid();
        if (IS_VIEW) $('#gridBody select').prop('disabled', true);
    });

    if (IS_VIEW) {
        $('.accordion-container :input').prop('disabled', true);
        $('[data-picker], #MasterBlendNo').off('click focus');
        $('#btnSave').prop('disabled', true);
        $('#btnAddRow, #btnRemoveRows').css({ opacity: .4, pointerEvents: 'none' });
    }
</script>
</body>
</html>
