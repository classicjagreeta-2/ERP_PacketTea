@model PacketTea.Models.PT.BLEND_PACKING_DATA
@using Newtonsoft.Json
@{
    ViewBag.Title = "Packing Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    bool isEdit = ViewBag.IsEdit ?? false;
    // Opened via the list's "View" button -- read-only (see IS_VIEW at the bottom of the script).
    bool isView = ViewBag.IsView ?? false;
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    var head = Model;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (see CLAUDE.md's "lookup pickers" rule) -- same
         jquery.inputpicker include PacketTeaPurchaseEntry/InsertOrUpdate.cshtml already
         uses, replacing this screen's earlier bespoke centered-modal picker. -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        /* Same additions as Master/Final Blend Entry's InsertOrUpdate views. */
        input[readonly] { background-color: #f3f4f7; color: #555; }
        /* purchase-order.css hard-codes .accordion-container to a fixed 350px scroll area --
           see Master Blend Entry's InsertOrUpdate for the rationale. Let the standalone
           Unit / Blend Type strip above Header size to its own content. */
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 80px; }
        /* Lookup cells: the code box itself opens the inputpicker dropdown; the picked name
           shows beside it. Mark gets the widest cell (garden names are long). */
        #gridTable th.col-sl, #gridTable td.col-sl { min-width: 60px; width: 60px; text-align: center; }
        #gridTable th.col-blend, #gridTable td.col-blend { min-width: 160px; }
        #gridTable td.col-blend input { width: 140px; }
        #gridTable td.col-mark { min-width: 320px; }
        #gridTable td.col-grade { min-width: 260px; }
        #gridTable td.col-size { min-width: 210px; }
        #gridTable td.col-mark input, #gridTable td.col-grade input, #gridTable td.col-size input { width: 90px; }
        #gridTable .lk-name { display: inline-block; max-width: 210px; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; margin-left: 6px; color: #555; }
        #gridTable td.col-mark .lk-name { max-width: 220px; }
        /* The plugin wraps a picked cell's input in a div with inline "overflow:auto; height:100%"; inside a
           table cell that can sprout scrollbars, so keep the wrapper exactly the size of its input. */
        #gridTable .inputpicker-div { overflow: hidden !important; height: auto !important; }
        #gridTable .inputpicker-overflow-hidden { overflow: hidden; }
        /* Hidden columns (Alloc / Item / MRP): still rendered so their values round-trip on Save. */
        #gridTable .col-hide { display: none; }
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        #balanceHint { font-size: 12px; color: var(--mbe-muted, #6b7280); padding-top: 6px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />
    <input type="hidden" id="BlendDocNo" value="@head.BlendDocNo" />
    <input type="hidden" id="BlendDocDt" value="@(head.BlendDocDt?.ToString("yyyy-MM-dd"))" />

    <div class="general-container">
        <div class="purchase-details">

            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "Packing")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "Packing")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Packing Entry</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : @(head.DOCNO ?? "")</div>
                    </div>
                </div>
            </div>

            <!-- Unit / Blend Type -- its own section above Header, same as Master Blend Entry's
                 InsertOrUpdate (Packet Type is the same underlying value as Blend Type, so it is not
                 repeated here -- it is still picked on the list page's "New" row). Unit is restricted
                 to what the user picked on the list page (itself scoped to USER_SCHEMA_LINK) and is
                 posted on Save. Blend Type locks read-only once Unit + Packing Type were chosen on the
                 list page (lockedFromList) and in Edit mode. -->
            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit / Blend Type</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                <input type="text" id="UNIT_disp" value="@head.UNIT" readonly />
                            </div>
                                            <div class="form-col-20">
                                <label>Blend Type <span>(*)</span></label>
                                <select id="BLEND_TYPE" @((isEdit || lockedFromList) ? "disabled" : "")>
                                    @foreach (var bt in blendTypes)
                                    {
                                        <option value="@bt.Key" selected="@(bt.Key == head.BLEND_TYPE)">@bt.Value (@bt.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" value="@head.DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Doc Date <span>(*)</span></label>
                                <input type="date" id="DOCDT" value="@(head.DOCDT?.ToString("yyyy-MM-dd"))"
                                       min="@ViewBag.MinDocDate" max="@ViewBag.FyEnd" @(isEdit ? "disabled" : "") />
                            </div>
                            <div class="form-col-20">
                                <label>Blend No <span>(*)</span></label>
                                <input type="text" id="MasterBlendNo" data-picker="blend" value="@head.MasterBlendNo" placeholder="Blend No" />
                                <div id="balanceHint"></div>
                            </div>
                            <div class="form-col-20">
                                <label>Blend Date</label>
                                <input type="text" id="MasterBlendDate" value="@PacketTea.DateText.Display(head.BlendDocDate)" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Party</label>
                                <input type="text" id="PartyName" value="@head.PartyName" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Location <span>(*)</span></label>
                                <input type="text" id="SaleCentre" data-picker="salescentre" value="@head.SaleCentre" placeholder="Code" />
                                <input type="hidden" id="SaleCentre_disp" value="@head.SaleCentreName" />
                            </div>
                            <div class="form-col-20">
                                <label>Shipping Mark</label>
                                <input type="text" id="ShipMark" value="@head.ShipMark" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Short/Excess</label>
                                <input type="number" step="0.01" id="ShortExcess" value="@head.ShortExcess" />
                            </div>
                            <div class="form-col-20">
                                <label>Total Qty</label>
                                <input type="number" id="TotalQty" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-100">
                                <label>Remarks</label>
                                <textarea id="Remarks" style="height:50px;">@head.Remarks</textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header"><span class="txt">Lines</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnAddRow"><i class="fa fa-plus"></i> Add Row</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th class="col-sl">Sl</th>
                                        <th class="col-blend">Blend</th>
                                        <th class="col-mark">Mark <span style="color:red;">(*)</span></th>
                                        <th class="col-grade">Grade <span style="color:red;">(*)</span></th>
                                        <th>Category</th>
                                        <th>Inv No <span style="color:red;">(*)</span></th>
                                        <th style="width:110px;">Pack Date</th>
                                        <th>Season</th>
                                        <th style="width:65px;">Bag</th>
                                        <th style="width:60px;">Chest F</th>
                                        <th style="width:60px;">Chest T</th>
                                        <th style="width:80px;text-align:right;">Gross Wt</th>
                                        <th style="width:80px;text-align:right;">Net Wt</th>
                                        <th style="width:75px;text-align:right;">Tare</th>
                                        <th style="width:85px;text-align:right;">Qty</th>
                                        <th>Batch No</th>
                                        <th style="width:110px;">Mfg Date</th>
                                        <th class="col-size">Size</th>
                                        <th style="width:75px;text-align:right;">Rate</th>
                                        <th style="width:90px;text-align:right;">Amount</th>
                                        <th class="col-hide">Alloc</th>
                                        <th class="col-hide">Item</th>
                                        <th class="col-hide" style="width:60px;">MRP</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="9" style="text-align:right;">Total</td>
                                        <td id="ftBag" style="text-align:right;"></td>
                                        <td colspan="5"></td>
                                        <td id="ftQty" style="text-align:right;"></td>
                                        <td colspan="4"></td>
                                        <td id="ftAmt" style="text-align:right;"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Mark/Grade/Chest Size/Allocation/Sales Centre AND the Final Blend (header Blend No + each
         row's Blend) use jquery.inputpicker (Root UI convention -- see CLAUDE.md's "lookup
         pickers" rule), which renders its own anchored dropdown next to the field itself -- no
         shared modal markup needed. -->

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
    function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) {
        $('#appAlertTitle').text('Notice');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').hide();
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onOk) onOk(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function showConfirm(message, onYes) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', closeAppAlert);
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onYes) onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }

    $('#appAlertOverlay, #appAlertBox').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    var rows = @Html.Raw(JsonConvert.SerializeObject(Model.Details));
    var rowSeq = 0;
    rows.forEach(function (r) { r._cid = ++rowSeq; });

    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
    }
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    // HTML-escape a value going into a built attribute/text (names such as "M&M TEA" or a
    // stray quote would otherwise break the row markup).
    function esc(v) {
        return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function round2(v) { return Math.round(num(v) * 100) / 100; }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r, idx) {
            r.SL_NO = String(idx + 1);
            var net = round2((r.GROSS || 0) - (r.TARE || 0));
            totBag += num(r.BAG_CHEST);
            totQty += num(r.QTY);
            totAmt += num(r.AMOUNT);
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" /></td>');
            tr.append('<td class="col-sl">' + r.SL_NO + '</td>');
            // Blend: the box itself is the Final Blend dropdown (Blend No shown; a saved line that
            // only carries the blend's Doc No shows that until another blend is picked).
            tr.append('<td class="col-blend"><input type="text" class="f-blend" value="' + esc(r.BlendNo || r.BLEND_DOCNO) + '" placeholder="Blend No" /></td>');
            // Lookup cells: the code box is itself the inputpicker dropdown (no "..." button);
            // the picked name is shown beside it.
            tr.append('<td class="col-mark"><input type="text" class="f-mark" value="' + esc(r.MARK) + '" placeholder="Code" />' +
                '<span class="lk-name f-mark-name" title="' + esc(r.MarkName) + '">' + esc(r.MarkName) + '</span></td>');
            tr.append('<td class="col-grade"><input type="text" class="f-grade" value="' + esc(r.GRADE) + '" placeholder="Code" />' +
                '<span class="lk-name f-grade-name" title="' + esc(r.GradeName) + '">' + esc(r.GradeName) + '</span></td>');
            tr.append('<td><input type="text" class="f-cat" value="' + (r.CAT || '') + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-invno" value="' + (r.INVNO || '') + '" maxlength="10" /></td>');
            tr.append('<td><input type="date" class="f-packdate" value="' + (r.PACK_DATE ? r.PACK_DATE.substring(0, 10) : '') + '" /></td>');
            tr.append('<td><input type="text" class="f-season" value="' + (r.SEASON || '') + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-bag" value="' + (r.BAG_CHEST || 0) + '" /></td>');
            tr.append('<td><input type="number" class="f-chestf" value="' + (r.CHESTSLF || 0) + '" /></td>');
            tr.append('<td><input type="number" class="f-chestt" value="' + (r.CHESTSLT || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-gross" value="' + (r.GROSS || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-net" value="' + net + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-tare" value="' + (r.TARE || 0) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-qty" value="' + (r.QTY || 0) + '" /></td>');
            tr.append('<td><input type="text" class="f-batchno" value="' + (r.BATCHNO || '') + '" /></td>');
            tr.append('<td><input type="date" class="f-mfgfrom" value="' + (r.MFG_FROM ? r.MFG_FROM.substring(0, 10) : '') + '" /></td>');
            tr.append('<td class="col-size"><input type="text" class="f-szcode" value="' + esc(r.SZ_CODE) + '" placeholder="Code" />' +
                '<span class="lk-name f-sz-name" title="' + esc(r.SzDesc) + '">' + esc(r.SzDesc) + '</span></td>');
            tr.append('<td><input type="number" step="0.01" class="f-rate" value="' + (r.RATE || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-amount" value="' + (r.AMOUNT || 0) + '" readonly /></td>');
            // Alloc / Item / MRP are hidden columns -- kept in the DOM so their values still Save.
            tr.append('<td class="col-hide"><input type="text" class="f-alloc" value="' + esc(r.ALLOCATION) + '" /></td>');
            tr.append('<td class="col-hide"><input type="text" class="f-itcd" value="' + esc(r.ITCD) + '" /></td>');
            tr.append('<td class="col-hide"><input type="text" class="f-mrp" value="' + esc(r.MRP) + '" /></td>');
            $tb.append(tr);
        });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(round2(totAmt));
        $('#TotalQty').val(round2(totQty + num($('#ShortExcess').val())));
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    $('#gridBody').on('input change', 'input', function () {
        var $tr = $(this).closest('tr');
        var r = findRow($tr.data('cid'));
        if (!r) return;
        r.MARK = $tr.find('.f-mark').val();
        r.GRADE = $tr.find('.f-grade').val();
        r.INVNO = $tr.find('.f-invno').val();
        r.PACK_DATE = $tr.find('.f-packdate').val() || null;
        r.SEASON = $tr.find('.f-season').val();
        r.CHESTSLF = num($tr.find('.f-chestf').val());
        r.CHESTSLT = num($tr.find('.f-chestt').val());
        r.BATCHNO = $tr.find('.f-batchno').val();
        r.MFG_FROM = $tr.find('.f-mfgfrom').val() || null;
        r.SZ_CODE = $tr.find('.f-szcode').val();
        r.ALLOCATION = $tr.find('.f-alloc').val();
        r.ITCD = $tr.find('.f-itcd').val();
        r.MRP = $tr.find('.f-mrp').val();

        var netWt = num($tr.find('.f-net').val());
        r.BAG_CHEST = num($tr.find('.f-bag').val());
        r.GROSS = num($tr.find('.f-gross').val());

        // Bag/NetWt drive Qty; Gross/NetWt drive Tare -- same recompute chain
        // as VB's DATAGRID1_BeforeColUpdate (Case BAGS/NETWT/grosswt), just
        // collapsed into one handler. A direct edit to Qty itself overrides
        // the computed value (matches Master/Final Blend Entry's f-qty/f-bag
        // precedence).
        if ($(this).hasClass('f-qty')) {
            r.QTY = num($tr.find('.f-qty').val());
        } else if ($(this).hasClass('f-bag') || $(this).hasClass('f-net')) {
            r.QTY = round2(r.BAG_CHEST * netWt);
            $tr.find('.f-qty').val(r.QTY);
        } else {
            r.QTY = num($tr.find('.f-qty').val());
        }
        r.TARE = round2(r.GROSS - netWt);
        $tr.find('.f-tare').val(r.TARE);

        if (($(this).hasClass('f-chestf') || $(this).hasClass('f-bag')) && r.CHESTSLF) {
            r.CHESTSLT = r.CHESTSLF + r.BAG_CHEST - 1;
            $tr.find('.f-chestt').val(r.CHESTSLT);
        }

        r.AMOUNT = round2(r.QTY * num($tr.find('.f-rate').val()));
        r.RATE = num($tr.find('.f-rate').val());
        $tr.find('.f-amount').val(r.AMOUNT);

        renderTotalsOnly();
    });

    function renderTotalsOnly() {
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r) { totBag += num(r.BAG_CHEST); totQty += num(r.QTY); totAmt += num(r.AMOUNT); });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(round2(totAmt));
        $('#TotalQty').val(round2(totQty + num($('#ShortExcess').val())));
    }
    $('#ShortExcess').on('input change', renderTotalsOnly);

    $('#btnAddRow').on('click', function () {
        rows.push({ _cid: ++rowSeq, BAG_CHEST: 0, QTY: 0, GROSS: 0, TARE: 0, RATE: 0, AMOUNT: 0 });
        renderGrid();
    });
    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });
    $('#btnRemoveRows').on('click', function () {
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        renderGrid();
    });

    // =========================================================
    // Header/row field lookups -- jquery.inputpicker (Root UI convention: an anchored,
    // paginated picker under the field itself -- see CLAUDE.md's "lookup pickers" rule).
    // Replaces this screen's earlier bespoke centered-modal picker (#genericPicker, now
    // removed) -- same pattern as Master/Final Blend Entry's header pickers. Row-level
    // lookups (Mark/Grade/Chest Size/Allocation) anchor to that row's own text input
    // (rowField) since inputpicker needs a real <input>, not the "..." button itself.
    // =========================================================
    // Extra query params sent with every Final Blend dropdown request. inputpicker merges this
    // object into each request as-is, so refreshing the values here is enough (Blend Type can
    // still change on a screen that wasn't opened locked from the list).
    var blendParams = { blendType: '', unit: '' };
    function syncBlendParams() {
        blendParams.blendType = $('#BLEND_TYPE').val() || '';
        blendParams.unit = $('#UNIT_disp').val() || '';
    }
    $('#BLEND_TYPE').on('change', syncBlendParams);

    var pickerConfig = {
        mark: { url: '@Url.Action("GetMark", "Packing")', fields: [{ name: 'MCD', text: 'Code' }, { name: 'MDESC', text: 'Garden/Mark' }], rowField: '.f-mark' },
        grade: { url: '@Url.Action("GetBlendGrade", "Packing")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], rowField: '.f-grade' },
        chestsize: { url: '@Url.Action("GetChestSize", "Packing")', fields: [{ name: 'SZ_CODE', text: 'Code' }, { name: 'SZ_DESC', text: 'Description' }], rowField: '.f-szcode' },
        allocation: { url: '@Url.Action("GetAllocation", "Packing")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'DESCN', text: 'Description' }], rowField: '.f-alloc' },
        salescentre: { url: '@Url.Action("GetSalesCentre", "Packing")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'SaleCentre' },
        // Final Blend (header Blend No + each row's Blend). Blends already fully packed are not
        // offered by the API. 'creatable' keeps a saved line's existing value in the box even
        // when that blend is no longer in the (remaining > 0) list, instead of swapping in the
        // first row; only an actual pick applies anything (see onPick / rowLookups).
        blend: {
            url: '@Url.Action("GetFinalBlendList", "Packing")',
            fields: [{ name: 'BLEND_NO', text: 'Blend No' }, { name: 'DOCNO', text: 'Doc No' }, { name: 'BLEND_QTY', text: 'Blend Qty' },
                     { name: 'PACKED_QTY', text: 'Packed' }, { name: 'REMAINING_QTY', text: 'Remaining' }, { name: 'RATE', text: 'Rate' }],
            urlParam: blendParams, pageLimit: 20, selectMode: 'creatable',
            onPick: function (b) { applyHeaderBlend(b); }
        }
    };

    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });
    // Row lookups: the row's own box is the dropdown -- clicking/focusing it (or typing in it)
    // opens the inputpicker anchored right under it, no separate "..." button.
    var rowLookups = [
        { sel: '.f-blend',  key: 'blend',     apply: function (r, row) { r.BlendNo = row.BLEND_NO || ''; applyBlendToRow(row.DOCNO, row.DOCDT, r._cid); } },
        { sel: '.f-mark',   key: 'mark',      apply: function (r, row, $tr) { r.MARK = row.MCD; r.MarkName = row.MDESC || ''; $tr.find('.f-mark').val(row.MCD); $tr.find('.f-mark-name').text(r.MarkName).attr('title', r.MarkName); } },
        { sel: '.f-grade',  key: 'grade',     apply: function (r, row, $tr) { r.GRADE = row.CODE; r.GradeName = row.NAME || ''; $tr.find('.f-grade').val(row.CODE); $tr.find('.f-grade-name').text(r.GradeName).attr('title', r.GradeName); } },
        { sel: '.f-szcode', key: 'chestsize', apply: function (r, row, $tr) { r.SZ_CODE = row.SZ_CODE; r.SzDesc = row.SZ_DESC || ''; $tr.find('.f-szcode').val(row.SZ_CODE); $tr.find('.f-sz-name').text(r.SzDesc).attr('title', r.SzDesc); } }
    ];
    rowLookups.forEach(function (lk) {
        // inputpicker clones the input it is attached to (classes included, e.g. "f-blend") and
        // shows the clone; the clone must NOT match here, or clicking it would attach a second
        // picker inside the first and stack up wrappers/scrollbars in the cell.
        $('#gridBody').on('click focus', lk.sel + ':not(.inputpicker-input)', function () {
            var $in = $(this), $tr = $in.closest('tr'), r = findRow($tr.data('cid'));
            if (!r) return;
            openPicker(lk.key, $in, function (row) { lk.apply(r, row, $tr); });
        });
    });

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the
    // plugin writes the picked value into the original input and fires "change" on it; it does
    // not hand the row to a select handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    function openPicker(key, $input, onSelect) {
        var cfg = pickerConfig[key];
        $('.inputpicker-wrapped-list').remove();

        if ($input.data('inputpicker')) {
            $input.inputpicker('show');
            return;
        }

        if (cfg.urlParam) syncBlendParams();
        var opts = {
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: cfg.pageLimit || 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 150      // small debounce: one request per pause in typing, not per keystroke
        };
        if (cfg.urlParam) opts.urlParam = cfg.urlParam;
        if (cfg.selectMode) opts.selectMode = cfg.selectMode;
        $input.inputpicker(opts);

        function deliver(row) {
            if (!row) return;
            if (onSelect) {
                onSelect(row);
            } else if (cfg.onPick) {
                cfg.onPick(row);
            } else if (cfg.target) {
                $('#' + cfg.target).val(row[cfg.fields[0].name]);
                $('#' + cfg.target + '_disp').val(row[cfg.fields[1].name] || '');
            }
            renderTotalsOnly();
        }
        // Both hooks call the same idempotent handler, so whichever this plugin build fires works.
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
    }

    // =========================================================
    // Final Blend dropdown (header "Blend No" AND each row's own "Blend").
    // A pick on the header fills the header; a pick on a row fills that row (see rowLookups).
    // =========================================================
    function applyHeaderBlend(b) {
        $('#BlendDocNo').val(b.DOCNO);
        $('#BlendDocDt').val(b.DOCDT);
        $('#MasterBlendNo').val(b.BLEND_NO || '');
        $('#MasterBlendDate').val(fmtDate(b.BLEND_DATE));
        $('#PartyName').val(b.PartyName || '');
        $('#ShipMark').val(b.SHIP_MARK || '');
        $('#balanceHint').text('Balance Qty To Be Packed: ' + b.REMAINING_QTY);
        // Auto-populate ONE summary row, same as VB's TxtBlendNo_Validate --
        // only when adding fresh with an empty grid, so re-picking the
        // header blend on an in-progress document never clobbers rows.
        if (!IS_EDIT && rows.length === 0) {
            applyBlendToRow(b.DOCNO, b.DOCDT, null);
        }
    }

    function applyBlendToRow(blendDocNo, blendDocDt, cid) {
        $.get('@Url.Action("GetFinalBlendRowValues", "Packing")', {
            docno: blendDocNo, docdt: blendDocDt, blendType: $('#BLEND_TYPE').val(), unit: $('#UNIT_disp').val(),
            excludeDocNo: $('#DOCNO').val(), excludeDocDt: $('#DOCDT').val()
        }, function (v) {
            if (!v) return;
            var r = cid ? findRow(cid) : null;
            if (!r) {
                r = { _cid: ++rowSeq };
                rows.push(r);
            }
            r.BlendNo = v.blendNo || '';
            r.BLEND_DOCNO = v.blendDocNo;
            r.BLEND_DOCDT = v.blendDocDt;
            r.MARK = v.mark; r.MarkName = v.markName;
            r.GRADE = v.grade; r.GradeName = v.gradeName;
            r.CAT = v.cat;
            r.INVNO = v.invno;
            r.BAG_CHEST = v.bagChest;
            r.GROSS = v.grossWt; // GrossWt seeded from the blend's own value; Net is what the header field represents
            r.TARE = round2(v.grossWt - v.netWt);
            r.QTY = v.qty;
            r.RATE = v.rate;
            r.AMOUNT = v.amount;
            r.ALLOCATION = v.allocCode;
            renderGrid();
        });
    }

    // =========================================================
    // Save (mirrors VB Command1_Click validation order)
    // =========================================================
    $('#btnSave').on('click', function () {
        if (!$('#DOCDT').val()) { showAlert('Doc Date cannot be blank'); return; }
        if (!$('#BlendDocNo').val()) { showAlert('Blend No cannot be blank'); return; }
        if (!$('#SaleCentre').val()) { showAlert('Location cannot be blank'); return; }

        var valid = rows.filter(function (r) { return r.MARK; });
        if (!valid.length) { showAlert('Without Grade Detail, Record Can Not be Saved.'); return; }
        if (valid.some(function (r) { return !r.INVNO; })) { showAlert('Invoice No. cannot be blank'); return; }

        var seen = {};
        for (var i = 0; i < valid.length; i++) {
            var k = valid[i].GRADE + '|' + valid[i].INVNO + '|' + valid[i].MARK;
            if (seen[k]) { showAlert('Duplicate Entry'); return; }
            seen[k] = true;
        }

        showConfirm('Are you sure?', function () {
            var model = {
                DOCNO: $('#DOCNO').val(),
                DOCDT: $('#DOCDT').val(),
                BLEND_TYPE: $('#BLEND_TYPE').val(),
                // The Unit picked on the list (new) / the record's own Unit (edit) -- stored
                // as-is; the server checks a new document's Unit against the user's units.
                UNIT: $('#UNIT_disp').val(),
                BlendDocNo: $('#BlendDocNo').val(),
                BlendDocDt: $('#BlendDocDt').val(),
                SaleCentre: $('#SaleCentre').val(),
                Remarks: $('#Remarks').val(),
                ShortExcess: num($('#ShortExcess').val()),
                Details: valid,
                IsNew: !IS_EDIT
            };

            $.ajax({
                url: '@Url.Action("Save", "Packing")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(model),
                success: function (resp) {
                    if (resp.success) {
                        showAlert(resp.message || 'Saved.', function () {
                            window.location.href = '@Url.Action("Index", "Packing")' + '?blendType=' + encodeURIComponent($('#BLEND_TYPE').val());
                        });
                    } else {
                        showAlert(resp.message || 'Save failed.');
                    }
                },
                error: function () { showAlert('Save failed - server error.'); }
            });
        });
    });

    renderGrid();

    // View mode (list page "View" button): runs after the first renderGrid() has built every grid
    // row, then disables the header fields, the whole grid and the Save / row buttons.
    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    if (IS_VIEW) {
        $('.accordion-container :input').prop('disabled', true);
        $('#btnSave').prop('disabled', true).css({ opacity: .4, cursor: 'not-allowed' });
        $('#btnAddRow, #btnRemoveRows').css({ opacity: .4, 'pointer-events': 'none' });
    }
</script>
</body>
</html>
