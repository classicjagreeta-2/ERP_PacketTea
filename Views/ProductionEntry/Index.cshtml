@using PacketTea.Utility
@model List<Finance.Controllers.TEA.ProdDocRow>

@{
    ViewBag.Title = "Production Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var types = (Dictionary<string, string>)ViewBag.Types;
    var unitList = (List<PacketTea.Models.PT.UnitOption>)ViewBag.UnitList ?? new List<PacketTea.Models.PT.UnitOption>();
}

@{
    Func<string, string, MvcHtmlString> SortTh = (key, label) =>
    {
        var cur = (string)(ViewBag.SortBy ?? "");
        var dir = (string)(ViewBag.SortDir ?? "");
        var active = string.Equals(cur, key, StringComparison.OrdinalIgnoreCase);
        var next = (active && dir == "asc") ? "desc" : "asc";
        var thClass = active ? "sortable is-sorted" : "sortable";
        var up = (active && dir == "asc") ? "feather icon-arrow-up on" : "feather icon-arrow-up";
        var down = (active && dir != "asc") ? "feather icon-arrow-down on" : "feather icon-arrow-down";
        return MvcHtmlString.Create(
            "<th class=\"" + thClass + "\" data-sort=\"" + key + "\" data-dir=\"" + next +
            "\" title=\"Sort by " + label + "\"><span class=\"th-label\">" + label +
            "</span><span class=\"sort-arrows\"><i class=\"" + up + "\"></i><i class=\"" +
            down + "\"></i></span></th>");
    };
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <style>
        .table.table-sm td, .table.table-sm th { padding: 0.6rem; }
        tbody div { overflow: unset !important; height: auto !important; max-height: none !important; }
        .btn-link { font-weight: 500; color: black; border-radius: 0; }
        table.main-table th, table.main-table td {
            padding: 6px; font-size: 12px; line-height: 1.3;
            height: 30px; box-sizing: border-box; vertical-align: middle;
        }
        table.main-table td .row-check { margin: 0; vertical-align: middle; }
        .table-responsive thead th.sortable { cursor: pointer; user-select: none; }
        .table-responsive thead th.sortable:hover { background-color: #4b5b7a; }
        .table-responsive thead th.is-sorted { background-color: #4b5b7a; }
        th.sortable .sort-arrows { margin-left: 6px; white-space: nowrap; }
        th.sortable .sort-arrows i { font-size: 12px; color: rgba(255,255,255,.45); vertical-align: middle; }
        th.sortable .sort-arrows i.on { color: #fff; }
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        table.main-table td .row-expand-btn { font-size: 12px; line-height: 1.3; }
        table.detail-sub-table { width: 100%; border-collapse: collapse; }
        table.detail-sub-table th, table.detail-sub-table td { border: 1px solid #ddd; padding: 6px; white-space: nowrap; }
        table.detail-sub-table thead th { background-color: #404e68; color: #fff; font-weight: bold; }
        /* LIST badge at the right end of the toolbar -- same look as Packing / Master / Final Blend Entry. */
        .list-badge { display: inline-block; background: #2c3958; color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .05em; padding: 5px 10px; margin: 0 10px; border-radius: 4px; }
        /* Chunked list (same behaviour as ERP_Inventory's Purchase Order list): fixed-height
           scroll box with a sticky header; the next chunk of rows loads when the box is
           scrolled to the bottom -- see Scripts/list-infinite-scroll.js. */
        #tableScroll { max-height: calc(100vh - 380px); min-height: 240px; overflow: auto; }
        .dataTables_info { padding: 10px 20px 0; color: #6b7280; font-size: 12.5px; }
        tr.new-entry-row td { background-color: #eef3ff; vertical-align: middle; }
        tr.new-entry-row input.new-row-pick { border: 1px solid #dde2ea; border-radius: 6px; padding: 6px 8px; font-size: 13px; width: 100%; box-sizing: border-box; }
        /* jquery.inputpicker wraps each input in a div with inline overflow:auto; inside the
           narrow cell the input + arrow overflow it and native scrollbars blow the row up. Clip it. */
        tr.new-entry-row .inputpicker-overflow-hidden, tr.new-entry-row .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        tr.new-entry-row input.new-row-pick { min-width: 240px; }
        #inputpicker-wrapped-list { min-width: 300px; }
        tr.new-entry-row .go-new { font-size: 15px; cursor: not-allowed; color: #aab2c0; }
        tr.new-entry-row .go-new.is-ready { cursor: pointer; color: #404e68; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="action-btns">
            <ul>
                <li><a href="@Url.Action("Index", "Menu")"><i class="fa fa-arrow-left"></i> Back</a></li>
                <li>
                    <a href="javascript:void(0)" id="btnNew"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Add ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-plus"></i> New
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="editBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-pencil"></i> Edit
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="deleteBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Delete ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-trash-o"></i> Delete
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="viewBtn"
                       style="@(!((ViewBag.Permission as PacketTea.Helpers.AEDV)?.View ?? false) ? "pointer-events:none; opacity:0.5;" : "")">
                        <i class="fa fa-eye"></i> View
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="linesBtn" title="Show the ticked row's lines">
                        <i class="fa fa-list"></i> Lines
                    </a>
                </li>
                <li style="margin-left:auto">
                    <span class="list-badge">LIST</span>
                </li>
            </ul>
        </div>

        <div class="title-heading">Production Entry</div>

        <div style="display: flex; justify-content: flex-end; width: 100%; margin-bottom: 15px;">
            <div style="position: relative; width: 250px;">
                <input type="text" id="searchInput" value="@ViewBag.CurrentFilter" placeholder="Search Doc No"
                       style="width: 100%; padding: 6px 40px 6px 10px; border: 1px solid #ccc; border-radius: 4px;" />
                <i class="fa fa-search" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #333;"></i>
            </div>
        </div>

        <div class="table-responsive" id="tableScroll">
            <table class="border main-table" id="prodTable">
                <thead>
                    <tr>
                        <th style="width:26px;"></th>
                        <th style="width:26px;"></th>
                        <th>Unit</th>
                        @SortTh("DOCNO", "Doc No")
                        @SortTh("DOCDT", "Date")
                        <th>Item</th>
                        <th>MRP</th>
                        <th>Batch No</th>
                        <th>Mfg Date</th>
                        <th style="text-align:right;">Prod Qty</th>
                        <th style="text-align:right;">Gross Wt</th>
                        <th style="text-align:right;">Net Wt</th>
                    </tr>
                </thead>
                <tbody id="listBody">
                    @Html.Partial("_ListRows", Model)
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr><td colspan="12" style="text-align:center;">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            int pageSize = (int)ViewBag.PageSize;
            int rowCount = (int)ViewBag.RowCount;
        }
        <div id="listLoading" style="display:none;text-align:center;padding:8px 0 0;color:#6b7280;font-size:12.5px;">Loading...</div>
        <div class="dataTables_info">Showing <span id="shownCount">@(Model?.Count ?? 0)</span> of @rowCount</div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <script src="~/Scripts/list-new-row-pickers.js"></script>
    <script src="~/Scripts/list-infinite-scroll.js"></script>
    <script>
        // In-app Notice/Confirm popup (same as the entry screen) instead of the browser's
        // native alert()/confirm(), which shows as "localhost says...".
        $('#appAlertOverlay, #appAlertBox').appendTo(document.body);
        function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
        function showAlert(message) {
            $('#appAlertTitle').text('Notice');
            $('#appAlertMessage').text(message || '');
            $('#appAlertCancel').hide();
            $('#appAlertOk').off('click').on('click', closeAppAlert);
            $('#appAlertOverlay, #appAlertBox').fadeIn(120);
        }
        function showConfirm(message, onYes) {
            $('#appAlertTitle').text('Confirm');
            $('#appAlertMessage').text(message || '');
            $('#appAlertCancel').show().off('click').on('click', closeAppAlert);
            $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); onYes(); });
            $('#appAlertOverlay, #appAlertBox').fadeIn(120);
        }

        // TEMPORARY diagnostic -- shows which Oracle schema (x-database header, see
        // Services.SalesGetAsync/SalesPostAsync) this session's TB Sales API calls
        // actually connect as (CLASSIC_CONTROL.SCHEMA_SALES for the selected company/
        // location, e.g. "FIN_JSTIL2027"), NOT the unit's normal getDbName schema.
        // Same pattern as MasterBlendEntry/Index.cshtml's own diagnostic. Safe to
        // remove once you've confirmed the schema name in the browser console.
        console.log('[ProductionEntry diag] x-database (Sales schema) for this session: ' +
            @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(SessionHelper.GetUser()?.Salesdb ?? "(null/empty -- Salesdb is not set for this session)")));
        $(function () {
            var searchTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () { reload(); }, 400);
            });

            // A search / header-sort click reloads the page from the first chunk; the current sort
            // (and Unit / Type filter, when the URL carried one) travels with every further chunk
            // (initInfiniteList's `extra`) so they stay in order.
            var SORT_BY = '@(ViewBag.SortBy ?? "")', SORT_DIR = '@(ViewBag.SortDir ?? "")';
            function reload(sortBy, sortDir) {
                var by = (sortBy === undefined) ? SORT_BY : sortBy;
                var dir = (sortDir === undefined) ? SORT_DIR : sortDir;
                window.location.href = '@Url.Action("Index", "ProductionEntry")'
                    + '?searchString=' + encodeURIComponent($('#searchInput').val())
                    + '&sortBy=' + encodeURIComponent(by || '')
                    + '&sortDir=' + encodeURIComponent(dir || '');
            }

            $('#prodTable').on('click', 'thead th.sortable', function () {
                reload($(this).data('sort'), $(this).data('dir'));
            });

            // Chunked loading: the first chunk is rendered with the page, further chunks are
            // appended as the list is scrolled to the bottom (Scripts/list-infinite-scroll.js).
            initInfiniteList({
                scroll: '#tableScroll', body: '#listBody', loading: '#listLoading', count: '#shownCount',
                url: '@Url.Action("Index", "ProductionEntry")',
                search: $('#searchInput').val(), pageSize: @pageSize, total: @rowCount, startPage: 1,
                extra: {
                    sortBy: SORT_BY, sortDir: SORT_DIR,
                    unit: '@(ViewBag.Unit ?? "")', type: '@(ViewBag.Type ?? "")'
                }
            });

            // "+" toggle -- reveals the document's detail fields (those the list doesn't show).
            // Every open re-fetches them via GetRowDetail (the API's lean GetRowLines) instead of
            // trusting what was rendered at page load. Delegated so rows appended by later chunks work.
            function openDetail($btn) {
                var $detail = $('#' + $btn.data('target'));
                $detail.show();
                $btn.removeClass('fa-plus').addClass('fa-minus');
                var $body = $detail.find('.detail-items-body');
                $.get('@Url.Action("GetRowDetail", "ProductionEntry")', {
                    docno: $detail.data('docno'),
                    unit: $detail.data('unit')
                }).done(function (r) {
                    if (!r || !r.success) {
                        $body.html('<tr><td colspan="5" style="text-align:center;color:#666;">Unable to load lines.</td></tr>');
                        return;
                    }
                    var items = r.rows || [];
                    if (items.length === 0) {
                        $body.html('<tr><td colspan="5" style="text-align:center;color:#666;">No lines</td></tr>');
                        return;
                    }
                    $body.empty();
                    items.forEach(function (d) {
                        $('<tr>').append(
                            $('<td>').text(d.itcd || ''),
                            $('<td>').text(d.shift || ''),
                            $('<td>').text(d.timeFrom || ''),
                            $('<td>').text(d.timeTo || ''),
                            $('<td style="text-align:right;">').text(Number(d.gainLoss || 0).toFixed(3))
                        ).appendTo($body);
                    });
                }).fail(function () {
                    $body.html('<tr><td colspan="5" style="text-align:center;color:#666;">Unable to load lines.</td></tr>');
                });
            }
            function closeDetail($btn) {
                $('#' + $btn.data('target')).hide();
                $btn.removeClass('fa-minus').addClass('fa-plus');
            }
            $('#prodTable').on('click', '.row-expand-btn', function () {
                var $btn = $(this);
                if ($('#' + $btn.data('target')).is(':visible')) closeDetail($btn); else openDetail($btn);
            });

            // "New" inline row -- pick Unit + Type here first (Type is a fixed single
            // option for this module -- Production Entry has no real "type" axis in the
            // legacy form -- shown purely so this list matches Master Blend Entry's
            // Unit+Type "New" row shape). Unit + Type are inputpicker dropdowns (searchable by
            // Code and Name) over the user's permitted units / types, initialised right after
            // the row is inserted -- see initNewRowPickers(). (The shared script keys the type
            // box as #newRowPacketType, so it keeps that id here.)
            var UNIT_LIST = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitList));
            var TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(types));

            function buildNewRow() {
                return '<tr id="newUnitRow" class="new-entry-row">' +
                    '<td colspan="2" style="text-align:center;"><i class="fa fa-pencil go-new" title="Open Production Entry"></i></td>' +
                    // Unit picker spans 3 columns (Doc No / Date) so the "CODE - Name" text isn't clipped.
                    '<td colspan="3"><input type="text" id="newRowUnit" class="new-row-pick" placeholder="Select Unit" autocomplete="off" /></td>' +
                    '<td colspan="2"><input type="text" id="newRowPacketType" class="new-row-pick" placeholder="Select Type" autocomplete="off" /></td>' +
                    '<td colspan="5"></td>' +
                    '</tr>';
            }

            function refreshGoNewState() {
                var ready = !!$('#newRowUnit').val() && !!$('#newRowPacketType').val();
                $('.go-new').toggleClass('is-ready', ready);
            }

            $('#btnNew').on('click', function () {
                if ($('#newUnitRow').length) return;
                $('#listBody').prepend(buildNewRow());
                initNewRowPickers({ units: UNIT_LIST, types: TYPES });   // also pre-selects a single Unit
                refreshGoNewState();
            });

            $('#prodTable').on('change', '#newRowUnit, #newRowPacketType', refreshGoNewState);

            $('#prodTable').on('click', '.go-new', function () {
                var unit = $('#newRowUnit').val(), type = $('#newRowPacketType').val();
                if (!unit) { showAlert('Please select Unit first'); return; }
                if (!type) { showAlert('Please select Type first'); return; }
                window.location.href = '@Url.Action("InsertOrUpdate", "ProductionEntry")'
                    + '?unit=' + encodeURIComponent(unit)
                    + '&type=' + encodeURIComponent(type);
            });

            function getSingleChecked(action) {
                var $c = $('.row-check:checked');
                if ($c.length === 0) { showAlert('Please select a record to ' + action + '.'); return null; }
                if ($c.length > 1) { showAlert('Please select only one record to ' + action + '.'); return null; }
                return $c;
            }

            // Toolbar buttons act on the ticked row. The row's Unit travels with Edit/View/Delete/"+":
            // a Doc No repeats across units, so the document is identified by Doc No + Unit.
            $('#editBtn').on('click', function () {
                var $c = getSingleChecked('edit');
                if (!$c) return;
                window.location.href = '@Url.Action("InsertOrUpdate", "ProductionEntry")'
                    + '?docno=' + encodeURIComponent($c.val()) + '&unit=' + encodeURIComponent($c.data('unit'));
            });

            $('#deleteBtn').on('click', function () {
                var $c = getSingleChecked('delete');
                if (!$c) return;
                showConfirm('Are you sure you want to delete Doc No ' + $c.val() + ' ?', function () {
                    $('<form>', { method: 'POST', action: '@Url.Action("Delete", "ProductionEntry")' })
                        .append($('<input>', { type: 'hidden', name: 'docno', value: $c.val() }))
                        .append($('<input>', { type: 'hidden', name: 'unit', value: $c.data('unit') }))
                        .appendTo('body').submit();
                });
            });

            $('#viewBtn').on('click', function () {
                var $c = getSingleChecked('view');
                if (!$c) return;
                window.location.href = '@Url.Action("InsertOrUpdate", "ProductionEntry")'
                    + '?docno=' + encodeURIComponent($c.val()) + '&unit=' + encodeURIComponent($c.data('unit')) + '&view=true';
            });

            // Lines: open the ticked row's "+" expand panel (its detail fields) and scroll it into view.
            $('#linesBtn').on('click', function () {
                var $c = getSingleChecked('view its lines');
                if (!$c) return;
                var $btn = $c.closest('tr').find('.row-expand-btn');
                if ($btn.hasClass('fa-plus')) $btn.trigger('click');
                var $detail = $('#' + $btn.data('target'));
                if ($detail.length && $detail[0].scrollIntoView) $detail[0].scrollIntoView({ block: 'nearest' });
            });
        });
    </script>
</body>
</html>
