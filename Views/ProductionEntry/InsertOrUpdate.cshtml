@model PacketTea.Models.PT.T_PROD_DATA
@using Newtonsoft.Json
@{
    ViewBag.Title = "Production Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var types = (Dictionary<string, string>)ViewBag.Types;
    bool isEdit = ViewBag.IsEdit ?? false;
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    bool isView = ViewBag.IsView ?? false;
    var head = Model.T_PROD;
    string newType = (string)ViewBag.NewType;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (see CLAUDE.md's "lookup pickers" rule) -- the same
         jquery.inputpicker include PacketTeaPurchaseEntry / Packing / AWR use, replacing this
         screen's earlier bespoke centered-modal Item picker (#genericPicker). -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        input[readonly] { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        input[type="number"], #MRP { text-align: right; }
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />
    <input type="hidden" id="ID" value="@head.ID" />

    <div class="general-container">
        <div class="purchase-details">

            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "ProductionEntry")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "ProductionEntry")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Production Entry</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : @(head.DOCNO ?? "")</div>
                    </div>
                </div>
            </div>

            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit / Type</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                <input type="text" id="UNIT_disp" value="@head.UNIT" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Type <span>(*)</span></label>
                                <select id="TYPE" disabled>
                                    @foreach (var t in types)
                                    {
                                        <option value="@t.Key" selected="@(t.Key == newType)">@t.Value (@t.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" value="@head.DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Date <span>(*)</span></label>
                                <input type="date" id="DATE_ORA" value="@(head.DATE_ORA?.ToString("yyyy-MM-dd"))"
                                       min="@ViewBag.MinDocDate" max="@ViewBag.FyEnd" />
                            </div>
                            <div class="form-col-20">
                                <label>Item <span>(*)</span></label>
                                <input type="text" id="ITCD" data-picker="item" value="@head.ITCD" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Item Name</label>
                                <input type="text" id="ITCD_disp" value="@head.ItemName" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>MRP <span>(*)</span></label>
                                <input type="text" inputmode="decimal" id="MRP" value="@head.MRP" placeholder="max 4 chars, e.g. 9.50 / 12.5"
                                       title="MRP is a 4-character code (PROD.MRP / STOCK.MRP), e.g. 9.50, 12.5, 220" />
                            </div>
                            <div class="form-col-20">
                                <label id="lblBatchNo">Batch No. <span>(*)</span></label>
                                <input type="text" id="BATCHNO" value="@head.BATCHNO" maxlength="12" />
                            </div>
                            <div class="form-col-20">
                                <label>Mfg. Dt. <span>(*)</span></label>
                                <input type="date" id="MFGDT" value="@(head.MFGDT?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="form-col-20">
                                <label>Shift</label>
                                <input type="text" id="SHIFT" value="@head.SHIFT" maxlength="2" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Time From</label>
                                <input type="time" id="TIME_FROM" value="@head.TIME_FROM" />
                            </div>
                            <div class="form-col-20">
                                <label>Time To</label>
                                <input type="time" id="TIME_TO" value="@head.TIME_TO" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Production (Pkts/Bags) <span>(*)</span></label>
                                <input type="number" step="0.001" id="PD" value="@(head.PD?.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="form-col-20">
                                <label>Gross Weight (Kg.)</label>
                                <input type="number" step="0.001" id="GROSS_WEIGHT" value="@(head.GROSS_WEIGHT?.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="form-col-20">
                                <label>Net Weight (Kg.)</label>
                                <input type="number" step="0.001" id="NET_WEIGHT" value="@(head.NET_WEIGHT?.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="form-col-20">
                                <label>Gain/Loss (Kg.)</label>
                                <input type="number" step="0.001" id="GAIN_LOSS" value="@(head.GAIN_LOSS?.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
    function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) {
        $('#appAlertTitle').text('Notice');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').hide();
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onOk) onOk(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function showConfirm(message, onYes) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', closeAppAlert);
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onYes) onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function handleLookupFail(jqXHR) {
        if (jqXHR.status === 440) {
            showAlert((jqXHR.responseJSON && jqXHR.responseJSON.message) || 'Your session has expired. Please log in again.',
                function () { window.location.reload(); });
        } else {
            showAlert('Could not load data. Please try again.');
        }
    }

    $('#appAlertOverlay, #appAlertBox').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function round2(v) { return Math.round(num(v) * 100) / 100; }
    // Qty / weights are shown, calculated and posted with exactly 3 decimals.
    function round3(v) { return Math.round(num(v) * 1000) / 1000; }
    function fmt3(v) { return round3(v).toFixed(3); }

    // PROD.MRP is VARCHAR2(4) and is matched as text against STOCK.MRP, so it is
    // kept exactly as typed (no rounding/reformatting) and limited to 4 chars.
    $('#MRP').on('input', function () {
        var typed = $(this).val().replace(/[^0-9.]/g, '');
        var v = typed.slice(0, 4);
        if (v !== $(this).val()) $(this).val(v);
        if (typed.length > 4) {
            showAlert('MRP can be at most 4 characters (the database column is 4 characters, same as the VB screen). ' +
                'Two decimals fit only below 10, e.g. 9.50; from 10 upward use one decimal, e.g. 12.5.');
        }
    });

    $('#GROSS_WEIGHT, #NET_WEIGHT, #GAIN_LOSS, #PD').on('blur', function () {
        $(this).val(fmt3($(this).val()));
    });

    // =========================================================
    // Field rules ported from VB frmProduction (the server re-checks all of these on Save)
    // =========================================================
    function todayIso() {
        var d = new Date();
        return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
    }
    function addDaysIso(iso, days) {
        var p = iso.split('-');
        var d = new Date(+p[0], +p[1] - 1, +p[2] + days);
        return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
    }
    function toDisplay(iso) { var p = (iso || '').split('-'); return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : iso; }
    function field(row, name) { return row[name] !== undefined ? row[name] : row[name.toLowerCase()]; }

    // Selected item's packing factor (pieces per case) and best-before days.
    var currentItem = null;

    function applyItem(row) {
        var nob = Math.max(1, parseInt(field(row, 'NOB'), 10) || 1);
        // VB text1_Validate -> blankrec: a different pieces-per-case makes the entered quantities meaningless.
        if (currentItem && currentItem.nob !== nob) {
            $('#PD, #GROSS_WEIGHT, #NET_WEIGHT, #GAIN_LOSS').val(fmt3(0));
        }
        currentItem = { code: field(row, 'CODE'), nob: nob, bbd: parseInt(field(row, 'BBD'), 10) || 0 };
        $('#ITCD').val(currentItem.code);
        $('#ITCD_disp').val(field(row, 'NAME') || '');
    }

    function lookupItem(code, onFound, onMissing) {
        // Same endpoint as the Item dropdown: { data, count } (q = typed text, matched on Code and Name).
        $.getJSON('@Url.Action("GetItemMaster", "ProductionEntry")', { q: code, limit: 50 }, function (resp) {
            var hit = ((resp && resp.data) || []).filter(function (r) { return String(field(r, 'CODE') || '').trim().toUpperCase() === code.toUpperCase(); })[0];
            if (hit) onFound(hit); else if (onMissing) onMissing();
        }).fail(handleLookupFail);
    }

    $('#ITCD').on('change', function () {
        var code = $.trim($(this).val());
        if (!code) { currentItem = null; $('#ITCD_disp').val(''); return; }
        // Picked from the dropdown: the row (incl. NOB / BBD) is already in the data it loaded.
        var picked = pickedRow($(this), pickerConfig.item);
        if (picked) { applyItem(picked); return; }
        lookupItem(code, applyItem, function () {
            $('#ITCD, #ITCD_disp').val('');
            currentItem = null;
            showAlert('Invalid Item', function () { $('#ITCD').focus(); });
        });
    });

    $('#BATCHNO').on('blur', function () { $(this).val($.trim($(this).val()).toUpperCase()); });

    function pdError() {
        var pd = num($('#PD').val());
        if (pd < 0) return 'Net Production can not be negative';
        var nob = currentItem ? currentItem.nob : 1;
        var pieces = Math.round((pd - Math.floor(pd)) * 100);
        if (nob > 1 && pieces > nob - 1) return 'Decimal part cannot be more than ' + (nob - 1) + ' (cases.pieces, ' + nob + ' pieces per case)';
        return null;
    }
    $('#PD').on('change', function () { var e = pdError(); if (e) showAlert(e, function () { $('#PD').focus(); }); });

    function mfgError() {
        var mfg = $('#MFGDT').val();
        if (!mfg) return 'Enter Manufacturing Date';
        var today = todayIso();
        if (mfg > today) return 'Can not enter future dated Manufacturing Date';
        if (currentItem && currentItem.bbd > 0 && mfg <= addDaysIso(today, -currentItem.bbd))
            return 'Material age is more than BBD Period (' + currentItem.bbd + ' days)';
        return null;
    }
    $('#MFGDT').on('change', function () { var e = mfgError(); if (e) showAlert(e, function () { $('#MFGDT').focus(); }); });

    function timeError() {
        var from = $('#TIME_FROM').val(), to = $('#TIME_TO').val();
        return (from && to && from >= to) ? 'Time To should be greater than Time From' : null;
    }
    $('#TIME_TO, #TIME_FROM').on('change', function () { var e = timeError(); if (e) showAlert(e, function () { $('#TIME_TO').focus(); }); });

    // Edit/view: load the saved item's NOB/BBD so the rules above apply without re-picking it.
    if ($.trim($('#ITCD').val())) {
        var savedCode = $.trim($('#ITCD').val());
        lookupItem(savedCode, function (row) {
            currentItem = { code: savedCode, nob: Math.max(1, parseInt(field(row, 'NOB'), 10) || 1), bbd: parseInt(field(row, 'BBD'), 10) || 0 };
        });
    }

    // =========================================================
    // Item lookup -- jquery.inputpicker (Root UI convention: an anchored, paginated picker
    // under the field itself -- see CLAUDE.md's "lookup pickers" rule). The endpoint matches the
    // typed text against every column shown (Code and Name).
    // =========================================================
    var pickerConfig = {
        item: { url: '@Url.Action("GetItemMaster", "ProductionEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'ITCD' }
    };

    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the
    // plugin writes the picked value into the original input and fires "change" on it; it does
    // not hand the row to a select handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        if (!$input.hasClass('inputpicker-original')) return null;
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    // Open the dropdown AND refresh its rows. The plugin loads url-backed data asynchronously and
    // only re-renders the list on a keystroke, so showing it right after init (before the first
    // response lands) displayed "No results" -- the keyup makes it fetch and render the rows.
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function openPicker(key, $input) {
        var cfg = pickerConfig[key];
        $('.inputpicker-wrapped-list').remove();

        // This plugin never sets $.data('inputpicker'); the class it puts on the original input
        // is the "already initialised" test (otherwise every click re-wraps the field and drops
        // whatever the user has typed).
        // Showing is deferred a tick: called from a click, the click's own bubbling up to the
        // plugin's document-level "outside click" handler would otherwise hide it straight away.
        if ($input.hasClass('inputpicker-original')) {
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker({
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2      // seconds (the plugin multiplies by 1000): one request per pause in typing, not per keystroke
        });
        setTimeout(function () { showPickerList($input); }, 0);

        // Both hooks apply the same idempotent handler, so whichever this plugin build fires works.
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            if (row) applyItem(row);
            $(this).inputpicker('hide');
        });
        // (The page-level #ITCD "change" handler above applies the picked row via pickedRow().)
    }

    // =========================================================
    // Save (mirrors VB Command1_Click validation order)
    // =========================================================
    function fail(message, fieldId) {
        showAlert(message, function () { if (fieldId) $('#' + fieldId).focus(); });
    }

    $('#btnSave').on('click', function () {
        $('#BATCHNO').val($.trim($('#BATCHNO').val()).toUpperCase());
        $('#MRP').val($.trim($('#MRP').val()));

        if (!$('#DATE_ORA').val()) return fail('Date required', 'DATE_ORA');
        if (!$.trim($('#ITCD').val())) return fail('Item code required', 'ITCD');
        if (!$('#MRP').val()) return fail('MRP required', 'MRP');
        if ($('#MRP').val().length > 4) return fail('MRP can be at most 4 characters (e.g. 220, 5.55)', 'MRP');
        if (!$('#BATCHNO').val()) return fail('Batchno Number required', 'BATCHNO');
        var e = mfgError(); if (e) return fail(e, 'MFGDT');
        e = timeError(); if (e) return fail(e, 'TIME_TO');
        e = pdError(); if (e) return fail(e, 'PD');

        // VB shows this as a non-blocking warning -- fold it into the confirmation.
        var confirmMsg = 'Are you sure?';
        if ($('#DATE_ORA').val() !== $('#MFGDT').val()) {
            confirmMsg = 'Document Date (' + toDisplay($('#DATE_ORA').val()) + ') and Manufacturing Date (' +
                toDisplay($('#MFGDT').val()) + ') are different. Check the manufacturing date before saving.\n\nAre you sure?';
        }

        showConfirm(confirmMsg, function () {
            var model = {
                ID: $('#ID').val() ? parseInt($('#ID').val(), 10) : 0,
                // The Unit picked on the list (new) / the record's own Unit (edit) -- stored as-is;
                // the server checks it against the user's linked units.
                UNIT: $('#UNIT_disp').val(),
                DOCNO: $('#DOCNO').val(),
                DATE_ORA: $('#DATE_ORA').val(),
                ITCD: $.trim($('#ITCD').val()),
                TM: 'T',
                MRP: $('#MRP').val(),
                BATCHNO: $('#BATCHNO').val(),
                MFGDT: $('#MFGDT').val(),
                SHIFT: $('#SHIFT').val(),
                TIME_FROM: $('#TIME_FROM').val(),
                TIME_TO: $('#TIME_TO').val(),
                PD: round3($('#PD').val()),
                GROSS_WEIGHT: round3($('#GROSS_WEIGHT').val()),
                NET_WEIGHT: round3($('#NET_WEIGHT').val()),
                GAIN_LOSS: round3($('#GAIN_LOSS').val())
            };

            $.ajax({
                url: '@Url.Action("Save", "ProductionEntry")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify({ T_PROD: model, IsNew: !IS_EDIT }),
                success: function (resp) {
                    if (resp.success) {
                        showAlert(resp.message || 'Saved.', function () {
                            window.location.href = '@Url.Action("Index", "ProductionEntry")' + '?unit=' + encodeURIComponent($('#UNIT_disp').val());
                        });
                    } else {
                        fail(resp.message || 'Save failed.', resp.field);
                    }
                },
                error: function () { showAlert('Save failed - server error.'); }
            });
        });
    });

    // =========================================================
    // View mode
    // =========================================================
    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    if (IS_VIEW) {
        $('.accordion-container :input').prop('disabled', true);
        $('#btnSave').addClass('is-disabled').prop('disabled', true);
    }
</script>
</body>
</html>
