        let isLoading = false;
        let allLoaded = false;

        $("#tableScroll").on("scroll", function () {

            let element = $(this)[0];

            if (element.scrollTop + element.clientHeight >= element.scrollHeight - 10) {

                if (isLoading || allLoaded) {
                    return;
                }

                isLoading = true;

                // Show loading only while AJAX is running
                $("#loading").show();
                $("#noMoreData").hide();

                let page = parseInt($("#page").val()) || 1;

                $("#page").val(page + 1);

                $("#loadMoreForm").submit();
            }
        });
function onLoadSuccess() {

    let pageSize = parseInt("@Model.PageSize");
    let page = parseInt($("#page").val());

    let shown = page * pageSize;

    let total = parseInt("@Model.TotalItemCount");

    if (shown > total) {
        shown = total;
    }

    $("#shownCount").text(shown);

    // AJAX finished
    $("#loading").hide();
    isLoading = false;

    // All records loaded
    if (shown >= total) {

        allLoaded = true;

        // Only show this
        $("#noMoreData").show();

    } else {

        $("#noMoreData").hide();
    }
}
    </script>
    <script>
        $(document).ready(function () {
            debugger;
            var $searchInput = $('input[name="searchString"]');
            var searchInput = $('#searchInput');
            var $tableBody = $('#PktTeaInvContainer');
            var searchTimeout;

            // Store the original table content (before any search)
            var originalContent = $tableBody.html();

            // If page loads with existing search term
            if ($searchInput.val() && $searchInput.val().length > 0) {
                searchInput.removeClass('fa-search').addClass('fa-times').css('cursor', 'pointer');
            }

            function performSearch(query) {
                debugger;

                if (!query || !query.trim()) {
                    $("#page").val(1);
                    $searchInput.val('');
                    $('#loadMoreForm input[name="searchString"]').val('');
                    isLoading = false;
                    $("#loadMoreForm").submit();
                    return;
                }

                // Just clear, don't show loading message
                $tableBody.empty();

                // Update both search inputs
                $("#page").val(1);
                $searchInput.val(query);
                $('#loadMoreForm input[name="searchString"]').val(query);
                isLoading = false;
                $("#loadMoreForm").submit();
            }

            // Typing → debounced search
            $searchInput.on('input', function () {
                var value = $(this).val().trim();

                // Toggle X icon
                if (value) {
                    searchInput.removeClass('fa-search').addClass('fa-times').css('cursor', 'pointer');
                } else {
                    searchInput.removeClass('fa-times').addClass('fa-search').css('cursor', 'default');
                }

                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function () {
                    performSearch(value);
                }, 500);
            });

            // Click on X → clear everything
            searchInput.on('click', function () {
                if ($(this).hasClass('fa-times')) {
                    $searchInput.val('');
                    $('#loadMoreForm input[name="searchString"]').val('');
                    $("#page").val(1);
                    searchInput.removeClass('fa-times').addClass('fa-search').css('cursor', 'default');
                    isLoading = false;
                    $("#loadMoreForm").submit();
                }
            });

            // Enter key → immediate search
            $searchInput.on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    clearTimeout(searchTimeout);
                    performSearch($(this).val().trim());
                }
            });
        });
    </script>



    <script>
    $(document).on("click", ".toggle-details", function () {
        debugger;
     let icon = $(this);
     let row = icon.closest("tr");
     let childRow = row.next(".child-row");
     let tbody = childRow.find(".child-details-body");
     let doC_YEAR = icon.data("doC_YEAR");
     let blno = icon.data("blno");
     let unitRaw = icon.data("unit") || "";
     let unit = unitRaw.split('-')[0];
     let bldt = icon.data("bldt");
     let formatted = bldt.split(" ")[0];

     // If already open → close
     if (childRow.is(":visible")) {
         childRow.hide();
         tbody.empty();
         icon.removeClass("fa-minus").addClass("fa-plus");
         return;
     }
     // Show loader
     tbody.html(`<tr><td colspan="17"><div id="detailLoader" style="text-align:center;"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading...</div></td></tr>`);
     childRow.show();

     $.ajax({
         url: '@Url.Action("GetPacketTeaInvoiceDetails", "PacketTeaInvoice")',
         type: "GET",
         data: {  blno: blno, unit: unit, bldt: bldt },
         dataType: "json",
         success: function (response) {
             debugger;
             tbody.empty();
             let data = Array.isArray(response) ? response : [response];
             data.forEach(function (d) {
                 let net = (Number(d.GROSS || 0) - Number(d.TARE || 0)).toFixed(3);
                 let rowHtml = `
                 <tr>
                     <td>${d.blno }</td>
                     <td>${d.bldt ? new Date(parseInt(d.bldt.replace(/[^0-9]/g, ''))).toLocaleDateString('en-GB'): ''}</td>
                     <td>${d.itcd ?? ""}</td>
                     <td>${d.itemName ?? ""}</td>
                     <td>${d.itdesC1 ?? ""}</td>
                     <td>${d.mrp ?? ""}</td>
                     <td>${d.mfgdt ? new Date(parseInt(d.mfgdt.replace(/[^0-9]/g, ''))).toLocaleDateString('en-GB') : ''}</td>
                     <td>${d.batchno ?? ""}</td>
                     <td>${d.qty ?? ""}</td>
                     <td>${d.grosS_WEIGHT ?? ""}</td>
                     <td>${d.weight ?? ""}</td>
                 </tr>`;
                 tbody.append(rowHtml);
             });
             childRow.show();
             icon.removeClass("fa-plus").addClass("fa-minus");
         },
         error: function (xhr) {
             tbody.html(`<tr><td colspan="17" style="color:red;">Error loading data!</td></tr>`);
             console.log("Error:", xhr);
         }
         });
     });
    </script>
    <script>
         // Build New Row with inputpicker
         function buildNewRow() {
             return `
                     <tr id="newUnitRow" class="new-entry-row">
                     <td class="text-center"> <i class="fa fa-pencil go-new" style="cursor:pointer;color:#black;" title="Go to New Entry"></i> </td>
                     <td></td>
                     <!-- Inputpicker -->
                     <td> <input type="text" id="ListingUnitCode" class="form-control" placeholder="Select Unit" autocomplete="off" style="width:140px;" /></td>
                     <td colspan="8"></td>
                    </tr>`;
         }

        $(document).on('click', '.IdaddNewRecord', function () {
            if ($('#newUnitRow').length > 0) {
                $('#ListingUnitCode').focus();
                return;
            }

            $('#hiddenUNIT').val('');
            $('#hiddenLOCA').val('');

            $('#PktTeaInvContainer').prepend(buildNewRow());

            initUnitPicker();

            setTimeout(function () {
                $('#ListingUnitCode').focus();
            }, 100);
        });

         // Initialize inputpicker
         function initUnitPicker() {
             console.log('🔧 Initializing inputpicker...');

             $('#ListingUnitCode').inputpicker({
                 url: '@Url.Action("GetUnit", "PacketTeaInvoice")',
                 fields: [
                     { name: 'CODE', text: 'CODE' },
                     { name: 'NAME', text: 'NAME' }
                 ],
                 fieldText: 'CODE',
                 fieldValue: 'CODE',
                 headShow: true,
                 autoOpen: true,
                 pagination: true,
                 pageField: 'p',
                 pageLimitField: 'limit',
                 pageLimit: 10,
                 pageCountField: 'count',
                 width: '140px',
                 urlDelay: 1
             });

             console.log('✅ Inputpicker initialized');

             // ✅ Method 1: Try inputpicker.select event
             $('#ListingUnitCode').on('inputpicker.select', function (e, item) {
                 console.log('✅ inputpicker.select event fired!', item);
                 if (item && item.CODE) {
                     saveUnitData(item.CODE, item.LOCA);
                 }
             });

             // ✅ Method 2: Listen to the 'change' event
             $('#ListingUnitCode').on('change', function () {
                 var selectedCode = $(this).val();
                 console.log('✅ change event fired, selectedCode:', selectedCode);

                 if (selectedCode) {
                     // Fetch the full unit data including GLOCA
                     fetchUnitByCode(selectedCode);
                 }
             });
             setTimeout(function() {
                 $(document).off('click.unitpicker');
                 $(document).on('click.unitpicker', '.inputpicker-list li, .inputpicker-item', function() {
                     console.log('✅ Dropdown item clicked (backup method)');
                     var selectedText = $(this).text().trim();
                     console.log('   Clicked text:', selectedText);
                     var code = selectedText.split(/[\s-]/)[0].trim();
                     console.log('   Extracted CODE:', code);

                     if (code) {
                         setTimeout(function() {
                             fetchUnitByCode(code);
                         }, 100);
                     }
                 });
             }, 500);
         }
         function fetchUnitByCode(code) {
             console.log('🔍 Fetching unit data for CODE:', code);

             $.ajax({
                 url: '@Url.Action("GetUnit", "PacketTeaInvoice")',
                 data: { q: code, limit: 1, p: 1 },
                 method: 'GET',
                 success: function(response) {
                     console.log('✅ API response:', response);

                     if (response.data && response.data.length > 0) {
                         var unit = response.data[0];
                         console.log('   Found unit:', unit);
                         saveUnitData(unit.CODE, unit.LOCA);
                     } else {
                         console.warn('⚠️ No unit found for CODE:', code);
                     }
                 },
                 error: function(err) {
                     console.error('❌ Error fetching unit:', err);
                 }
             });
         }
         function saveUnitData(code, loca) {
             $('#hiddenUNIT').val(code);
             $('#hiddenLOCA').val(loca || '');
         }

    </script>
    <script>
            $(document).on('click', '#deleteBtn', function () {
        var $checked = $('.row-check:checked');

        if ($checked.length === 0) {
            $.confirm({
                title: "Delete",
                type: "orange",
                content: "<b>Please select one record to delete.</b>",
                buttons: { ok: { btnClass: "btn-primary" } }
            });
            return;
        }

        if ($checked.length > 1) {
            $.confirm({
                title: "Delete",
                type: "orange",
                content: "<b>Please select only ONE record.</b>",
                buttons: { ok: { btnClass: "btn-primary" } }
            });
            return;
        }
        var id = $checked.attr('data-id');
        var desp_no = $checked.data('desp_no');

        $.confirm({
            title: "Confirm Delete",
            type: "red",
            content: `<b>Are you sure you want to delete Bought Leaf Purchase Data SLNO <span style="color:#d9534f;">${desp_no}</span> ?</b>`,
            buttons: {
                yes: {
                    text: "Yes, Delete",
                    btnClass: "btn-danger",
                    action: function () {

                        $('<form>', {
                            method: 'POST',
                            action: '@Url.Action("Delete", "PacketTeaInvoice")'
                        })
                        .append($('<input>', {
                            type: 'hidden',
                            name: 'id',
                            value: id
                        }))
                        .appendTo('body')
                        .submit();
                    }
                },
                no: {
                    text: "Cancel",
                    btnClass: "btn-primary"
                }
            }
        });
    });
    </script>
    <script>
        function formatDotNetDate(dateString) {
            if (!dateString) return "";
            let timestamp = parseInt(dateString.replace(/[^0-9]/g, ''));
            let date = new Date(timestamp);
            let month = String(date.getMonth() + 1).padStart(2, '0');
            let year = date.getFullYear();

            return month + "-" + year;
        }
    </script>
