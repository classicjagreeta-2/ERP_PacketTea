
@using PacketTea.Utility
@using PagedList.Mvc
@using PagedList

@model List<PacketTea.Models.PT.UNBL>

@{
    int RowIndex = ViewBag.RowIndex ?? 0;
}

@if (Model != null)
{
    foreach (var pt in Model)
    {
        <tr>
            <td style="display:none;">
                <input type="hidden" class="txtNob" value="0" />
                <input type="hidden" class="txtClStock" value="0" />
                <input type="hidden" class="txtBBD" value="0" />
            </td>
            <td><input type="checkbox" name="selectedDetail" /> </td>
            <td><input type="text" class="form-control req NumSlNo" data-field="srlno" value="@(pt.srlno > 0 ? pt.srlno : ++RowIndex)" readonly style="width:10px !important;" /> </td>
            <td> <input type="text" class="form-control req txtItemCode" data-field="itcd" value="@pt.itcd" /> </td>
            <td> <input type="text" class="form-control req ddlItemName" data-field="itemName" value="@pt.itcd" /> </td> @*there no field itemName is UNBL API (getbyid and save )*@
            <td> <input type="text" class="form-control txtItemDesc" data-field="itdesC1" value="@pt.itdesC1" /></td>
            <td> <input type="text" class="form-control req txtMrp" data-field="mrp" value="@pt.mrp" style="width:80px;" /> </td>
            <td> <input type="text" class="form-control req dateMfgdt" data-field="mfgdt" value="@(pt.mfgdt.HasValue ? pt.mfgdt.Value.ToString("dd-MM-yyyy") : "")" /> </td>
            <td><input type="text" class="form-control req txtBatchNo" data-field="batchno" value="@pt.batchno" style="width:80px;" /></td>

            <td> <input type="text" class="form-control req txtQuantity right-aligned" data-field="qty" value="@pt.qty" style="width:80px;" /></td>
            <td><input type="text" class="form-control req txtGross" data-field="grosS_WEIGHT" value="@pt.grosS_WEIGHT" style="width:80px;" /> </td>
            <td> <input type="text" class="form-control req txtNet_Wt" data-field="weight" value="@pt.weight" style="width:80px;" /> </td>
            <td> <input type="text" class="form-control req txtRate" data-field="rate" value="@pt.rate" style="width:80px;" /> </td>
            <td> <input type="text" class="form-control txtDesc_Percent" data-field="disc" value="@pt.disc" style="width:80px;" /> </td>
            <td><input type="text" class="form-control txtDesc_Amount right-aligned" data-field="descAmount" value="@pt.srlno" readonly style="width:80px;" /> </td>
            <td> <input type="text" class="form-control req txtAmount" data-field="amt" value="@pt.amt" readonly style="width:80px;" /> </td>
            <td> <input type="text" class="form-control  ddlGstPerc" data-field="gsT_PCD" value="@pt.gsT_PCD" style="width:100px;" /> </td>
            <td><input type="text" class="form-control txtGstAmt" data-field="sgsT_AMT" value="@pt.sgsT_AMT" readonly style="width:80px;" />  </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="16" class="text-center text-muted" style="padding:20px;">
            No detail rows found. Click <strong>Add</strong> to create the first line.
        </td>
    </tr>
}
