@using PacketTea.Utility;
@using PagedList.Mvc;
@using PagedList;

@model IPagedList<PacketTea.Models.PT.UNBL_HED>

@foreach (var pt in Model)
{
    var hasPermission = (ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? true;
    var inlineStyle = !hasPermission ? "pointer-events:none; color:gray; text-decoration:none;" : "";
    var encryptedId = PacketTea.Utility.Cryptography.Encrypt(pt.id);
    var urlEncodedId = HttpUtility.UrlEncode(encryptedId);

    <tr class="parent-row" data-id="@pt.id">
        <td> <input type="checkbox" class="row-check" value="@encryptedId" data-unit="@pt.unit" data-bldt="@pt.bldt" data-blno="@pt.blno" /> </td>
        <td><i class="fa fa-plus toggle-details" data-unit="@pt.unit" data-bldt="@pt.bldt" data-blno="@pt.blno" style="cursor:pointer"></i> </td>
        <td><a href="@Url.Action("InsertOrUpdate", "PacketTeaInvoice")?id=@urlEncodedId" style="@inlineStyle"> @(pt.blno)</a></td>
        <td>@DateHelper.DateFormatter(pt.bldt)</td>
        <td>@(string.IsNullOrEmpty(pt.pcd) || string.IsNullOrEmpty(pt.delivery) ? " " : pt.pcd + " - " + pt.delivery)</td>
        <td>@pt.partY_ORDER_NO</td>
        <td>@(string.IsNullOrEmpty(pt.BillTo) || string.IsNullOrEmpty(pt.BillToPartyName) ? " " : pt.BillTo + " - " + pt.BillToPartyName)</td>
    </tr>
    <tr class="child-row" style="display:none; background:#f9f9f9;">
        <td colspan="15">
            <table class="table table-sm table-bordered mb-0" style="width: 80%; position: relative; left: 3.0%;">
                <thead>
                    <tr>
                        <th>Bill No</th>
                        <th>Bill Date</th>
                        <th>Item</th>
                        <th>Item Name</th>
                        <th>Item Descn</th>
                        <th>MRP</th>
                        <th>Mfg Date</th>
                        <th style="text-align:right;">Batch No</th>
                        <th style="text-align:right;">Quantity</th>
                        <th style="text-align:right;">Gross Wt</th>
                        <th style="text-align:right;">Net Wt</th>
                    </tr>
                </thead>
                <tbody class="child-details-body">
                    <!-- Ajax inserts rows here -->
                </tbody>
            </table>
        </td>
    </tr>
}
