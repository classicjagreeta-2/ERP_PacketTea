            tabToSelect: true,
            urlDelay: 1,
            openAfterLoad: false
        });
        $('.TransDDL').inputpicker({
            url: '@Url.Action("GetTransCode", "PacketTeaInvoice")',
            fields: [
                { name: 'code', text: 'code' },
                { name: 'name', text: 'name' },
            ],
            fieldText: 'name',
            fieldValue: 'code',
            placeholder: '-- Select A/C Description --',
            headShow: true,
            filterOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 20,
            pageCountField: 'count',
            pageCurrent: 1,
            width: '100%',
            dialogWidth: '700px',
            tabToSelect: true,
            urlDelay: 1,
            openAfterLoad: false
        });
        debugger;
        $('.BrokerDDL').inputpicker({
            url: '@Url.Action("GetBroker", "PacketTeaInvoice")',
            fields: [
                { name: 'code', text: 'code' },
                { name: 'name', text: 'name' },
            ],
            fieldText: 'name',
            fieldValue: 'code',
            placeholder: '-- Select A/C Description --',
            headShow: true,
            filterOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 20,
            pageCountField: 'count',
            pageCurrent: 1,
