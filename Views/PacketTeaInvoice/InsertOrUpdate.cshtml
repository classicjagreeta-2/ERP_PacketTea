    </script>
    <script>

        function calculateRowAmount(row) {
            var net_wt = parseFloat(row.find(".txtNet_Wt").val()) || 0;
            var rate = parseFloat(row.find(".txtRate").val()) || 0;
            var desc_percent = parseFloat(row.find(".txtDesc_Percent").val()) || 0;
            var gstPercent = parseFloat(row.find(".ddlGstPerc").attr("data-percent")) || 0;
            var qty = parseFloat(row.find(".txtQuantity").val()) || 0;
            var flag = $("input[name='unbL_HED.flag']:checked").val();

            var gross_amount = 0;

            if (flag == "2") {
                // Net Wt.
                amount = net_wt * rate;
            }
            else if (flag == "1") {
                // Quantity
                amount = qty * rate;
            }
            // Calculations
            //  var gross_amount = net_wt * rate;
            var desc_amount = (amount * desc_percent) / 100;
            // var amount = gross_amount - desc_amount;
            var gst_amount = (amount * gstPercent) / 100;

            // UI Updates
            row.find(".txtDesc_Amount").val(desc_amount.toFixed(2));
            row.find(".txtAmount").val(amount.toFixed(2));
            // row.find(".txtGstAmt").val(gst_amount.toFixed(2));
            row.find(".txtGstAmt").val(gst_amount.toFixed(2)).attr("title", gst_amount.toFixed(2));
        }
        $(document).on("input", ".txtNet_Wt, .txtQuantity, .txtMrp, .txtRate, .txtDesc_Percent", function () {
            var row = $(this).closest("tr");
            calculateRowAmount(row);
        });
        $(document).on("change", "input[name='unbL_HED.flag']", function () {
            $("#mainTable tbody tr").each(function () {
                calculateRowAmount($(this));
            });
        });
        $(document).on("blur", ".txtGross", function () {

            var row = $(this).closest("tr");

            var gross = parseFloat(row.find(".txtGross").val()) || 0;
            var net = parseFloat($(this).val()) || 0;

            if (net > gross) {
                $.alert("Net Weight cannot be greater than Gross Weight.");

                $(this).val("");
                $(this).focus();
            }
        });
        $(document).on("blur", ".txtQuantity", function () {
            debugger;
            var row = $(this).closest("tr");
            var flag = $("input[name='unbL_HED.flag']:checked").val();
            var clstock = parseFloat(row.find(".txtClStock").val()) || 0;
            var nob = parseFloat(row.find(".txtNob").val()) || 0;
            var batchno = parseFloat(row.find(".txtBatchNo").val()) || 0;

            var batchno = $.trim(row.find(".txtBatchNo").val());

            if (batchno === "") {
                $.alert("Select a Batch.");
                row.find(".txtBatchNo").focus();
                return;
            }
            var bags = parseFloat(row.find(".txtQuantity").val()) || 0;
            if (nob <= 0) return;
            var bag_limit = clstock / nob;

            if (bags > bag_limit) {
                $.alert("Out Of Stock. Maximum : " + bag_limit.toFixed(3) + " Bags");
                row.find(".txtQuantity").val("").focus();
            }
        });
        $(document).on("blur", ".txtNet_Wt", function () {

            var row = $(this).closest("tr");

            var batchno = $.trim(row.find(".txtBatchNo").val());
            var gross = parseFloat(row.find(".txtGross").val()) || 0;
            var net = parseFloat($(this).val()) || 0;
            var clstock = parseFloat(row.find(".txtClStock").val()) || 0;

            // 1. Batch validation
            if (batchno === "") {
                $.alert("Select a Batch.");
                row.find(".txtBatchNo").focus();
                return false;
            }

            // 2. Gross validation
            if (net > gross) {
                $.alert("Net Weight cannot be greater than Gross Weight.");
                $(this).val("").focus();
                return false;
            }

            // 3. Stock validation
            if (net > clstock) {
                $.alert("Out Of Stock. Maximum : " + clstock.toFixed(3) + " Kg");
                $(this).val("").focus();
                return false;
            }

        });
        $(document).on("change", ".dateMfgdt", function () {
            debugger;
            var row = $(this).closest("tr");

            var bbd = parseInt(row.find(".txtBBD").val()) || 0;

            var mfgDate = row.find(".dateMfgdt").next().find(".inputpicker-input").val();

            if (!mfgDate || bbd <= 0)
                return;

            function parseDate(dateStr) {
                var p = dateStr.split("-");   // dd-MM-yyyy
                return new Date(p[2], p[1] - 1, p[0]);
            }

            // MFG Date
            var mfg = parseDate(mfgDate);

            // Bill Date (12-July-2026)
            var bill = new Date($("#txtBillDate").val());

            // Expiry Date
            var expiry = new Date(mfg);
            expiry.setDate(expiry.getDate() + bbd);

            console.log("MFG :", mfg);
            console.log("Bill :", bill);
            console.log("Expiry :", expiry);

            if (bill > expiry) {
                $.alert("Item has expired.");
                row.find(".dateMfgdt").val("");
                row.find(".dateMfgdt").focus();
            }
        });
    </script>
    <script>
        $(document).on('click', '#btnAddRow', function (e) {
            e.preventDefault();
            var isValid = true;
            var $lastRow = $('#mainTable tbody tr:last');
            $lastRow.find('.req').each(function () {
                var val = $(this).val().trim();
                if (val === '' || parseFloat(val) === 0) {
                    isValid = false;
                    $(this).css('border', '1px solid red');
                } else {
                    $(this).css('border', '');
                }
            });
            if (!isValid) {
                $.confirm({
                    title: "Required Fields",
                    type: "red",
                    content: "<b>Please fill all required (*) fields before adding a new row.</b>",
                    buttons: {
                        ok: {
                            text: "OK",
                            btnClass: "btn-danger"
                        }
                    }
                });
                return;
            }

            var rowIndex = $('#mainTable tbody tr').length;
            $.ajax({
                url: '@Url.Action("AddRow", "PacketTeaInvoice")',
                type: 'GET',
                data: { rowIndex: rowIndex },
                success: function (html) {
                    var $row = $(html);
                    $("#mainTable tbody").append($row);
                    initializeRow($row);
                    $row.find(".txtItemCode").focus();
                }
            });

        });
