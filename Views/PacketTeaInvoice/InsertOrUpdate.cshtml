            url: '@Url.Action("GetBankCode", "PacketTeaInvoice")',
            fields: [
                { name: 'ACODE', text: 'ACODE' },
                { name: 'ACNAME', text: 'ACNAME' },
                { name: 'AC_NO', text: 'AC_NO' },
                { name: 'UNIT', text: 'UNIT' }
            ],
            fieldText: 'ACNAME',
            fieldValue: 'ACODE',
            placeholder: '-- Select A/C Description --',
            headShow: true,
            filterOpen: true,
            urlParam: { // 👈 pass parameters here
                aCodePrefix: '@acodePrefixVal',
                unit: '@UnitValue'
