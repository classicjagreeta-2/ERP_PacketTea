    <script>
        function buildModel() {
            debugger;
            var model = {
                unbL_HED: {},
                unbl: [],
                unblplt: []
            };

            // Header
            $("[name^='unbL_HED.']").each(function () {
                var name = $(this).attr("name").replace("unbL_HED.", "");
                if ($(this).is(":radio")) {

                    if ($(this).is(":checked"))
                        model.unbL_HED[name] = $(this).val();

                } else if ($(this).is(":checkbox")) {

                    model.unbL_HED[name] = $(this).is(":checked");

                } else {

                    model.unbL_HED[name] = $(this).val();
                }
            });
            model.unbL_HED.bldt = toIsoDate(model.unbL_HED.bldt);

            model.unbL_HED.ewaybilL_DT = toNullableDate(toIsoDate(model.unbL_HED.ewaybilL_DT));
            model.unbL_HED.cnotE_DT = toNullableDate(toIsoDate(model.unbL_HED.cnotE_DT));
            model.unbL_HED.challaN_DT = toNullableDate(toIsoDate(model.unbL_HED.challaN_DT));
            model.unbL_HED.remdt = toNullableDate(toIsoDate(model.unbL_HED.remdt));
            model.unbL_HED.partY_ORDER_DT = toNullableDate(toIsoDate(model.unbL_HED.partY_ORDER_DT));
            model.unbL_HED.rt = 32;
            model.unbL_HED.tm = 'T';
            // Details
            $("#mainTable tbody tr").each(function () {

                var row = {};

                $(this).find("[data-field]").each(function () {
                    row[$(this).data("field")] = $(this).val();
                });

                // Copy header flag to detail
                row.flag = model.unbL_HED.flag;
                row.mfgdt = toIsoDate(row.mfgdt);

                //var gst = $(this).find(".ddlGstPerc").inputpicker("element");
                //row.gsT_PCD = gst ? gst.GST_CODE : "";
                var $gst = $(this).find(".ddlGstPerc");
                var gstCode = "";

                if ($gst.length > 0) {
                    gstCode = $gst.attr("data-gstcode") || "";

                    if (!gstCode) {
                        try {
                            var gst = $gst.inputpicker("element");

                            if (gst && gst.GST_CODE) {
                                gstCode = gst.GST_CODE;
                            }
                        } catch (e) {
                            console.log("GST picker is not initialized.");
                        }
                    }

                    if (!gstCode) {
                        gstCode = $gst.val() || "";
                    }
                }

                row.gsT_PCD = gstCode;

                row.blno = model.unbL_HED.blno;
                row.bldt = model.unbL_HED.bldt;
                row.pcd = model.unbL_HED.pcd;
                row.tpt = model.unbL_HED.tpt;
                row.veh = model.unbL_HED.veh;
                row.unit = model.unbL_HED.unit;
                row.loca = model.unbL_HED.loca;
                row.rt = 32;
                row.tm = model.unbL_HED.tm;
                row.doc_YEAR = '2027';
                row.cstcd = "81";
                row.tm = 'T';
                model.unbl.push(row);
            });
            // Free Tea Details
            $("#tblFreeDetail tr").each(function (index) {

                var freeRow = {};

                freeRow.srlno = index + 1;

                freeRow.plcrcd = $(this).find(".FreeTeaCode").val();
                freeRow.plcrqty = parseFloat($(this).find(".txtFreeTeaQty").val()) || 0;
                freeRow.plcrrate = parseFloat($(this).find(".txtFreeTeaRate").val()) || 0;
                freeRow.plcrval = parseFloat($(this).find(".txtFreeTeaAmount").val()) || 0;

                freeRow.blno = "";
                freeRow.bldt = model.unbL_HED.bldt;
                freeRow.pcd = model.unbL_HED.pcd;
                freeRow.unit = model.unbL_HED.unit;
                freeRow.loca = model.unbL_HED.loca;
                freeRow.rt = 32;
                freeRow.tm = "T";
                freeRow.doc_YEAR = "2027";

                model.unblplt.push(freeRow);
            });
            return model;
        }
    </script>
    <script>
        function toIsoDate(dateStr) {

            if (!dateStr) return null;

            var p = dateStr.split("-");

            if (p.length != 3) return null;

            var day = p[0];
            var month = p[1];
            var year = p[2];

            var months = {
                January: "01",
                February: "02",
                March: "03",
                April: "04",
                May: "05",
                June: "06",
                July: "07",
                August: "08",
                September: "09",
                October: "10",
                November: "11",
                December: "12"
            };

            if (months[month]) {
                month = months[month];
            }

            if (year.length == 2)
                year = "20" + year;

            return year + "-" + month + "-" + day + "T00:00:00";
        }
    </script>
