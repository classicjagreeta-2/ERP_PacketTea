@model PacketTea.Models.PT.UNBLDATA
@using PacketTea.Models.Enum

@using PacketTea.Utility
@{
    ViewBag.Title = "InsertOrUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int acodePrefixVal = (int)NewVouType.Bank;
    string UnitValue = ViewBag.Unit;
}

<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- CSS -->
    <link href="~/Content/assets/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/assets/css/jquery-ui.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry-responsive.css">
    <link href="~/Content/src/jquery.inputpicker.css" rel="stylesheet">


    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th {
            background-color: #248cb5 !important;
            color: white !important;
            font-weight: bold !important;
        }

        .inputpicker-wrapped-list .inputpicker-highlight-active td {
            background-color: #404e68 !important;
            color: white !important;
        }

        .inputpicker-wrapped-list .inputpicker-active td {
            background: #404e68 !important;
            color: white !important;
        }
    </style>
    <style>
        #prScroll {
            max-height: 420px; /* change height */
            overflow-y: auto;
        }

        #mainTable {
            table-layout: auto;
            width: auto;
        }

            #mainTable th,
            #mainTable td {
                white-space: nowrap;
                padding: 2px 4px;
            }

        .popup-overlay {
            display: none;
            z-index: 9999;
        }

        .popup-box {
            display: none;
            overflow: hidden;
        }

        tbody div {
            overflow: visible !important;
            height: max-content;
        }

        .table.table-sm td, .table.table-sm th {
            padding: 0.4rem 0.2rem !important;
        }

        .inputpicker-wrapped-list {
            min-width: max-content !important;
            max-width: max-content !important;
        }

            .inputpicker-wrapped-list table {
                width: max-content !important;
            }

        .table th {
            background-color: #404e68 !important;
        }

        .form-col-33 {
            width: 33.333%;
            padding: 0 6px;
            box-sizing: border-box;
        }

            .form-col-33 .d-flex {
                gap: 8px;
            }

            .form-col-33 .form-control {
                width: 100%;
            }
    </style>
    <style>
    </style>
</head>
<body>
    <div class="general-container">
        <div class="purchase-details">
            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "PacketTeaInvoice" )"> <i class="fa fa-arrow-left"></i> Back </a> </li>
                        <li>  <button type="button" id="btnSave" style="background:none;border:0;cursor:pointer;"> <i class="fa fa-floppy-o"></i> Save </button> </li>
                        <li><a href="@Url.Action("Index", "PacketTeaInvoice")" onclick="return ReleaseLockAndRedirect(this);"><i class="fa fa-times"></i> Cancel</a></li>

                        <li><a href="javascript:void(0)" data-popup="Notes"><i class="fa fa-file-text-o"></i> Notes</a></li>
                        <li style="margin-left:auto"> <label class="btn btn-inverse pull-right" style="margin:20px; border:none;"> Status : <span id="statusText" style="color:white;">Add</span> </label> </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt">
                                <div class="title-heading">Packet Tea Invoice</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-container" style="height:auto">
                <div class="accordion">
                    <div class="accordion-header"><span class="txt">Header</span></div>
                    <div class="accordion-body">
                        <div class="form-row ">
                            <div class="form-col-20">
                                <label>Bill No</label>
                                @Html.TextBoxFor(m => m.unbL_HED.blno, new { @class = "form-control ", @readonly = "readonly", @id = "txtBlNo" })
                                @Html.HiddenFor(m => m.unbL_HED.id)
                                @Html.HiddenFor(m => m.unbL_HED.rt)
                                @Html.HiddenFor(m => m.unbL_HED.tm)
                                @Html.HiddenFor(m => m.unbL_HED.timE_ORA)
                                @Html.HiddenFor(m => m.unbL_HED.useR_ORA)
                                @Html.HiddenFor(m => m.unbL_HED.loca)
                                @Html.HiddenFor(m => m.unbL_HED.unit)
                            </div>
                            <div class="form-col-20">
                                <label>Bill Date<span>(*)</span></label>
                                <div class="col-md-12 pl-1">
                                    <div class="date-field">
                                        @Html.TextBoxFor(m => m.unbL_HED.bldt, "{0:dd-MM-yy}", new { @class = "form-control", @required = "required", @id = "txtBillDate" })
                                        <img src="~/Content/assets/images/calendar.png" alt="calendar" class="calendar-icon" data-target="BillDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Party Code (Ship To) <span>(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.pcd, new { @class = "form-control PartyCodeDDL", @required = "required", @id = "txtPartyCode " })
                            </div>
                            <div class="form-col-20">
                                <label>Order No <span class="text-danger">(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.partY_ORDER_NO, new { @class = "form-control", @required = "required", @id = "txtOrderNo" })
                            </div>
                            <div class="form-col-20">
                                <label>Bill To</label>
                                @Html.TextBoxFor(m => m.unbL_HED.bilL_LOCA, new { @class = "form-control", @id = "txtBillTo" })
                            </div>
                        </div>
                        <div class="form-row ">
                            <div class="form-col-20">
                                <label>Vehicle No<span>(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.veh, new { @class = "form-control VehNoDDL", @required = "required", @id = "txtVehNo" })
                            </div>
                            <div class="form-col-20">
                                <label>Transaction Code<span>(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.tpt, new { @class = "form-control TransDDL", @required = "required", @id = "txtTransCode" })
                            </div>
                            <div class="form-col-20">
                                <label>Broker<span class="text-danger">(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.sman, new { @class = "form-control BrokerDDL", @required = "required", @id = "txtBroker" })
                            </div>
                            <div class="form-col-20">
                                <label>FDA No</label>
                                @Html.TextBoxFor(m => m.unbL_HED.unit, new { @class = "form-control", @id = "txtFDANo" })
                            </div>
                            <div class=" form-col-20 p-2">
                                <label class="d-block mb-1">Unit of Calculation</label>
                                <div class="row mx-0">
                                    <label class="mr-3 mb-0">
                                        @Html.RadioButtonFor(m => m.unbL_HED.flag, "1", new { id = "flagQty" })
                                        Quantity
                                    </label>
                                    <label class="mb-0">
                                        @Html.RadioButtonFor(m => m.unbL_HED.flag, "2", new { id = "flagNetWt" })
                                        Net Wt.
                                    </label>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Removal Date<span>(*)</span></label>
                                <div class="col-md-12 pl-1">
                                    <div class="date-field">
                                        @Html.TextBoxFor(m => m.unbL_HED.remdt, "{0:dd-MM-yyyy}", new { @class = "form-control", @id = "txtRemovalDate", @required = "required", })
                                        <img src="~/Content/assets/images/calendar.png" alt="calendar" class="calendar-icon" data-target="RemovalDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Max Load<span>(*)</span></label>
                                @Html.TextBoxFor(m => m.unbL_HED.maxload, new { @class = "form-control ", @required = "required", @id = "txtMaxLoad" })
                            </div>
                            <div class="form-col-20">
                                <label>Time</label>
                                @Html.TextBoxFor(m => m.unbL_HED.tim, new { @class = "form-control ", @required = "required", @id = "txtTime" })
                            </div>
                            <div class="form-col-20">
                                <label>Time Removal</label>
                                @Html.TextBoxFor(m => m.unbL_HED.timrem, new { @class = "form-control ", @required = "required", @id = "txtTimeRemoval" })
                            </div>
                            <div class="form-col-20">
                                <label>Vehicle Type</label>
                                @Html.TextBoxFor(model => model.unbL_HED.vtype, new { @class = "form-control VehicleTypeDDL", @required = "required", @id = "txtRemovalDate" })
                            </div>
                        </div>
                        <div class="form-row ">
                            <div class="form-col-20">
                                <label>E-Way Bill Date <span>(*)</span></label>
                                <div class="col-md-12 pl-1">
                                    <div class="date-field">
                                        @Html.TextBoxFor(m => m.unbL_HED.ewaybilL_DT, "{0:dd-MM-yyyy}", new { @class = "form-control", @id = "txtE_WayBillDate" })
                                        <img src="~/Content/assets/images/calendar.png" alt="calendar" class="calendar-icon" data-target="E_WayBillDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Lorry Rcpt No </label>
                                @Html.TextBoxFor(m => m.unbL_HED.lR_NO, new { @class = "form-control ", @id = "txtLorryRcptNo" })
                            </div>
                            <div class="form-col-20">
                                <label>Delivery </label>
                                @Html.TextBoxFor(m => m.unbL_HED.delivery, new { @class = "form-control ", @id = "txtDelivery" })
                            </div>
                            <div class="form-col-20">
                                <label>Delivery Date </label>
                                <div class="col-md-12 pl-1">
                                    <div class="date-field">
                                        @Html.TextBoxFor(m => m.unbL_HED.bldt, "{0:dd-MM-yyyy}", new { @class = "form-control", @required = "required", @id = "txtDeliveryDate" })
                                        <img src="~/Content/assets/images/calendar.png" alt="calendar" class="calendar-icon" data-target="DeliveryDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Bank</label>
                                @Html.TextBoxFor(m => m.unbL_HED.banK_CODE, new { @class = "form-control ", @required = "required", @id = "BankCodeDDL" })
                            </div>
                        </div>
                        <div class="form-row">

                            <div class="form-col-20">
                                <label>Address </label>
                                @Html.TextBoxFor(m => m.unbL_HED.adD1,
                                new { @class = "form-control", @id = "txtAddress1" })
                            </div>

                            <div class="form-col-20">
                                <label>&nbsp;</label>
                                @Html.TextBoxFor(m => m.unbL_HED.adD2,
                                new { @class = "form-control", @id = "txtAddress2" })
                            </div>

                            <div class="form-col-20">
                                <label>&nbsp;</label>
                                @Html.TextBoxFor(m => m.unbL_HED.adD3,
                                new { @class = "form-control", @id = "txtAddress3" })
                            </div>

                            <div class="form-col-20">
                                <label>City</label>
                                @Html.TextBoxFor(m => m.unbL_HED.city,
                                new { @class = "form-control", @id = "txtCity" })
                            </div>

                            <div class="form-col-20">
                                <label>Pin</label>
                                @Html.TextBoxFor(m => m.unbL_HED.pin,
                                new { @class = "form-control", @id = "txtPin" })
                            </div>

                        </div>
                        <div class="form-row">

                            <!-- PO No & Date -->
                            <div class="form-col-33 mt-3">
                                <label>PO No. &amp; Date</label>
                                <div class="d-flex">
                                    @Html.TextBoxFor(m => m.unbL_HED.partY_ORDER_NO,
                                    new { @class = "form-control mr-2", style = "flex:1;" })

                                    <div class="date-field" style="flex:1;">
                                        @Html.TextBoxFor(m => m.unbL_HED.partY_ORDER_DT, "{0:dd-MM-yyyy}",
                                        new { @class = "form-control", @id = "txtPODate" })
                                        <img src="~/Content/assets/images/calendar.png"
                                             class="calendar-icon"
                                             data-target="PODate" />
                                    </div>
                                </div>
                            </div>

                            <!-- C/Note No & Date -->
                            <div class="form-col-33 mt-3">
                                <label>C/Note No. &amp; Date</label>
                                <div class="d-flex">
                                    @Html.TextBoxFor(m => m.unbL_HED.cnotE_NO,
                                    new { @class = "form-control mr-2", style = "flex:1;" })

                                    <div class="date-field" style="flex:1;">
                                        @Html.TextBoxFor(m => m.unbL_HED.cnotE_DT, "{0:dd-MM-yyyy}",
                                        new { @class = "form-control", @id = "txtCDate" })
                                        <img src="~/Content/assets/images/calendar.png"
                                             class="calendar-icon"
                                             data-target="CDate" />
                                    </div>
                                </div>
                            </div>

                            <!-- Chalan No & Date -->
                            <div class="form-col-33 mt-3">
                                <label>Chalan No. &amp; Date</label>
                                <div class="d-flex">
                                    @Html.TextBoxFor(m => m.unbL_HED.challaN_NO,
                                    new { @class = "form-control mr-2", style = "flex:1;" })

                                    <div class="date-field" style="flex:1;">
                                        @Html.TextBoxFor(m => m.unbL_HED.challaN_DT, "{0:dd-MM-yyyy}",
                                        new { @class = "form-control", @id = "txtChalanDate" })
                                        <img src="~/Content/assets/images/calendar.png"
                                             class="calendar-icon"
                                             data-target="ChalanDate" />
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="form-row ">
                            <div class="form-col-100 mt-3">
                                <label>Remarks</label>
                                @Html.TextBoxFor(m => m.unbL_HED.remarks, new { @class = "form-control ", @id = "txtRemarks" })
                            </div>
                        </div>
                    </div>
                    <div class="accordion">
                        <div class="accordion-header"><span class="txt">Lines</span></div>
                        <div class="accordion-body active" style="display:block;">
                            <div class="action-btns">
                                <ul>
                                    <li><a href="#" id="btnAddRow"><i class="fa fa-plus"></i> Add</a></li>
                                    <li><a href="#" id="btnRemoveAll"><i class="fa fa-trash-o"></i> Remove</a></li>
                                    <li> <a href="javascript:void(0)" data-popup="Freedetails" id="btnFreedetails">  <i class="fa fa-credit-card"></i> Free Details </a> </li>
                                </ul>
                            </div>
                            <div id="tableContainer" style="overflow-x:auto;">
                                <table id="mainTable" class="table table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="width: auto !important;"></th>
                                            <th style="width: auto !important;">Sl No</th>
                                            <th style="width: auto;">Item<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Item Name<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Item Descn</th>
                                            <th style="width: auto;">MRP<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Mfg Date<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Batch No<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Quantity<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto; ">Gross Wt<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Net Wt<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Rate<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">Disc %</th>
                                            <th style="width: auto;">Disc Amt</th>
                                            @*
                                                <th style="width:10px;" hidden>T Rate</th>
                                                <th style="width:10px;" hidden>T Amt</th>*@
                                            <th style="width: auto;">Amount<spam style="color:red">(*)</spam></th>
                                            <th style="width: auto;">GST</th>
                                            <th style="width: auto;">GST Amt</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabledetail">
                                        @Html.Partial("_PT_Detail_Table", Model.unbl)
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="popup-overlay">

                    <div id="Freedetails" class="popup-box">

                        <div class="popup-header">
                            <h2>Free Details</h2>
                            <button class="close-btn" type="button">X</button>
                        </div>

                        <div class="search-box">
                            <div class="search">
                                <input type="text" id="searchInput" placeholder="Search" />

                                <div class="btncontent">
                                    <button class="searchbtn" type="button">
                                        <i class="fa fa-search"></i>
                                    </button>

                                    <button class="clearbtn" type="button">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>

                        </div>
                        <div class="accordion-body active" style="display:block;">
                            <div class="action-btns">
                                <ul>
                                    <li><a href="#" id="btnAddFreeRow"><i class="fa fa-plus"></i> Add</a></li>
                                    <li><a href="#" id="btnRemoveFreeRow"><i class="fa fa-trash-o"></i> Remove</a></li>
                                </ul>

                            </div>

                            <div id="tableContainer" style="overflow-x:auto;">
                                <table id="freeDetailTable" class="table table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="width:35px;">
                                                <input type="checkbox" id="chkAllFree" />
                                            </th>
                                            <th style="width:60px;">Sl No</th>
                                            <th style="width:120px;">Code</th>
                                            <th style="width:120px;">Description</th>
                                            <th style="width:120px;">Quantity</th>
                                            <th style="width:120px;">Rate</th>
                                            <th style="width:120px;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblFreeDetail">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="bottom-btn">
                            <button class="btn-blue" type="button" id="btnFreeOk">OK</button>
                            <button id="btnFreeCancel" class="btn-white" type="button">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Controllers/Test/assets/js/jquery-ui.js"></script>
    <script src="~/Controllers/Test/assets/js/custom.js"></script>

    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <script>
        var freeTeaData = [];
    </script>
    <script>
