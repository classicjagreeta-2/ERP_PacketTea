@using PacketTea.Utility
@model List<Finance.Controllers.TEA.InvDocRow>

@{
    string tran = (string)ViewBag.Tran ?? "1";
    string tranName = (string)ViewBag.TranName ?? "Other Invoice";
    string listAction = (string)ViewBag.ListAction ?? "Index";
    bool isNote = tran != "1";
    ViewBag.Title = tranName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var docTypes = (Dictionary<string, string>)ViewBag.DocTypes ?? new Dictionary<string, string>();
    var unitList = (List<PacketTea.Models.PT.UnitOption>)ViewBag.UnitList ?? new List<PacketTea.Models.PT.UnitOption>();
    const int colCount = 15;
    // AEDV gating of the toolbar buttons (UX only -- the controller re-checks every right).
    var perm = ViewBag.Permission as PacketTea.Helpers.AEDV;
    Func<bool, string> denied = ok => ok ? "" : "pointer-events:none; opacity:0.5;";
}

@{
    // Sortable column header -- server-side sort (the API's GetByPage sortBy/sortDir),
    // same as Master Blend Entry's list: a header sorts the whole filtered result set.
    Func<string, string, string, MvcHtmlString> SortTh = (key, label, extraClass) =>
    {
        var cur = (string)(ViewBag.SortBy ?? "");
        var dir = (string)(ViewBag.SortDir ?? "");
        var active = string.Equals(cur, key, StringComparison.OrdinalIgnoreCase);
        var next = (active && dir == "asc") ? "desc" : "asc";
        var thClass = (active ? "sortable is-sorted" : "sortable") + (string.IsNullOrEmpty(extraClass) ? "" : " " + extraClass);
        var up = (active && dir == "asc") ? "feather icon-arrow-up on" : "feather icon-arrow-up";
        var down = (active && dir != "asc") ? "feather icon-arrow-down on" : "feather icon-arrow-down";
        return MvcHtmlString.Create(
            "<th class=\"" + thClass + "\" data-sort=\"" + key + "\" data-dir=\"" + next +
            "\" title=\"Sort by " + label + "\"><span class=\"th-label\">" + label +
            "</span><span class=\"sort-arrows\"><i class=\"" + up + "\"></i><i class=\"" +
            down + "\"></i></span></th>");
    };
    Func<decimal?, string> N2 = v => (v ?? 0m).ToString("N2");
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <style>
        /* Same list metrics as Master Blend Entry / Purchase Order. */
        .table.table-sm td, .table.table-sm th { padding: 0.6rem; }
        tbody div { overflow: unset !important; height: auto !important; max-height: none !important; }
        .btn-link { font-weight: 500; color: black; border-radius: 0; }

        table.main-table th, table.main-table td {
            padding: 6px; font-size: 12px; line-height: 1.3;
            height: 30px; box-sizing: border-box; vertical-align: middle;
        }
        table.main-table td .row-expand-btn { font-size: 12px; line-height: 1.3; }
        table.main-table td .row-check { margin: 0; vertical-align: middle; }
        table.main-table th.num, table.main-table td.num { text-align: right; white-space: nowrap; }

        .table-responsive thead th.sortable { cursor: pointer; user-select: none; }
        .table-responsive thead th.sortable:hover { background-color: #4b5b7a; }
        .table-responsive thead th.is-sorted { background-color: #4b5b7a; }
        th.sortable .sort-arrows { margin-left: 6px; white-space: nowrap; }
        th.sortable .sort-arrows i { font-size: 12px; color: rgba(255,255,255,.45); vertical-align: middle; }
        th.sortable .sort-arrows i.on { color: #fff; }

        table.detail-sub-table { width: 100%; border-collapse: collapse; }
        table.detail-sub-table th, table.detail-sub-table td { border: 1px solid #ddd; padding: 6px; white-space: nowrap; }
        table.detail-sub-table thead th { background-color: #404e68; color: #fff; font-weight: bold; }
        table.detail-sub-table .num { text-align: right; }

        /* Right-aligned "LIST" badge of the standard list toolbar (same look as Packing Entry's). */
        .list-badge { display: inline-block; background: #2c3958; color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .05em; padding: 5px 10px; border-radius: 4px; margin: 6px 10px; }
        /* Chunked list (same behaviour as ERP_Inventory's Purchase Order list): fixed-height
           scroll box with a sticky header; the next chunk of rows loads when the box is
           scrolled to the bottom -- see Scripts/list-infinite-scroll.js. */
        #tableScroll { max-height: calc(100vh - 380px); min-height: 240px; overflow: auto; }
        #tableScroll table.main-table thead th { position: sticky; top: 0; z-index: 3; }
        /* The "New" inline row -- pick Unit + Type first (inputpicker dropdowns), then the pencil
           (enabled only once both are chosen) opens the entry screen with both locked in. */
        tr.new-entry-row td { background-color: #eef3ff; vertical-align: middle; }
        tr.new-entry-row input.new-row-pick { border: 1px solid #dde2ea; border-radius: 6px; padding: 6px 8px; font-size: 13px; width: 100%; box-sizing: border-box; }
        /* jquery.inputpicker wraps each input in a div with inline overflow:auto; inside the
           narrow cell the input + arrow overflow it and native scrollbars blow the row up. Clip it. */
        tr.new-entry-row .inputpicker-overflow-hidden, tr.new-entry-row .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        tr.new-entry-row input.new-row-pick { min-width: 240px; }
        #inputpicker-wrapped-list { min-width: 300px; }
        tr.new-entry-row .go-new { font-size: 15px; cursor: not-allowed; color: #aab2c0; }
        tr.new-entry-row .go-new.is-ready { cursor: pointer; color: #404e68; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="action-btns">
            <ul>
                <li><a href="@Url.Action("Index", "Menu")"><i class="fa fa-arrow-left"></i> Back</a></li>
                <li><a href="javascript:void(0)" id="btnNew" style="@(denied(perm?.Add ?? false))"><i class="fa fa-plus"></i> New</a></li>
                <li><a href="javascript:void(0)" id="editBtn" style="@(denied(perm?.Edit ?? false))"><i class="fa fa-pencil"></i> Edit</a></li>
                <li><a href="javascript:void(0)" id="deleteBtn" style="@(denied(perm?.Delete ?? false))"><i class="fa fa-trash-o"></i> Delete</a></li>
                <li><a href="javascript:void(0)" id="viewBtn" style="@(denied(perm?.View ?? false))"><i class="fa fa-eye"></i> View</a></li>
                <li><a href="javascript:void(0)" id="linesBtn" title="Show the ticked row's lines"><i class="fa fa-list"></i> Lines</a></li>
                <li style="margin-left:auto"><span class="list-badge">LIST</span></li>
            </ul>
        </div>

        <div class="title-heading">@tranName</div>

        <div style="display: flex; justify-content: flex-end; width: 100%; margin-bottom: 15px;">
            <div style="position: relative; width: 300px;">
                <input type="text" id="searchInput" value="@ViewBag.CurrentFilter" placeholder="Search Doc No / Party / Type / Unit / Date"
                       style="width: 100%; padding: 6px 40px 6px 10px; border: 1px solid #ccc; border-radius: 4px;" />
                <i class="fa fa-search" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: #333;"></i>
            </div>
        </div>

        <div class="table-responsive" id="tableScroll">
            <table class="border main-table" id="invTable">
                <thead>
                    <tr>
                        <th style="width:26px;"></th>
                        <th style="width:26px;"></th>
                        @SortTh("UNIT", "Unit", "")
                        @SortTh("DOCNO", "Doc No", "")
                        @SortTh("DOCDT", "Date", "")
                        @SortTh("DOCTYPE", "Type", "")
                        @SortTh("PARTY", "Party", "")
                        @SortTh("CONTRACT_NO", isNote ? "Invoice No" : "Contract No", "")
                        <th>@(isNote ? "Invoice Date" : "Vehicle No")</th>
                        @SortTh("TAXABLE_AMT", "Taxable Amt", "num")
                        <th class="num">GST Amt</th>
                        <th class="num">TCS Amt</th>
                        <th class="num">Round Off</th>
                        @SortTh("TOTAL_AMT", "Net Amt", "num")
                        <th>IRN</th>
                    </tr>
                </thead>
                <tbody id="listBody">
                    @Html.Partial("_ListRows", Model)
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr><td colspan="@colCount" style="text-align:center;">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            int pageSize = (int)ViewBag.PageSize;
            int rowCount = (int)ViewBag.RowCount;
        }
        <div id="listLoading" style="display:none;text-align:center;padding:8px 0 0;color:#666;font-size:12.5px;">Loading...</div>
        <div class="dataTables_info" style="padding:10px 20px 0;">Showing <span id="shownCount">@(Model?.Count ?? 0)</span> of @rowCount</div>
    </div>

    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <script src="~/Scripts/list-new-row-pickers.js"></script>
    <script src="~/Scripts/list-infinite-scroll.js"></script>
    <script>
        $(function () {
            var TRAN = '@tran';
            var LIST_URL = '@Url.Action(listAction, "OtherInvoice")';
            var ENTRY_URL = '@Url.Action("InsertOrUpdate", "OtherInvoice")';

            function fmt3(v) { var n = parseFloat(v); return (isNaN(n) ? 0 : n).toLocaleString('en-IN', { minimumFractionDigits: 3, maximumFractionDigits: 3 }); }
            function fmt2(v) { var n = parseFloat(v); return (isNaN(n) ? 0 : n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
            function esc(v) { return $('<div>').text(v == null ? '' : v).html(); }

            var searchTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () { reload(); }, 400);
            });

            // Search / sort reload the page from the first chunk (the Unit scope is applied
            // server-side -- see OtherInvoiceController.List).
            var SORT_BY = '@(ViewBag.SortBy ?? "")', SORT_DIR = '@(ViewBag.SortDir ?? "")';
            function reload(sortBy, sortDir) {
                var by = (sortBy === undefined) ? SORT_BY : sortBy;
                var dir = (sortDir === undefined) ? SORT_DIR : sortDir;
                window.location.href = LIST_URL
                    + '?searchString=' + encodeURIComponent($('#searchInput').val())
                    + '&sortBy=' + encodeURIComponent(by || '')
                    + '&sortDir=' + encodeURIComponent(dir || '');
            }

            $('#invTable').on('click', 'thead th.sortable', function () {
                reload($(this).data('sort'), $(this).data('dir'));
            });

            // Chunked loading: the first chunk is rendered with the page, further chunks are
            // appended as the list is scrolled to the bottom (Scripts/list-infinite-scroll.js).
            // Sorting is server-side, so each chunk request carries the current sort.
            initInfiniteList({
                scroll: '#tableScroll', body: '#listBody', loading: '#listLoading', count: '#shownCount',
                url: LIST_URL,
                search: $('#searchInput').val(), pageSize: @pageSize, total: @rowCount, startPage: 1,
                extra: { sortBy: SORT_BY, sortDir: SORT_DIR }
            });

            // "+" toggle -- the document's item lines, fetched fresh on every open through the API's
            // lean GetRowLines (one call, the row's own Year / Unit / Type / Doc No).
            function openDetail($btn) {
                var $detail = $('#' + $btn.data('target'));
                $detail.show();
                $btn.removeClass('fa-plus').addClass('fa-minus');
                var $body = $detail.find('.detail-items-body');
                $.get('@Url.Action("GetRowDetail", "OtherInvoice")', {
                    docYear: $detail.data('docyear'), unit: $detail.data('unit'),
                    doctype: $detail.data('doctype'), docno: $detail.data('docno')
                }).done(function (r) {
                    if (!r || !r.success) {
                        $body.html('<tr><td colspan="15" style="text-align:center;color:#666;">Unable to load item lines.</td></tr>');
                        return;
                    }
                    var items = r.details || [];
                    if (!items.length) {
                        $body.html('<tr><td colspan="15" style="text-align:center;color:#666;">No item lines</td></tr>');
                        return;
                    }
                    $body.empty();
                    items.forEach(function (d, i) {
                        $('<tr>').append(
                            '<td>' + (d.SRLNO != null ? d.SRLNO : (i + 1)) + '</td>',
                            '<td>' + esc(d.ITCD) + (d.ITEM_NAME ? ' - ' + esc(d.ITEM_NAME) : '') + '</td>',
                            '<td>' + esc(d.ITDESC1) + '</td>',
                            '<td>' + esc(d.HSN_CODE) + '</td>',
                            '<td class="num">' + fmt3(d.QTY) + '</td>',
                            '<td>' + esc(d.UNIT_DESC) + '</td>',
                            '<td class="num">' + fmt2(d.RATE) + '</td>',
                            '<td class="num">' + fmt2(d.AMT) + '</td>',
                            '<td>' + esc(d.GST_CODE) + '</td>',
                            '<td class="num">' + fmt2(d.CGST_AMT) + '</td>',
                            '<td class="num">' + fmt2(d.SGST_AMT) + '</td>',
                            '<td class="num">' + fmt2(d.IGST_AMT) + '</td>',
                            '<td class="num">' + fmt2(d.GCESS_AMT) + '</td>',
                            '<td class="num">' + fmt2(d.TCS_AMT) + '</td>',
                            '<td class="num">' + fmt2(d.TOT_AMT) + '</td>'
                        ).appendTo($body);
                    });
                }).fail(function () {
                    $body.html('<tr><td colspan="15" style="text-align:center;color:#666;">Unable to load item lines.</td></tr>');
                });
            }
            function closeDetail($btn) {
                $('#' + $btn.data('target')).hide();
                $btn.removeClass('fa-minus').addClass('fa-plus');
            }
            // Delegated: rows appended by the infinite scroll need the handler too.
            $('#invTable').on('click', '.row-expand-btn', function () {
                var $btn = $(this);
                if ($('#' + $btn.data('target')).is(':visible')) closeDetail($btn); else openDetail($btn);
            });

            // =========================================================
            // "New" inline row -- same flow as Master Blend Entry: pick Unit + Type
            // (the document type) here, then the pencil opens the entry screen
            // with both locked.
            // =========================================================
            var UNIT_LIST = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unitList));
            var TYPES = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(docTypes));

            function buildNewRow() {
                // Unit + Type are inputpicker dropdowns (searchable by Code and Name) -- initialised
                // right after the row is inserted, see initNewRowPickers().
                return '<tr id="newUnitRow" class="new-entry-row">' +
                    '<td colspan="2" style="text-align:center;"><i class="fa fa-pencil go-new" title="Open @tranName"></i></td>' +
                    // Unit picker spans 3 columns so the "CODE - Name" text isn't clipped; the table's own
                    // columns are untouched.
                    '<td colspan="3"><input type="text" id="newRowUnit" class="new-row-pick" placeholder="Select Unit" autocomplete="off" /></td>' +
                    '<td colspan="2"><input type="text" id="newRowPacketType" class="new-row-pick" placeholder="Select Type" autocomplete="off" /></td>' +
                    '<td colspan="@(colCount - 7)"></td>' +
                    '</tr>';
            }
            function refreshGoNewState() {
                $('.go-new').toggleClass('is-ready', !!$('#newRowUnit').val() && !!$('#newRowPacketType').val());
            }
            $('#btnNew').on('click', function () {
                if ($('#newUnitRow').length) return;
                $('#listBody').prepend(buildNewRow());
                initNewRowPickers({ units: UNIT_LIST, types: TYPES });   // also pre-selects a single Unit
                refreshGoNewState();
            });
            $('#invTable').on('change', '#newRowUnit, #newRowPacketType', refreshGoNewState);
            $('#invTable').on('click', '.go-new', function () {
                var unit = $('#newRowUnit').val(), type = $('#newRowPacketType').val();
                if (!unit) { alert('Please select Unit first'); return; }
                if (!type) { alert('Please select Type first'); return; }
                window.location.href = ENTRY_URL + '?tran=' + TRAN
                    + '&unit=' + encodeURIComponent(unit) + '&doctype=' + encodeURIComponent(type);
            });

            // Row selection is checkboxes -- Edit / Delete / View / Lines only make sense against
            // exactly one row.
            function getSingleChecked(action) {
                var $c = $('.row-check:checked');
                if ($c.length === 0) { alert('Please select a record to ' + action + '.'); return null; }
                if ($c.length > 1) { alert('Please select only one record to ' + action + '.'); return null; }
                return $c;
            }
            // The row's Year + Unit + Type travel with Edit / View / Delete: a Doc No repeats across
            // units, so a document is identified by Year + Unit + Type + Doc No.
            function entryUrl($c, view) {
                return ENTRY_URL + '?tran=' + TRAN
                    + '&docYear=' + encodeURIComponent($c.data('docyear'))
                    + '&unit=' + encodeURIComponent($c.data('unit'))
                    + '&doctype=' + encodeURIComponent($c.data('doctype'))
                    + '&docno=' + encodeURIComponent($c.val())
                    + (view ? '&view=true' : '');
            }
            function goEdit($c) { window.location.href = entryUrl($c, false); }
            function goView($c) { window.location.href = entryUrl($c, true); }
            function doDelete($c) {
                if (!confirm('Are you sure to Cancel ' + $c.data('doctype') + ' ' + $c.val() + ' ?\nIts accounting voucher will be removed as well.')) return;
                $('<form>', { method: 'POST', action: '@Url.Action("Delete", "OtherInvoice")' })
                    .append($('<input>', { type: 'hidden', name: 'tran', value: TRAN }))
                    .append($('<input>', { type: 'hidden', name: 'docYear', value: $c.data('docyear') }))
                    .append($('<input>', { type: 'hidden', name: 'unit', value: $c.data('unit') }))
                    .append($('<input>', { type: 'hidden', name: 'doctype', value: $c.data('doctype') }))
                    .append($('<input>', { type: 'hidden', name: 'docno', value: $c.val() }))
                    .appendTo('body').submit();
            }

            $('#editBtn').on('click', function () {
                var $c = getSingleChecked('edit'); if (!$c) return;
                if ($c.data('irn') === 'Y') { alert('e-Invoice (IRN) already generated for ' + $c.val() + ' -- it cannot be edited.'); return; }
                goEdit($c);
            });
            $('#viewBtn').on('click', function () { var $c = getSingleChecked('view'); if ($c) goView($c); });
            $('#deleteBtn').on('click', function () {
                var $c = getSingleChecked('delete'); if (!$c) return;
                if ($c.data('irn') === 'Y') { alert('e-Invoice (IRN) already generated for ' + $c.val() + ' -- it cannot be deleted.'); return; }
                doDelete($c);
            });

            // Lines: open the ticked row's "+" expand panel (its item lines) and scroll it into view.
            $('#linesBtn').on('click', function () {
                var $c = getSingleChecked('view its lines'); if (!$c) return;
                var $btn = $c.closest('tr').find('.row-expand-btn');
                if ($btn.hasClass('fa-plus')) openDetail($btn);
                var $detail = $('#' + $btn.data('target'));
                if ($detail.length && $detail[0].scrollIntoView) $detail[0].scrollIntoView({ block: 'nearest' });
            });
        });
    </script>
</body>
</html>
