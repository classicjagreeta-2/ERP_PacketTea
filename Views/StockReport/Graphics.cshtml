@model PacketTea.Models.PT.StockReportResult
@{
    Layout = null;

    // VB6 printed this through a Crystal report (Rep_fullsmove_depo, A4 landscape).
    // Same data, laid out as fixed-height landscape pages with the company header
    // and "Page: n" on each one. Kinds: D = item row, L = rule, G = grand total.
    const int LinesPerPage = 34;
    var lines = new List<object[]>();
    if (Model.Rows != null)
    {
        foreach (var r in Model.Rows) { lines.Add(new object[] { "D", r }); }
        lines.Add(new object[] { "L" });
        foreach (var r in Model.Totals) { lines.Add(new object[] { "G", r }); }
        lines.Add(new object[] { "L" });
    }
    var pages = new List<List<object[]>>();
    for (int i = 0; i < lines.Count; i += LinesPerPage)
    {
        pages.Add(lines.GetRange(i, Math.Min(LinesPerPage, lines.Count - i)));
    }
    Func<decimal, string> N = v => v == 0 ? "" : v.ToString("0.00");
    Func<PacketTea.Models.PT.StockReportRow, decimal[]> Vals = r => new[] {
        r.OP, r.PROD, r.PURCH, r.MRETU, r.TOTAL_RECT, r.LOADOUT, r.CHECKIN, r.DIRECT_SALE, r.INDIRECT_SALE,
        r.TRANS, r.PURCH_RETU, r.TOTAL_DESP, r.ADJ, r.SAMPLE, r.BKG_LKG, r.SHT, r.TOTAL_OUT, r.CL_STOCK, r.GAIN_LOSS };
    string[] h1 = { "Opening", "", "", "Market", "Total", "Load", "Check", "Direct", "", "", "Purch.", "Total", "", "", "Bkg./", "", "Total", "Closing", "Gain/" };
    string[] h2 = { "Balance", "Production", "Purchase", "Return", "Receipt", "Out", "In", "Sale", "Sale", "Transfers", "Return", "Despatch", "Adjust.", "Sample", "Lkg.", "Shortage", "Out", "Stock", "Loss" };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Stock Report @Model.FromDate - @Model.ToDate</title>
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: "Arial Narrow", Arial, sans-serif; font-stretch: condensed; color: #000; }
        .toolbar { position: sticky; top: 0; z-index: 2; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; font-family: Arial, sans-serif; font-size: 13px; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 281mm; min-height: 194mm; margin: 12px auto; padding: 7mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.25); font-size: 10px; }
        .hd { position: relative; line-height: 1.45; font-size: 11px; }
        .hd .pg { position: absolute; right: 0; top: 1.45em; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        td, th { padding: 1px 2px; white-space: nowrap; overflow: hidden; font-weight: normal; text-align: right; line-height: 1.45; }
        td.l, th.l { text-align: left; }
        thead tr:first-child th { border-top: 1px solid #000; padding-top: 4px; }
        thead tr:last-child th { border-bottom: 1px solid #000; padding-bottom: 4px; }
        .rule td { padding: 0; height: 6px; border-bottom: 1px solid #000; }
        .gt td { font-weight: bold; }
        .neg { color: #c00; }
        .note { margin-top: 6px; color: #555; }
        .err { font-family: Arial, sans-serif; margin: 40px auto; width: 420px; background: #fff; padding: 24px; border-left: 4px solid #c00; }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { margin: 0; box-shadow: none; width: auto; min-height: 0; padding: 0; page-break-after: always; }
            .sheet:last-child { page-break-after: auto; }
            .neg { color: #000; }
        }
    </style>
</head>
<body>
    @if (ViewBag.Error != null)
    {
        <div class="err"><b>Stock Report</b><br /><br />@ViewBag.Error</div>
    }
    else
    {
        <div class="toolbar">
            <button type="button" onclick="window.print()">Print</button>
            <span>Stock Report @Model.FromDate to @Model.ToDate &nbsp;|&nbsp; Unit: @Model.Units &nbsp;|&nbsp; @pages.Count page(s)</span>
        </div>

        for (int p = 0; p < pages.Count; p++)
        {
            <div class="sheet">
                <div class="hd">
                    <div>@Model.Company</div>
                    <div>@Model.Address</div>
                    <div class="pg">Page: @(p + 1)</div>
                    <div><b>Stock Report</b></div>
                    <div>For the period @Model.FromDate To @Model.ToDate &nbsp; [Unit: @Model.Units]</div>
                </div>
                <table>
                    <colgroup>
                        <col style="width:4.2%" />
                        <col style="width:14%" />
                        <col style="width:4.6%" />
                        @for (int c = 0; c < 19; c++)
                        {
                            <col />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="l">Item</th>
                            <th class="l">Item</th>
                            <th class="l"></th>
                            @foreach (var t in h1)
                            {
                                <th>@t</th>
                            }
                        </tr>
                        <tr>
                            <th class="l">Code</th>
                            <th class="l">Description</th>
                            <th class="l">Type</th>
                            @foreach (var t in h2)
                            {
                                <th>@t</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ln in pages[p])
                        {
                            var kind = (string)ln[0];
                            if (kind == "L")
                            {
                                <tr class="rule"><td colspan="22"></td></tr>
                            }
                            else
                            {
                                var r = (PacketTea.Models.PT.StockReportRow)ln[1];
                                <tr class="@(kind == "G" ? "gt" : "")">
                                    <td class="l">@r.ITCD</td>
                                    <td class="l" title="@r.DESCN">@r.DESCN</td>
                                    <td class="l">@r.TypeText</td>
                                    @foreach (var v in Vals(r))
                                    {
                                        <td class="@(v < 0 ? "neg" : "")">@N(v)</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @if (p == pages.Count - 1)
                {
                    if (Model.Skipped != null && Model.Skipped.Count > 0)
                    {
                        <div class="note">Not included (table not found in this schema): @string.Join(", ", Model.Skipped)</div>
                    }
                    <div class="note" style="color:#000">Rundate @Model.RunAt &nbsp;&nbsp; User @Model.RunBy</div>
                }
            </div>
        }
    }
</body>
</html>
