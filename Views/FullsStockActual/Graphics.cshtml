@model PacketTea.Models.PT.FullsStockReport
@{
    Layout = null;

    // VB6 PRINTREPORT/prnpg layout, flattened into printable lines and cut into
    // pages of a fixed height (a rule line takes one line, like VB6 pgchk).
    // Kinds: D = batch row, L = rule line, T = item total, G = grand total,
    // K = legend, B = blank.
    const int LinesPerPage = 50;
    var lines = new List<object[]>();
    if (Model.Items != null)
    {
        foreach (var it in Model.Items)
        {
            var first = true;
            foreach (var l in it.Lines)
            {
                lines.Add(new object[] { "D", first ? it.ITCD : "", first ? it.NAME : "", l });
                first = false;
            }
            lines.Add(new object[] { "L" });
            lines.Add(new object[] { "T", it });
            lines.Add(new object[] { "L" });
        }
        lines.Add(new object[] { "G" });
        lines.Add(new object[] { "L" });
        lines.Add(new object[] { "K", " ** - ", "DOD Date over" });
        lines.Add(new object[] { "K", "*** - ", "BBD Date over" });
        lines.Add(new object[] { "B" });
    }
    var pages = new List<List<object[]>>();
    for (int i = 0; i < lines.Count; i += LinesPerPage)
    {
        pages.Add(lines.GetRange(i, Math.Min(LinesPerPage, lines.Count - i)));
    }
    Func<decimal, string> N = v => v.ToString("0.00");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fulls Stock Actual - @Model.AsOn</title>
    <style>
        @@page { size: A4 portrait; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: "Arial Narrow", Arial, sans-serif; font-stretch: condensed; color: #000; }
        .toolbar { position: sticky; top: 0; z-index: 2; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; font-family: Arial, sans-serif; font-size: 13px; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 194mm; min-height: 277mm; margin: 12px auto; padding: 8mm 8mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.25); font-size: 11px; }
        .hd { position: relative; line-height: 1.45; }
        .hd .pg { position: absolute; right: 0; top: 1.45em; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        td, th { padding: 1px 3px; white-space: nowrap; overflow: hidden; font-weight: normal; text-align: left; line-height: 1.45; }
        th { border-top: 1px solid #000; border-bottom: 1px solid #000; padding-top: 5px; padding-bottom: 5px; }
        .r { text-align: right; }
        .rule td { padding: 0; height: 9px; }
        .rule td.ln { border-bottom: 1px solid #000; }
        .tot td.nm { padding-left: 34px; }
        .err { font-family: Arial, sans-serif; margin: 40px auto; width: 420px; background: #fff; padding: 24px; border-left: 4px solid #c00; }
        .foot { margin-top: 6px; }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { margin: 0; box-shadow: none; width: auto; min-height: 0; padding: 0; page-break-after: always; }
            .sheet:last-child { page-break-after: auto; }
        }
    </style>
</head>
<body>
    @if (ViewBag.Error != null)
    {
        <div class="err"><b>Fulls Stock Actual</b><br /><br />@ViewBag.Error</div>
    }
    else
    {
        <div class="toolbar">
            <button type="button" onclick="window.print()">Print</button>
            <span>Fulls Stock (Actual) closing report as on @Model.AsOn &nbsp;|&nbsp; Unit: @Model.Unit &nbsp;|&nbsp; @pages.Count page(s)</span>
        </div>

        for (int p = 0; p < pages.Count; p++)
        {
            <div class="sheet">
                <div class="hd">
                    <div>@Model.Company</div>
                    <div>@Model.Address</div>
                    <div class="pg">Page: @(p + 1)</div>
                    <div>FULLS STOCK (Actual) CLOSING REPORT AS ON @Model.AsOn</div>
                </div>
                <table>
                    <colgroup>
                        <col style="width:7%" />
                        <col style="width:24%" />
                        <col style="width:5%" />
                        <col style="width:9%" />
                        <col style="width:10%" />
                        <col style="width:9%" />
                        <col style="width:8%" />
                        <col style="width:8%" />
                        <col style="width:8.5%" />
                        <col style="width:8.5%" />
                        <col style="width:4%" />
                        <col style="width:4%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>ITCD</th>
                            <th>DESCRIPTION</th>
                            <th>MRP</th>
                            <th>MFG. DATE</th>
                            <th>BATCH NO</th>
                            <th class="r">QUANTITY</th>
                            <th class="r">Gross Wt</th>
                            <th class="r">Net Wt</th>
                            <th>DOD</th>
                            <th>BBD</th>
                            <th class="r">Age</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ln in pages[p])
                        {
                            var kind = (string)ln[0];
                            if (kind == "D")
                            {
                                var d = (PacketTea.Models.PT.FullsStockLine)ln[3];
                                <tr>
                                    <td>@ln[1]</td>
                                    <td title="@ln[2]">@ln[2]</td>
                                    <td>@d.MRP</td>
                                    <td>@d.MFGDT</td>
                                    <td>@d.BATCHNO</td>
                                    <td class="r">@N(d.QTY)</td>
                                    <td class="r">@N(d.GROSS_WEIGHT)</td>
                                    <td class="r">@N(d.NET_WEIGHT)</td>
                                    <td>@d.DOD</td>
                                    <td>@d.BBD</td>
                                    <td class="r">@(string.IsNullOrEmpty(d.MFGDT) ? "0" : d.AGE.ToString())</td>
                                    <td>@d.STATUS</td>
                                </tr>
                            }
                            else if (kind == "L")
                            {
                                <tr class="rule"><td class="ln" colspan="11"></td><td></td></tr>
                            }
                            else if (kind == "T")
                            {
                                var t = (PacketTea.Models.PT.FullsStockItem)ln[1];
                                <tr class="tot">
                                    <td></td>
                                    <td class="nm">Total</td>
                                    <td colspan="3"></td>
                                    <td class="r">@N(t.QTY)</td>
                                    <td class="r">@N(t.GROSS_WEIGHT)</td>
                                    <td class="r">@N(t.NET_WEIGHT)</td>
                                    <td colspan="4"></td>
                                </tr>
                            }
                            else if (kind == "G")
                            {
                                <tr class="tot">
                                    <td></td>
                                    <td class="nm"><b>Grand Total</b></td>
                                    <td colspan="3"></td>
                                    <td class="r"><b>@N(Model.GRAND_QTY)</b></td>
                                    <td class="r"><b>@N(Model.GRAND_GROSS_WEIGHT)</b></td>
                                    <td class="r"><b>@N(Model.GRAND_NET_WEIGHT)</b></td>
                                    <td colspan="4"></td>
                                </tr>
                            }
                            else if (kind == "K")
                            {
                                <tr><td style="white-space:pre">@ln[1]</td><td colspan="11">@ln[2]</td></tr>
                            }
                            else
                            {
                                <tr><td colspan="12">&nbsp;</td></tr>
                            }
                        }
                    </tbody>
                </table>
                @if (p == pages.Count - 1)
                {
                    <div class="foot">Report: Fulls Stock Actual &nbsp;&nbsp; User: @Model.RunBy &nbsp;&nbsp; Run: @Model.RunAt</div>
                }
            </div>
        }
    }
</body>
</html>
