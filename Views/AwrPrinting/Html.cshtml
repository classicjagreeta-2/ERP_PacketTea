@model PacketTea.Models.PT.AwrPrintingResult
@{
    Layout = null;
    string title = ViewBag.Title as string ?? "Arrival & Weightment Report";
    Func<decimal, string> N = v => v == 0 ? "" : v.ToString("0.000");
    var rows = Model.Rows ?? new List<PacketTea.Models.PT.AwrPrintingRow>();
    var first = rows.Count > 0 ? rows[0] : null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: Calibri, Arial, sans-serif; color: #222; font-size: 12px; }
        .toolbar { position: sticky; top: 0; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 281mm; margin: 12px auto; padding: 7mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
        h1 { font-size: 16px; margin: 0; text-align: center; }
        h2 { font-size: 13px; margin: 2px 0; text-align: center; font-weight: normal; }
        .sub { text-align: center; font-size: 11px; margin: 2px 0 6px; }
        table { border-collapse: collapse; width: 100%; }
        th { background: #404E67; color: #fff; padding: 4px 5px; border: 1px solid #8A94A8; text-align: left; }
        td { border: 1px solid #BBBBBB; padding: 3px 5px; vertical-align: top; }
        td.n, th.n { text-align: right; }
        .awr td { background: #E8EBF1; font-weight: bold; }
        .dmg td { color: #444; font-size: 11px; }
        .foot { margin-top: 8px; font-size: 11px; }
        .err { padding: 40px; font-size: 14px; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; width: auto; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">Print</button><span>@title</span></div>
    @if (ViewBag.Error != null)
    {
        <div class="sheet"><div class="err"><b>Arrival &amp; Weightment Report</b><br /><br />@ViewBag.Error</div></div>
    }
    else
    {
        <div class="sheet">
            @{ var line1 = !string.IsNullOrWhiteSpace(Model.CompanyV) && Model.CompanyV.Trim().Length > 1 ? Model.CompanyV.Trim() : Model.Company; }
            <h1>@line1</h1>
            @if (line1 != Model.Company)
            {
                <h2>@Model.Company</h2>
            }
            @if (first != null)
            {
                <div class="sub">@first.REG_ADDR @(string.IsNullOrEmpty(first.PH_NO) ? "" : " Ph: " + first.PH_NO)</div>
            }
            <h2><b>ARRIVAL &amp; WEIGHTMENT REPORT</b></h2>
            <div class="sub">@title</div>
            <div class="sub">Tea Warehouse &amp; Export Department</div>
            <table>
                <thead>
                    <tr>
                        <th>Invoice No</th><th>Mark</th><th>Grade</th><th>Garden Serial</th>
                        <th class="n">Bags</th><th class="n">Gross Wt</th><th class="n">Net Wt</th><th class="n">Total Net</th>
                        <th class="n">Tare</th><th class="n">Short / Excess</th><th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @{ string cur = null; }
                    @foreach (var x in rows)
                    {
                        if (cur != x.AWR_NO + "|" + x.AWR_DATE)
                        {
                            cur = x.AWR_NO + "|" + x.AWR_DATE;
                            <tr class="awr">
                                <td colspan="11">
                                    AWR No: @x.AWR_NO &nbsp; Date: @x.AWR_DATE &nbsp; Received from: @x.REC_NAME
                                    &nbsp; Transporter: @x.TransName &nbsp; Vehicle: @x.TNO &nbsp; Way Bill: @x.WAY_BILL
                                    &nbsp; Despatch: @x.DESP_NO &nbsp; Broker: @x.BROK_NAME
                                </td>
                            </tr>
                        }
                        <tr>
                            <td>@x.INVNO</td><td>@x.MARK</td><td>@x.GRADE</td><td>@x.GARDEN_SERIAL</td>
                            <td class="n">@x.BAG_CHEST.ToString("0.##")</td><td class="n">@N(x.TGROSS_WT)</td><td class="n">@N(x.NET_WT)</td><td class="n">@N(x.TNET_WT)</td>
                            <td class="n">@N(x.TARE)</td><td class="n">@N(x.SHORT_EXCESS)</td><td>@x.AWR_REMARK</td>
                        </tr>
                        if (!string.IsNullOrWhiteSpace(x.SINGLELINE))
                        {
                            <tr class="dmg"><td colspan="11">@x.SINGLELINE.Trim()</td></tr>
                        }
                    }
                </tbody>
            </table>
            <div class="foot">Abbr.: B.R. broken &amp; repaired condition. L.C. leaky condition. O.S. outwardly sound condition. W.C. weak condition. W.S. water stained.</div>
            <div class="foot">Report: AWR Printing &nbsp; user: @ViewBag.RunBy &nbsp; @ViewBag.RunAt</div>
        </div>
    }
</body>
</html>
