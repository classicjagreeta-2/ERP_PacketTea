@model PacketTea.Models.PT.SampleGainLossResult
@{
    Layout = null;
    string title = ViewBag.Title as string ?? "Sample Gain Loss Register";
    Func<decimal, string> N = v => v == 0 ? "" : v.ToString("0.00");
    var rows = Model.Rows ?? new List<PacketTea.Models.PT.SampleGainLossRow>();
    var line1 = !string.IsNullOrWhiteSpace(Model.CompanyV) && Model.CompanyV.Trim().Length > 1 ? Model.CompanyV.Trim() : Model.Company;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: Calibri, Arial, sans-serif; color: #222; font-size: 12px; }
        .toolbar { position: sticky; top: 0; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 281mm; margin: 12px auto; padding: 7mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
        h1 { font-size: 16px; margin: 0; text-align: center; }
        h2 { font-size: 13px; margin: 2px 0; text-align: center; font-weight: normal; }
        .sub { text-align: center; font-size: 11px; margin: 2px 0 6px; }
        table { border-collapse: collapse; width: 100%; }
        th { background: #404E67; color: #fff; padding: 4px 5px; border: 1px solid #8A94A8; text-align: left; }
        td { border: 1px solid #BBBBBB; padding: 3px 5px; vertical-align: top; }
        td.n, th.n { text-align: right; }
        .tot td { background: #DFE3EC; font-weight: bold; }
        .foot { margin-top: 8px; font-size: 11px; }
        .err { padding: 40px; font-size: 14px; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; width: auto; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">Print</button><span>@title</span></div>
    @if (ViewBag.Error != null)
    {
        <div class="sheet"><div class="err"><b>Sample Gain Loss Register</b><br /><br />@ViewBag.Error</div></div>
    }
    else
    {
        <div class="sheet">
            <h1>@line1</h1>
            <div class="sub">@Model.Address</div>
            <h2><b>@title</b></h2>
            <table>
                <thead>
                    <tr>
                        <th>Sample Letter No</th><th>Date</th><th>Packing No</th><th>Packing Date</th><th>Blend No</th><th>Sale Bill No</th><th>Garden</th><th>Inv No</th>
                        <th class="n">Sample (kg)</th><th class="n">Gain (kg)</th><th class="n">Loss (kg)</th><th>AWR No</th><th>AWR Date</th><th class="n">Short Qty</th><th>MFG Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in rows)
                    {
                        <tr>
                            <td>@x.SAMPLE_LETTER_NO</td><td>@x.SAMPLE_LETTER_DATE</td><td>@x.PACKING_NO</td><td>@x.PACKING_DATE</td><td>@x.BLEND_NO</td>
                            <td>@x.SALE_BILL_NO</td><td>@x.GARDEN</td><td>@x.INVNO</td><td class="n">@N(x.SAMPLE)</td><td class="n">@N(x.GAIN)</td>
                            <td class="n">@N(x.LOSS)</td><td>@x.AWR_NO</td><td>@x.AWR_DATE</td><td class="n">@N(x.SHORT_QTY)</td><td>@x.MFG_DATE</td>
                        </tr>
                    }
                    <tr class="tot">
                        <td colspan="8">Total</td><td class="n">@N(rows.Sum(x => x.SAMPLE))</td><td class="n">@N(rows.Sum(x => x.GAIN))</td>
                        <td class="n">@N(rows.Sum(x => x.LOSS))</td><td></td><td></td><td class="n">@N(rows.Sum(x => x.SHORT_QTY))</td><td></td>
                    </tr>
                </tbody>
            </table>
            <div class="foot">Report: Sample Gain Loss Register &nbsp; user: @ViewBag.RunBy &nbsp; @ViewBag.RunAt</div>
        </div>
    }
</body>
</html>
