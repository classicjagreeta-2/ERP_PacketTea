@model PacketTea.Models.PT.TEA_BLEND_DATA
@using Newtonsoft.Json
@{
    ViewBag.Title = "Master Blend Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blendTypes = (Dictionary<string, string>)ViewBag.BlendTypes;
    bool isEdit = ViewBag.IsEdit ?? false;
    // True only when this window was opened from the list page's "New" inline row
    // (item 2) -- Unit + Packet Type were already chosen there, so Unit and Blend Type (the
    // same value as Packet Type) repeat here read-only instead of Blend Type staying editable
    // and Unit staying invisible.
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    // Opened via the list page's "View" action (spec: add a View button to the list
    // toolbar) -- same record fetch as Edit, but the whole form renders read-only.
    bool isView = ViewBag.IsView ?? false;
    var head = Model.T_TEA_BLEND;
    string approved = (head.APPROVED ?? "").Trim().ToUpper();
    string approvedText = approved == "Y" ? "Approved" : approved == "R" ? "Rejected" : "Pending";
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (see CLAUDE.md's "lookup pickers" rule) -- same
         jquery.inputpicker include PacketTeaPurchaseEntry/InsertOrUpdate.cshtml already
         uses, replacing this screen's earlier bespoke centered-modal picker. -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        /* Small additions purchase-order.css doesn't already cover -- everything else
           (action-btns, accordion, form-row/form-col-*, table.border, popup-overlay/box)
           comes from the shared stylesheet so this page matches the other InsertOrUpdate
           screens (Purchase Order Entry etc.) instead of a one-off look. */
        input[readonly] { background-color: #f3f4f7; color: #555; }
        /* purchase-order.css hard-codes .accordion-container to a fixed 350px scroll
           area, sized for the multi-row Header/Lines accordions -- the standalone
           Unit/Blend Type strip above Header is a single row, so left at
           350px it renders one short row followed by a huge block of empty space
           before "Header" begins. Let this one container size to its own content. */
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        .disp-pair { display: flex; gap: 0; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 90px; }
        /* Inv No / Trans Code lookup buttons -- these two grid columns genuinely have a
           button-triggered popup in trn_blend_sheet.frm's datagrid1 (datagrid1_ButtonClick);
           every other grid column doesn't, so no button is added to them. Plain inline
           sibling of the input (no wrapper div) -- something in the page's shared grid
           CSS/JS distorted the row when these lived inside a flex wrapper div in a <td>. */
        .grid-pick-btn { width: 20px; height: 21px; padding: 0; margin-left: 2px; vertical-align: middle; border: 1px solid #ccc; background: #f4f6fa; cursor: pointer; font-size: 11px; line-height: 1; }
        #gridTable td input.f-invno, #gridTable td input.f-transcode { vertical-align: middle; width: 68px; min-width: 0; }
        /* Trans Code is a readonly cell that opens a picker overlay (see openTransPicker). */
        #gridTable td input.f-transcode { cursor: pointer; width: 100px; }
        .tc-proxy-box .inputpicker-overflow-hidden, .tc-proxy-box .inputpicker-div { overflow: visible !important; height: auto !important; }
        /* Every numeric field, grid and header alike, right-aligned. Amount/Rate are also
           forced to 2 decimal places -- see round2().toFixed(2) in renderGrid(). Number
           inputs already right-align their content in most browsers, but that's
           incidental -- pin it explicitly so it doesn't silently depend on that. */
        #gridTable td input.f-rate, #gridTable td input.f-amount, #gridTable td input.f-qty,
        #gridTable td input.f-bag, #gridTable td input.f-sampleqty,
        input[type="number"] { text-align: right; }
        /* Inv No is populated only via the "Select Data" toolbar link now (item 5) -- no
           free typing, no button, and the cell itself no longer opens the picker either. */
        #gridTable td input.f-invno[readonly] { background-color: #f3f4f7; color: #555; cursor: default; }
        .popup-box.picker-box { width: 420px; display: none; }
        .popup-box.picker-box.wide { width: 700px; max-width: 90vw; }
        .popup-box .picker-body { max-height: 36vh; overflow-y: auto; margin-top: 8px; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 12px; }
        /* No color was ever set here, so the header text just inherited whatever the popup's
           ancestor happened to supply -- washed out to near-illegible once appendTo(body)
           (below) detached these popups from that ancestor. Pin it explicitly. */
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .popup-box .picker-search { margin-bottom: 8px; }
        .stock-filters { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
        .stock-filters input { width: 200px; }
        /* jquery.inputpicker's wrapper divs carry inline overflow:auto -- clip them so the input +
           arrow don't spawn stray scrollbars (same fix as the list pages' "New" row). */
        .stock-filters .inputpicker-overflow-hidden, .stock-filters .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        .stock-filters .inputpicker-div input { display: block; }
        .action-btns li a.is-disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
        /* In-page alert/confirm -- see showAlert()/showConfirm() below. */
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />
    <!-- API's T_TEA_BLEND uses an "assigned" (not auto-generated) id strategy --
         the existing row's ID must be echoed back on update or NHibernate refuses
         to save ("ids for this class must be manually assigned before calling
         save()"). Keep it around so btnSave can resend it. -->
    <input type="hidden" id="ID" value="@head.ID" />
    <input type="hidden" id="fyShortFrom" value="@ViewBag.FyShortFrom" />
    <input type="hidden" id="fyShortTo" value="@ViewBag.FyShortTo" />

    <div class="general-container">
        <div class="purchase-details">

            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "MasterBlendEntry")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "MasterBlendEntry")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li><button type="button" id="btnDoPrint" disabled title="Available once at least one line has a DO No"><i class="fa fa-print"></i> DO Print</button></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Master Blend Entry</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : @(head.DOCNO ?? "")</div>
                    </div>
                    <div class="right">
                        <div>Status : <span id="statusText2">@approvedText</span></div>
                    </div>
                </div>
            </div>

            <!-- Unit / Blend Type -- its own section above Header, always visible (not
                 collapsible away with the rest of Header). Packet Type is the same underlying
                 value as Blend Type (see MasterBlendEntryController's BlendTypes dict), so it is
                 not repeated here -- it is still picked on the list page's "New" row. Unit is
                 otherwise never user-facing (UNIT is derived server-side -- see
                 UnitForBlendType's comment), it's shown here purely for confirmation. Blend Type
                 locks read-only once Unit + Packet Type were chosen on the list page
                 (lockedFromList) and in Edit mode. -->
            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit / Blend Type</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                <input type="text" id="UNIT_disp" value="@head.UNIT" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Blend Type <span>(*)</span></label>
                                <select id="BLEND_TYPE" @((isEdit || lockedFromList) ? "disabled" : "")>
                                    @foreach (var bt in blendTypes)
                                    {
                                        <option value="@bt.Key" selected="@(bt.Key == head.BLEND_TYPE)">@bt.Value (@bt.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">

                <!-- Header -->
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" value="@head.DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Doc Date <span>(*)</span></label>
                                <input type="date" id="DOCDT" value="@head.DOCDT.ToString("yyyy-MM-dd")"
                                       min="@ViewBag.MinDocDate" max="@ViewBag.FyEnd" @(isEdit ? "disabled" : "") />
                            </div>
                            <div class="form-col-20">
                                <label>Party</label>
                                <input type="text" id="PCODE" data-picker="party" value="@head.PCODE" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Party Name</label>
                                <input type="text" id="PCODE_disp" value="@head.PartyName" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Blend No <span>(*)</span></label>
                                <input type="text" id="BLEND_NO" value="@head.BLEND_NO" />
                            </div>
                            <div class="form-col-20">
                                <label>Blend Date <span>(*)</span></label>
                                <input type="date" id="BLEND_DATE" value="@(head.BLEND_DATE?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="form-col-20">
                                <label>Warehouse <span>(*)</span></label>
                                <input type="text" id="BLEND_WH" data-picker="warehouse" value="@head.BLEND_WH" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Warehouse Name</label>
                                <input type="text" id="BLEND_WH_disp" value="@head.WarehouseName" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Allocation</label>
                                <input type="text" id="ALLOC_CODE" data-picker="allocation" value="@head.ALLOC_CODE" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Allocation Description</label>
                                <input type="text" id="ALLOC_CODE_disp" value="@head.AllocationName" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Blend Mark <span>(*)</span></label>
                                <input type="text" id="BLEND_MARK" data-picker="mark" value="@head.BLEND_MARK" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Mark</label>
                                <input type="text" id="BLEND_MARK_disp" value="@head.BlendMarkName" readonly disabled />
                            </div>
                            <div class="form-col-20">
                                <label>Blend Grade <span>(*)</span></label>
                                <input type="text" id="BLEND_GRADE" data-picker="blendgrade" value="@head.BLEND_GRADE" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Grade Name</label>
                                <input type="text" id="BLEND_GRADE_disp" value="@head.BlendGradeName" readonly disabled />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-20">
                                <label>No of Chest</label>
                                <input type="number" step="1" id="BLEND_CHEST" value="@head.BLEND_CHEST" />
                            </div>
                            <div class="form-col-20">
                                <label>Net WT/Chest</label>
                                <input type="number" step="0.01" id="BLEND_CHEST_WT" value="@head.BLEND_CHEST_WT" />
                            </div>
                            <div class="form-col-20">
                                <label>Gross WT/Chest</label>
                                <input type="number" step="0.01" id="BLEND_CHEST_GROSSWT" value="@head.BLEND_CHEST_GROSSWT" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-100">
                                <label>Blend Details</label>
                                <textarea id="BLEND_DESCN" style="height:50px;">@head.BLEND_DESCN</textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Header Details -->
                <div class="accordion">
                    <div class="accordion-header"><span class="txt">Header Details</span></div>
                    <div class="accordion-body">

                        <div class="form-row">
                            <div class="form-col-15">
                                <label>Export Ref. No</label>
                                <input type="text" id="EXPREF_NO" value="@head.EXPREF_NO" />
                            </div>
                            <div class="form-col-15">
                                <label>Transporter</label>
                                <input type="text" id="TPT" data-picker="transporter" value="@head.TPT" placeholder="Code" />
                            </div>
                            <div class="form-col-20">
                                <label>Transporter Name</label>
                                <input type="text" id="TPT_disp" value="@head.TransporterName" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Shipping Mark</label>
                                <input type="text" id="SHIP_MARK" value="@head.SHIP_MARK" />
                            </div>
                            <div class="form-col-10">
                                <label>Closed</label>
                                <div style="padding-top:6px;">
                                    <input type="checkbox" id="CLOSED" style="width:auto;" @(head.CLOSED == "Y" ? "checked" : "") /> Yes
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-col-50">
                                <label>Notes</label>
                                <textarea id="NOTES">@head.NOTES</textarea>
                            </div>
                            <div class="form-col-50">
                                <label>Special Instructions</label>
                                <textarea id="SP_NOTES">@head.SP_NOTES</textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Lines -->
                <div class="accordion">
                    <div class="accordion-header"><span class="txt">Lines</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnSelectStock"><i class="fa fa-search"></i> Select Data</a></li>
                                <li><a href="javascript:void(0)" id="btnAddRow"><i class="fa fa-plus"></i> Add Row</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                                <li><a href="javascript:void(0)" id="btnGenDoNo"><i class="fa fa-hashtag"></i> Generate DO No</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;">Sl</th>
                                        <th>Mark/Garden</th>
                                        <th>Inv No <span style="color:red;">(*)</span></th>
                                        <th style="width:110px;">Pack Date</th>
                                        <th>Grade</th>
                                        <th>Category</th>
                                        <th style="width:65px;">Bag <span style="color:red;">(*)</span></th>
                                        <th style="width:85px;text-align:right;">Qty <span style="color:red;">(*)</span></th>
                                        <th style="width:75px;text-align:right;">Sam. Qty</th>
                                        <th style="width:75px;text-align:right;">Rate</th>
                                        <th style="width:90px;text-align:right;">Amount</th>
                                        <th>Location</th>
                                        <th style="width:110px;">Arrival Date</th>
                                        <th>Arrival No</th>
                                        <th>Warehouse</th>
                                        <th style="width:30px;">Tag</th>
                                        <th style="width:150px;">DO No</th>
                                        <th style="width:110px;">DO Date</th>
                                        <th style="width:80px;">Trans Code</th>
                                        <th>Transporter Name</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="7" style="text-align:right;">Total</td>
                                        <td id="ftBag" style="text-align:right;"></td>
                                        <td id="ftQty" style="text-align:right;"></td>
                                        <td></td><td></td>
                                        <td id="ftAmt" style="text-align:right;"></td>
                                        <td colspan="9"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Backdrop shared by both pickers below -->
    <div class="popup-overlay" id="pickerOverlay"></div>

    <!-- Party/Warehouse/Allocation/Grade/Mark/Transporter now use jquery.inputpicker
         (Root UI convention -- see CLAUDE.md's "lookup pickers" rule), which renders its
         own anchored dropdown next to the field itself -- no shared modal markup needed. -->

    <!-- Stock / "Select Data" picker -->
    <div class="popup-box picker-box wide" id="stockPicker">
        <div class="popup-header">
            <h2>Select Data (Available Purchased Invoices)</h2>
            <button type="button" class="close-btn" onclick="closeStockPicker()">X</button>
        </div>
        <div class="stock-filters">
            <!-- Dropdowns (jquery.inputpicker, initialised when the popup opens -- see
                 initStockFilters). Mark lists only the picked Garden's marks. -->
            <input type="text" id="stockGardenFilter" placeholder="Select Garden" autocomplete="off" />
            <input type="text" id="stockMarkFilter" placeholder="Select Mark" autocomplete="off" />
            <input type="text" id="stockCategoryFilter" placeholder="Select Category" autocomplete="off" />
            <button type="button" id="btnStockFilter" class="btn-blue" style="width:auto;padding:5px 14px;">Refresh</button>
            <button type="button" id="btnStockSelectAll" class="btn-white" style="width:auto;padding:5px 14px;">Select All</button>
            <button type="button" id="btnStockDeselectAll" class="btn-white" style="width:auto;padding:5px 14px;">De-Select All</button>
        </div>
        <div class="picker-body" id="stockBody"></div>
        <div style="text-align:right;padding-top:10px;">
            <button type="button" class="btn-blue" id="btnStockOk" style="width:auto;padding:5px 16px;">OK</button>
            <button type="button" class="btn-white" onclick="closeStockPicker()" style="width:auto;padding:5px 16px;">Cancel</button>
        </div>
    </div>

    <!-- In-page alert/confirm modal -- replaces native alert()/confirm() so
         messages render in the app's own UI instead of the browser's native
         "<host> says" dialog chrome. -->
    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header">
            <h2 id="appAlertTitle">Notice</h2>
        </div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
    // =========================================================
    // In-page alert/confirm (see markup above).
    // =========================================================
    function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) {
        $('#appAlertTitle').text('Notice');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').hide();
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onOk) onOk(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function showConfirm(message, onYes) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', closeAppAlert);
        $('#appAlertOk').off('click').on('click', function () { closeAppAlert(); if (onYes) onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }

    // This view declares its own <html>/<body> while also using _Layout.cshtml as its Layout,
    // so everything below actually renders nested inside _Layout's own sidebar/wrapper markup
    // (the browser's HTML parser silently folds the duplicate <html>/<body> tags into the ones
    // _Layout already opened). If any of THAT wrapper chain carries a CSS transform/filter/
    // perspective (common for a collapsible-sidebar theme), it creates a new containing block
    // for `position: fixed` descendants -- so a "fixed, centered" popup ends up centered
    // against that narrower wrapper instead of the real viewport, clipping its left edge (the
    // "Select Data" title/filter labels losing their first several characters). Re-parenting
    // these onto the true <body> sidesteps that regardless of which ancestor is the culprit.
    $('#pickerOverlay, #stockPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    var rows = @Html.Raw(JsonConvert.SerializeObject(Model.T_TEA_BLEND_DET));
    var rowSeq = 0;
    // TAG isn't a persisted column (see T_TEA_BLEND_DET) -- VB derived it purely
    // from "has a DO No been raised for this row", so re-derive it the same way
    // when re-opening a saved record for edit.
    rows.forEach(function (r) { r._cid = ++rowSeq; if (r.TAG === undefined) r.TAG = !!r.DONO; });
    var lastWhInfo = {}; // whCode -> {DONO, DODT, TRANS_CODE, TransporterName}

    // NOTE: Mark/Garden, Grade and Category are deliberately NOT re-derived or validated here.
    // Checked against the real trn_blend_sheet.frm: DATAGRID1_BeforeColUpdate and
    // datagrid1_ButtonClick have no Case for any of the three -- the legacy grid never looked
    // them up or re-joined them on reload either (dtload() never sets a Category field at
    // all, even in Edit mode). A row is either whole-row-filled by "Select Data", or these
    // are typed free-hand with zero assist, matching that exactly.

    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
    }
    function toIso(dmy) {
        // input[type=date] already gives yyyy-mm-dd
        return dmy || null;
    }
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function round2(v) { return Math.round(num(v) * 100) / 100; }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r, idx) {
            r.SLNO = idx + 1;
            totBag += num(r.BAG_CHEST);
            totQty += num(r.QTY);
            totAmt += num(r.AMOUNT);
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" /></td>');
            tr.append('<td>' + r.SLNO + '</td>');
            // Mark/Garden, Grade, Category: plain, freely-typed cells -- no lookup in the
            // legacy grid (see the note above rows.forEach). Select Data still fills them
            // wholesale same as before.
            tr.append('<td><input type="text" class="f-mark" value="' + (r.MarkName || r.MARK || '') + '" /></td>');
            // Inv No DOES have a real legacy lookup (datagrid1_ButtonClick's pINVNO case +
            // the F1 shortcut in datagrid1_KeyDown), both just reopening "Select Data".
            // Item 5: no free-typed lookup here any more -- readonly, filled only by
            // picking a row in "Select Data" (searchable via its Garden/Mark/Category
            // filters, see loadStock()). No lookup button in the column either -- clicking
            // the cell itself (or F1) opens "Select Data", same as the click handler below.
            tr.append('<td><input type="text" class="f-invno" value="' + (r.INVNO || '') + '" placeholder="Via Select Data" readonly /></td>');
            tr.append('<td><input type="date" class="f-packdate" value="' + (r.PACK_DATE ? r.PACK_DATE.substring(0, 10) : '') + '" /></td>');
            tr.append('<td><input type="text" class="f-grade" value="' + (r.GRADE || '') + '" /></td>');
            tr.append('<td><input type="text" class="f-category" value="' + (r.CategoryDescn || '') + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-bag" value="' + (r.BAG_CHEST || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-qty" value="' + (r.QTY || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-sampleqty" value="' + (r.SAMPLE_QTY || 0) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-rate" value="' + round2(r.RATE).toFixed(2) + '" /></td>');
            tr.append('<td><input type="number" step="0.01" class="f-amount" value="' + round2(r.AMOUNT).toFixed(2) + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-whloca" value="' + (r.WH_LOCA || '') + '" /></td>');
            tr.append('<td><input type="date" class="f-awrdate" value="' + (r.AWR_DATE ? r.AWR_DATE.substring(0, 10) : '') + '" /></td>');
            tr.append('<td><input type="text" class="f-awrno" value="' + (r.AWR_NO || '') + '" /></td>');
            tr.append('<td><input type="text" class="f-warehouse" value="' + (r.WAREHOUSE || '') + '" /></td>');
            tr.append('<td style="text-align:center;"><input type="checkbox" class="f-tag" ' + (r.TAG ? 'checked' : '') + ' /></td>');
            tr.append('<td><input type="text" class="f-dono" value="' + (r.DONO || '') + '" /></td>');
            tr.append('<td><input type="date" class="f-dodt" value="' + (r.DODT ? r.DODT.substring(0, 10) : '') + '" /></td>');
            // Trans Code also has a real legacy lookup (datagrid1_ButtonClick's pTransCode
            // case, hlpl.GETHELP against rsTransp) -- add the same button here, on top of the
            // existing blur-resolve which already matches BeforeColUpdate's rsTransp.Find check.
            tr.append('<td><input type="text" class="f-transcode" value="' + (r.TRANS_CODE || '') + '" readonly placeholder="Select" /></td>');
            tr.append('<td><input type="text" class="f-transname" value="' + (r.TransporterName || '') + '" readonly /></td>');
            $tb.append(tr);
        });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(round2(totAmt).toFixed(2));
        updateDoPrintButton();
    }

    // DO Print (VB Command8_Click) is only ever enabled once the record is saved
    // and at least one line has a DO No raised against it.
    function updateDoPrintButton() {
        var hasDono = rows.some(function (r) { return r.DONO; });
        $('#btnDoPrint').prop('disabled', !(IS_EDIT && hasDono));
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    // Live edits -> keep the `rows` model in sync + recompute Qty/Amount, mirroring
    // VB's DATAGRID1_BeforeColUpdate (Bag*NetWt -> Qty, Qty*Rate -> Amount).
    $('#gridBody').on('input change', 'input', function () {
        var $tr = $(this).closest('tr');
        var r = findRow($tr.data('cid'));
        if (!r) return;
        // The Mark cell displays the mark NAME (MarkName) when Select Data supplied one, but
        // T_TEA_BLEND_DET.MARK is the 4-char code -- only overwrite r.MARK when the user
        // actually typed something different from what was displayed, otherwise any edit to
        // another cell in the row wrote the full name back into MARK (ORA-12899 on Save).
        var markShown = $tr.find('.f-mark').val();
        if (markShown !== (r.MarkName || r.MARK || '')) { r.MARK = markShown; r.MarkName = ''; }
        r.INVNO = $tr.find('.f-invno').val();
        r.PACK_DATE = toIso($tr.find('.f-packdate').val());
        r.GRADE = $tr.find('.f-grade').val();
        r.CategoryDescn = $tr.find('.f-category').val();
        r.BAG_CHEST = num($tr.find('.f-bag').val());
        r.SAMPLE_QTY = num($tr.find('.f-sampleqty').val());
        r.RATE = num($tr.find('.f-rate').val());
        r.WH_LOCA = $tr.find('.f-whloca').val();
        r.AWR_DATE = toIso($tr.find('.f-awrdate').val());
        r.AWR_NO = $tr.find('.f-awrno').val();
        r.WAREHOUSE = $tr.find('.f-warehouse').val();
        r.TAG = $tr.find('.f-tag').is(':checked');
        r.DONO = $tr.find('.f-dono').val();
        r.DODT = toIso($tr.find('.f-dodt').val());
        r.TRANS_CODE = $tr.find('.f-transcode').val();

        if ($(this).hasClass('f-qty')) {
            r.QTY = num($tr.find('.f-qty').val());
        } else if ($(this).hasClass('f-bag') && r._netWt) {
            r.QTY = round2(r.BAG_CHEST * r._netWt);
            $tr.find('.f-qty').val(r.QTY);
        } else {
            r.QTY = num($tr.find('.f-qty').val());
        }
        r.AMOUNT = round2(r.QTY * r.RATE);
        $tr.find('.f-amount').val(r.AMOUNT.toFixed(2));

        // Tag carry-forward: same warehouse code as a previously tagged row ->
        // reuse its DO No/DO Date/Transporter (VB datagrid1_MouseUp behaviour).
        if ($(this).hasClass('f-tag') && r.TAG && r.WAREHOUSE && lastWhInfo[r.WAREHOUSE]) {
            var info = lastWhInfo[r.WAREHOUSE];
            if (!r.DONO) { r.DONO = info.DONO; $tr.find('.f-dono').val(r.DONO); }
            if (!r.DODT) { r.DODT = info.DODT; $tr.find('.f-dodt').val(r.DODT ? r.DODT.substring(0, 10) : ''); }
            if (!r.TRANS_CODE) { r.TRANS_CODE = info.TRANS_CODE; $tr.find('.f-transcode').val(r.TRANS_CODE); r.TransporterName = info.TransporterName; $tr.find('.f-transname').val(r.TransporterName); }
        }
        if (r.WAREHOUSE && (r.DONO || r.TRANS_CODE)) {
            lastWhInfo[r.WAREHOUSE] = { DONO: r.DONO, DODT: r.DODT, TRANS_CODE: r.TRANS_CODE, TransporterName: r.TransporterName };
        }

        renderTotalsOnly();
    });

    // Rate: snap the displayed value to 2 decimal places once the user leaves the field
    // (item 3) -- the live `input`/`change` handler above already keeps r.RATE/r.AMOUNT
    // numerically correct on every keystroke; this only tidies up what's shown.
    $('#gridBody').on('blur', '.f-rate', function () {
        $(this).val(round2($(this).val()).toFixed(2));
    });

    // =========================================================
    // Inv No -- the ONE grid column (besides Trans Code) that genuinely has a lookup in
    // trn_blend_sheet.frm:
    //   datagrid1_ButtonClick  Case GridFCons.pINVNO : Call Command4_Click   ' opens Select Data
    //   datagrid1_KeyDown      KeyCode = vbKeyF1 ... Case GridFCons.pINVNO : Call Command4_Click
    //   DATAGRID1_BeforeColUpdate  Case GridFCons.pINVNO : rspack.Find "invno='...'" -- rejects
    //                              a typed value that isn't in the available-stock recordset
    //                              ("Enter valid Invoice Code")
    // Item 5: unlike VB (and unlike this screen's own earlier revision), the cell no longer
    // accepts a hand-typed value at all -- it's readonly, filled only by picking rows via
    // the "Select Data" toolbar link, so a value here is always a real, resolved Inv No.
    // No lookup button in the column, and the column itself no longer opens the picker
    // either (clicking/F1 on the cell used to reopen it -- removed): "Select Data" (the
    // toolbar link above the grid) is the only way in.
    // =========================================================
    function openStockPicker() {
        $('#pickerOverlay, #stockPicker').fadeIn(120);
        initStockFilters();
        loadStock();
    }

    // =========================================================
    // Trans Code lookup -- datagrid1_ButtonClick's pTransCode case (hlpl.GETHELP against
    // rsTransp). The cell itself stays a plain, readonly input: jquery.inputpicker wraps the
    // field it's attached to in extra divs, and doing that inside a <td> distorted the row
    // (tall row, stray arrows). So clicking the cell overlays a temporary picker field
    // (outside the table, in <body>, sitting exactly over the cell) which shows the usual
    // anchored dropdown; picking a row writes the code/name back and removes the overlay.
    // Delete/Backspace on the cell clears it.
    // =========================================================
    var $tcBox = null;

    function closeTransProxy() {
        $(document).off('.tcproxy');
        $(window).off('.tcproxy');
        $('#gridTable').closest('.table-responsive').off('.tcproxy');
        if ($tcBox) {
            try { $tcBox.find('.inputpicker-original').inputpicker('hide'); } catch (e) { }
            $tcBox.remove();
            $tcBox = null;
        }
    }

    function setRowTransporter($tr, r, code, name) {
        r.TRANS_CODE = code; r.TransporterName = name;
        $tr.find('.f-transcode').val(code);
        $tr.find('.f-transname').val(name);
    }

    function openTransPicker($tr) {
        var r = findRow($tr.data('cid'));
        if (!r) return;
        closeTransProxy();

        var cfg = pickerConfig.transporter;
        var $cell = $tr.find('input.f-transcode'), off = $cell.offset();
        var w = Math.max($cell.outerWidth(), 110);

        $tcBox = $('<div class="tc-proxy-box"></div>')
            .css({ position: 'absolute', left: off.left, top: off.top, width: w, zIndex: 10001, background: '#fff' })
            .appendTo(document.body);
        var $p = $('<input type="text" class="tc-proxy" autocomplete="off" placeholder="Search transporter" />')
            .css({ width: w, border: '1px solid #404e68', padding: '2px 22px 2px 4px', boxSizing: 'border-box' })
            .appendTo($tcBox);

        $p.inputpicker({
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2
        });

        // The plugin fires a plain 'change' on the original field once a row is picked.
        $p.on('change', function () {
            var code = $.trim($(this).val());
            setTimeout(closeTransProxy, 0);
            if (!code) { setRowTransporter($tr, r, '', ''); return; }
            lookupPickerRow(cfg, code, function (row) {
                if (row) setRowTransporter($tr, r, row.CODE, row.NAME || '');
            });
        });

        // Deferred: the click that opened this would otherwise bubble to the plugin's
        // document-level "outside click" handler and hide the list straight away.
        setTimeout(function () {
            $p.next('.inputpicker-overflow-hidden').find('input').focus();
            showPickerList($p);
        }, 0);

        $(document).on('mousedown.tcproxy', function (e) {
            if (!$(e.target).closest('.tc-proxy-box, .inputpicker-wrapped-list').length) closeTransProxy();
        }).on('keydown.tcproxy', function (e) {
            if (e.key === 'Escape') closeTransProxy();
        });
        $(window).on('resize.tcproxy', closeTransProxy);
        $('#gridTable').closest('.table-responsive').on('scroll.tcproxy', closeTransProxy);
    }

    $('#gridBody').on('click', 'input.f-transcode', function () { openTransPicker($(this).closest('tr')); });
    $('#gridBody').on('keydown', 'input.f-transcode', function (e) {
        var $tr = $(this).closest('tr'), r = findRow($tr.data('cid'));
        if (e.key === 'Enter' || e.key === 'F4' || e.key === 'ArrowDown') { e.preventDefault(); openTransPicker($tr); }
        else if ((e.key === 'Delete' || e.key === 'Backspace') && r) { e.preventDefault(); setRowTransporter($tr, r, '', ''); }
    });

    function renderTotalsOnly() {
        var totBag = 0, totQty = 0, totAmt = 0;
        rows.forEach(function (r) { totBag += num(r.BAG_CHEST); totQty += num(r.QTY); totAmt += num(r.AMOUNT); });
        $('#ftBag').text(round2(totBag));
        $('#ftQty').text(round2(totQty));
        $('#ftAmt').text(round2(totAmt).toFixed(2));
    }

    $('#btnAddRow').on('click', function () {
        rows.push({ _cid: ++rowSeq, SLNO: rows.length + 1, BAG_CHEST: 0, QTY: 0, SAMPLE_QTY: 0, RATE: 0, AMOUNT: 0, TAG: false });
        renderGrid();
    });

    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });

    $('#btnRemoveRows').on('click', function () {
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        renderGrid();
    });

    // =========================================================
    // Header/grid field lookups -- jquery.inputpicker (Root UI convention: an anchored,
    // paginated picker under the field itself, matching every other PacketTea screen's
    // lookups -- see CLAUDE.md's "lookup pickers" rule). Replaces this screen's earlier
    // bespoke centered-modal picker (#genericPicker, now removed).
    // =========================================================
    var pickerConfig = {
        party: { url: '@Url.Action("GetParty", "MasterBlendEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'PCODE' },
        warehouse: { url: '@Url.Action("GetWarehouse", "MasterBlendEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }, { name: 'DESTI', text: 'Destination' }], target: 'BLEND_WH' },
        allocation: { url: '@Url.Action("GetAllocation", "MasterBlendEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'DESCN', text: 'Description' }], target: 'ALLOC_CODE' },
        blendgrade: { url: '@Url.Action("GetBlendGrade", "MasterBlendEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'BLEND_GRADE' },
        mark: { url: '@Url.Action("GetMark", "MasterBlendEntry")', fields: [{ name: 'MCD', text: 'Code' }, { name: 'MDESC', text: 'Garden/Mark' }], target: 'BLEND_MARK' },
        transporter: { url: '@Url.Action("GetTransporter", "MasterBlendEntry")', fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }], target: 'TPT' }
    };

    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });

    // This copy of jquery.inputpicker never fires an 'inputpicker.select' event -- picking a row
    // just sets the original input's value and fires a plain 'change'. So the name/description
    // beside each code field (Party Name, Warehouse Name, Allocation Description, Mark/Grade
    // name) is filled from that 'change' by resolving the code through the same lookup URL
    // (PacketTeaPurchaseEntry's Mark picker does the same). Emptying the code empties the name.
    // Open the dropdown AND refresh its rows. The plugin loads url-backed data asynchronously and
    // only re-renders the list on a keystroke, so showing it right after init (before the first
    // response lands) displayed "No results" -- the keyup makes it fetch and render the rows.
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function lookupPickerRow(cfg, code, cb) {
        var f = cfg.fields[0].name, want = String(code).toUpperCase();
        $.getJSON(cfg.url, { q: code, limit: 50, p: 1 }, function (res) {
            var hit = null;
            $.each((res && res.data) || [], function (_, r) {
                if (String(r[f]).toUpperCase() === want) { hit = r; return false; }
            });
            cb(hit);
        }).fail(function () { cb(null); });
    }

    $('[data-picker]').on('change', function () {
        var $el = $(this), cfg = pickerConfig[$el.data('picker')], code = $.trim($el.val());
        if (!code) { $('#' + this.id + '_disp').val(''); return; }
        if (!cfg || !cfg.target || cfg.target !== this.id) return;
        lookupPickerRow(cfg, code, function (row) {
            $('#' + cfg.target + '_disp').val(row ? (row[cfg.fields[1].name] || '') : '');
        });
    });

    // Header-field lookups only -- the grid's Trans Code has its own overlay picker
    // (openTransPicker). The chosen row's name is filled by the [data-picker] 'change'
    // handler above.
    function openPicker(key, $input) {
        var cfg = pickerConfig[key];

        // This plugin never sets $.data('inputpicker'), so the "already initialised" test is
        // the class it puts on the original input -- otherwise every click re-wraps the field
        // again (nested wrappers = the distorted Trans Code cell).
        // Showing is deferred a tick: called from a click, the click's own bubbling up to the
        // plugin's document-level "outside click" handler would otherwise hide it straight away.
        if ($input.hasClass('inputpicker-original')) {
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $('.inputpicker-wrapped-list').remove();
        $input.inputpicker({
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2
        });

        setTimeout(function () { showPickerList($input); }, 0);
    }

    // =========================================================
    // Stock / "Select Data" picker (VB Command4_Click / dataselect) -- openStockPicker() is
    // defined further down (Inv No lookup block) since the grid's Inv No button/F1 shortcut
    // reopen this exact same popup, matching datagrid1_ButtonClick/datagrid1_KeyDown.
    // =========================================================
    $('#btnSelectStock').on('click', openStockPicker);
    function closeStockPicker() { $('.inputpicker-wrapped-list').hide(); $('#pickerOverlay, .popup-box').fadeOut(120); }
    $('#btnStockFilter').on('click', loadStock);

    // Garden / Mark / Category are dropdowns (jquery.inputpicker). Picking (or clearing) any of
    // them reloads the grid below, filtered by all three; the API matches each as an exact code
    // (see GetAvailableStock). Mark is dependent: it only lists the picked Garden's marks
    // (GetMark's `garden` param), and picking a Garden again empties Mark so it's chosen afresh.
    // Initialised on first open -- the popup is display:none until then, and the plugin sizes
    // itself from the field's rendered width.
    var stockMarkParams = { garden: '' };

    function stockFilterInput($orig) { return $orig.next('.inputpicker-overflow-hidden').find('input'); }

    // Empty a dropdown without firing 'change' (the caller reloads the grid itself).
    function clearStockFilter($orig) {
        $orig.val('');
        stockFilterInput($orig).val('').data('value', '');
    }

    function initStockFilter($orig, url, fields, urlParam, refreshOnOpen) {
        if ($orig.hasClass('inputpicker-original')) return;
        var opts = {
            url: url,
            fields: fields,
            fieldText: fields[0].name,
            fieldValue: fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2,
            selectMode: 'empty'     // typed text that isn't picked from the list is discarded
        };
        if (urlParam) opts.urlParam = urlParam;
        $orig.inputpicker(opts);
        // Wiping the visible text is how a filter is removed: the plugin keeps the last picked
        // value on the hidden original in that case, so clear it (and reload) ourselves.
        stockFilterInput($orig).on('input', function () {
            if (!$(this).val() && $orig.val()) { $orig.val(''); $(this).data('value', ''); $orig.trigger('change'); }
        });
        // The plugin lists whatever it loaded at init until a keystroke makes it fetch again, so
        // the dependent Mark list would keep showing the marks of the previously picked Garden.
        // A keyup on open (same trick as showPickerList) re-queries with the current urlParam.
        if (refreshOnOpen) {
            stockFilterInput($orig).on('focus click', function () {
                var $v = $(this);
                setTimeout(function () { $v.trigger($.Event('keyup', { keyCode: 0 })); }, 0);
            });
        }
    }

    function initStockFilters() {
        initStockFilter($('#stockGardenFilter'), '@Url.Action("GetGarden", "MasterBlendEntry")',
            [{ name: 'CODE', text: 'Code' }, { name: 'DESCN', text: 'Garden' }]);
        initStockFilter($('#stockMarkFilter'), '@Url.Action("GetMark", "MasterBlendEntry")',
            [{ name: 'MCD', text: 'Code' }, { name: 'MDESC', text: 'Garden/Mark' }], stockMarkParams, true);
        initStockFilter($('#stockCategoryFilter'), '@Url.Action("GetCategory", "MasterBlendEntry")',
            [{ name: 'CAT', text: 'Code' }, { name: 'DESCN', text: 'Category' }]);
    }

    $('#stockGardenFilter').on('change', function () {
        stockMarkParams.garden = $.trim($(this).val());
        clearStockFilter($('#stockMarkFilter'));
        loadStock();
    });
    $('#stockMarkFilter, #stockCategoryFilter').on('change', loadStock);

    var stockReq = 0;   // only the latest request may fill the grid (a slow, older one must not overwrite it)
    function loadStock() {
        var blendType = $('#BLEND_TYPE').val(), reqId = ++stockReq;
        $('.inputpicker-wrapped-list').hide();
        $('#stockBody').data('rows', []).html('<div style="padding:10px;color:#666;">Loading...</div>');
        $.getJSON('@Url.Action("GetAvailableStock", "MasterBlendEntry")', {
            blendType: blendType,
            garden: $('#stockGardenFilter').val(),
            mark: $('#stockMarkFilter').val(),
            category: $('#stockCategoryFilter').val()
        }).fail(function () {
            if (reqId !== stockReq) return;
            $('#stockBody').html('<div style="padding:10px;color:#b00;">Could not load the available invoices. Please click Refresh to try again.</div>');
        }).done(function (data) {
            if (reqId !== stockReq) return;
            data = data || [];
            if (!data.length) {
                $('#stockBody').data('rows', []).html('<div style="padding:10px;color:#666;">No available stock found for the selected Garden / Mark / Category.</div>');
                return;
            }
            var html = '<table><thead><tr><th></th><th>Inv No</th><th>Garden/Mark</th><th>Grade</th><th>Pack Date</th><th>Bag</th><th>Available Qty</th><th style="text-align:right;">Rate</th></tr></thead><tbody>';
            data.forEach(function (r, i) {
                html += '<tr data-i="' + i + '"><td><input type="checkbox" class="stockChk" /></td><td>' + (r.invno || '') + '</td><td>' + (r.markDescn || '') + '</td>' +
                    '<td>' + (r.gradeName || r.grade || '') + '</td><td>' + fmtDate(r.packDate) + '</td><td>' + r.bagChest + '</td><td>' + r.available + '</td><td style="text-align:right;">' + round2(r.rate).toFixed(2) + '</td></tr>';
            });
            html += '</tbody></table>';
            $('#stockBody').html(html);
            $('#stockBody').data('rows', data);
        });
    }

    $('#btnStockSelectAll').on('click', function () { $('#stockBody .stockChk').prop('checked', true); });
    $('#btnStockDeselectAll').on('click', function () { $('#stockBody .stockChk').prop('checked', false); });

    $('#btnStockOk').on('click', function () {
        var data = $('#stockBody').data('rows') || [];
        $('#stockBody .stockChk:checked').each(function () {
            var i = $(this).closest('tr').data('i');
            var s = data[i];
            var dup = rows.some(function (r) { return r.INVNO === s.invno && r.GRADE === s.grade && r.MARK === s.mark && (r.PACK_DATE || '').substring(0, 10) === (s.packDate || '').substring(0, 10); });
            if (dup) return;
            rows.push({
                _cid: ++rowSeq, _netWt: s.netWt,
                MARK: s.mark, MarkName: s.markDescn || '',
                INVNO: s.invno, PACK_DATE: s.packDate, GRADE: s.grade,
                CategoryDescn: s.categoryDescn || '',
                BAG_CHEST: s.bagChest, QTY: s.available, SAMPLE_QTY: 0,
                RATE: s.rate, AMOUNT: round2(s.available * s.rate),
                WH_LOCA: '', WAREHOUSE: '', AWR_NO: '', AWR_DATE: null,
                TAG: false, DONO: '', DODT: null, TRANS_CODE: '', TransporterName: ''
            });
        });
        renderGrid();
        closeStockPicker();
    });

    // =========================================================
    // Generate DO No (VB Command7_Click) -- one DO number per distinct
    // warehouse code among tagged rows that don't have one yet.
    // =========================================================
    // Spec §2.2 Command7: only enabled in Edit mode (save first in Add mode).
    if (!IS_EDIT) { $('#btnGenDoNo').addClass('is-disabled'); }
    $('#btnGenDoNo').on('click', function () {
        if (!IS_EDIT) { showAlert('Save the record first, then Generate DO No.'); return; }
        var need = [];
        rows.forEach(function (r) { if (r.TAG && !r.DONO && r.WAREHOUSE && need.indexOf(r.WAREHOUSE) === -1) need.push(r.WAREHOUSE); });
        if (!need.length) { showAlert('Tag a row (with a Warehouse set) that needs a DO No first.'); return; }
        // Build the query string by hand (whCodes=A&whCodes=B) -- jQuery's default
        // (non-traditional) array serialization emits whCodes[]=A which MVC5's
        // model binder does not bind to a string[] parameter.
        var qs = $.param({
            blendType: $('#BLEND_TYPE').val(),
            fyShortFrom: $('#fyShortFrom').val(),
            fyShortTo: $('#fyShortTo').val(),
            whCodes: need
        }, true);
        $.getJSON('@Url.Action("GenerateDoNo", "MasterBlendEntry")' + '?' + qs, function (map) {
            rows.forEach(function (r) {
                if (r.TAG && !r.DONO && r.WAREHOUSE && map[r.WAREHOUSE]) r.DONO = map[r.WAREHOUSE];
            });
            renderGrid();
        });
    });

    // =========================================================
    // Save (mirrors VB Command1_Click validation order)
    // =========================================================
    $('#btnSave').on('click', function () {
        if (!$('#DOCDT').val()) { showAlert('Doc Date cannot be blank'); return; }
        var docDtVal = $('#DOCDT').val(), fyMin = $('#DOCDT').attr('min'), fyMax = $('#DOCDT').attr('max');
        // input[type=date] always gives the LOCAL calendar date with no time/zone attached, so
        // "today" must be built from local getters too. new Date().toISOString() reports UTC --
        // for any timezone ahead of UTC (IST included) that's still "yesterday" for several
        // hours after local midnight, which made a same-day Doc Date get rejected as "future".
        var now = new Date();
        var todayStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
        if (docDtVal > todayStr) { showAlert('Doc Date cannot be a future date'); return; }
        if ((fyMin && docDtVal < fyMin) || (fyMax && docDtVal > fyMax)) { showAlert('Doc Date is outside the allowed range (financial year / back-date policy)'); return; }
        if (!$('#BLEND_WH').val()) { showAlert('Warehouse cannot be blank'); return; }
        if (!$('#BLEND_GRADE').val()) { showAlert('Blend Grade cannot be blank'); return; }
        if (!$('#BLEND_MARK').val()) { showAlert('Blend Mark cannot be blank'); return; }
        if (!$('#BLEND_NO').val()) { showAlert('Blend No cannot be blank'); return; }
        if (!$('#BLEND_DATE').val()) { showAlert('Blend Date cannot be blank'); return; }

        var netWt = num($('#BLEND_CHEST_WT').val()), grossWt = num($('#BLEND_CHEST_GROSSWT').val());
        if (netWt > grossWt) { showAlert("Gross Weight Can't Be Less Than Net Weight Or Blank. Please Check It."); return; }

        var valid = rows.filter(function (r) { return r.INVNO; });
        if (!valid.length) { showAlert('Without Invoice Detail, Record Can Not be Saved.'); return; }
        if (valid.some(function (r) { return num(r.QTY) <= 0; })) { showAlert('Enter Quantity Invoice Detail !'); return; }
        // T_TEA_BLEND_DET.MARK is a 4-char code column -- catch a hand-typed name/long value
        // here instead of surfacing a raw ORA-12899 from the database.
        var badMark = valid.filter(function (r) { return (r.MARK || '').length > 4; })[0];
        if (badMark) { showAlert('Mark/Garden "' + badMark.MARK + '" (Inv No ' + badMark.INVNO + ') is not a valid Mark code (max 4 characters).'); return; }

        // Dupe key: Invoice + Grade + Mark + Pack Date -- the same key stock is grouped by
        // (GetAvailableStock) and the Select Data picker's own duplicate check. Lots of one
        // invoice/grade/mark packed on different dates are distinct stock lines.
        var seen = {};
        for (var i = 0; i < valid.length; i++) {
            var k = valid[i].INVNO + '|' + valid[i].GRADE + '|' + valid[i].MARK + '|' + (valid[i].PACK_DATE || '').substring(0, 10);
            if (seen[k]) { showAlert('Duplicate Entry'); return; }
            seen[k] = true;
        }
        if (valid.some(function (r) { return r.TAG && !r.DONO; })) { showAlert('Please Generate DO No'); return; }
        if (valid.some(function (r) { return r.TAG && !r.DODT; })) { showAlert('Please Enter DO Date'); return; }

        showConfirm('Are you sure?', function () {
            var model = {
                T_TEA_BLEND: {
                    ID: $('#ID').val() ? parseFloat($('#ID').val()) : null,
                    DOCNO: $('#DOCNO').val(),
                    DOCDT: $('#DOCDT').val(),
                    BLEND_TYPE: $('#BLEND_TYPE').val(),
                    // The Unit picked on the list (new) / the record's own Unit (edit) -- stored
                    // as-is; the server checks a new sheet's Unit against the user's units.
                    UNIT: $('#UNIT_disp').val(),
                    ALLOC_CODE: $('#ALLOC_CODE').val(),
                    BLEND_NO: $('#BLEND_NO').val(),
                    BLEND_GRADE: $('#BLEND_GRADE').val(),
                    BLEND_DATE: $('#BLEND_DATE').val(),
                    BLEND_WH: $('#BLEND_WH').val(),
                    BLEND_DESCN: $('#BLEND_DESCN').val(),
                    BLEND_MARK: $('#BLEND_MARK').val(),
                    BLEND_CHEST: num($('#BLEND_CHEST').val()),
                    BLEND_CHEST_WT: netWt,
                    BLEND_CHEST_GROSSWT: grossWt,
                    PCODE: $('#PCODE').val(),
                    TPT: $('#TPT').val(),
                    EXPREF_NO: $('#EXPREF_NO').val(),
                    SHIP_MARK: $('#SHIP_MARK').val(),
                    NOTES: $('#NOTES').val(),
                    SP_NOTES: $('#SP_NOTES').val(),
                    CLOSED: $('#CLOSED').is(':checked') ? 'Y' : 'N'
                },
                T_TEA_BLEND_DET: valid,
                IsNew: !IS_EDIT
            };

            $.ajax({
                url: '@Url.Action("Save", "MasterBlendEntry")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(model),
                success: function (resp) {
                    if (resp.success) {
                        showAlert(resp.message || 'Saved.', function () {
                            window.location.href = '@Url.Action("Index", "MasterBlendEntry")' + '?blendType=' + encodeURIComponent($('#BLEND_TYPE').val());
                        });
                    } else {
                        showAlert(resp.message || 'Save failed.');
                    }
                },
                error: function () { showAlert('Save failed - server error.'); }
            });
        });
    });

    // =========================================================
    // DO Print (VB Command8_Click)
    // NOTE: the VB form drove a full Crystal Report ("Conf DI") pulling in
    // consignee/broker/destination/HSN details from half a dozen master
    // tables. That report isn't reproduced here -- this opens a plain,
    // printable summary of each Delivery Order (grouped the same way VB
    // grouped them: one block per DO No) using the data already on screen,
    // so there's a working "hand this to the transporter" document while a
    // full report-parity pass is a separate follow-up.
    // =========================================================
    $('#btnDoPrint').on('click', function () {
        var tagged = rows.filter(function (r) { return r.DONO; });
        if (!tagged.length) return;

        var groups = {};
        tagged.forEach(function (r) {
            (groups[r.DONO] = groups[r.DONO] || []).push(r);
        });

        var html = '<!doctype html><html><head><title>Delivery Order - ' + $('#DOCNO').val() + '</title><style>' +
            'body{font-family:Arial,sans-serif;font-size:13px;color:#222;margin:24px;}' +
            'h2{margin:0 0 4px;} .meta{margin-bottom:18px;color:#444;}' +
            'table{width:100%;border-collapse:collapse;margin-bottom:22px;}' +
            'th,td{border:1px solid #999;padding:6px 8px;text-align:left;} th{background:#eee;}' +
            '.do-block{margin-bottom:26px;page-break-inside:avoid;}' +
            '.do-title{font-weight:bold;margin-bottom:6px;}' +
            '@@media print{.no-print{display:none;}}' +
            '</style></head><body>';

        html += '<h2>Delivery Order</h2>';
        html += '<div class="meta">Doc No: <b>' + ($('#DOCNO').val() || '') + '</b> &nbsp; ' +
            'Blend No: <b>' + ($('#BLEND_NO').val() || '') + '</b> &nbsp; ' +
            'Blend Date: <b>' + ($('#BLEND_DATE').val() || '') + '</b> &nbsp; ' +
            'Party: <b>' + ($('#PCODE_disp').val() || $('#PCODE').val() || '') + '</b></div>';

        Object.keys(groups).forEach(function (dono) {
            var grp = groups[dono];
            var first = grp[0];
            html += '<div class="do-block"><div class="do-title">DO No: ' + dono +
                ' &nbsp; DO Date: ' + (first.DODT ? first.DODT.substring(0, 10) : '') +
                ' &nbsp; Warehouse: ' + (first.WAREHOUSE || '') +
                ' &nbsp; Transporter: ' + (first.TransporterName || first.TRANS_CODE || '') + '</div>';
            html += '<table><thead><tr><th>Inv No</th><th>Mark/Garden</th><th>Grade</th><th>Pack Date</th>' +
                '<th>Bag</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead><tbody>';
            grp.forEach(function (r) {
                html += '<tr><td>' + (r.INVNO || '') + '</td><td>' + (r.MarkName || r.MARK || '') + '</td>' +
                    '<td>' + (r.GRADE || '') + '</td><td>' + (r.PACK_DATE ? r.PACK_DATE.substring(0, 10) : '') + '</td>' +
                    '<td>' + (r.BAG_CHEST || 0) + '</td><td>' + (r.QTY || 0) + '</td>' +
                    '<td>' + (r.RATE || 0) + '</td><td>' + (r.AMOUNT || 0) + '</td></tr>';
            });
            html += '</tbody></table></div>';
        });

        html += '<button class="no-print" onclick="window.print()">Print</button></body></html>';

        var w = window.open('', '_blank');
        w.document.open();
        w.document.write(html);
        w.document.close();
    });

    renderGrid();

    // =========================================================
    // View mode (spec: list page "View" action) -- same data as Edit, but nothing on
    // the form is editable. Runs once, after the initial renderGrid() above has built
    // every grid row (nothing adds more afterwards in view mode -- Select Data/Add Row/
    // Remove Selected/Generate DO No are all locked out below too), so a single blanket
    // disable here covers the header fields and the whole grid.
    // =========================================================
    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    if (IS_VIEW) {
        $('.accordion-container :input').prop('disabled', true);
        $('#btnSave, #btnDoPrint, #btnSelectStock, #btnAddRow, #btnRemoveRows, #btnGenDoNo')
            .addClass('is-disabled').prop('disabled', true);
    }
</script>
</body>
</html>
