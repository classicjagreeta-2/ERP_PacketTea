    <script>
        $(document).ready(function () {

            var Docno = $('#Docno').val();   // SLNO input id

            if (Docno && $.trim(Docno) !== '') {

                // Edit Mode
                $('#statusText').text('Edit');
                $("#PurchaseDate").prop("disabled", true);
            } else {

                // Add Mode
                $('#statusText').text('Add');

            }

        });
        $(document).ready(function () {

            var status = $('#approvedVal').val();

            console.log("STATUS RAW:", status); // debug

            status = (status || "").trim().toUpperCase(); // 🔥 IMPORTANT

            var text = "Unknown";

            if (status === "Y") {
                text = "Approved";
            } else if (status === "N") {
                text = "Pending";
            } else if (status === "R") {
                text = "Rejected";
            }

            $('#statusText2').text(text);
        });
    </script>




