    <script>
        $(document).ready(function () {

            var Docno = $('#DOCNO').val();   // SLNO input id

            if (Docno && $.trim(Docno) !== '') {

                // Edit Mode
                $('#statusText').text('Edit');
                $("#PacketDate").prop("disabled", true);
            } else {

                // Add Mode
                $('#statusText').text('Add');

            }

        });
        $(document).ready(function () {

            var status = $('#approvedVal').val();

            console.log("STATUS RAW:", status); // debug

            status = (status || "").trim().toUpperCase(); // 🔥 IMPORTANT

            var text = "Unknown";

            if (status === "Y") {
                text = "Approved";
            } else if (status === "N") {
                text = "Pending";
            } else if (status === "R") {
                text = "Rejected";
            }

            $('#statusText2').text(text);
        });
    </script>

    <script>

        function LoadPacketTeaPurchaseDetails() {

    var unit = $('#UNIT').val();
            var Docdt = $('#DOCDT').val() || '';

            var docno = $('#DOCNO').val() || '';
            $('#linesLoader').css('display', 'flex');

    $.ajax({
        url: '@Url.Action("LoadPacketTeaPurchaseDetails", "PacketTeaPurchaseEntry")',
        type: 'GET',
        data: {

             docno: docno,

            unit: unit,
            Docdt: Docdt
        },
        success: function (html) {
            $('#mainTable tbody').html(html);


            $("#mainTable tbody tr").each(function () {

                var invNo = $(this).find("input[name*='.INVNO']").val();

                if (invNo) {


                        invNo: $.trim(invNo)


                }

            });
        },
        error: function (xhr) {

            console.log(xhr.responseText);

            $('#mainTable tbody').html(
                '<tr>' +
                '<td colspan="28" style="text-align:center;color:red;">' +
                'Unable to load product details.' +
                '</td>' +
                '</tr>'
            );
        },

        complete: function () {

            // Hide loader after response/error
            $('#linesLoader').hide();
        }
    });
        }

     // ✅ PAGE LOAD
     $(document).ready(function () {
         LoadPacketTeaPurchaseDetails();
     });

    </script>
    <script>
    function formatDateToYMD(date) {
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');

        return year + '/' + month + '/' + day;
    }

    $(function () {

        var $dateInputs = $("#PacketDate");
        var activeInput = null;

        // Destroy old datepicker
        $dateInputs.each(function () {
            var $el = $(this);

            if ($el.data("datepicker")) {
                $el.datepicker("destroy");
            }

            $el.removeClass("hasDatepicker");
        });

        function ensureOverlay() {
            if (!$(".ui-datepicker-overlay").length) {
                $("body").append('<div class="ui-datepicker-overlay"></div>');
            }
        }

        // Get permission days
        var prno = $('#Docno').val();
        var permissionDate = 0;

        if (prno && $.trim(prno) !== '') {
            // Edit Mode
            permissionDate = parseInt('@((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Eday)') || 0;
        } else {
            // Add Mode
            permissionDate = parseInt('@((ViewBag.Permission as PacketTea.Helpers.AEDV)?.Aday)') || 0;
        }

        var pDate = new Date();
        pDate.setDate(pDate.getDate() - permissionDate);

        console.log("Min Date:", formatDateToYMD(pDate));

        $dateInputs.datepicker({
            dateFormat: "dd/mm/yy",
            minDate: pDate,
            maxDate: 0,
            showAnim: "",

            beforeShow: function (input) {
                activeInput = input;

                ensureOverlay();
                $(".ui-datepicker-overlay").show();
                $("body").addClass("datepicker-open");

                setTimeout(function () {
                    $("#ui-datepicker-div")
                        .addClass("force-block")
                        .css({ zIndex: 99999 });
                }, 0);
            },

            onChangeMonthYear: function () {
                setTimeout(function () {
                    $("#ui-datepicker-div")
                        .addClass("force-block")
                        .css({ zIndex: 99999 });
                }, 0);
            },

            onClose: function () {
                $(".ui-datepicker-overlay").hide();
                $("#ui-datepicker-div").removeClass("force-block");
                $("body").removeClass("datepicker-open");
                activeInput = null;
            }
        });

        // Overlay click closes calendar
        $(document).on("click", ".ui-datepicker-overlay", function () {
            if (activeInput) {
                $(activeInput).datepicker("hide");
            }
        });

        // Open calendar on textbox click
        $("#PacketDate").on("click", function () {
            $(this).datepicker("show");
        });

    });
    </script>
    <script>
        // ── Manual typing max date validation (PurchaseDate) ──
        $(document).on("blur", "#PacketDate", function () {
            var $el = $(this);
            var val = $el.val();
            if (!val) return;

            // Strict dd/mm/yyyy shape check first
            if (!/^\d{2}\/\d{2}\/\d{4}$/.test(val)) {
                $.confirm({
                    title: 'Date Validation',
                    type: 'red',
                    content: 'Invalid date format. Please enter a valid date (dd/mm/yyyy).',
                    buttons: { ok: function () { $el.val('').focus(); } }
                });
                return;
            }

            var typedDate;
            try {
                typedDate = $.datepicker.parseDate("dd/mm/yy", val);
            } catch (e) {
                $.confirm({
                    title: 'Date Validation',
                    type: 'red',
                    content: 'Invalid date. Please enter a valid date.',
                    buttons: { ok: function () { $el.val('').focus(); } }
                });
                return;
            }

            var maxDate = new Date();
            maxDate.setHours(0, 0, 0, 0);
            typedDate.setHours(0, 0, 0, 0);

            if (typedDate > maxDate) {
                $.confirm({
                    title: 'Date Validation',
                    type: 'red',
                    content: 'Purchase Order Date cannot be greater than today.',
                    buttons: { ok: function () { $el.val('').focus(); } }
                });
            }
        });
    </script>
