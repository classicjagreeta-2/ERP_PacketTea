        if (!item) return;

        // 🔥 direct selector (NO tr)
        $('.vendor-code').val(item.CODE);
        $('.vendor-desc').val(item.NAME || '');

        $(this).inputpicker('hide');
    });

});


// ✅ CHANGE EVENT (FIXED)
$(document).on('change', '.broker-code', function () {

    var code = $(this).val();

    if (!code) {
        $('.vendor-desc').val('');
        return;
    }

    $.ajax({
        url: '@Url.Action("GetVendor", "PacketTeaPurchaseEntry")',
        type: 'GET',
        data: { q: code, limit: 1, p: 1 },
        success: function (res) {

            if (res && res.data && res.data.length > 0) {
                $('.vendor-desc').val(res.data[0].NAME || '');
            } else {
                $('.vendor-desc').val('');
            }
        }
    });
    $(document).on('blur', '.vendor-code', function () {

    var $input = $(this);
    var code = $input.val().trim();

    // small delay → allows inputpicker select to complete first
    setTimeout(function () {

        // ❌ if empty → clear desc
        if (!code) {
            $('.vendor-desc').val('');
            return;
        }

        // 🔍 verify code from server
        $.ajax({
            url: '@Url.Action("GetVendor", "PacketTeaPurchaseEntry")',
            type: 'GET',
            data: { q: code, limit: 1, p: 1 },
            success: function (res) {

                // ❌ NO RESULT → CLEAR BOTH
                if (!res || !res.data || res.data.length === 0) {

                    $input.val('');                 // 🔥 clear code
                    $('.vendor-desc').val('');       // 🔥 clear desc

                }

                // ✅ VALID → keep as is (already handled in change)
            }
        });

    }, 200); // important delay

});



});
    </script>

