@model PacketTea.Models.PT.AwrRegisterResult
@{
    Layout = null;
    string title = ViewBag.Title as string ?? "AWR Register";
    bool sellerWise = ViewBag.SellerWise is bool b && b;
    Func<decimal, string> N = v => v == 0 ? "" : v.ToString("0.000");
    var rows = Model.Rows ?? new List<PacketTea.Models.PT.AwrRegisterRow>();
    var line1 = !string.IsNullOrWhiteSpace(Model.CompanyV) && Model.CompanyV.Trim().Length > 1 ? Model.CompanyV.Trim() : Model.Company;
    // groups: by seller (Seller Wise) or by warehouse destination (Garden Wise), as the old layouts
    var groups = rows.GroupBy(x => sellerWise ? "Seller : " + x.SELLER : "Warehouse : " + x.DESTI + (string.IsNullOrEmpty(x.ADD1) ? "" : " - " + x.ADD1)).ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: Calibri, Arial, sans-serif; color: #222; font-size: 12px; }
        .toolbar { position: sticky; top: 0; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 281mm; margin: 12px auto; padding: 7mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
        h1 { font-size: 16px; margin: 0; text-align: center; }
        h2 { font-size: 13px; margin: 2px 0; text-align: center; font-weight: normal; }
        .sub { text-align: center; font-size: 11px; margin: 2px 0 6px; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 10px; }
        th { background: #404E67; color: #fff; padding: 4px 5px; border: 1px solid #8A94A8; text-align: left; }
        td { border: 1px solid #BBBBBB; padding: 3px 5px; vertical-align: top; }
        td.n, th.n { text-align: right; }
        .grp td { background: #E8EBF1; font-weight: bold; }
        .tot td { background: #DFE3EC; font-weight: bold; }
        .foot { margin-top: 8px; font-size: 11px; }
        .err { padding: 40px; font-size: 14px; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; width: auto; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">Print</button><span>@title</span></div>
    @if (ViewBag.Error != null)
    {
        <div class="sheet"><div class="err"><b>AWR Register</b><br /><br />@ViewBag.Error</div></div>
    }
    else
    {
        <div class="sheet">
            <h1>@line1</h1>
            @if (line1 != Model.Company)
            {
                <h2>@Model.Company</h2>
            }
            <div class="sub">@Model.Address</div>
            <h2><b>@title</b></h2>
            <table>
                <thead>
                    <tr>
                        <th>AWR No</th><th>Date</th><th>Lorry No</th><th>Carrier</th><th>CN No</th><th>CN Date</th><th>Garden</th>
                        <th>Invoice</th><th>Grade</th><th class="n">Rec Bags</th><th class="n">Rec Kgs</th><th class="n">Short Bags</th>
                        <th class="n">Short Kgs</th><th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in groups)
                    {
                        <tr class="grp"><td colspan="14">@g.Key</td></tr>
                        foreach (var x in g)
                        {
                            <tr>
                                <td>@x.AWR_NO</td><td>@x.AWR_DATE</td><td>@x.TNO</td><td>@x.TransName</td><td>@x.CONS_NO1</td><td>@x.CONS_DT1</td>
                                <td>@x.REC_NAME</td><td>@x.INVNO</td><td>@x.GRADE</td><td class="n">@x.BAG_RCVD.ToString("0.##")</td>
                                <td class="n">@N(x.TNET_WT)</td><td class="n">@x.SR_QTY</td><td class="n">@N(x.SR_KGS)</td><td>@x.REMARK</td>
                            </tr>
                        }
                        <tr class="tot">
                            <td colspan="9">Total</td><td class="n">@g.Sum(x => x.BAG_RCVD).ToString("0.##")</td><td class="n">@N(g.Sum(x => x.TNET_WT))</td>
                            <td></td><td class="n">@N(g.Sum(x => x.SR_KGS))</td><td></td>
                        </tr>
                    }
                    <tr class="tot">
                        <td colspan="9">Grand Total</td><td class="n">@rows.Sum(x => x.BAG_RCVD).ToString("0.##")</td><td class="n">@N(rows.Sum(x => x.TNET_WT))</td>
                        <td></td><td class="n">@N(rows.Sum(x => x.SR_KGS))</td><td></td>
                    </tr>
                </tbody>
            </table>
            <div class="foot">Report: AWR Register &nbsp; user: @ViewBag.RunBy &nbsp; @ViewBag.RunAt</div>
        </div>
    }
</body>
</html>
