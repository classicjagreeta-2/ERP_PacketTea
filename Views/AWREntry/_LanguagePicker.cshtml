@* Screen-language dropdown (i18n) for AWR Entry's list and entry screen -- a toolbar <li>.
   Picking a language calls AWREntry/SetLanguage, which stores it in the "ui_lang" cookie and
   reloads this page in that language (texts: Resources\AWR*.resx via PacketTea.Utility.AwrText).
   ViewData["ConfirmReload"] = true asks before reloading (the entry screen, where unsaved
   changes would be lost). *@
@using PacketTea.Utility
@{
    var current = UiLanguage.Current;
    var currentCode = UiLanguage.CurrentCode;
    var confirmReload = (ViewData["ConfirmReload"] as bool?) ?? false;
}
<li class="ui-lang-item" style="display:flex;align-items:center;white-space:nowrap;">
    <label for="uiLang" style="margin:0 6px 0 0;font-size:12px;color:#555;"><i class="fa fa-globe"></i> @AwrText.T("Language")</label>
    <select id="uiLang" style="height:28px;border:1px solid #ccc;border-radius:4px;padding:0 6px;font-size:12px;"
            data-confirm="@(confirmReload ? AwrText.T("Msg_LangReload") : "")">
        @foreach (var l in UiLanguage.Supported)
        {
            <option value="@l[0]" selected="@(l[0] == current && !CultureCatalog.Contains(currentCode))">@l[1]</option>
        }
        @foreach (var g in CultureCatalog.ByContinent())
        {
            <optgroup label="@g.Key">
                @foreach (var c in g)
                {
                    <option value="@c.Code" selected="@(c.Code == currentCode)">@c.DisplayName</option>
                }
            </optgroup>
        }
    </select>
    <script>
        (function () {
            var sel = document.getElementById('uiLang'), prev = sel.value;
            sel.addEventListener('change', function () {
                var msg = sel.getAttribute('data-confirm');
                if (msg && !window.confirm(msg)) { sel.value = prev; return; }
                window.location.href = '@Url.Action("SetLanguage", "AWREntry")'
                    + '?lang=' + encodeURIComponent(sel.value)
                    + '&returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
            });
        })();
    </script>
</li>
