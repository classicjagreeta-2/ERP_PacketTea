@* Table rows for the AWR Entry list. Rendered by Index.cshtml for the first chunk and
   returned on its own (Request.IsAjaxRequest) for every further chunk the list's infinite
   scroll asks for -- see Scripts/list-infinite-scroll.js and AWREntryController.Index.
   ViewBag.RowOffset keeps the "+" expand ids unique across chunks.
   The list starts with a Unit column (the user's permitted Units); each row also carries its own
   Unit + AWR Type as data attributes / link params -- a Doc No repeats across units, so
   Edit / View / Delete / "+" all identify the document by Doc No + Date + AWR Type + Unit. *@
@model List<Finance.Controllers.TEA.AWRDocRow>
@{
    var rowIndex = (int?)ViewBag.RowOffset ?? 0;
    // Doc No is a link into Edit mode only for users holding the Edit right (AEDV) -- UX only:
    // AWREntryController.InsertOrUpdate re-checks the right and the back-date window server-side.
    var canEdit = (ViewBag.Permission as PacketTea.Helpers.AEDV)?.Edit ?? false;
}
@if (Model != null)
{
    foreach (var row in Model)
    {
        rowIndex++;
        var detailId = "rowDetail" + rowIndex;
        <tr class="data-row">
            <td>
                <input type="checkbox" class="row-check"
                       value="@row.docno"
                       data-awrdate="@row.awrDate.ToString("yyyy-MM-dd")"
                       data-awrtype="@row.tranType"
                       data-unit="@row.unit" />
            </td>
            <td style="text-align:center;">
                <i class="fa fa-plus row-expand-btn" data-target="@detailId" title="Show lines" style="cursor:pointer;"></i>
            </td>
            <td>@row.unit</td>
            <td>
                @if (canEdit)
                {
                    <a href="@Url.Action("InsertOrUpdate", "AWREntry", new { docno = row.docno, awrDate = row.awrDate.ToString("yyyy-MM-dd"), awrType = row.tranType, unit = row.unit })">@row.docno</a>
                }
                else
                {
                    @row.docno
                }
            </td>
            <td>@row.awrDate.ToString("dd/MM/yyyy")</td>
            <td>@(row.arrivalDate?.ToString("dd/MM/yyyy"))</td>
            <td>@row.warehouseName</td>
            <td>@row.saleCentreName</td>
            <td style="text-align:right;">@row.totalBagChest.ToString("0.##")</td>
            <td style="text-align:right;">@row.totalNetWt.ToString("0.000")</td>
            <td style="text-align:right;">@row.totalBagRcvd.ToString("0.##")</td>
        </tr>
        <tr class="row-detail" id="@detailId" style="display:none;"
            data-docno="@row.docno" data-awrdate="@row.awrDate.ToString("yyyy-MM-dd")" data-awrtype="@row.tranType" data-unit="@row.unit">
            <td colspan="11" style="background:#f8f9fc;padding:10px 12px;">
                <div style="overflow-x:auto;">
                    <table class="detail-sub-table">
                        <thead>
                            <tr>
                                <th style="width:34px;">Sl</th>
                                <th>Mark</th>
                                <th>Inv No</th>
                                <th>Pack Date</th>
                                <th>Grade</th>
                                <th style="text-align:right;">Bag/Chest</th>
                                <th style="text-align:right;">Bag Rcvd</th>
                                <th style="text-align:right;">Net Rcvd</th>
                                <th style="text-align:right;">Gross Rcvd</th>
                            </tr>
                        </thead>
                        <tbody class="detail-items-body">
                            <tr><td colspan="9" style="text-align:center;color:#666;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
    }
}
