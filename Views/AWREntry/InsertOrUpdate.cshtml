@model PacketTea.Models.PT.T_AWR_PT_DATA
@using Newtonsoft.Json
@using PacketTea.Utility
@* Texts are localized (AwrText -> Resources\AWR*.resx); the language is picked in the toolbar
   (_LanguagePicker, which confirms first since reloading drops unsaved changes). *@
@{
    ViewBag.Title = AwrText.T("Title");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var awrTypes = (Dictionary<string, string>)ViewBag.AWRTypes;
    bool isEdit = ViewBag.IsEdit ?? false;
    bool lockedFromList = ViewBag.LockedFromList ?? false;
    bool isView = ViewBag.IsView ?? false;
    var first = Model.T_AWR.FirstOrDefault();
    string unit = (string)(ViewBag.NewUnit ?? first?.UNIT ?? "");
    string awrType = (string)(ViewBag.NewAWRType ?? first?.TRAN_TYPE ?? "");
    string docno = first?.DOCNO ?? "";
    string awrNo = first?.AWR_NO ?? "";
}

<!doctype html>
<html lang="@UiLanguage.Current">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (see CLAUDE.md's "lookup pickers" rule) -- the same
         jquery.inputpicker include PacketTeaPurchaseEntry / Packing use, replacing this screen's
         earlier bespoke centered-modal picker (#genericPicker). -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        input[readonly] { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 90px; }
        /* Every numeric field, grid and header alike, is right-aligned. Weights (Net Wt, Total
           Net/Gross Wt, Net/Gross Rcvd) show exactly 3 decimals (round3().toFixed(3)); Bag/Chest
           and Bag Rcvd are whole-number counts (no forced decimals) -- see renderGrid(). */
        #gridTable td input.f-bagchest, #gridTable td input.f-netwt, #gridTable td input.f-tnetwt,
        #gridTable td input.f-tgrosswt, #gridTable td input.f-bagrcvd, #gridTable td input.f-netrcvd,
        #gridTable td input.f-grossrcvd, input[type="number"] { text-align: right; }
        #gridTable tfoot td, .popup-box .picker-body td.num, .popup-box .picker-body th.num { text-align: right; }
        #gridTable td input.f-invno[readonly] { background-color: #f3f4f7; color: #555; cursor: default; }
        .popup-box.picker-box { width: 420px; display: none; }
        .popup-box.picker-box.wide { width: 700px; max-width: 90vw; }
        .popup-box .picker-body { max-height: 36vh; overflow-y: auto; margin-top: 8px; }
        .popup-box .picker-body .stock-empty { margin: 10px 4px 2px; font-size: 12px; color: #666; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .stock-filters { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; align-items: center; }
        .action-btns li a.is-disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
        .popup-box.alert-box { width: 420px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
    </style>
</head>
<body>

    <input type="hidden" id="isEdit" value="@(isEdit ? "1" : "0")" />

    <div class="general-container">
        <div class="purchase-details">
            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "AWREntry")"><i class="fa fa-arrow-left"></i> @AwrText.T("Back")</a></li>
                        <li><button type="button" id="btnSave"><i class="fa fa-floppy-o"></i> @AwrText.T("Save")</button></li>
                        <li><a href="@Url.Action("Index", "AWREntry")"><i class="fa fa-times"></i> @AwrText.T("Cancel")</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                @AwrText.T("Status") : <span id="statusText">@AwrText.T(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                        @Html.Partial("_LanguagePicker", new ViewDataDictionary { { "ConfirmReload", !isView } })
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">@AwrText.T("Title")</div></div>
                        </div>
                        <div class="title-heading">@AwrText.T("DocNoLabel") : @docno</div>
                    </div>
                </div>
            </div>

            <!-- Unit / AWR Type -- relabelled from "Unit / Blend Type" per the request. -->
            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">@AwrText.T("Sec_UnitType")</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <!-- Read-only: the Unit picked on the list page (new) / the record's own Unit (edit).
                                 It is POSTED on Save (UNIT) and stored as-is; the server checks a new
                                 record's Unit against the user's linked units. The AWR Type locks
                                 (read-only) once Unit + AWR Type were chosen on the list (lockedFromList)
                                 and in Edit mode. -->
                            <div class="form-col-20">
                                <label>@AwrText.T("Col_Unit")</label>
                                <input type="text" id="UNIT_disp" value="@unit" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Lbl_AwrType") <span>(*)</span></label>
                                <select id="AWR_TYPE" @((isEdit || lockedFromList) ? "disabled" : "")>
                                    @foreach (var t in awrTypes)
                                    {
                                        <option value="@t.Key" selected="@(t.Key == awrType)">@t.Value (@t.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container">

                <!-- Header -->
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">@AwrText.T("Sec_Header")</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>@AwrText.T("Lbl_AwrNo") <span>(*)</span></label>
                                <input type="text" id="AWR_NO" value="@awrNo" @(isEdit ? "readonly" : "") maxlength="20" />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Col_AwrDate") <span>(*)</span></label>
                                <input type="date" id="AWR_DATE" value="@(first?.AWR_DATE.ToString("yyyy-MM-dd"))"
                                       min="@ViewBag.MinDocDate" max="@ViewBag.FyEnd" @(isEdit ? "disabled" : "") />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Col_ArrivalDate")</label>
                                <input type="date" id="ARRIVAL_DATE" value="@(first?.ARRIVAL_DATE?.ToString("yyyy-MM-dd"))"
                                       min="@ViewBag.FyStart" max="@ViewBag.FyEnd" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>@AwrText.T("Col_Warehouse") <span>(*)</span></label>
                                <input type="text" id="WAREHOUSE" data-picker="warehouse" value="@(first?.WAREHOUSE)" placeholder="@AwrText.T("Pick_Code")" />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Lbl_WarehouseName")</label>
                                <input type="text" id="WAREHOUSE_disp" value="@(first?.WarehouseName)" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Col_SalesCentre") <span>(*)</span></label>
                                <input type="text" id="SALE_CENTRE" data-picker="salescentre" value="@(first?.SALE_CENTRE)" placeholder="@AwrText.T("Pick_Code")" />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Lbl_SalesCentreName")</label>
                                <input type="text" id="SALE_CENTRE_disp" value="@(first?.SaleCentreName)" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>@AwrText.T("Lbl_Source")</label>
                                <select id="SOURCE_MODE">
                                    <option value="Purchase">@AwrText.T("Src_Purchase")</option>
                                    <option value="Transfer">@AwrText.T("Src_Transfer")</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lines -->
                <div class="accordion">
                    <div class="accordion-header"><span class="txt">@AwrText.T("Lines")</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnSelectStock"><i class="fa fa-search"></i> @AwrText.T("SelectDespatch")</a></li>
                                <li><a href="javascript:void(0)" id="btnAddRow"><i class="fa fa-plus"></i> @AwrText.T("AddRow")</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> @AwrText.T("RemoveSelected")</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;">@AwrText.T("Col_Sl")</th>
                                        <th>@AwrText.T("Col_InvNo") <span style="color:red;">(*)</span></th>
                                        <th style="width:110px;">@AwrText.T("Col_PackDate")</th>
                                        <th>@AwrText.T("Col_Grade")</th>
                                        <th>@AwrText.T("Col_Mark")</th>
                                        <th style="width:75px;text-align:right;">@AwrText.T("Col_BagChest")</th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_NetWt")</th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_TotalNetWt")</th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_TotalGrossWt")</th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_BagRcvd") <span style="color:red;">(*)</span></th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_NetRcvd")</th>
                                        <th style="width:85px;text-align:right;">@AwrText.T("Col_GrossRcvd")</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="6" style="text-align:right;">@AwrText.T("Total")</td>
                                        <td id="ftBag" style="text-align:right;"></td>
                                        <td></td>
                                        <td id="ftTNet" style="text-align:right;"></td>
                                        <td id="ftTGross" style="text-align:right;"></td>
                                        <td id="ftBagRcvd" style="text-align:right;"></td>
                                        <td id="ftNetRcvd" style="text-align:right;"></td>
                                        <td id="ftGrossRcvd" style="text-align:right;"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="popup-overlay" id="pickerOverlay"></div>

    <div class="popup-box picker-box wide" id="stockPicker">
        <div class="popup-header">
            <h2>@AwrText.T("SelectDespatch")</h2>
            <button type="button" class="close-btn" onclick="closeStockPicker()">X</button>
        </div>
        <div class="stock-filters">
            <button type="button" id="btnStockFilter" class="btn-blue" style="width:auto;padding:5px 14px;">@AwrText.T("Refresh")</button>
            <button type="button" id="btnStockSelectAll" class="btn-white" style="width:auto;padding:5px 14px;">@AwrText.T("SelectAll")</button>
            <button type="button" id="btnStockDeselectAll" class="btn-white" style="width:auto;padding:5px 14px;">@AwrText.T("DeselectAll")</button>
        </div>
        <div class="picker-body" id="stockBody"></div>
        <div style="text-align:right;padding-top:10px;">
            <button type="button" class="btn-blue" id="btnStockOk" style="width:auto;padding:5px 16px;">@AwrText.T("OK")</button>
            <button type="button" class="btn-white" onclick="closeStockPicker()" style="width:auto;padding:5px 16px;">@AwrText.T("Cancel")</button>
        </div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">@AwrText.T("Notice")</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">@AwrText.T("Cancel")</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">@AwrText.T("OK")</button>
        </div>
    </div>

<script>
    // Localized texts for this script (Resources\AWR*.resx, current UI language).
    var L = @Html.Raw(AwrText.Json("Notice", "Msg_SessionExpired", "Msg_CouldNotLoad", "Ph_ViaDespatch",
        "Msg_SelectRowRemove", "Pick_Code", "Pick_Name", "Pick_Destination", "Col_InvNo", "Col_Mark", "Col_Grade",
        "Col_PackDate", "Col_BagChest", "Col_NetWt", "Msg_NoDespatch", "Msg_Blank", "Lbl_AwrNo", "Col_AwrDate",
        "Col_Warehouse", "Col_SalesCentre", "Msg_NoInvoice", "Msg_BagRcvdRequired", "Msg_Saved", "Msg_SaveFailed"));
    var UI_LANG = '@UiLanguage.Current';
    function fmt(s) { var a = arguments; return String(s).replace(/\{(\d+)\}/g, function (m, i) { return a[+i + 1] != null ? a[+i + 1] : ''; }); }
    function esc(s) { return $('<div>').text(s == null ? '' : s).html().replace(/"/g, '&quot;'); }

    function closeAppAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) { AppMsg.show(message, onOk); }
    function handleLookupFail(jqXHR) {
        if (jqXHR.status === 440) {
            showAlert((jqXHR.responseJSON && jqXHR.responseJSON.message) || L.Msg_SessionExpired,
                function () { window.location.reload(); });
        } else {
            showAlert((jqXHR.responseJSON && jqXHR.responseJSON.message) || L.Msg_CouldNotLoad);
        }
    }
    $('#pickerOverlay, #stockPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);

    var IS_EDIT = $('#isEdit').val() === '1';
    var FY_MIN = '@ViewBag.FyStart';
    var FY_MAX = '@ViewBag.FyEnd';

    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function round2(v) { return Math.round(num(v) * 100) / 100; }
    function round3(v) { return Math.round(num(v) * 1000) / 1000; }
    // Whole-number/count fields (Bag/Chest, Bag Rcvd): shown as they are (12, not 12.00), never rounded.
    // (Only float noise beyond 6 dp is trimmed, so sums like 0.1+0.2 don't print 0.30000000000000004.)
    function fmtCount(v) { return String(Math.round(num(v) * 1e6) / 1e6); }
    function toIso(dmy) { return dmy || null; }
    function fmtDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
    }

    var rows = @Html.Raw(JsonConvert.SerializeObject(Model.T_AWR));
    var rowSeq = 0;
    rows.forEach(function (r) { r._cid = ++rowSeq; });

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        var totBag = 0, totNet = 0, totTNet = 0, totTGross = 0, totBagRcvd = 0, totNetRcvd = 0, totGrossRcvd = 0;
        rows.forEach(function (r, idx) {
            r.SRLNO = idx + 1;
            totBag += num(r.BAG_CHEST); totNet += num(r.NET_WT);
            totTNet += num(r.TNET_WT); totTGross += num(r.TGROSS_WT);
            totBagRcvd += num(r.BAG_RCVD); totNetRcvd += num(r.NET_RCVD); totGrossRcvd += num(r.GROSS_RCVD);
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" /></td>');
            tr.append('<td>' + r.SRLNO + '</td>');
            tr.append('<td><input type="text" class="f-invno" value="' + (r.INVNO || '') + '" placeholder="' + esc(L.Ph_ViaDespatch) + '" readonly /></td>');
            tr.append('<td><input type="date" class="f-packdate" value="' + (r.PACK_DATE ? r.PACK_DATE.substring(0, 10) : '') + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-grade" value="' + (r.GRADE || '') + '" readonly /></td>');
            tr.append('<td><input type="text" class="f-mark" value="' + (r.MarkName || r.MARK || '') + '" readonly /></td>');
            tr.append('<td><input type="number" step="any" style="text-align:right;" class="f-bagchest" value="' + fmtCount(r.BAG_CHEST) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.001" style="text-align:right;" class="f-netwt" value="' + round3(r.NET_WT).toFixed(3) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.001" style="text-align:right;" class="f-tnetwt" value="' + round3(r.TNET_WT).toFixed(3) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.001" style="text-align:right;" class="f-tgrosswt" value="' + round3(r.TGROSS_WT).toFixed(3) + '" readonly /></td>');
            tr.append('<td><input type="number" step="any" style="text-align:right;" class="f-bagrcvd" value="' + fmtCount(r.BAG_RCVD) + '" /></td>');
            tr.append('<td><input type="number" step="0.001" style="text-align:right;" class="f-netrcvd" value="' + round3(r.NET_RCVD).toFixed(3) + '" readonly /></td>');
            tr.append('<td><input type="number" step="0.001" style="text-align:right;" class="f-grossrcvd" value="' + round3(r.GROSS_RCVD).toFixed(3) + '" readonly /></td>');
            $tb.append(tr);
        });
        renderTotalsOnly();
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    // Bag Received recompute -- verbatim from the spec PDF's AWR calculation
    // section: proportional received-weight allocation.
    // TNetWtRcvd = NetWt(per-bag) * BagRcvd ; TGrossWtRcvd = TGrossWt * BagRcvd / BagChest.
    $('#gridBody').on('input change', '.f-bagrcvd', function () {
        var $tr = $(this).closest('tr');
        var r = findRow($tr.data('cid'));
        if (!r) return;
        r.BAG_RCVD = num($(this).val());
        var bagChest = num(r.BAG_CHEST);
        var netWtPerBag = bagChest > 0 ? num(r.TNET_WT) / bagChest : 0;
        r.NET_RCVD = round3(netWtPerBag * r.BAG_RCVD);
        r.GROSS_RCVD = bagChest > 0 ? round3(num(r.TGROSS_WT) * r.BAG_RCVD / bagChest) : 0;
        $tr.find('.f-netrcvd').val(r.NET_RCVD.toFixed(3));
        $tr.find('.f-grossrcvd').val(r.GROSS_RCVD.toFixed(3));
        renderTotalsOnly();
    });
    // Bag Rcvd is a count: on blur just normalise the text (12, not 12.00) -- never rounded.
    $('#gridBody').on('blur', '.f-bagrcvd', function () { $(this).val(fmtCount($(this).val())); });

    function renderTotalsOnly() {
        var totBag = 0, totTNet = 0, totTGross = 0, totBagRcvd = 0, totNetRcvd = 0, totGrossRcvd = 0;
        rows.forEach(function (r) {
            totBag += num(r.BAG_CHEST); totTNet += num(r.TNET_WT); totTGross += num(r.TGROSS_WT);
            totBagRcvd += num(r.BAG_RCVD); totNetRcvd += num(r.NET_RCVD); totGrossRcvd += num(r.GROSS_RCVD);
        });
        $('#ftBag').text(fmtCount(totBag));
        $('#ftTNet').text(round3(totTNet).toFixed(3));
        $('#ftTGross').text(round3(totTGross).toFixed(3));
        $('#ftBagRcvd').text(fmtCount(totBagRcvd));
        $('#ftNetRcvd').text(round3(totNetRcvd).toFixed(3));
        $('#ftGrossRcvd').text(round3(totGrossRcvd).toFixed(3));
    }

    $('#btnAddRow').on('click', function () {
        rows.push({ _cid: ++rowSeq, BAG_CHEST: 0, NET_WT: 0, TNET_WT: 0, TGROSS_WT: 0, BAG_RCVD: 0, NET_RCVD: 0, GROSS_RCVD: 0 });
        renderGrid();
    });
    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });
    $('#btnRemoveRows').on('click', function () {
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert(L.Msg_SelectRowRemove); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        renderGrid();
    });

    // =========================================================
    // Header lookups (Warehouse / Sales Centre) -- jquery.inputpicker (Root UI convention: an
    // anchored, paginated picker under the field itself -- see CLAUDE.md's "lookup pickers" rule).
    // Replaces this screen's earlier bespoke centered-modal picker (#genericPicker, now removed).
    // The endpoints match the typed text against every column shown (Warehouse: Code, Name,
    // Destination; Sales Centre: Code, Name).
    // =========================================================
    var pickerConfig = {
        warehouse: { url: '@Url.Action("GetWarehouse", "AWREntry")', fields: [{ name: 'CODE', text: L.Pick_Code }, { name: 'NAME', text: L.Pick_Name }, { name: 'DESTI', text: L.Pick_Destination }], target: 'WAREHOUSE' },
        salescentre: { url: '@Url.Action("GetSalesCentre", "AWREntry")', fields: [{ name: 'CODE', text: L.Pick_Code }, { name: 'NAME', text: L.Pick_Name }], target: 'SALE_CENTRE' }
    };

    $('[data-picker]').on('click focus', function () { openPicker($(this).data('picker'), $(this)); });

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the
    // plugin writes the picked value into the original input and fires "change" on it; it does
    // not hand the row to a select handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    // Open the dropdown AND refresh its rows. The plugin loads url-backed data asynchronously and
    // only re-renders the list on a keystroke, so showing it right after init (before the first
    // response lands) displayed "No results" -- the keyup makes it fetch and render the rows.
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function openPicker(key, $input) {
        var cfg = pickerConfig[key];
        $('.inputpicker-wrapped-list').remove();

        // This plugin never sets $.data('inputpicker'); the class it puts on the original input
        // is the "already initialised" test (otherwise every click re-wraps the field and drops
        // whatever the user has typed).
        // Showing is deferred a tick: called from a click, the click's own bubbling up to the
        // plugin's document-level "outside click" handler would otherwise hide it straight away.
        if ($input.hasClass('inputpicker-original')) {
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker({
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2      // seconds (the plugin multiplies by 1000): one request per pause in typing, not per keystroke
        });
        setTimeout(function () { showPickerList($input); }, 0);

        function deliver(row) {
            if (!row) return;
            $('#' + cfg.target).val(row[cfg.fields[0].name]);
            $('#' + cfg.target + '_disp').val(row[cfg.fields[1].name] || '');
        }
        // Both hooks call the same idempotent handler, so whichever this plugin build fires works.
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
    }

    // Select Despatch Data (Purchase / Inter Transfer toggle)
    function openStockPicker() { $('#pickerOverlay, #stockPicker').fadeIn(120); loadStock(); }
    $('#btnSelectStock').on('click', openStockPicker);
    function closeStockPicker() { $('#pickerOverlay, .popup-box').fadeOut(120); }
    $('#btnStockFilter, #SOURCE_MODE').on('click change', loadStock);

    function loadStock() {
        var awrType = $('#AWR_TYPE').val();
        var mode = $('#SOURCE_MODE').val();
        $.getJSON('@Url.Action("GetDespatchData", "AWREntry")', { awrType: awrType, mode: mode }, function (data) {
            data = data || [];
            var html = '<table><thead><tr><th></th><th>' + esc(L.Col_InvNo) + '</th><th>' + esc(L.Col_Mark) + '</th><th>' + esc(L.Col_Grade) + '</th><th>' + esc(L.Col_PackDate) +
                '</th><th class="num" style="text-align:right;">' + esc(L.Col_BagChest) + '</th><th class="num" style="text-align:right;">' + esc(L.Col_NetWt) + '</th></tr></thead><tbody>';
            data.forEach(function (r, i) {
                html += '<tr data-i="' + i + '"><td><input type="checkbox" class="stockChk" /></td><td>' + (r.invno || '') + '</td><td>' + (r.markDescn || r.mark || '') + '</td>' +
                    '<td>' + (r.gradeName || r.grade || '') + '</td><td>' + fmtDate(r.packDate) + '</td><td class="num" style="text-align:right;">' + fmtCount(r.bagChest) + '</td><td class="num" style="text-align:right;">' + round3(r.netWt).toFixed(3) + '</td></tr>';
            });
            html += '</tbody></table>';
            if (!data.length) {
                // The Source option's (localized) text, lower-cased mid-sentence except in German.
                var modeText = $('#SOURCE_MODE option:selected').text();
                if (UI_LANG !== 'de') modeText = modeText.toLowerCase();
                html += '<p class="stock-empty">' + esc(fmt(L.Msg_NoDespatch, modeText, awrType)) + '</p>';
            }
            $('#stockBody').html(html);
            $('#stockBody').data('rows', data);
        }).fail(handleLookupFail);
    }
    $('#btnStockSelectAll').on('click', function () { $('#stockBody .stockChk').prop('checked', true); });
    $('#btnStockDeselectAll').on('click', function () { $('#stockBody .stockChk').prop('checked', false); });

    $('#btnStockOk').on('click', function () {
        var data = $('#stockBody').data('rows') || [];
        $('#stockBody .stockChk:checked').each(function () {
            var i = $(this).closest('tr').data('i');
            var s = data[i];
            var dup = rows.some(function (r) { return r.INVNO === s.invno && r.GRADE === s.grade && r.MARK === s.mark && (r.PACK_DATE || '').substring(0, 10) === (s.packDate || '').substring(0, 10); });
            if (dup) return;
            rows.push({
                _cid: ++rowSeq,
                MARK: s.mark, MarkName: s.markDescn || '',
                INVNO: s.invno, PACK_DATE: s.packDate, GRADE: s.grade,
                BAG_CHEST: s.bagChest, NET_WT: s.netWt, TNET_WT: s.tnetWt || s.netWt, TGROSS_WT: s.tgrossWt || 0,
                GP_NO: s.gpNo, GP_DATE: s.gpDate,
                BAG_RCVD: 0, NET_RCVD: 0, GROSS_RCVD: 0
            });
        });
        renderGrid();
        closeStockPicker();
    });

    $('#btnSave').on('click', function () {
        if (!$('#AWR_NO').val()) { showAlert(fmt(L.Msg_Blank, L.Lbl_AwrNo)); return; }
        if (!$('#AWR_DATE').val()) { showAlert(fmt(L.Msg_Blank, L.Col_AwrDate)); return; }
        if (!$('#WAREHOUSE').val()) { showAlert(fmt(L.Msg_Blank, L.Col_Warehouse)); return; }
        if (!$('#SALE_CENTRE').val()) { showAlert(fmt(L.Msg_Blank, L.Col_SalesCentre)); return; }
        var validRows = rows.filter(function (r) { return r.INVNO; });
        if (!validRows.length) { showAlert(L.Msg_NoInvoice); return; }
        if (validRows.some(function (r) { return !(num(r.BAG_RCVD) > 0); })) { showAlert(L.Msg_BagRcvdRequired); return; }

        var payload = { T_AWR: validRows.map(function (r) {
            return {
                ID: r.ID || 0,
                // The Unit picked on the list (new) / the record's own Unit (edit) -- stored as-is;
                // the server checks it against the user's linked units.
                UNIT: $('#UNIT_disp').val(),
                TRAN_TYPE: $('#AWR_TYPE').val(),
                DOCNO: '@docno',
                AWR_NO: $('#AWR_NO').val(),
                AWR_DATE: $('#AWR_DATE').val(),
                ARRIVAL_DATE: $('#ARRIVAL_DATE').val() || null,
                WAREHOUSE: $('#WAREHOUSE').val(),
                SALE_CENTRE: $('#SALE_CENTRE').val(),
                INVNO: r.INVNO, PACK_DATE: r.PACK_DATE, GRADE: r.GRADE, MARK: r.MARK,
                BAG_CHEST: num(r.BAG_CHEST), NET_WT: num(r.NET_WT), TNET_WT: num(r.TNET_WT), TGROSS_WT: num(r.TGROSS_WT),
                BAG_RCVD: num(r.BAG_RCVD), NET_RCVD: num(r.NET_RCVD), GROSS_RCVD: num(r.GROSS_RCVD),
                GP_NO: r.GP_NO, GP_DATE: r.GP_DATE
            };
        }), IsNew: !IS_EDIT };

        $.ajax({
            url: '@Url.Action("Save", "AWREntry")', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload)
        }).done(function (resp) {
            if (resp.success) {
                showAlert(L.Msg_Saved, function () { window.location.href = '@Url.Action("Index", "AWREntry")'; });
            } else {
                showAlert(resp.message || L.Msg_SaveFailed);
            }
        }).fail(handleLookupFail);
    });

    renderGrid();

    // View mode (list page "View" button): runs after the first renderGrid() has built every grid
    // row, then disables the header fields, the whole grid and the Save / row buttons.
    var IS_VIEW = @Html.Raw(isView ? "true" : "false");
    if (IS_VIEW) {
        $('.accordion-container :input').prop('disabled', true);
        $('#btnSave').prop('disabled', true).css({ opacity: .4, cursor: 'not-allowed' });
        $('#btnSelectStock, #btnAddRow, #btnRemoveRows').css({ opacity: .4, 'pointer-events': 'none' });
    }
</script>
@Html.Partial("_RecordLock")
</body>
</html>
