@model PacketTea.Models.PT.TeaPurchaseRegisterResult
@{
    Layout = null;
    string title = ViewBag.Title as string ?? "Tea Purchase Register";
    string opt = ViewBag.ReportOpt as string ?? "Opt1";
    Func<decimal, string> N = v => v == 0 ? "" : v.ToString("#,##0.00");
    var rows = Model.Rows ?? new List<PacketTea.Models.PT.TeaPurchaseRow>();
    var line1 = !string.IsNullOrWhiteSpace(Model.CompanyV) && Model.CompanyV.Trim().Length > 1 ? Model.CompanyV.Trim() : Model.Company;
    bool detail = opt == "Opt1";
    int cols = detail ? 13 : 10;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        @@page { size: A4 landscape; margin: 8mm; }
        body { margin: 0; background: #e9e9e9; font-family: Calibri, Arial, sans-serif; color: #222; font-size: 12px; }
        .toolbar { position: sticky; top: 0; background: #404E67; color: #fff; padding: 8px 16px; display: flex; gap: 10px; align-items: center; }
        .toolbar button { background: #fff; color: #404E67; border: 0; padding: 5px 14px; cursor: pointer; font-weight: bold; }
        .sheet { background: #fff; width: 281mm; margin: 12px auto; padding: 7mm; box-sizing: border-box; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
        h1 { font-size: 16px; margin: 0; text-align: center; }
        h2 { font-size: 13px; margin: 2px 0; text-align: center; font-weight: normal; }
        .sub { text-align: center; font-size: 11px; margin: 2px 0 6px; }
        table { border-collapse: collapse; width: 100%; }
        th { background: #404E67; color: #fff; padding: 4px 5px; border: 1px solid #8A94A8; text-align: left; }
        td { border: 1px solid #BBBBBB; padding: 3px 5px; vertical-align: top; }
        td.n, th.n { text-align: right; }
        .tot td { background: #DFE3EC; font-weight: bold; }
        .foot { margin-top: 8px; font-size: 11px; }
        .err { padding: 40px; font-size: 14px; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .sheet { box-shadow: none; margin: 0; width: auto; padding: 0; } }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">Print</button><span>@title</span></div>
    @if (ViewBag.Error != null)
    {
        <div class="sheet"><div class="err"><b>Tea Purchase Register</b><br /><br />@ViewBag.Error</div></div>
    }
    else
    {
        <div class="sheet">
            <h1>@line1</h1>
            <h2><b>@title</b></h2>
            <div class="sub">@ViewBag.AcYear</div>
            <table>
                <thead>
                    @if (detail)
                    {
                        <tr>
                            <th>Doc No</th><th>Date</th><th>Bill No</th><th>Party</th><th>Garden</th><th>Invoice</th><th>Grade</th>
                            <th class="n">Bags</th><th class="n">Qty</th><th class="n">Rate</th><th class="n">Amount</th><th class="n">GST</th><th class="n">Total</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th>Party</th><th>Doc No</th><th>Bill No</th><th>Bill Date</th><th class="n">Qty</th><th class="n">Amount</th>
                            <th class="n">CGST</th><th class="n">SGST</th><th class="n">IGST</th><th class="n">Total</th>
                        </tr>
                    }
                </thead>
                <tbody>
                    @foreach (var x in rows)
                    {
                        if (detail)
                        {
                            <tr>
                                <td>@x.DOCNO</td><td>@x.DOCDT</td><td>@x.BILLNO</td><td>@x.PARTY</td><td>@x.GARDEN</td><td>@x.INVNO</td><td>@x.GRADE_NAME</td>
                                <td class="n">@x.BAG_CHEST.ToString("0.##")</td><td class="n">@N(x.QTY)</td><td class="n">@N(x.RATE)</td>
                                <td class="n">@N(x.AMOUNT)</td><td class="n">@N(x.GST_AMT)</td><td class="n">@N(x.TOT_AMT)</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@x.PARTY</td><td>@x.DOCNO</td><td>@x.BILLNO</td><td>@x.BILLDT</td><td class="n">@N(x.QTY)</td><td class="n">@N(x.AMOUNT)</td>
                                <td class="n">@N(x.CGST_AMT)</td><td class="n">@N(x.SGST_AMT)</td><td class="n">@N(x.IGST_AMT)</td><td class="n">@N(x.TOT_AMT)</td>
                            </tr>
                        }
                    }
                    <tr class="tot">
                        @if (detail)
                        {
                            <td colspan="7">Grand Total</td><td class="n">@rows.Sum(x => x.BAG_CHEST).ToString("0.##")</td><td class="n">@N(rows.Sum(x => x.QTY))</td><td></td>
                            <td class="n">@N(rows.Sum(x => x.AMOUNT))</td><td class="n">@N(rows.Sum(x => x.GST_AMT))</td><td class="n">@N(rows.Sum(x => x.TOT_AMT))</td>
                        }
                        else
                        {
                            <td colspan="4">Grand Total</td><td class="n">@N(rows.Sum(x => x.QTY))</td><td class="n">@N(rows.Sum(x => x.AMOUNT))</td>
                            <td class="n">@N(rows.Sum(x => x.CGST_AMT))</td><td class="n">@N(rows.Sum(x => x.SGST_AMT))</td><td class="n">@N(rows.Sum(x => x.IGST_AMT))</td>
                            <td class="n">@N(rows.Sum(x => x.TOT_AMT))</td>
                        }
                    </tr>
                </tbody>
            </table>
            @if (Model.TotalRound != 0)
            {
                <div class="foot">Total round off: @Model.TotalRound.ToString("0.00")</div>
            }
            <div class="foot">Report: Tea Purchase Register &nbsp; user: @ViewBag.RunBy &nbsp; @ViewBag.RunAt</div>
        </div>
    }
</body>
</html>
