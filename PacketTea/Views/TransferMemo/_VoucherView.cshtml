@model List<Finance.Models.Master.Memo_VoucherEntryHeaderDetails>
@using Finance.Models.Enum
@{
    //int cc = ViewBag.count;
    //decimal SrlNoCount = ViewBag.SrlNoCount;
}
@if (Model != null)
{
    int cc = 0;
    foreach (var item in Model)
    {
        <tr id="@cc">
            <td  class="col-sm-1 target">
                @Html.TextBoxFor(o => o[cc].CHQNO, new { @id = "CHQNO_" + cc })
            </td>
            <td  class="col-sm-1 target">
                @Html.TextBoxFor(o => o[cc].CHQDT, new { @id = "CHQDT_" + cc })
            </td>
          
            <td>
                @Html.TextBoxFor(model => model[cc].NARRATION, new { @class = "form-control", @id = "NARRATION_" + cc, data_id = @cc, @readonly = "readonly" })
            </td>
            <td  class="col-sm-1">
                @Html.TextBoxFor(o => o[cc].AMOUNT, new { @id = "AMOUNT_" + cc, name = "AMOUNT", @type = "number", @class = "cr required", min = "0", @required = "required", @readonly = "readonly" })
            </td>
        </tr>
        cc++;
    }
}




