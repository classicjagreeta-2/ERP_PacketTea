
@{
    ViewBag.Title = "Index";
}

﻿
@model Finance.Models.Master.Memo_VoucherEntryHeaderDetails
@using Finance.Utility
@using Finance.Models.Enum
@{
    ViewBag.Title = "InsertOrUpdate - " + ViewBag.VouType;
    //var isOtherModelCount = Model.OtherModel;
    //decimal? countRowIndex = Model.T_BH11Details != null ? Model.T_BH11Details.Max(s => s.SRLNO) : 0;
    //int countingRow = (int)(countRowIndex ?? 1);
    int countingRow = 0;
    int acodePrefixVal = (int)NewVouType.Bank;
    string UnitValue = ViewBag.Unit ?? "";
    //int Con = ViewBag.VouType;
    int payment = (int)EnumPaymentType.Payment;
    int receipt = (int)EnumPaymentType.Receipt;
    TempData["VoucherEntryData"] = Model; //used when opening Bill Settlement Directly
    var _aedv = (Finance.Helpers.AEDV)ViewBag._aedv;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Voucher Entry</title>
    <!-- CSS -->

    <link href="~/Content/assets/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/assets/css/jquery-ui.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry-responsive.css">
    <link href="~/Content/src/jquery.inputpicker.css" rel="stylesheet">
    <script src="https://unpkg.com/slim-select@latest/dist/slimselect.js"></script>
    <link href="https://unpkg.com/slim-select@latest/dist/slimselect.css" rel="stylesheet">
    <style>
        /* Keyboard ↑ ↓ selected row */
        .inputpicker-wrapped-list tr.inputpicker-active {
            background-color: #0d6efd !important; /* BLUE */
            color: #ffffff !important;
        }

            /* Force text visibility */
            .inputpicker-wrapped-list tr.inputpicker-active td {
                color: white !important;
                background-color: navy !important;
            }

        /* Mouse hover same as keyboard */
        .inputpicker-wrapped-list tr:hover {
            background-color: #0d6efd !important;
            color: #ffffff !important;
        }

        /* Optional: selected (clicked) row */
        .inputpicker-wrapped-list tr.inputpicker-selected {
            background-color: #cfe2ff !important;
        }
        /* make space for X */
        .inputpicker-input {
            padding-right: 22px !important;
            overflow: hidden !important;
        }

        /* parent must allow absolute position */
        .inputpicker-div {
            position: relative !important;
            overflow: hidden !important;
        }

        /* X button always top */
        /*      .ip-clear-btn {
            position: absolute !important;
            right: 6px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            z-index: 9;
            pointer-events: auto !important;
            cursor: pointer !important;
        }*/

        /* dropdown should be lower than X */
        .inputpicker-wrapped-list {
            z-index: 9;
            max-width: 50%;
            min-width: 250px;
        }

        /* space for X */
        .inputpicker-input {
            padding-right: 22px !important;
        }
        /* input[type="number"] {
            text-align: right;
        }*/
    </style>
</head>

<body>

    <!-- third screen start -->
    <div class="general-container">
        <div class="voucher-details">
            <!-- header content start -->
            <!-- header content end -->

            <div class="voucher-container">

                <div class="voucher-content">
                    <form id="form1" name="form1" class="cash-form" novalidate="novalidate">
                        <div class="row">
                            <div class="col">
                                <div class="form-group border-bottom">
                                    <label for="InvoiceNo">Voucher No:</label>
                                    @Html.HiddenFor(c => c.CON)
                                    @Html.HiddenFor(c => c.UNIT)
                                    @Html.HiddenFor(c => c._asId)
                                    @Html.HiddenFor(c => c.TIME_ORA)
                                    @Html.HiddenFor(c => c.DR_SUBCODE)
                                    @Html.HiddenFor(c => c.DR_ACODE)
                                    @Html.HiddenFor(c => c._EndFYear)
                                    @Html.HiddenFor(c => c._StartFYear)
                                    @Html.HiddenFor(c => c.NARR, new { @id = "hiddenNarration", @name = "NARR" })

                                    @Html.TextBoxFor(c => c.VOU_NO, new { @class = "form-control voucherNumber", @name = "VOU_NO" })

                                </div>
                            </div>
                            <div class="col">
                                <div class="form-group border-bottom">
                                    <label for="DocumentType">Voucher Type:</label>
                                    @Html.TextBoxFor(c => c.VOU_TYPE, new { @class = "form-control voucherType" })
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-group border-bottom">
                                    <label for="InvoiceDate">Voucher Date:</label>
                                    @if (Model.VOU_DT == null)
                                    {
                                        @Html.TextBox("VOU_DT", "yyyy-MM-dd", new { @class = "form-control", @style = "width:100%", type = "date", @name = "VOU_DT"});
                                    }
                                    else
                                    {

                                        Model._LAST_DT = Model._LAST_DT.HasValue ? Model._LAST_DT.Value : Model._FROM_DATE.Value;
                                        if (Model._LAST_DT <= Model._TO_DATE && Model._TO_DATE >= DateTime.Now.AddDays(-(_aedv.Aday)))
                                        {
                                            if (Model._LAST_DT <= Model._EndFYear && Model._LAST_DT >= Model._StartFYear)
                                            {

                                                if (DateTime.Now.AddDays(-(_aedv.Aday)) >= Model._FROM_DATE && DateTime.Now.AddDays(-(_aedv.Aday)) >= Model._LAST_DT)
                                                {
                                                    Model._LAST_DT = DateTime.Now.AddDays(-(_aedv.Aday));
                                                }
                                                //else if (DateTime.Now.AddDays(-(_aedv.Aday)) >= Model._FROM_DATE && DateTime.Now.AddDays(-(_aedv.Aday)) <= Model._LAST_DT)
                                                //{
                                                //    Model._LAST_DT= Model._LAST_DT;
                                                //}
                                                //else if (DateTime.Now.AddDays(-(_aedv.Aday)) <= Model._FROM_DATE && DateTime.Now.AddDays(-(_aedv.Aday)) <= Model._LAST_DT)
                                                //{

                                                //}
                                                @Html.TextBox("VOU_DT",
                                                Model.VOU_DT.HasValue ? Model.VOU_DT.Value.ToString("yyyy-MM-dd") : Model._LAST_DT.Value != null ? Model._LAST_DT.Value.ToString("yyyy-MM-dd") : Model._FROM_DATE.Value.ToString("yyyy-MM-dd"),

                                                new
                                                {
                                                    @class = "form-control",
                                                    @style = "width:100%",
                                                    @name = "VOU_DT",
                                                    type = "date",
                                                    @required = "required",
                                                    min = Model._LAST_DT.Value != null ? Model._LAST_DT.Value.ToString("yyyy-MM-dd") : Model._FROM_DATE.Value.ToString("yyyy-MM-dd"), // Set the minimum date range
                                                    max = Model._TO_DATE.Value.ToString("yyyy-MM-dd")  // Set the maximum date range
                                                })
                                                <label id="VOU_DT-error" class="error" for="VOU_DT">Select Date from @(Model._LAST_DT.Value != null ? Model._LAST_DT.Value.ToString("dd-MM-yyyy") : Model._FROM_DATE.Value.ToString("dd-MM-yyyy"))  to @Model._TO_DATE.Value.ToString("dd-MM-yyyy")</label>
                                            }
                                            else
                                            {
                                                Model._LAST_DT = DateTime.Now.AddDays(-(_aedv.Aday));
                                                //Model._LAST_DT = ;
                                                @Html.TextBox("VOU_DT", "yyyy-MM-dd",
                                                    new
                                                    {
                                                        @class = "form-control",
                                                        @style = "width:100%",
                                                        @name = "VOU_DT",
                                                        type = "date",
                                                        @readonly = "readonly",
                                                        @required = "required",
                                                        min = Model._LAST_DT.Value != null ? Model._LAST_DT.Value.ToString("yyyy-MM-dd") : Model._FROM_DATE.Value.ToString("yyyy-MM-dd"), // Set the minimum date range
                                                        max = Model._TO_DATE.Value.ToString("yyyy-MM-dd")  // Set the maximum date range
                                                    })
                                                <label id="VOU_DT-error" class="error" for="VOU_DT">Financial Year - @(Model._StartFYear.Value.ToString("dd-MM-yyyy"))  to @Model._EndFYear.Value.ToString("dd-MM-yyyy")</label>
                                            }
                                        }

                                        else
                                        {
                                            Model._LAST_DT = DateTime.Now.AddDays(-(_aedv.Aday));
                                            //Model._LAST_DT = ;
                                            @Html.TextBox("VOU_DT", "yyyy-MM-dd",
                                                new
                                                {
                                                    @class = "form-control",
                                                    @style = "width:100%",
                                                    @name = "VOU_DT",
                                                    type = "date",
                                                    @readonly = "readonly",
                                                    @required = "required",
                                                    min = Model._LAST_DT.Value != null ? Model._LAST_DT.Value.ToString("yyyy-MM-dd") : Model._FROM_DATE.Value.ToString("yyyy-MM-dd"), // Set the minimum date range
                                                    max = Model._TO_DATE.Value.ToString("yyyy-MM-dd")  // Set the maximum date range
                                                })
                                            <label id="VOU_DT-error" class="error" for="VOU_DT">Permission till @(Model._LAST_DT.Value.ToString("dd-MM-yyyy")) & Date Range is @(Model._FROM_DATE.Value.ToString("dd-MM-yyyy"))  to @Model._TO_DATE.Value.ToString("dd-MM-yyyy")</label>
                                        }
                                    }
                                </div>
                            </div>

                        </div>
                    </form>
                </div>


                <div class="voucher-content">

                    <!-- action btns start -->
                    <div class="action-btns">
                        <ul>
                            <li> <button id="Btn_AddVoucherSet"> <i class="fa fa-plus"></i> Detail View </button> </li>
                        </ul>
                    </div>
                    <!-- action btns end -->

                    <form id="form2" name="form2" class="cash-form">
                        <div class="table-responsive">
                            <table class="border no-border-form">
                                <thead>
                                    <tr>
                                        @*<th>Action</th>*@

                                        <th>Chq. No</th>
                                        <th>Chq. Date</th>
                                        <th>Narration</th>
                                        <th>Amount</th>

                                    </tr>
                                </thead>
                                <tbody id="VoucherViewHeaderClass">
                                    @if (Model.T_BH11Details.Count != 0)
                                    {
                                        if (Model.T_BH11Details != null)
                                        {
                                            int v = 0;
                                            foreach (var item in Model.T_BH11Details.ToList())
                                            {                                               
                                                <tr id="@v">
                                                    <td>
                                                        @Html.EditorFor(o => o.T_BH11Details[v].CHQNO, new { @id = "CHQNO_" + v })
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(o => o.T_BH11Details[v].CHQDT, new { @id = "CHQDT_" + v, type = "date" })
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(o => o.T_BH11Details[v].NARRATION, new { @id = "NARRATION_" + v })
                                                    </td>
                                                    <td>
                                                        @Html.TextBoxFor(o => o.T_BH11Details[v].AMOUNT, new { @id = "AMOUNT_" + v, name = "AMOUNT", @type = "number" })
                                                    </td>
                                                </tr>
                                                v++;
                                            }
                                        }
                                    }
                                    <partial name="_VoucherView.cshtml">
                                </tbody>
                            </table>
                        </div>

                    </form>
                </div>


            </div>


        </div>


    </div>
    <!-- third screen end -->
    @*<script src="~/Content/assets/js/jquery-3.7.1.min.js"></script>
        <script src="~/Content/assets/js/jquery-ui.js"></script>*@
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
    <script src="~/Content/src/jquery.inputpicker.js"></script>
    <script src="~/Content/assets/js/custom.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            let load = false;
            let UnitValue = "";
            $('#VOU_NO').inputpicker({
                url: '@Url.Action("ReturnVoucherListDDLData", "TransferMemo")',
                fields: [
                    { name: '_VOU_DT', text: '_VOU_DT' },
                    { name: 'VOU_NO', text: 'VOU_NO' },
                    { name: 'UNIT', text: 'UNIT' }
                ],
                fieldText: 'VOU_NO',
                fieldValue: 'VOU_NO',
                placeholder: '-- Select Voucher --',
                headShow: true,
                filterOpen: true,
                autoOpen: false,
                pagination: true,
                pageField: 'p',
                pageLimitField: 'limit',
                pageLimit: 20,
                pageCountField: 'count',
                pageCurrent: 1,          // ✅ ADD THIS
                width: '100%',
                tabToSelect: true,
                urlDelay: 1,
                openAfterLoad: true,
                nextPicker: '#VOU_TYPE'
            }).on('change select', function (e) {
                debugger;
                var $element = $(this); // Get the selected value
                var vouNo = $element.val(); // Get the selected item directly from inputpicker
                var selectedData = $element.inputpicker('data'); // all rows
                var selectedItem = Array.isArray(selectedData) ? selectedData.find(item => item.VOU_NO === vouNo) : null;
                //var acName = selectedItem?.ACNAME || '';
                var Unit = selectedItem?.UNIT;
                UnitValue = selectedItem?.UNIT;
                var vouDt = selectedItem?._VOU_DT;
                openVoucerType(vouNo, Unit, true);
                _addVoucherData();

            });
            //openVoucerType(load);
            function openVoucerType(vouNo, Unit, load) {
                  $('#VOU_TYPE').inputpicker({
                    url: '@Url.Action("GetMastVouRight", "TransferMemo")',
                    fields: [
                        { name: 'TYPE', text: 'TYPE' },
                        { name: 'DESC_ORA', text: 'DESC_ORA' }
                    ],
                      fieldText: 'DESC_ORA',
                      fieldValue: 'TYPE',
                      placeholder: '-- Select Voucher Type --',
                      headShow: true,
                      filterOpen: true,
                      autoOpen: false,
                      urlParam: {
                          VouNo: vouNo,
                          unit: Unit
                      },
                      pagination: true,
                      pageField: 'p',
                      pageLimitField: 'limit',
                      pageLimit: 20,
                      pageCountField: 'count',
                      pageCurrent: 1,          // ✅ ADD THIS
                      width: '100%',
                      tabToSelect: true,
                      urlDelay: 1,
                      openAfterLoad: load,
                  }).on('change select', function (e) {
                      debugger;
                      _checkVouDt();
                  });
            }
            $(document).on('click', '#Btn_AddVoucherSet', function () {
                 $.ajax({
                    url: '@Url.Action("TransferMemoSave", "TransferMemo")',
                     data: { VouNo: $('#VOU_NO').val(), vouType: $('#VOU_TYPE').val(), VouDt: $('#VOU_DT').val() },
                     success: function (response) { 
                            if (response.IsSuccessStatusCode) {
                                toastr.success(response.Message);
                            }
                            else {
                                toastr.error(response.Message);
                            }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            console.log(xhr);
                        } 
                });
            });
            function _addVoucherData() {
                /*let dd = $('#VOU_NO').val();*/
                $.ajax({
                    url: '@Url.Action("DisplayVoucher_PartialView", "TransferMemo")',
                    data: { VouNo: $('#VOU_NO').val() },
                    success: function (partialView) {                       
                        debugger;
                       $('#VoucherViewHeaderClass').empty();
                        $('#VoucherViewHeaderClass').append(partialView);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        console.log(xhr);
                    }
                });
            }
            function _checkVouDt() {
                let vouType = $('#VOU_TYPE').val();
                $.ajax({
                    url: '@Url.Action("CheckVouDt", "TransferMemo")',
                    data: { VouNo: $('#VOU_TYPE').val(), Unit: UnitValue },
                    success: function (data) {
                        console.log("Success:", data);
                        debugger;
                        $('#VOU_DT')
                            .attr('min', data.fromDate)   // e.g. "2026-06-01"
                            .attr('max', data.toDate)    // e.g. "2026-06-17"
                            .val(data.lastDate);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        console.log(xhr);
                    }
                });
            }
        });

    </script>
</body>
</html>

