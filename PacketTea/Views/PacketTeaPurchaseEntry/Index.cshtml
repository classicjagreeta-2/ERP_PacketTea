// Add New Row
$(document).on('click', '.IdaddNewRecord', function () {
    if ($('#newUnitRow').length) return;

    $('#hiddenUNIT').val('');
    $('#hiddenDOCTYPE').val('');

    $('#prContainer').prepend(buildNewRow());
    initUnitPicker();

    setTimeout(() => {
        $('#ListingUnitCode').focus();
    }, 100);
});


// Unit Picker
function initUnitPicker() {

    $('#ListingUnitCode').inputpicker({
        url: '@Url.Action("GetUnit", "Purchase_Requisition")',
        fields: [
            { name: 'code', text: 'CODE' },
            { name: 'descn', text: 'NAME' }
        ],
        fieldText: 'code',
        fieldValue: 'code',
        headShow: true,
        autoOpen: true,
        pagination: true,
        pageField: 'p',
        pageLimitField: 'limit',
        pageLimit: 10,
        pageCountField: 'count',
        width: '140px',
        urlDelay: 1
    });

    // select event
    $('#ListingUnitCode').on('inputpicker.select', function (e, item) {
        if (item && item.code) {
            saveUnitData(item.code);
        }
    });

    // change fallback
    $('#ListingUnitCode').on('change', function () {
        var selectedCode = $(this).val();
        if (selectedCode) {
            fetchUnitByCode(selectedCode);
        }
    });
}


// Fetch Unit
function fetchUnitByCode(code) {
    $.ajax({
        url: '@Url.Action("GetUnit", "Purchase_Requisition")',
        data: { q: code, limit: 1, p: 1 },
        method: 'GET',
        success: function (response) {
            if (response.data && response.data.length > 0) {
                saveUnitData(response.data[0].code);
            }
        }
    });
}


// ✅ MAIN FIX HERE
function saveUnitData(code, gloca) {
    console.log('💾 Saving unit data:', code);

    $('#hiddenUNIT').val(code);

    // enable doctype
    $('#ListingDocType').prop('disabled', false);

    // clear
    $('#ListingDocType').val('');
    $('#hiddenDOCTYPE').val('');

    // load picker
    loadDocType(code);

    // 🔥 IMPORTANT: OPEN DROPDOWN
    setTimeout(() => {
        $('#ListingDocType').click();
    }, 300);
}


// Go New
