    <script>

    // =========================================================
    // LOAD DOCTYPE PICKER
    // =========================================================
    function loadDocType() {

        console.log("=================================");
        console.log("📡 LOAD DOCTYPE");
        console.log("=================================");

        var $input = $('#ListingDocType');

        // -----------------------------------------------------
        // Destroy existing inputpicker
        // -----------------------------------------------------
        if ($input.data('inputpicker')) {
            $input.inputpicker('destroy');
        }

        // -----------------------------------------------------
        // Clear old values
        // -----------------------------------------------------
        $input.val('');

        $('#hiddenDOCTYPE').val('');
        $('#hiddenDOCTYPETYPE').val('');


        // =====================================================
        // INITIALIZE DOCTYPE PICKER
        // =====================================================
        $input.inputpicker({

            // IMPORTANT:
            // No ?unit= here.
            //
            // GetDocType() internally calls:
            // /api/TeaPurchase/GetType?
            //
            url: '@Url.Action("GetDocType", "PacketTeaPurchaseEntry")',

            // Only these two are displayed
            fields: [
                { name: 'CODE', text: 'CODE' },
                { name: 'DESCN', text: 'DESCN' }
            ],

            // Show only CODE after selection
            fieldText: 'CODE',

            // Input value = CODE
            fieldValue: 'CODE',

            headShow: true,
            autoOpen: true,

            pagination: true,

            pageField: 'p',
            pageLimitField: 'limit',

            pageLimit: 10,
            pageCountField: 'count',

            width: '140px',

            urlDelay: 1
        });


        // =====================================================
        // DOCTYPE SELECT
        // =====================================================
        $input
            .off('inputpicker.select')
            .on('inputpicker.select', function (e, item) {

                console.log("=================================");
                console.log("📌 DOCTYPE SELECTED");
                console.log("Full Item:", item);
                console.log("CODE:", item ? item.CODE : '');
                console.log("DESCN:", item ? item.DESCN : '');
                console.log("TYPE:", item ? item.TYPE : '');
                console.log("=================================");


                // -------------------------------------------------
                // Invalid selection
                // -------------------------------------------------
                if (!item || !item.CODE) {

                    $('#hiddenDOCTYPE').val('');
                    $('#hiddenDOCTYPETYPE').val('');

                    return;
                }


                // -------------------------------------------------
                // Store CODE
                // -------------------------------------------------
                $('#hiddenDOCTYPE').val(item.CODE);


                // -------------------------------------------------
                // Display only CODE
                // -------------------------------------------------
                $input.val(item.CODE);


                // -------------------------------------------------
                // If inputpicker provides TYPE, store it.
                //
                // This is optional.
                // We DO NOT depend on it.
                // -------------------------------------------------
                if (item.TYPE) {

                    $('#hiddenDOCTYPETYPE').val(item.TYPE);

                    console.log(
                        "✅ TYPE received from picker:",
                        item.TYPE
                    );

                }
                else {

                    // TYPE is not available from picker.
                    // Leave it empty.
                    //
                    // It will be loaded when Go New is clicked.

                    $('#hiddenDOCTYPETYPE').val('');

                    console.log(
                        "⚠️ TYPE not available in picker."
                    );
                }


                console.log(
                    "hiddenDOCTYPE:",
                    $('#hiddenDOCTYPE').val()
                );

                console.log(
                    "hiddenDOCTYPETYPE:",
                    $('#hiddenDOCTYPETYPE').val()
                );


                // Hide picker
                $input.inputpicker('hide');

            });


        // =====================================================
        // BACKUP CHANGE EVENT
        // =====================================================
        $input
            .off('change')
            .on('change', function () {

                var value = $(this).val();

                console.log(
                    "📌 DOCTYPE CHANGE:",
                    value
                );


                if (value) {

                    $('#hiddenDOCTYPE').val(value);

                }

            });

    }



    // =========================================================
    // BUILD NEW ROW
    // =========================================================
