            </tr>
        `;
    }



    // =========================================================
    // ADD NEW ROW
    // =========================================================
    $(document).on('click', '.IdaddNewRecord', function () {

        // Prevent duplicate row
        if ($('#newUnitRow').length) {
            return;
        }


        // Clear hidden values
        $('#hiddenUNIT').val('');
        $('#hiddenDOCTYPE').val('');
        $('#hiddenDOCTYPETYPE').val('');


        // Add row
        $('#prContainer').prepend(
            buildNewRow()
        );


        // Initialize Unit picker
        initUnitPicker();


        // Focus Unit
        setTimeout(function () {

            $('#ListingUnitCode').focus();

        }, 100);

    });



    // =========================================================
    // UNIT PICKER
    // =========================================================
    function initUnitPicker() {

        var $input = $('#ListingUnitCode');


        // =====================================================
        // INITIALIZE UNIT INPUTPICKER
        // =====================================================
        $input.inputpicker({

            url: '@Url.Action("GetUnit", "PacketTeaPurchaseEntry")',

            fields: [
                { name: 'code', text: 'CODE' }
            ],

            fieldText: 'code',

            fieldValue: 'code',

            headShow: true,

            autoOpen: true,

            pagination: true,

            pageField: 'p',

            pageLimitField: 'limit',

            pageLimit: 10,

            pageCountField: 'count',

            width: '140px',

            urlDelay: 1
        });


        // =====================================================
        // UNIT SELECT
        // =====================================================
        $input
            .off('inputpicker.select')
            .on('inputpicker.select', function (e, item) {

                console.log(
                    "📌 UNIT SELECTED:",
                    item
                );


                if (item && item.code) {

                    saveUnitData(item.code);

                }

            });


        // =====================================================
        // UNIT CHANGE
        // =====================================================
        $input
            .off('change')
            .on('change', function () {

                var selectedCode = $(this).val();

                console.log(
                    "📌 UNIT CHANGE:",
                    selectedCode
                );


                if (selectedCode) {

                    fetchUnitByCode(selectedCode);

                }

            });

    }



    // =========================================================
    // FETCH UNIT BY CODE
    // =========================================================
    function fetchUnitByCode(code) {

        $.ajax({

            url: '@Url.Action("GetUnit", "PacketTeaPurchaseEntry")',

            type: 'GET',

            data: {
                q: code,
                limit: 1,
                p: 1
            },

            dataType: 'json',

            success: function (response) {

                console.log(
                    "GetUnit response:",
                    response
                );


                if (
                    response &&
                    response.data &&
                    response.data.length > 0
                ) {

                    saveUnitData(
                        response.data[0].code
                    );

                }

            },

            error: function (xhr) {

                console.error(
                    "GetUnit ERROR:",
                    xhr.status,
                    xhr.responseText
                );

            }

        });

    }



    // =========================================================
    // SAVE UNIT + LOAD DOCTYPE
    // =========================================================
    function saveUnitData(code) {

        console.log(
            "💾 Saving UNIT:",
            code
        );


        // -----------------------------------------------------
        // Store UNIT
        // -----------------------------------------------------
        $('#hiddenUNIT').val(code);


        // -----------------------------------------------------
        // Enable DocType
        // -----------------------------------------------------
        $('#ListingDocType')
            .prop('disabled', false);


        // -----------------------------------------------------
        // Clear previous DocType
        // -----------------------------------------------------
        $('#ListingDocType').val('');

        $('#hiddenDOCTYPE').val('');

        $('#hiddenDOCTYPETYPE').val('');


        // -----------------------------------------------------
        // Load DocType
        // -----------------------------------------------------
        loadDocType();


        // -----------------------------------------------------
        // Open DocType picker
        // -----------------------------------------------------
        setTimeout(function () {

            $('#ListingDocType').click();

        }, 300);

    }



    // =========================================================
    // GET TYPE FOR SELECTED DOCTYPE
    // =========================================================
    function getDocTypeType(docType, callback) {

        console.log("=================================");
        console.log("📡 GET DOCTYPE TYPE");
        console.log("DOCTYPE:", docType);
        console.log("=================================");


        if (!docType) {

            $('#hiddenDOCTYPETYPE').val('');

            callback('');

            return;
        }


        $.ajax({

            url: '@Url.Action("GetDocType", "PacketTeaPurchaseEntry")',

            type: 'GET',

            data: {
                q: docType,
                limit: 10,
                p: 1
            },

            dataType: 'json',

            success: function (response) {

                console.log(
                    "GetDocType response:",
                    response
                );


                var typeValue = '';


                // -------------------------------------------------
                // Find selected CODE
                // -------------------------------------------------
                if (
                    response &&
                    response.data &&
                    response.data.length > 0
                ) {

                    var selected = null;


                    for (
                        var i = 0;
                        i < response.data.length;
                        i++
                    ) {

                        if (
                            response.data[i].CODE &&
                            response.data[i].CODE.toUpperCase() ===
                            docType.toUpperCase()
                        ) {

                            selected = response.data[i];

                            break;
                        }

                    }


                    // If exact match wasn't found,
                    // use first result
                    if (!selected) {

                        selected =
                            response.data[0];

                    }


                    if (selected) {

                        typeValue =
                            selected.TYPE || '';

                    }

                }


                console.log(
                    "Selected TYPE:",
                    typeValue
                );


                // -------------------------------------------------
                // Store TYPE
                // -------------------------------------------------
                $('#hiddenDOCTYPETYPE')
                    .val(typeValue);


                console.log(
                    "hiddenDOCTYPETYPE:",
                    $('#hiddenDOCTYPETYPE').val()
                );


                // Return TYPE
                callback(typeValue);

            },


            error: function (xhr) {

                console.error(
                    "❌ GetDocType TYPE ERROR:",
                    xhr.status,
                    xhr.responseText
                );


                $('#hiddenDOCTYPETYPE').val('');

                callback('');

            }

        });

    }



    // =========================================================
    // GO TO NEW ENTRY
    // =========================================================
    $(document).on('click', '.go-new', function (e) {

        e.preventDefault();


        // =====================================================
        // READ UNIT
        // =====================================================
        var UNIT =
            $('#hiddenUNIT').val();


        // =====================================================
        // READ DOCTYPE
        // =====================================================
        var DOCTYPE =
            $('#hiddenDOCTYPE').val();


        // =====================================================
        // READ TYPE
        // =====================================================
        var DOCTYPE_TYPE =
            $('#hiddenDOCTYPETYPE').val();


        console.log("=================================");
        console.log("GO NEW");
        console.log("UNIT:", UNIT);
        console.log("DOCTYPE:", DOCTYPE);
        console.log("DOCTYPE TYPE:", DOCTYPE_TYPE);
        console.log("=================================");


        // =====================================================
        // UNIT VALIDATION
        // =====================================================
        if (!UNIT) {

            $.confirm({

                title: "Required Unit",

                type: "orange",

                content:
                    "<b>Please select Unit.</b>",

                buttons: {

                    OK: {
                        btnClass: "btn-orange"
                    }

                }

            });

            return;
        }



        // =====================================================
        // DOCTYPE VALIDATION
        // =====================================================
        if (!DOCTYPE) {

            $.confirm({

                title: "Required DocType",

                type: "orange",

                content:
                    "<b>Please select DocType.</b>",

                buttons: {

                    OK: {
                        btnClass: "btn-orange"
                    }

                }

            });

            return;
        }



        // =====================================================
        // IMPORTANT:
        //
        // If TYPE is already available,
        // redirect directly.
        // =====================================================
        if (DOCTYPE_TYPE) {

            redirectToInsert(
                UNIT,
                DOCTYPE,
                DOCTYPE_TYPE
            );

            return;
        }



        // =====================================================
        // TYPE IS EMPTY
        //
        // Get TYPE now and ONLY THEN redirect.
        //
        // This removes the AJAX race-condition.
        // =====================================================
        console.log(
            "⚠️ hiddenDOCTYPETYPE is empty."
        );

        console.log(
            "📡 Getting TYPE before redirect..."
        );


        // Disable Go New while loading
        $('.go-new').css({
            'pointer-events': 'none',
            'opacity': '0.5'
        });


        getDocTypeType(
            DOCTYPE,
            function (typeValue) {


                // Re-enable button
                $('.go-new').css({
                    'pointer-events': '',
                    'opacity': ''
                });


                // -------------------------------------------------
                // TYPE NOT FOUND
                // -------------------------------------------------
                if (!typeValue) {

                    $.confirm({

                        title: "Invalid DocType",

                        type: "orange",

                        content:
                            "<b>TYPE was not found for DocType: "
                            + DOCTYPE +
                            "</b>",

                        buttons: {

                            OK: {
                                btnClass: "btn-orange"
                            }

                        }

                    });

                    return;
                }


                // -------------------------------------------------
                // TYPE FOUND
                // -------------------------------------------------
                console.log(
                    "✅ TYPE found before redirect:",
                    typeValue
                );


                redirectToInsert(
                    UNIT,
                    DOCTYPE,
                    typeValue
                );

            }
        );

    });



    // =========================================================
    // REDIRECT TO INSERT / UPDATE
    // =========================================================
    function redirectToInsert(
        UNIT,
        DOCTYPE,
        DOCTYPE_TYPE
    ) {

        console.log("=================================");
        console.log("REDIRECT TO INSERT/UPDATE");
        console.log("UNIT:", UNIT);
        console.log("DOCTYPE:", DOCTYPE);
        console.log("DOCTYPE TYPE:", DOCTYPE_TYPE);
        console.log("=================================");


        // Store one final time
        $('#hiddenUNIT').val(UNIT);

        $('#hiddenDOCTYPE').val(DOCTYPE);

        $('#hiddenDOCTYPETYPE')
            .val(DOCTYPE_TYPE);


        // Build URL
        var url =
            '@Url.Action("InsertOrUpdate", "PacketTeaPurchaseEntry")'
            + '?unit='
            + encodeURIComponent(UNIT)
            + '&doctype='
            + encodeURIComponent(DOCTYPE)
            + '&doctypeType='
            + encodeURIComponent(DOCTYPE_TYPE);


        console.log(
            "Final Redirect URL:",
            url
        );


        // Redirect
        window.location.href = url;
    }

    </script>  
    
    
    
