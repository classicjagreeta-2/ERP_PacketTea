                    buttons: { ok: function () { $el.val('').focus(); } }
                });
                return;
            }

            var typedDate;
            try {
                typedDate = $.datepicker.parseDate("dd/mm/yy", val);
            } catch (e) {
                $.confirm({
                    title: 'Date Validation',
                    type: 'red',
                    content: 'Invalid date. Please enter a valid date.',
                    buttons: { ok: function () { $el.val('').focus(); } }
                });
                return;
            }

            var maxDate = new Date();
            maxDate.setHours(0, 0, 0, 0);
            typedDate.setHours(0, 0, 0, 0);

            if (typedDate > maxDate) {
                $.confirm({
                    title: 'Date Validation',
                    type: 'red',
                    content: 'Purchase Order Date cannot be greater than today.',
                    buttons: { ok: function () { $el.val('').focus(); } }
