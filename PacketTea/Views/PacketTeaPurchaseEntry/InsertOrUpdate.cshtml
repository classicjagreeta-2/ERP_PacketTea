        $(document).on('click', '#btnAddRow', function (e) {

    e.preventDefault();

    var isValid = true;
    var $lastRow = $('#mainTable tbody tr:last');

    // =========================
    // ✅ REQUIRED FIELD CHECK
    // =========================
    $lastRow.find('.req').each(function () {

        var $input = $(this);

        // 🔥 SKIP INPUTPICKER WRAPPED INPUT
        if ($input.closest('.inputpicker-wrapper').length) {
            return true;
        }

        var val = $input.val().trim();

        if (val === '' || parseFloat(val) === 0) {
            isValid = false;
            $input.css('border', '1px solid red');
        } else {
            $input.css('border', '');
        }
    });

    if (!isValid) {
        $.confirm({
            title: "Required Fields",
            type: "red",
            content: "<b>Please fill all required (*) fields before adding a new row.</b>",
            buttons: {
                ok: {
                    text: "OK",
                    btnClass: "btn-danger"
                }
            }
        });
        return;
    }

  
    var rowIndex = $('#mainTable tbody tr').length;

    $.ajax({
        url: '@Url.Action("AddProductRow", "PacketTeaPurchaseEntry")',
        type: 'GET',
        data: { rowIndex: rowIndex },
        //success: function (html) {

