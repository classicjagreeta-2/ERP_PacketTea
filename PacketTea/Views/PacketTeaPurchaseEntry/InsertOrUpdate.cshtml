    <script>

        // ======================================================
        // CALCULATE ONE ROW
        // ======================================================

        function calculateRow($row) {

            if (!$row || !$row.length) {
                return;
            }


            // ============================================
            // 1. TOTAL NET WT
            // ============================================

            var totalNetWt =
                parseFloat(
                    $row.find('.total-net-wt').val()
                ) || 0;


            // ============================================
            // 2. RATE
            // ============================================

            var rate =
                parseFloat(
                    $row.find('.rate').val()
                ) || 0;


            // ============================================
            // 3. AMOUNT
            // TOTAL NET WT × RATE
            // ============================================

            var amount =
                totalNetWt * rate;

            $row.find('.amount')
                .val(amount.toFixed(2));


            // ============================================
            // 4. DISCOUNT %
            // ============================================

            var discPer =
                parseFloat(
                    $row.find('.disc-per').val()
                ) || 0;


            // ============================================
            // 5. DISCOUNT VALUE
            // AMOUNT × DISCOUNT % / 100
            // ============================================

            var discount =
                amount * discPer / 100;

            $row.find('.discount')
                .val(discount.toFixed(2));


            // ============================================
            // 6. TAXABLE AMOUNT
            // AMOUNT - DISCOUNT
            // ============================================

            var taxableAmount =
                amount - discount;

            if (taxableAmount < 0) {
                taxableAmount = 0;
            }

            $row.find('.taxable-amt')
                .val(taxableAmount.toFixed(2));


            // ============================================
            // 7. GST RATES
            // ============================================

            var cgstRate =
                parseFloat(
                    $row.find('.cgst-rate').val()
                ) || 0;

            var sgstRate =
                parseFloat(
                    $row.find('.sgst-rate').val()
                ) || 0;

            var igstRate =
                parseFloat(
                    $row.find('.igst-rate').val()
                ) || 0;


            // ============================================
            // 8. GST AMOUNT
            // GST MUST USE TAXABLE AMOUNT
            // ============================================

            var cgstAmt =
                taxableAmount * cgstRate / 100;

            var sgstAmt =
                taxableAmount * sgstRate / 100;

            var igstAmt =
                taxableAmount * igstRate / 100;


            // ============================================
            // 9. SET GST AMOUNTS
            // ============================================

            $row.find('.cgst-amt')
                .val(cgstAmt.toFixed(2));

            $row.find('.sgst-amt')
                .val(sgstAmt.toFixed(2));

            $row.find('.igst-amt')
                .val(igstAmt.toFixed(2));


            // ============================================
            // 10. TOTAL AMOUNT
            // TAXABLE + GST
            // ============================================

            var totalAmount =
                taxableAmount +
                cgstAmt +
                sgstAmt +
                igstAmt;

            $row.find('.tot-amt')
                .val(totalAmount.toFixed(2));


            // ============================================
            // 11. HEADER TOTALS
            // ============================================

            calculateHeaderTotals();
        }
        // ======================================================
        // CALCULATE ALL ROWS
        // ======================================================

        function calculateAllRows() {

            $('#mainTable tbody tr').each(function () {

                calculateRow($(this));

            });
        }



        // ======================================================
        // HEADER TOTALS
        // ======================================================

        function calculateHeaderTotals() {

            var totalGST = 0;
            var totalAmount = 0;


            $('#mainTable tbody tr').each(function () {

                var $row = $(this);


                var cgst =
                    parseFloat(
                        $row.find('.cgst-amt').val()
                    ) || 0;

                var sgst =
                    parseFloat(
                        $row.find('.sgst-amt').val()
                    ) || 0;

                var igst =
                    parseFloat(
                        $row.find('.igst-amt').val()
                    ) || 0;

                var rowTotal =
                    parseFloat(
                        $row.find('.tot-amt').val()
                    ) || 0;


                totalGST +=
                    cgst +
                    sgst +
                    igst;

                totalAmount +=
                    rowTotal;
            });


            // ==================================================
            // HEADER GST
            // ==================================================

            $('#TotalGSTSystem')
                .val(totalGST.toFixed(2));


            // ==================================================
            // HEADER TOTAL AMOUNT
            // ==================================================

            $('#TotalAmount')
                .val(totalAmount.toFixed(2));
        }



        // ======================================================
        // WHEN WEIGHT / RATE / DISCOUNT CHANGES
        // ======================================================

        // ======================================================
        // GST CONFIRMATION FOR:
        // TOTAL NET WT / RATE / DISCOUNT %
        // ======================================================

        $(document)
            .off(
                'focus.gstChange',
                '.total-net-wt, .rate, .disc-per'
            )
            .on(
                'focus.gstChange',
                '.total-net-wt, .rate, .disc-per',
                function () {

                    // Store old value before user changes it
                    $(this).data(
                        'gst-old-value',
                        $(this).val()
                    );
                }
            );


        $(document)
            .off(
                'change.gstChange',
                '.total-net-wt, .rate, .disc-per'
            )
            .on(
                'change.gstChange',
                '.total-net-wt, .rate, .disc-per',
                function () {

                    var $input = $(this);

                    var $row =
                        $input.closest('tr');

                    var newValue =
                        $input.val();

                    var oldValue =
                        $input.data('gst-old-value');


                    // ==========================================
                    // VALUE DID NOT CHANGE
                    // ==========================================

                    if (
                        String(newValue) ===
                        String(oldValue)
                    ) {
                        calculateRow($row);
                        return;
                    }


                    // ==========================================
                    // YES
                    // ==========================================

                    function applyChange() {

                        calculateRow($row);
                    }


                    // ==========================================
                    // NO
                    // ==========================================

                    function restoreChange() {

                        $input.val(oldValue);

                        calculateRow($row);
                    }


                    // ==========================================
                    // CONFIRM
                    // ==========================================

                    confirmGSTChange(
                        applyChange,
                        restoreChange
                    );
                }
            );
        function isGSTAlreadyCalculated() {

            var hasGST = false;

            $('#mainTable tbody tr').each(function () {

                var $row = $(this);

                var cgstRate = parseFloat(
                    $row.find('input[name$=".CGST_RT"]').val()
                ) || 0;

                var sgstRate = parseFloat(
                    $row.find('input[name$=".SGST_RT"]').val()
                ) || 0;

                var igstRate = parseFloat(
                    $row.find('input[name$=".IGST_RT"]').val()
                ) || 0;

                var cgstAmt = parseFloat(
                    $row.find('input[name$=".CGST_AMT"]').val()
                ) || 0;

                var sgstAmt = parseFloat(
                    $row.find('input[name$=".SGST_AMT"]').val()
                ) || 0;

                var igstAmt = parseFloat(
                    $row.find('input[name$=".IGST_AMT"]').val()
                ) || 0;

                if (
                    cgstRate > 0 ||
                    sgstRate > 0 ||
                    igstRate > 0 ||
                    cgstAmt > 0 ||
                    sgstAmt > 0 ||
                    igstAmt > 0
                ) {
                    hasGST = true;
                    return false;
                }
            });

            return hasGST;
        }




        function confirmGSTChange(onYes, onNo) {

            // No GST calculated yet -> directly continue
            if (!isGSTAlreadyCalculated()) {

                if (typeof onYes === 'function') {
                    onYes();
                }

                return;
            }

            $.confirm({
                title: "GST Warning",
                type: "orange",

                content:
                    "GST is already calculated.<br><br>" +
                    "Changing Vendor, Location, Total Net Wt, Rate or Discount % " +
                    "will recalculate GST.",

                buttons: {

                    Yes: {
                        text: "Yes",
                        btnClass: "btn-orange",

                        action: function () {

                            if (typeof onYes === 'function') {
                                onYes();
                            }
                        }
                    },

                    No: {
                        text: "No",

                        action: function () {

                            if (typeof onNo === 'function') {
                                onNo();
                            }
                        }
                    }
                }
            });
        }
        function calculateWeight($row, source) {
            var bags = parseFloat($row.find('.bags').val()) || 0;
            var netWt = parseFloat($row.find('.net-wt').val()) || 0;
            var totalNetWt = parseFloat($row.find('.total-net-wt').val()) || 0;

            if (source === 'bags' || source === 'net-wt') {

                // TOTAL NET WT = BAGS × NET WT
                if (bags > 0 && netWt > 0) {
                    totalNetWt = bags * netWt;

                    $row.find('.total-net-wt')
                        .val(totalNetWt.toFixed(3));
                }

            } else if (source === 'total-net-wt') {

                // NET WT = TOTAL NET WT ÷ BAGS
                if (bags > 0 && totalNetWt > 0) {
                    netWt = totalNetWt / bags;

                    $row.find('.net-wt')
                        .val(netWt.toFixed(3));
                }
            }
        }


        // Bags change
        $(document)
            .off('input.weightCalculation', '.bags')
            .on('input.weightCalculation', '.bags', function () {
                calculateWeight($(this).closest('tr'), 'bags');
            });


        // Net Wt change
        $(document)
            .off('input.weightCalculation', '.net-wt')
            .on('input.weightCalculation', '.net-wt', function () {
                calculateWeight($(this).closest('tr'), 'net-wt');
            });


        // Total Net Wt change
        $(document)
            .off('input.weightCalculation', '.total-net-wt')
            .on('input.weightCalculation', '.total-net-wt', function () {
                calculateWeight($(this).closest('tr'), 'total-net-wt');
            });
    </script>

    <script>
        // ✅ SINGLE UNIFIED SUBMIT HANDLER
        $('form').off('submit').on('submit', function (e) {



            // ─── STEP 3: Required validation ───
            var isValid = true;
            $('.req').each(function () {
                if ($(this).prop('disabled')) return;
                var val = $(this).val().trim();

                if (val === '' || parseFloat(val) === 0) {
                    isValid = false;
                    $(this).css('border', '1px solid red');
                } else {
                    $(this).css('border', '');
                }
            });

            if (!isValid) {
                e.preventDefault();
                $.confirm({
                    title: "Required Fields",
                    type: "red",
                    content: "<b>Please fill all required (*) fields before saving.</b>",
                    buttons: { ok: { text: "OK", btnClass: "btn-danger" } }
                });
                return false;
            }




            var val = $('#PacketDate').val();

            if (val) {
                var parts = val.split('/');   // ✅ matches "dd/mm/yyyy" from datepicker
                if (parts.length === 3) {
                    var formatted = parts[2] + '-' + parts[1] + '-' + parts[0] + 'T00:00:00';
                    $('#DOCDT').val(formatted);
                }
            }



        });

    </script>


