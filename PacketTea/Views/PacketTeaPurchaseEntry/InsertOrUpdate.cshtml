$(document)
    .off(
        'click.locationSelect',
        '#inputpicker-wrapped-list .inputpicker-element'
    )
    .on(
        'click.locationSelect',
        '#inputpicker-wrapped-list .inputpicker-element',
        function () {

            var $pickerRow = $(this);

            var code = $.trim(
                $pickerRow.attr('data-value') || ''
            );

            if (!code) {
                return;
            }


            // ==========================================
            // OLD LOCATION VALUES
            // ==========================================

            var oldLocationName =
                $.trim($('#LocationName').val() || '');

            var oldLocationCode =
                $.trim($('#LocationCode').val() || '');

            var oldLocationState =
                $.trim($('#LocationStateCode').val() || '');

            var oldLocationGST =
                $.trim($('#LocationGSTNo').val() || '');


            // ==========================================
            // APPLY LOCATION
            // ==========================================

            function loadAndApplyLocation() {

                $.ajax({

                    url: '@Url.Action("GetLocation", "PacketTeaPurchaseEntry")',

                    type: 'GET',

                    data: {
                        q: code,
                        limit: 1,
                        p: 1
                    },

                    success: function (res) {

                        if (
                            !res ||
                            !res.data ||
                            res.data.length === 0
                        ) {
                            return;
                        }

                        var location = res.data[0];


                        // ==========================================
                        // LOCATION VALUES
                        // ==========================================

                        var locationName =
                            $.trim(location.NAME || '');

                        var locationCode =
                            $.trim(location.CODE || code);

                        var locationState =
                            $.trim(location.STATE_CODE || '');

                        var locationGST =
                            $.trim(location.GST_NO || '');


                        // ==========================================
                        // SET LOCATION
                        // ==========================================

                        $('#LocationName').val(locationName);

                        $('#LocationCode').val(locationCode);

                        $('#LocationStateCode').val(locationState);

                        $('#LocationGSTNo').val(locationGST);


                        // ==========================================
                        // HIDE PICKER
                        // ==========================================

                        $('.inputpicker-wrapped-list').remove();


                        // ==========================================
                        // RECALCULATE GST
                        // ==========================================

                        if (
                            typeof recalculateAllGradeGST ===
                            'function'
                        ) {
                            recalculateAllGradeGST();
                        }
                    },

                    error: function (xhr) {

                        console.log(
                            "GetLocation ERROR:",
                            xhr.responseText
                        );
                    }
                });
            }


            // ==========================================
            // RESTORE OLD LOCATION
            // ==========================================

            function restoreLocation() {

                $('#LocationName').val(
                    oldLocationName
                );

                $('#LocationCode').val(
                    oldLocationCode
                );

                $('#LocationStateCode').val(
                    oldLocationState
                );

                $('#LocationGSTNo').val(
                    oldLocationGST
                );

                $('.inputpicker-wrapped-list').remove();
            }


            // ==========================================
            // GST CONFIRMATION
            // ==========================================

            confirmGSTChange(
                loadAndApplyLocation,
                restoreLocation
            );
        }
    );



    </script>

