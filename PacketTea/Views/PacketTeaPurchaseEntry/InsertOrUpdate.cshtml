// =====================================
// GET COMPLETE GRADE DATA
// =====================================

function getGradeDetails($row, gradeCode) {

    if (!gradeCode) {
        clearGradeGST($row);
        return;
    }

    $.ajax({
        url: '@Url.Action("GetGrade", "PacketTeaPurchaseEntry")',
        type: 'GET',

        data: {
            q: gradeCode,
            limit: 1,
            p: 1
        },

        success: function (res) {

            if (
                res &&
                res.data &&
                res.data.length > 0
            ) {

                var grade = res.data[0];

                // Set description
                $row.find('.grade-desc')
                    .val(grade.NAME || '');

                // Apply Grade GST rates
                applyGradeGST($row, grade);

            }
            else {

                clearGradeGST($row);

                $row.find('.grade-code').val('');
                $row.find('.grade-desc').val('');
            }
        },

        error: function (xhr) {

            console.log("GetGrade Error:", xhr.responseText);

            clearGradeGST($row);
        }
    });
}
function applyGradeGST($row, grade) {

    if (!$row || !$row.length || !grade) {
        clearGradeGST($row);
        return;
    }

    // ==================================================
    // VENDOR DATA
    // ==================================================

    var vendorGST = $.trim(
        $('#VendorGSTNo').val() || ''
    );

    var vendorState = $.trim(
        $('#VendorStateCode').val() || ''
    );


    // ==================================================
    // LOCATION DATA
    // ==================================================

    var locationGST = $.trim(
        $('#LocationGSTNo').val() || ''
    );

    var locationState = $.trim(
        $('#LocationStateCode').val() || ''
    );


    // ==================================================
    // GRADE MASTER GST
    // ==================================================

    var gradeCGST =
        parseFloat(grade.CGST_RATE) || 0;

    var gradeSGST =
        parseFloat(grade.SGST_RATE) || 0;

    var gradeIGST =
        parseFloat(grade.IGST_RATE) || 0;


    // ==================================================
    // GST INPUTS
    // ==================================================

    var $cgstRate = $row.find(
        'input[name$=".CGST_RT"]'
    );

    var $sgstRate = $row.find(
        'input[name$=".SGST_RT"]'
    );

    var $igstRate = $row.find(
        'input[name$=".IGST_RT"]'
    );

    var $cgstAmt = $row.find(
        'input[name$=".CGST_AMT"]'
    );

    var $sgstAmt = $row.find(
        'input[name$=".SGST_AMT"]'
    );

    var $igstAmt = $row.find(
        'input[name$=".IGST_AMT"]'
    );


    // ==================================================
    // ALWAYS CLEAR PREVIOUS GST FIRST
    // ==================================================

    $cgstRate.val('0.00');
    $sgstRate.val('0.00');
    $igstRate.val('0.00');

    $cgstAmt.val('0.00');
    $sgstAmt.val('0.00');
    $igstAmt.val('0.00');


    // ==================================================
    // 1. BOTH VENDOR GST AND LOCATION GST EMPTY
    //    ALL GST = ZERO
    // ==================================================

    if (
        vendorGST === '' &&
        locationGST === ''
    ) {

        $cgstRate.val('0.00');
        $sgstRate.val('0.00');
        $igstRate.val('0.00');

        $cgstAmt.val('0.00');
        $sgstAmt.val('0.00');
        $igstAmt.val('0.00');

        calculateRow($row);
        return;
    }


    // ==================================================
    // 2. REQUIRED GST / STATE DATA MISSING
    //    ALL GST = ZERO
    // ==================================================

    if (
        vendorGST === '' ||
        vendorState === '' ||
        locationGST === '' ||
        locationState === ''
    ) {

        $cgstRate.val('0.00');
        $sgstRate.val('0.00');
        $igstRate.val('0.00');

        $cgstAmt.val('0.00');
        $sgstAmt.val('0.00');
        $igstAmt.val('0.00');

        calculateRow($row);
        return;
    }


    // ==================================================
    // 3. VENDOR GST == LOCATION GST
    //    NO GST
    // ==================================================

    if (vendorGST === locationGST) {

        $cgstRate.val('0.00');
        $sgstRate.val('0.00');
        $igstRate.val('0.00');

        $cgstAmt.val('0.00');
        $sgstAmt.val('0.00');
        $igstAmt.val('0.00');

        calculateRow($row);
        return;
    }


    // ==================================================
    // 4. VENDOR GST != LOCATION GST
    //    SAME STATE -> CGST + SGST
    // ==================================================

    if (vendorState === locationState) {

        $cgstRate.val(
            gradeCGST.toFixed(2)
        );

        $sgstRate.val(
            gradeSGST.toFixed(2)
        );

        $igstRate.val('0.00');

        calculateRow($row);
        return;
    }


    // ==================================================
    // 5. VENDOR GST != LOCATION GST
    //    DIFFERENT STATE -> IGST
    // ==================================================

    $cgstRate.val('0.00');
    $sgstRate.val('0.00');

    $igstRate.val(
        gradeIGST.toFixed(2)
    );

    calculateRow($row);
}

