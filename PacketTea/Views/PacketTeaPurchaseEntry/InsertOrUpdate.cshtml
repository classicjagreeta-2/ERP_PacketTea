

@model PacketTea.Models.PT.PT_ALL_LIST
@using PacketTea.Utility
@{
    ViewBag.Title = "InsertOrUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">


    <!-- CSS -->
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/jquery-ui.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    @*<link rel="stylesheet" href="~/libraries/MULTI_SELECT_DROPDOWN/jquery.inputpicker.css">*@


    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th {
            background-color: #248cb5 !important;
            color: white !important;
            font-weight: bold !important;
        }

        .inputpicker-wrapped-list .inputpicker-highlight-active td {
            background-color: #404e68 !important;
            color: white !important;
        }

        .inputpicker-wrapped-list .inputpicker-active td {
            background: #404e68 !important;
            color: white !important;
        }

        #prScroll {
            max-height: 420px; /* change height */
            overflow-y: auto;
        }

        .popup-overlay {
            display: none;
        }

        .popup-box {
            display: none;
        }

        tbody div {
            overflow: visible !important;
            height: max-content;
        }

        .table.table-sm td, .table.table-sm th {
            padding: 0.4rem 0.2rem !important;
        }

        .inputpicker-wrapped-list {
            min-width: max-content !important;
            max-width: max-content !important;
        }

            .inputpicker-wrapped-list table {
                width: max-content !important;
            }

        .table th {
            background-color: #404e68 !important;
        }

        #linesTableWrapper {
            position: relative;
            min-height: 80px;
        }

        #linesLoader {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            min-height: 80px;
            background: rgba(255, 255, 255, 0.85);
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            z-index: 999;
        }

        .lines-spinner {
            width: 30px;
            height: 30px;
            border: 4px solid #ddd;
            border-top: 4px solid #404e68;
            border-radius: 50%;
            animation: linesSpinner 0.8s linear infinite;
        }

        #linesLoader span {
            margin-top: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        @@keyframes linesSpinner {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>


    <!-- second screen start -->
    <div class="general-container">
        <div class="purchase-details">

            @using (Html.BeginForm("SaveForm", "PacketTeaPurchaseEntry", FormMethod.Post, new { id = "frmpo" }))
            {
                @Html.HiddenFor(m => m.T_TEA_HEAD.UNIT, new { id = "UNIT" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.GLOCA, new { id = "GLOCA" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.DOCDT, new { id = "DOCDT" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.DOCNO, new { id = "DOCNO" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.PUR_TYPE, new { id = "PUR_TYPE" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.ID, new { id = "ID" })
                @Html.HiddenFor(m => m.T_TEA_HEAD.DOC_YEAR, new { id = "DOC_YEAR" })
                @Html.AntiForgeryToken()
                <input type="hidden" id="hiddenUNIT" />
                <input type="hidden" id="hiddenDOCTYPE" />
                <input type="hidden" id="hiddenDOCTYPETYPE" />
                @*<input type="hidden" id="LocationStateCode" />
                    <input type="hidden" id="LocationGSTNo" />*@

                <input type="hidden" id="VendorStateCode" />
                <input type="hidden" id="VendorGSTNo" />
                <!-- header content start -->
                <div class="header-content">
                    <!-- action btns start -->
                    <div class="action-btns">
                        <ul>

                            <li>
                                <a href="@Url.Action("Index", "PacketTeaPurchaseEntry")"
                                   onclick="return ReleaseLockAndRedirect(this);">
                                    <i class="fa fa-arrow-left"></i> Back
                                </a>
                            </li>
                            <li>
                                <button type="submit" style="background:none;border:0;cursor:pointer;">
                                    <i class="fa fa-floppy-o"></i> Save
                                </button>
                            </li>
                            <li><a href="@Url.Action("Index", "PacketTeaPurchaseEntry")" onclick="return ReleaseLockAndRedirect(this);"><i class="fa fa-times"></i> Cancel</a></li>


                            <li><a href="javascript:void(0)" class="openPopup" data-popup="Notes"><i class="fa fa-file-text-o"></i> Notes</a></li>
                            <li style="margin-left:auto">
                                <label class="btn btn-inverse pull-right" style="margin:20px; border:none;">

                                    Status : <span id="statusText" style="color:white;">Add</span>

                                </label>
                            </li>
                        </ul>
                    </div>
                    <!-- action btns end -->
                    <div class="header-details">
                        <div class="left">
                            <div class="order-code">
                                <div class="txt">
                                    <div class="title-heading">Packet Tea Purchase Entry</div>
                                </div>
                                <div class="field">
                                    @*Unit Code & Name*@
                                </div>
                            </div>

                            <div class="title-heading">
                                PT NO. : @(Model.T_TEA_HEAD.UNIT ?? "")@(Model.T_TEA_HEAD.DOCNO ?? "")
                            </div>
                        </div>

                        <div class="right">

                            <div>
                                Status : <span id="statusText2">Unknown</span>
                            </div>

                            @*<input type="hidden" id="approvedVal" value="@((Model.TRN_PO_HEAD.APPROVED ?? "").Trim())" />*@
                        </div>
                    </div>
                </div>
                <!-- header content end -->
                <div class="accordion-container">
                    <!-- Accordion for Header Section -->
                    <div class="accordion">
                        <div class="accordion-header"><span class="txt">Header</span></div>
                        <div class="accordion-body ">
                            <!-- Customer account -->
                            <div class="form-row">
                                <div class="form-col-10">
                                    <label>Document No </label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.DOCNO, new { @class = "form-control ", @readonly = "readonly", tabindex = "-1" })
                                </div>
                                <div class="form-col-10">
                                    <label>Date <span>(*)</span></label>
                                    <div class="date-field">

                                        @Html.TextBoxFor(m => m.T_TEA_HEAD.DOCDT, "{0:dd/MM/yyyy}",
                             new { @class = "form-control req", @id = "PacketDate" })
                                        <img src="@Url.Content("~/Controllers/Test/assets/images/calendar.png")"
                                             alt="calendar"
                                             class="calendar-icon" data-target="PacketDate" />
                                    </div>

                                </div>
                                <div class="form-col-10">
                                    <label>Pur. Location <span>(*)</span></label>
                                    @Html.TextBoxFor(
                                            m => m.T_TEA_HEAD.LOCATIONDESC,
                                            new
                                        {
                                                @class = "form-control req location-desc",
                                                @id = "LocationName"
                                            }
                                        )

                                    @Html.HiddenFor(
                                        m => m.T_TEA_HEAD.SALE_CENTRE,
                                        new
                                        {
                                            @id = "LocationCode"
                                        }
                                    )

                                    <input type="hidden"
                                           id="LocationStateCode" />

                                    <input type="hidden"
                                           id="LocationGSTNo" />


                                </div>


                                @*<div class="form-col-10">
                                        <label>Flavour Purchase</label>

                                        @Html.TextBoxFor(model => model.T_TEA_HEAD.FLAVOUR, new { @class = "form-control" })
                                    </div>*@
                                <div class="form-col-10">
                                    <label>Vendor Code <span>(*)</span></label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.PCODE, new { @class = "form-control req vendor-code" })

                                </div>
                                <div class="form-col-20">
                                    <label>Vendor Name</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.VENDORNAME, new { @class = "form-control vendor-desc", @readonly = "readonly" })

                                </div>


                                <div class="form-col-10">
                                    <label>Broker</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.BROK_CODE, new { @class = "form-control broker-code" })
                                </div>


                            </div>

                            <div class="form-row" style="line-height:2.5;">

                                <div class="form-col-20">
                                    <label>Broker Name</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.BROKERNAME, new { @class = "form-control broker-desc", @readonly = "readonly", tabindex = "-1" })
                                </div>

                                <div class="form-col-10">
                                    <label>Transporter</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TPT, new { @class = "form-control trans-code" })
                                </div>
                                <div class="form-col-20">
                                    <label>Transporter Name</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TRANSPORTERNAME, new { @class = "form-control trans-desc", @readonly = "readonly", tabindex = "-1" })
                                </div>
                                <div class="form-col-10">
                                    <label>Bill No <span>(*)</span></label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.BILLNO, new { @class = "form-control req" })
                                </div>
                                <div class="form-col-10">
                                    <label>Date </label>

                                    <div class="date-field">

                                        @Html.TextBoxFor(m => m.T_TEA_HEAD.BILLDT, "{0:dd/MM/yyyy}",
