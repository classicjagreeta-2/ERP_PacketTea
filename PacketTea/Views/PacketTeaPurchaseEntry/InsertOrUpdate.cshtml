        function renumberLines() {

            $('#mainTable tbody tr').each(function (index) {

                var lineNo = index + 1;

                // update visible line column
                $(this).find('td:eq(1)').text(lineNo);

                // update hidden SLNO
                $(this).find('input[name*=".SLNO"]').val(lineNo);

                // update all name indexes

                $(this).find('input,select,textarea').not('[name$=".ID"]').each(function () {

                    var name = $(this).attr('name');

                    if (name) {
                        var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                        $(this).attr('name', newName);
                    }

                });

            });

        }
    </script>
