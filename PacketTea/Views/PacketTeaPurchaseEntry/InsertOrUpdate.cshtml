                                            <th style="width:30px;" hidden>IndType</th>
                                            <th style="width:30px;" hidden>SrlNo</th>
                                            <th>Select</th>
                                            <th>Sl.</th>
                                            <th>Inv No  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Mark Code  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Mark</th>
                                            <th>Grade Code  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Grade</th>
                                            <th>Category</th>
                                            <th>Bags  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Net Wt  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Gross Wt <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Total Net Wt <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Size Code <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Size</th>
                                            <th style="text-align:right;">Rate  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Amount</th>
                                            <th style="text-align:right;">Disc %  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Disc Value  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th style="text-align:right;">Taxable Amt</th>
                                            <th style="text-align:right;">CGST %</th>
                                            <th style="text-align:right;">CGST Amt</th>
                                            <th style="text-align:right;">SGST %</th>
                                            <th style="text-align:right;">SGST Amt</th>
                                            <th style="text-align:right;">IGST %</th>
                                            <th style="text-align:right;">IGST Amt</th>
                                            <th style="text-align:right;">Total Amt</th>
                                            <th>WH Code  <span style="font-weight: bold; color: red;">(*)</span></th>
                                            <th>Warehouse</th>
                                            <th>DO No</th>
                                            <th>DO Date</th>
                                            <th>Alloc. Code</th>
                                            <th>Alocation</th>
                                            <th>OrgTe Type</th>
                                            <th>Descn</th>

                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                                <div id="modalContainer"></div>
                            </div>
                            <!-- table end -->
                        </div>
                    </div>

                    <!-- Accordion for Line Details Section -->
                    <div class="accordion">
                        <div class="accordion-header"><span class="txt">Line Details</span></div>
                        <div class="accordion-body active" style="display:block;">
                            <div class="form-row">
                                <div class="form-col-10">
                                    <label>Head</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.REMARKS, new { @class = "form-control " })
                                </div>
                                <div class="form-col-20">
                                    <label>Description</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.REMARKS, new { @class = "form-control ", @readonly = "readonly" })
                                </div>
                                <div class="form-col-10">
                                    <label>Detd. on Amt.</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TDS_DETD, new { @class = "form-control " })
                                </div>
                                <div class="form-col-10">
                                    <label>TDS %</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TDS_PER, new { @class = "form-control " })
                                </div>
                                <div class="form-col-10">
                                    <label>TDS Amt.</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TDS_AMT, new { @class = "form-control " })
                                </div>
                                <div class="form-col-10">
                                    <label>Total GST As Per System </label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TOT_GSTAMT_M, new { @class = "form-control", id = "TotalGSTSystem" })
                                </div>
                            </div>
                            <div class="form-row" style="line-height:2.5;">

                                <div class="form-col-10">
                                    <label>Total GST As Per Invoice </label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TOT_GSTAMT_M, new { @class = "form-control" })
                                </div>

                                <div class="form-col-10">
                                    <label> Rounded Off</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.ROUNDOFF, new { @class = "form-control" })
                                </div>

                                <div class="form-col-10">
                                    <label> Total Amount</label>
                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.TOT_AMT, new { @class = "form-control", id = "TotalAmount" })
                                </div>

                            </div>

                        </div>
