// ======================================================
// VENDOR VALIDATION MAP
// ======================================================

const vendorValidationMap = new Map();


// ======================================================
// CLEAR VENDOR
// ======================================================

function clearVendor($input) {

    $input.val('');
    $('.vendor-desc').val('');

    $('#VendorStateCode').val('');
    $('#VendorGSTNo').val('');

    $('#mainTable tbody tr').each(function () {

        recalculateAllGradeGST();
    });
}


// ======================================================
// SHOW ALERT
// ======================================================

function showVendorAlert(message) {

    $.alert({
        title: "",
        type: "red",
        content: message,
        buttons: {
            ok: {
                text: "OK",
                btnClass: "btn-danger"
            }
        }
    });
}


// ======================================================
// VALIDATE VENDOR
// ======================================================

function validateVendor($input, code) {

    code = $.trim(code || '');

    if (!code) {
        clearVendor($input);
        return;
    }

    var key = code.toUpperCase();


    // ==================================================
    // CHECK MAP
    // ==================================================

    if (vendorValidationMap.has(key)) {

        var cached = vendorValidationMap.get(key);


        // ----------------------------------------------
        // AJAX ALREADY RUNNING
        // ----------------------------------------------

        if (cached.status === 'loading') {
            return;
        }


        // ----------------------------------------------
        // VALID VENDOR
        // ----------------------------------------------

        if (cached.status === 'valid') {

            $input.val(cached.code);

            $('.vendor-desc').val(cached.name);

            $('#VendorStateCode').val(cached.state);

            $('#VendorGSTNo').val(cached.gst);

            if (typeof recalculateAllGradeGST === 'function') {
                recalculateAllGradeGST();
            }

            return;
        }

        // IMPORTANT:
        // There is NO "invalid" return here.
        //
        // Invalid vendors are not kept permanently in Map.
    }


    // ==================================================
    // SET LOADING
    // ==================================================

    vendorValidationMap.set(key, {
        status: 'loading'
    });


    // ==================================================
    // AJAX
    // ==================================================

    $.ajax({

        url: '@Url.Action("GetVendor", "PacketTeaPurchaseEntry")',

        type: 'GET',

        data: {
            q: code,
            limit: 1,
            p: 1
        },


        success: function (res) {

            // ==========================================
            // NOT FOUND
            // ==========================================

            if (
                !res ||
                !res.data ||
                res.data.length === 0
            ) {

                // REMOVE INVALID FROM MAP
                vendorValidationMap.delete(key);

                clearVendor($input);

                showVendorAlert(
                    'Invalid Vendor Code.'
                );

                return;
            }


            // ==========================================
            // GET VENDOR
            // ==========================================

            var vendor = res.data[0];

            var vendorCode =
                $.trim(vendor.subcode || '');

            var vendorName =
                $.trim(vendor.acname || '');

            var vendorState =
                $.trim(vendor.statE_CODE || '');

            var vendorGST =
                $.trim(vendor.gsT_NO || '');


            // ==========================================
            // VERIFY CODE
            // ==========================================

            if (
                vendorCode.toUpperCase() !==
                code.toUpperCase()
            ) {

                vendorValidationMap.delete(key);

                clearVendor($input);

                showVendorAlert(
                    'Invalid Vendor Code.'
                );

                return;
            }


            // ==========================================
            // STATE CODE REQUIRED
            // ==========================================

            if (!vendorState) {

                // IMPORTANT:
                // DO NOT CACHE INVALID VENDOR

                vendorValidationMap.delete(key);

                clearVendor($input);

                showVendorAlert(
                    'Vendor State Code is not available.'
                );

                return;
            }


            // ==========================================
            // VALID VENDOR
            // ==========================================

            vendorValidationMap.set(key, {

                status: 'valid',

                code: vendorCode,

                name: vendorName,

                state: vendorState,

                gst: vendorGST
            });


            // ==========================================
            // SET VALUES
            // ==========================================

            $input.val(vendorCode);

            $('.vendor-desc').val(vendorName);

            $('#VendorStateCode').val(vendorState);

            $('#VendorGSTNo').val(vendorGST);


            // ==========================================
            // GST RECALCULATION
            // ==========================================

            if (typeof recalculateAllGradeGST === 'function') {
                recalculateAllGradeGST();
            }
        },


        error: function (xhr) {

            console.log(
                "GetVendor Error:",
                xhr.responseText
            );

            vendorValidationMap.delete(key);

            clearVendor($input);

            showVendorAlert(
                'Unable to validate Vendor.'
            );
        }
    });
}


// ======================================================
// VENDOR INPUTPICKER
// ======================================================

$(document).on('click', '.vendor-code', function () {

    var $input = $(this);

    $('.inputpicker-wrapped-list').remove();


    // Already initialized
    if ($input.data('inputpicker')) {

        $input.inputpicker('show');

        return;
    }


    // ==================================================
    // INITIALIZE
    // ==================================================

    $input.inputpicker({

        url: '@Url.Action("GetVendor", "PacketTeaPurchaseEntry")',

        fields: [

            { name: 'subcode', text: 'CODE' },

            { name: 'acname', text: 'NAME' },

            { name: 'acode', text: 'ACODE' },

            { name: 'uniT_CODE', text: 'UNIT CODE' },

            { name: 'statE_CODE', text: 'STATE CODE' },

            { name: 'gsT_NO', text: 'GST NO' }
        ],

        fieldText: 'subcode',

        fieldValue: 'subcode',

        headShow: true,

        filterOpen: true,

        autoOpen: true,

        pagination: true,

        pageField: 'p',

        pageLimitField: 'limit',

        pageLimit: 10,

        pageCountField: 'count',

        width: 'auto',

        urlDelay: 1
    });

    $input
        .off('inputpicker.select.vendor')
        .on(
            'inputpicker.select.vendor',
            function (e, item) {

                if (!item) {
                    return;
                }

                var $this = $(this);

                // ======================================
                // OLD VALUES
                // ======================================

                var oldCode =
                    $.trim($this.val() || '');

                var oldName =
                    $.trim($('.vendor-desc').val() || '');

                var oldState =
                    $.trim($('#VendorStateCode').val() || '');

                var oldGST =
                    $.trim($('#VendorGSTNo').val() || '');


                // ======================================
                // NEW VALUES
                // ======================================

                var code =
                    $.trim(item.subcode || '');

                var name =
                    $.trim(item.acname || '');

                var state =
                    $.trim(item.statE_CODE || '');

                var gst =
                    $.trim(item.gsT_NO || '');


                // ======================================
                // EMPTY
                // ======================================

                if (!code) {

                    clearVendor($this);

                    $this.inputpicker('hide');

                    return;
                }


                // ======================================
                // STATE VALIDATION
                // ======================================

                if (!state) {

                    vendorValidationMap.delete(
                        code.toUpperCase()
                    );

                    showVendorAlert(
                        'Vendor State Code is not available.'
                    );

                    return;
                }


                // ======================================
                // APPLY NEW VENDOR
                // ======================================

                function applyVendor() {

                    $this.val(code);

                    $('.vendor-desc').val(name);

                    $('#VendorStateCode').val(state);

                    $('#VendorGSTNo').val(gst);

                    $this.inputpicker('hide');


                    // ======================================
                    // STORE VALID VENDOR
                    // ======================================

                    vendorValidationMap.set(
                        code.toUpperCase(),
                        {
                            status: 'valid',
                            code: code,
                            name: name,
                            state: state,
                            gst: gst
                        }
                    );


                    // ======================================
                    // RECALCULATE GST
                    // ======================================

                    if (typeof recalculateAllGradeGST === 'function') {
                        recalculateAllGradeGST();
                    }
                }


                // ======================================
                // CANCEL -> RESTORE OLD VENDOR
                // ======================================

                function restoreVendor() {

                    $this.val(oldCode);

                    $('.vendor-desc').val(oldName);

                    $('#VendorStateCode').val(oldState);

                    $('#VendorGSTNo').val(oldGST);

                    $this.inputpicker('hide');
                }


                // ======================================
                // GST CONFIRMATION
                // ======================================

                confirmGSTChange(
                    applyVendor,
                    restoreVendor
                );
            }
        );
  
});


// ======================================================
// MANUAL TYPING / BLUR
// ======================================================

$(document)
    .off('blur.vendorValidation', '.vendor-code')
    .on(
        'blur.vendorValidation',
        '.vendor-code',
        function () {

            var $input = $(this);

            var code =
                $.trim($input.val() || '');


            if (!code) {

                clearVendor($input);

                return;
            }


            var key = code.toUpperCase();


            // ==========================================
            // IF VALIDATED ALREADY
            // ==========================================

            if (vendorValidationMap.has(key)) {

                var cached =
                    vendorValidationMap.get(key);

                if (cached.status === 'loading') {
                    return;
                }

                if (cached.status === 'valid') {
                    return;
                }
            }


            // ==========================================
            // MANUAL VALIDATION
            // ==========================================

            validateVendor($input, code);
        }
    );

    </script>


