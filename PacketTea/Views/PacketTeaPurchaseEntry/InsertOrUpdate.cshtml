                                             alt="calendar"
                                             class="calendar-icon" data-target="BillNoDate" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-row" style="line-height:2.5;">

                                <div class="form-col-10">
                                    <label>Action Sale number</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.SALE_NO, new { @class = "form-control" })
                                </div>

                                <div class="form-col-10">
                                    <label>Vehicle No</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.VEH_NO, new { @class = "form-control" })
                                </div>
                                <div class="form-col-10">
                                    <label>CN NO</label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.CONCT_DOCNO, new { @class = "form-control" })
                                </div>
                                <div class="form-col-10">
                                    <label>Date</label>

                                    <div class="date-field">

                                        @Html.TextBoxFor(m => m.T_TEA_HEAD.SALE_DATE, "{0:dd/MM/yyyy}",
                             new { @class = "form-control", @id = "CnNoDate" })
                                        <img src="@Url.Content("~/Controllers/Test/assets/images/calendar.png")"
                                             alt="calendar"
                                             class="calendar-icon" data-target="CnNoDate" />
                                    </div>
                                </div>
                                <div class="form-col-10">
                                    <label>E-Way Bill No </label>

                                    @Html.TextBoxFor(model => model.T_TEA_HEAD.EWAYBILLNO, new { @class = "form-control" })
                                </div>
                                <div class="form-col-10">
                                    <label>Date </label>

                                    <div class="date-field">

                                        @Html.TextBoxFor(m => m.T_TEA_HEAD.EWAYBILLDT, "{0:dd/MM/yyyy}",
                             new { @class = "form-control", @id = "EWayBillNoDate" })
                                        <img src="@Url.Content("~/Controllers/Test/assets/images/calendar.png")"
                                             alt="calendar"
                                             class="calendar-icon" data-target="EWayBillNoDate" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

